"""The benchmark harness: its scenario corpus and its driver image.

`crates/bench-driver`'s `scenario_files` suite loads every scenario file through
the driver's own `Scenario` type, so a scenario that stops parsing names
itself. `bench/manifests/driver/job-template.yaml` runs the driver image as a
Kubernetes Job. The rest of this directory (the other manifests, the Terraform,
the scripts and the justfile) drives a live cluster and has no Bazel target.

The driver image is built the way //packaging builds the broker image: apko
builds the locked Wolfi base, and rules_img adds the Bazel-built binary.

    bazel run -c opt //bench:driver_image_load    # load into the local daemon
    bazel run -c opt //bench:driver_push -- --tag dev
"""

load("@rules_apko//apko:defs.bzl", "apko_image")
load("@rules_img//img:convert.bzl", "image_manifest_from_oci_layout")
load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:layer.bzl", "file_metadata", "image_layer")
load("@rules_img//img:load.bzl", "image_load")
load("@rules_img//img:media_types.bzl", "GZIP_LAYER")
load("@rules_img//img:push.bzl", "image_push")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "scenarios",
    srcs = glob(["scenarios/*.yaml"]),
)

apko_image(
    name = "driver_base_oci",
    config = "driver.apko.yaml",
    contents = "@bench_driver_base_lock//:contents",
    tag = "krabka-bench-driver-base:locked",
)

image_manifest_from_oci_layout(
    name = "driver_base",
    src = ":driver_base_oci",
    architecture = "amd64",
    layers = [GZIP_LAYER],
    os = "linux",
)

image_layer(
    name = "driver_layer",
    srcs = {
        "/usr/bin/krabka-bench-driver": "//crates/bench-driver:krabka-bench-driver",
    },
    # Owned by `nonroot` in the apko base, which is the user the Job runs as.
    default_metadata = file_metadata(
        gid = 65532,
        mode = "0755",
        uid = 65532,
    ),
    include_runfiles = False,
)

# The layer carries whatever the host toolchain built, and the manifest says
# linux/amd64. `target_compatible_with` makes a build on any other host skip
# the image, as //packaging:image does.
image_manifest(
    name = "driver_image",
    base = ":driver_base",
    entrypoint = ["/usr/bin/krabka-bench-driver"],
    layers = [":driver_layer"],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    user = "65532:65532",
)

# `krabka-bench-driver:e2e` is the tag `bench/justfile` and
# `bench/scripts/run-scenario.sh` use when `BENCH_DRIVER_IMAGE` is unset. It is
# spelled in full here: a daemon on the containerd image store lists a short
# tag that `image_load` writes, but `docker run` cannot resolve it.
image_load(
    name = "driver_image_load",
    image = ":driver_image",
    tag = "docker.io/library/krabka-bench-driver:e2e",
)

# The tarball `driver_image_load` writes, which `bench/justfile`'s
# `kind-up` recipe loads into the kind cluster.
filegroup(
    name = "driver_image_tar",
    srcs = [":driver_image_load"],
    output_group = "tarball",
)

# CI supplies the tags on the command line, as it does for //packaging:push.
image_push(
    name = "driver_push",
    image = ":driver_image",
    registry = "ghcr.io",
    repository = "krabka-io/krabka-bench-driver",
)
