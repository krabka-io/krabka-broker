[Unit]
Description=Krabka broker (OMB bench harness)
After=network.target

[Service]
ExecStart=/usr/local/bin/krabka-broker --config-file /etc/krabka-broker.toml
WorkingDirectory={{ krabka_install_dir }}
Environment='RUST_LOG=info,krabka_broker=info,krabka_log=info'
RestartSec=1s
Restart=on-failure
Type=simple
LimitNOFILE=300000

[Install]
WantedBy=multi-user.target
