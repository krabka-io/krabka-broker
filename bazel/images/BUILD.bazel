"""Kafka images the container-driven suites run against.

Pulled by Bazel from a digest and loaded into the local daemon at test time,
rather than pulled by testcontainers over the network mid-test. That pins the
bytes a test runs against, keeps the network out of the test itself, and lets
the repository cache carry the images between CI runs.

`image_load` produces a `docker load`-able tarball; `//bazel:docker_test.sh` loads
each one it is handed before executing the test binary.
"""

load("@rules_apko//apko:defs.bzl", "apko_image")
load("@rules_img//img:convert.bzl", "image_manifest_from_oci_layout")
load("@rules_img//img:load.bzl", "image_load")
load("@rules_img//img:media_types.bzl", "GZIP_LAYER")

package(default_visibility = ["//visibility:public"])

# Tag each image is loaded under -- the name the suites' `const KAFKA_IMAGE`
# strings use. Keep in step with //MODULE.bazel, which pins the digests.
IMAGES = {
    "apache_kafka_4_0_0": "mirror.gcr.io/apache/kafka:4.0.0",
    "apache_kafka_4_1_0": "mirror.gcr.io/apache/kafka:4.1.0",
    "apache_kafka_4_3_1": "mirror.gcr.io/apache/kafka:4.3.1",
    "cp_kafka_3_1_2": "mirror.gcr.io/confluentinc/cp-kafka:3.1.2",
    "cp_kafka_6_1_1": "mirror.gcr.io/confluentinc/cp-kafka:6.1.1",
    "cp_kafka_7_4_0": "mirror.gcr.io/confluentinc/cp-kafka:7.4.0",
    "cp_kafka_7_5_0": "mirror.gcr.io/confluentinc/cp-kafka:7.5.0",
    "cp_kafka_7_8_8": "mirror.gcr.io/confluentinc/cp-kafka:7.8.8",
    "fake_gcs_server": "mirror.gcr.io/fsouza/fake-gcs-server:1.56.1",
    "kcat_1_7_1": "mirror.gcr.io/edenhill/kcat:1.7.1",
    "minio": "mirror.gcr.io/minio/minio:RELEASE.2025-09-07T16-13-09Z",
    "minio_mc": "mirror.gcr.io/minio/mc:RELEASE.2025-08-13T08-35-41Z",
}

[
    image_load(
        name = name,
        image = "@" + name,
        tag = tag,
        tags = ["docker"],
    )
    for name, tag in IMAGES.items()
]

# The tarball each `image_load` produces, which is what a test consumes.
[
    filegroup(
        name = name + "_tar",
        srcs = [":" + name],
        output_group = "tarball",
        tags = ["docker"],
    )
    for name in IMAGES
]

# The client images built here rather than pulled, as `name: tag` the way
# `IMAGES` above is, and consumed by the suites the same way.
#
# Nothing published carries either client. `kcat` has had no release since
# 1.7.1 and every published build of it -- Confluent's 2026 `cp-kcat` included
# -- links the librdkafka 1.8.2 that release's bootstrap pins, so a client on
# the 2.x line that the whole confluent-kafka-{python,go,dotnet} family sits on
# has to be assembled. Wolfi packages `kcat` against its own librdkafka, which
# is 2.15.0, so the assembly is a package list. `kaf` is there for the same
# reason and a different one: it is a Kafka client that is neither librdkafka
# nor the JVM -- Go and sarama, an independent decoder of the protocol.
#
# The bytes are pinned by the apko lock beside each config rather than by a
# registry digest, which is why these are not in `IMAGES`: there is no
# //MODULE.bazel pull tuple for `aspect check-images` to hold them against, and
# the lock pins every package by version and checksum instead.
BUILT_IMAGES = {
    "kaf_sarama": "docker.io/krabka-io/kaf:0.2.14",
    "kcat_librdkafka_2x": "docker.io/krabka-io/kcat:librdkafka-2.15.0",
}

[
    apko_image(
        name = name + "_oci",
        config = name + ".apko.yaml",
        contents = "@" + name + "_lock//:contents",
        tag = name + ":locked",
        tags = ["docker"],
    )
    for name in BUILT_IMAGES
]

[
    image_manifest_from_oci_layout(
        name = name + "_manifest",
        src = ":" + name + "_oci",
        architecture = "amd64",
        layers = [GZIP_LAYER],
        os = "linux",
        tags = ["docker"],
    )
    for name in BUILT_IMAGES
]

[
    image_load(
        name = name,
        image = ":" + name + "_manifest",
        tag = tag,
        tags = ["docker"],
    )
    for name, tag in BUILT_IMAGES.items()
]

[
    filegroup(
        name = name + "_tar",
        srcs = [":" + name],
        output_group = "tarball",
        tags = ["docker"],
    )
    for name in BUILT_IMAGES
]

# The digests //MODULE.bazel pins, as a `rustc_env_files` file: one
# `KRABKA_PINNED_IMAGE_<NAME>=sha256:...` line per image above.
#
# A test that records which image a checked-in fixture was derived from can then
# compare its record against the live pin without reading MODULE.bazel itself --
# the pin reaches it as compile-time environment. `crates/broker/build.rs` emits
# the same variables for Cargo.
genrule(
    name = "pinned_digests",
    srcs = ["//:MODULE.bazel"],
    outs = ["pinned_digests.env"],
    cmd = "$(execpath :pinned_digests.sh) $(execpath //:MODULE.bazel) > $@",
    tools = [":pinned_digests.sh"],
)
