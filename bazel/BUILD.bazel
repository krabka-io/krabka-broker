# Macro package. See defs.bzl.
exports_files([
    "defs.bzl",
    "docker_test.sh",
])

# The platform `--config=rbe` executes on: `@llvm//:rbe_linux_x86_64`'s
# constraints, with its image pulled from Google's mirror of Docker Hub.
#
# `@llvm`'s platform names `docker://ubuntu:22.04`. That is Docker Hub, and a
# BuildBuddy executor fetches an anonymous pull token for it before every
# action it has not cached. Under load the token request times out, and the
# action fails before it starts:
#
#     Remote Execution Failure: Unavailable: prepare runner filesystem: Error
#     pulling container: ... Get "https://auth.docker.io/token?scope=repository
#     %3Alibrary%2Fubuntu%3Apull&service=registry.docker.io": context canceled
#
# One such action fails the whole `lint` or container job, so a change with
# many uncached actions failed every run. `mirror.gcr.io` serves the same
# official image without Docker Hub's token service. The constraints stay
# `@llvm`'s, so the toolchains resolve exactly as they did.
platform(
    name = "rbe_linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "@llvm//constraints/libc:gnu.2.28",
    ],
    exec_properties = {
        "container-image": "docker://mirror.gcr.io/library/ubuntu:22.04",
        "Arch": "amd64",
        "OSFamily": "Linux",
    },
    visibility = ["//visibility:public"],
)
