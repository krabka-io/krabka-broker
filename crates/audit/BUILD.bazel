load("//bazel:defs.bzl", "crate_binary", "crate_library", "crate_tests")

package(default_visibility = ["//visibility:public"])

# Consumed by `crate.from_cargo` (see //MODULE.bazel).
exports_files(["Cargo.toml"])

crate_library(name = "audit")

# `krabka-audit verify` — replays an audit log and checks its hash chain.
crate_binary(
    name = "krabka-audit",
    crate_root = "src/bin/audit.rs",
    lib = ":audit",
)

crate_tests(lib = "audit")
