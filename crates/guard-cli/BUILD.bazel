load("//bazel:defs.bzl", "crate_binary", "crate_library", "crate_tests")

package(default_visibility = ["//visibility:public"])

# Consumed by `crate.from_cargo` (see //MODULE.bazel).
exports_files(["Cargo.toml"])

crate_library(name = "guard-cli")

# `bazel run //crates/guard-cli:krabka-guard -- --bootstrap-server host:9092 freeze list`
crate_binary(
    name = "krabka-guard",
    crate_root = "src/main.rs",
    lib = ":guard-cli",
)

crate_tests(lib = "guard-cli")
