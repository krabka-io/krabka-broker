load("//bazel:defs.bzl", "crate_binary", "crate_library", "crate_tests")

package(default_visibility = ["//visibility:public"])

# Consumed by `crate.from_cargo` (see //MODULE.bazel).
exports_files(["Cargo.toml"])

# No rule claims a bench source: benches are a Cargo-only concern here, declared
# by a `[[bench]]` section and nothing else. CI's container-suite selection still
# feeds the change's touched `crates/**` paths to `rdeps`, which takes a target
# set, and one path Bazel does not know fails the whole query. Exporting them
# makes them targets that reach nothing, which is the true answer.
exports_files(glob(["benches/*.rs"]))

crate_library(name = "broker")

# The broker server. `bazel run //crates/broker:krabka-broker -- --help`.
crate_binary(
    name = "krabka-broker",
    crate_root = "src/bin/broker.rs",
    lib = ":broker",
)

crate_tests(
    # TLS certificates, Kerberos keytabs and captured Kafka frames. The TLS
    # material is `include_str!`ed by the suites that serve it and the keytabs
    # are opened at run time, so both lists are needed.
    compile_data = glob(["tests/fixtures/**"]),
    # Measure elapsed wall-clock time and assert a bound on it, so they are
    # timing-sensitive the way //crates/raft's engine simulation is: they pass in
    # the test run and fail under coverage instrumentation, which is a statement
    # about the instrumentation rather than about the code. `diskless_e2e` and
    # `sharegroup_backlog` assert on a committed high-watermark across three
    # brokers; `diskless_e2e` boots three such clusters at once, one per case,
    # and every case gates on a quorum-committed watermark inside a bounded
    # deadline.
    #
    # `durability` and `leader_election` each kill a broker and time the acks=-1
    # produce that the resulting ISR shrink unblocks. The wait cannot finish
    # before `replica_lag_time_max` elapses and must complete a few seconds
    # after it, and instrumentation stretches only the second half: `durability`
    # allows five seconds for a ~2s shrink, which leaves three for a detection
    # loop the profiler has slowed down. `ip_quotas` asserts the opposite
    # baseline -- five unthrottled connections inside 500ms -- which is bounded
    # by scheduling rather than by a timer, and so is the shape instrumentation
    # stretches most.
    #
    # `stretch_cluster` is `durability` again across three sites: it stops a
    # site's broker and then retries an acks=all produce against a 30-second
    # deadline, which the controller can only satisfy once it has committed the
    # ISR shrink for the replicas that went with the site. The same second half
    # is what stretches -- it passed the uninstrumented `test` step and both
    # local runs (~30s) on the commit whose `coverage` run failed it at 72s,
    # with the coverage job running ~140 suites in parallel on four cores.
    #
    # `deliver_at_time` measures elapsed time too and is deliberately absent:
    # its bound only separates a long poll woken by the delivery advance (~2s)
    # from one that waited out its 20s `max.wait.ms`. That wake is timer-driven,
    # so instrumentation does not move it.
    cpu_heavy = [
        "diskless_e2e",
        "durability",
        "ip_quotas",
        "leader_election",
        "sharegroup_backlog",
        "stretch_cluster",
    ],
    # The generated config schema and reference, and the example configs, are
    # checked in under //docs. `config_reference`, `docgen_contract` and
    # `example_broker_toml` read them back and compare or parse them, so a
    # schema change that is not regenerated fails here as well as in the docs
    # job.
    data = glob(["tests/fixtures/**"]) + [
        ":krabka-broker",
        "//docs:config-reference.md",
        "//docs:config-schema.json",
        "//docs:examples/broker-single-node.toml",
        "//docs:examples/broker-three-node-quorum.toml",
        # `metrics_contract` reads the published dashboard, the alert rules and
        # the checked-in `/metrics` body; `support::manifest_dir()` resolves
        # them under `$TEST_SRCDIR/$TEST_WORKSPACE/docs/operations`.
        "//docs/operations:contract",
    ],
    docker = {
        # One image, used twice: as the client that reads krabka's advertised
        # table and as the Kafka broker that table is compared against.
        "api_versions_differential": ["apache_kafka_4_3_1"],
        # The `fetch.min.bytes` floor, sent as identical bytes to krabka and to
        # a stock broker of the newest pinned release. The hermetic half of the
        # same exchange is `fetch_min_bytes`, which needs no image.
        "fetch_min_bytes_jvm": ["apache_kafka_4_3_1"],
        "jvm_acceptance_cli": [
            "apache_kafka_4_3_1",
            "cp_kafka_6_1_1",
            "cp_kafka_7_5_0",
        ],
        "jvm_acceptance_durability": [
            "cp_kafka_6_1_1",
            "cp_kafka_7_5_0",
        ],
        "jvm_acceptance_freeze": ["cp_kafka_7_5_0"],
        "jvm_acceptance_legacy": [
            "cp_kafka_3_1_2",
            "cp_kafka_6_1_1",
        ],
        "jvm_acceptance_quotas": [
            "cp_kafka_6_1_1",
            "cp_kafka_7_5_0",
        ],
        "jvm_acceptance_reassign": ["cp_kafka_7_5_0"],
        "jvm_acceptance_sasl": [
            "cp_kafka_6_1_1",
            "cp_kafka_7_5_0",
        ],
        "jvm_acceptance_tiered": [
            "cp_kafka_6_1_1",
            "cp_kafka_7_8_8",
            "minio",
            "minio_mc",
        ],
        "jvm_acceptance_tls": [
            "cp_kafka_6_1_1",
            "cp_kafka_7_5_0",
        ],
        "jvm_barrier_markers": ["cp_kafka_7_5_0"],
        "jvm_bootstrap_controller": ["apache_kafka_4_3_1"],
        # KIP-412 dynamic log levels. The 4.3.1 tool because its non-`--all`
        # describe asks `DescribeCluster` whether the broker exists before it
        # prints anything, which no older tool does.
        "jvm_broker_loggers": ["apache_kafka_4_3_1"],
        "jvm_consumer_group_next_gen": [
            "apache_kafka_4_0_0",
            "cp_kafka_7_4_0",
        ],
        # The probe compiles a Java helper in-container, so it needs the image
        # that ships a JDK with `javac` alongside the Kafka client jars.
        "jvm_deliver_at_time": ["cp_kafka_7_5_0"],
        "jvm_features": ["apache_kafka_4_3_1"],
        "jvm_kip320_divergence": [
            "apache_kafka_4_0_0",
            "apache_kafka_4_3_1",
            "cp_kafka_6_1_1",
            "cp_kafka_7_5_0",
        ],
        "jvm_role_separated_admin": ["apache_kafka_4_3_1"],
        "jvm_share_groups": ["apache_kafka_4_1_0"],
        "jvm_static_quorum_spike": ["apache_kafka_4_0_0"],
        "jvm_streams_groups": ["apache_kafka_4_1_0"],
        "kraft_checkpoint_jvm": ["apache_kafka_4_0_0"],
        "librdkafka_conformance": [
            "kcat_1_7_1",
        ],
        # One image, used twice: as the `kafka-topics` client that reads
        # krabka's answer and as the Kafka broker the same command is run
        # against for the differential.
        "unavailable_partitions_jvm": ["apache_kafka_4_3_1"],
        # Same image set as `jvm_acceptance_tiered`: the suite reuses that
        # harness's producer, consumer and topic-create helpers, and adds an
        # Object-Lock bucket that `mc` creates and then fails to empty.
        "worm_object_lock": [
            "cp_kafka_6_1_1",
            "cp_kafka_7_8_8",
            "minio",
            "minio_mc",
        ],
    },
    # `cli_smoke` boots the real binary and finds it through the variable Cargo
    # exports for a `[[bin]]` in the same package. Bazel exports no such thing,
    # so the same name is set here from the binary's own target.
    env = {"CARGO_BIN_EXE_krabka-broker": "$(rootpath :krabka-broker)"},
    lib = "broker",
    # Suites whose `#[ignore]`d cases drive real containers, and the images
    # each one starts. //bazel/images pins those by digest and //bazel/defs.bzl
    # loads them before the suite runs, so nothing is pulled mid-test.
    # `describe_groups_jvm` records a real-Kafka fixture into `tests/fixtures/`
    # rather than reading one, so it is a recording tool and not a test: a Bazel
    # test cannot write to the source tree, and should not want to. It still
    # runs under Cargo, which is where fixtures get regenerated.
    # `gssapi_e2e` cannot use the digest-pinned lane: its locally built KDC
    # fixture writes keytabs into the fixture directory and must be
    # Docker-Compose-managed.
    manual = [
        "describe_groups_jvm",
        "gssapi_e2e",
    ],
    # 212k lines: a full sweep is nightly-sized even sharded this far.
    mutants_shards = 32,
    # Every mutant rebuilds 212k lines, so a shard is dominated by rustc, not by
    # the 20.5s test baseline: a full sweep is hours of work however it is split.
    # This is the one crate that needs the longer per-shard bound.
    mutants_timeout = "eternal",
    # The digest //MODULE.bazel pins for each container image, as compile-time
    # environment. `src/codes/tests/kafka_error_table.rs` is a checked-in copy of
    # Kafka's `Errors` enum and records which image it was extracted from; the
    # guard beside it compares that record with the live pin, so bumping the
    # image fails the guard until the table is re-derived. `build.rs` emits the
    # same variables under Cargo.
    unit_rustc_env_files = ["//bazel/images:pinned_digests"],
)
