load("//bazel:defs.bzl", "crate_library")

package(default_visibility = ["//visibility:public"])

# Consumed by `crate.from_cargo` (see //MODULE.bazel).
exports_files(["Cargo.toml"])

# Re-exports crabka-broker's `test-helpers` feature so the integration suites can
# reach `BrokerHandle::test_truncate_local_log` without the broker's own unit
# tests enabling it. No tests and no mutants of its own: it is one `pub use`.
crate_library(name = "test-helpers")
