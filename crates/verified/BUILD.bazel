load("//bazel:defs.bzl", "crate_library", "crate_tests")

package(default_visibility = ["//visibility:public"])

# Consumed by `crate.from_cargo` (see //MODULE.bazel).
exports_files(["Cargo.toml"])

crate_library(name = "verified")

crate_tests(
    compile_data = ["Cargo.toml"] + glob(["tests/features/**/*.feature"]),
    lib = "verified",
)
