load("//bazel:defs.bzl", "crate_binary", "crate_library", "crate_tests")

package(default_visibility = ["//visibility:public"])

# Consumed by `crate.from_cargo` (see //MODULE.bazel).
exports_files(["Cargo.toml"])

crate_library(name = "barrier-cli")

# `bazel run //crates/barrier-cli:crabka-barrier -- --bootstrap-server host:9092 list --group g`
crate_binary(
    name = "crabka-barrier",
    crate_root = "src/main.rs",
    lib = ":barrier-cli",
)

crate_tests(lib = "barrier-cli")
