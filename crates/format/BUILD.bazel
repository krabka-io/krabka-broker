load("//bazel:defs.bzl", "crate_binary", "crate_library", "crate_tests")

package(default_visibility = ["//visibility:public"])

# Consumed by `crate.from_cargo` (see //MODULE.bazel).
exports_files(["Cargo.toml"])

crate_library(name = "format")

# `bazel run //crates/format:crabka-format -- --log-dir /var/lib/krabka --standalone ...`
crate_binary(
    name = "crabka-format",
    crate_root = "src/main.rs",
    lib = ":format",
)

crate_tests(
    # `format_smoke` runs the binary and reads back what it wrote.
    data = [":crabka-format"],
    env = {"CARGO_BIN_EXE_crabka-format": "$(rootpath :crabka-format)"},
    lib = "format",
)
