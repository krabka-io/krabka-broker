load("//bazel:defs.bzl", "crate_binary", "crate_library", "crate_tests")

package(default_visibility = ["//visibility:public"])

# Consumed by `crate.from_cargo` (see //MODULE.bazel).
exports_files(["Cargo.toml"])

crate_library(name = "docgen")

# `bazel run //crates/docgen:krabka-docgen -- all --out /tmp/reference`
crate_binary(
    name = "krabka-docgen",
    crate_root = "src/main.rs",
    lib = ":docgen",
)

crate_tests(lib = "docgen")
