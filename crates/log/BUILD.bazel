load("//bazel:defs.bzl", "crate_library", "crate_tests")

package(default_visibility = ["//visibility:public"])

# Consumed by `crate.from_cargo` (see //MODULE.bazel).
exports_files(["Cargo.toml"])

crate_library(name = "log")

crate_tests(
    docker = {"integration": ["cp_kafka_6_1_1"]},
    lib = "log",
    # ~830 mutants, each a rebuild plus a test run against a ~4s baseline. At the
    # default 8 shards every one of them ran out the 900s bound and the sweep
    # reported nothing at all; at 32 a single shard still overran, which loses
    # its mutants silently -- the totals are the only place it shows.
    mutants_shards = 40,
)
