load("//bazel:defs.bzl", "crate_library", "crate_tests")

package(default_visibility = ["//visibility:public"])

# Consumed by `crate.from_cargo` (see //MODULE.bazel).
exports_files(["Cargo.toml"])

# `glossary.toml` is the tag and term glossary the crate embeds.
crate_library(
    name = "bdd-model",
    compile_data = ["glossary.toml"],
)

crate_tests(
    # rstest's `#[case]` expansion reads the manifest to find its own crate.
    compile_data = [
        "Cargo.toml",
        "glossary.toml",
    ],
    lib = "bdd-model",
)
