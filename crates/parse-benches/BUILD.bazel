load("//bazel:defs.bzl", "crate_binary", "crate_library", "crate_tests")

package(default_visibility = ["//visibility:public"])

# Consumed by `crate.from_cargo` (see //MODULE.bazel).
exports_files(["Cargo.toml"])

crate_library(name = "parse-benches")

# `bazel run //crates/parse-benches:krabka-parse-benches -- --results-dir bench-results`
crate_binary(
    name = "krabka-parse-benches",
    crate_root = "src/main.rs",
    lib = ":parse-benches",
)

crate_tests(
    # `budget_tests` validates the checked-in contract with `include_str!`.
    compile_data = ["//packaging:performance/regression-contract.json"],
    lib = "parse-benches",
    # `artifact_isolation_tests` builds and runs two fixture crates with a real
    # `cargo`, which a Bazel test sandbox does not have. It runs under
    # `cargo nextest run --workspace`, the `cargo` job in ci.yml.
    manual = ["artifact_isolation_tests"],
)
