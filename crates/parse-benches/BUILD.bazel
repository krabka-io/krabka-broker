load("//bazel:defs.bzl", "crate_binary", "crate_library", "crate_tests")

package(default_visibility = ["//visibility:public"])

# Consumed by `crate.from_cargo` (see //MODULE.bazel).
exports_files(["Cargo.toml"])

crate_library(name = "parse-benches")

# `bazel run //crates/parse-benches:krabka-parse-benches -- --results-dir bench-results`
crate_binary(
    name = "krabka-parse-benches",
    crate_root = "src/main.rs",
    lib = ":parse-benches",
)

crate_tests(
    # `budget_tests` validates the checked-in contract with `include_str!`.
    compile_data = ["//packaging:performance/regression-contract.json"],
    # `artifact_isolation_tests` builds and runs two fixture crates with a real
    # `cargo`: Cargo's freshness decision is what it tests. These are the Rust
    # toolchain's own cargo, rustc, rustc libraries and standard library. The
    # suite composes them into a working toolchain; the system `cc` links.
    data = [
        "@rules_rust//rust/toolchain:current_cargo_files",
        "@rules_rust//rust/toolchain:current_rust_stdlib_files",
        "@rules_rust//rust/toolchain:current_rustc_files",
        "@rules_rust//rust/toolchain:current_rustc_lib_files",
    ],
    env = {
        "KRABKA_TEST_CARGO": "$(rootpath @rules_rust//rust/toolchain:current_cargo_files)",
        "KRABKA_TEST_RUSTC": "$(rootpath @rules_rust//rust/toolchain:current_rustc_files)",
        "KRABKA_TEST_RUST_STDLIB": "$(rootpaths @rules_rust//rust/toolchain:current_rust_stdlib_files)",
    },
    lib = "parse-benches",
)
