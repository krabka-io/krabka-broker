load("//bazel:defs.bzl", "crate_binary", "crate_library", "crate_tests")

package(default_visibility = ["//visibility:public"])

# Consumed by `crate.from_cargo` (see //MODULE.bazel).
exports_files(["Cargo.toml"])

crate_library(name = "restore")

# `krabka-restore`, not `krabka-restore`. The `krabka` operator CLI resolves an
# unknown subcommand to `krabka-<name>` on `PATH`, the way git resolves
# `git foo` to `git-foo`, so this exact spelling is what makes `krabka restore`
# work. `bazel run //crates/restore:krabka-restore -- --help`.
crate_binary(
    name = "krabka-restore",
    crate_root = "src/main.rs",
    lib = ":restore",
)

crate_tests(
    # `cli_surface` runs the binary to check the flags it accepts.
    data = [":krabka-restore"],
    # `minio_roundtrip` archives through the production S3 backend into a real
    # `MinIO` and restores out of the bucket, so it needs the server image and
    # the `mc` client that creates the bucket. //bazel/images pins both by
    # digest and loads them before the suite runs.
    docker = {"minio_roundtrip": [
        "minio",
        "minio_mc",
    ]},
    env = {"CARGO_BIN_EXE_krabka-restore": "$(rootpath :krabka-restore)"},
    lib = "restore",
)
