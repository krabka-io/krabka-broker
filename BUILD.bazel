"""Root package: the public krabka broker surface."""

package(default_visibility = ["//visibility:public"])

# Cargo.lock/Cargo.toml are consumed by `crate.from_cargo` (see //MODULE.bazel);
# clippy.toml by the lint aspect in //tools/lint; .cargo/mutants.toml by the
# mutation sweep, via `--@rules_rs_mutants//mutants:config` in //.bazelrc.
exports_files([
    ".cargo/mutants.toml",
    "Cargo.lock",
    "Cargo.toml",
    "clippy.toml",
])

alias(
    name = "broker",
    actual = "//crates/broker",
)

# The broker server. `bazel run //:broker_bin -- --help`.
alias(
    name = "broker_bin",
    actual = "//crates/broker:crabka-broker",
)

# Formats a fresh log directory. A KRaft node will not boot without this having
# been run against its data directory first.
alias(
    name = "format_bin",
    actual = "//crates/format:crabka-format",
)

alias(
    name = "raft",
    actual = "//crates/raft",
)

alias(
    name = "log",
    actual = "//crates/log",
)

alias(
    name = "audit",
    actual = "//crates/audit",
)
