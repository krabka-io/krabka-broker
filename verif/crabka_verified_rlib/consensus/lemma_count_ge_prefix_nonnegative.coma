constant log_end : int

constant s : Seq.seq Int64.t

constant v : int

constant limit : int

function lemma_count_ge_prefix_nonnegative [#"/home/user/krabka-broker/crates/verified/src/consensus.rs" 57 0 57 87] (log_end: int) (s: Seq.seq Int64.t) (v: int) (limit: int) : ()

goal vc_lemma_count_ge_prefix_nonnegative: ([%#sconsensus'0] 0 <= limit /\ limit <= Seq.length s + 1)
  -> (if gt_log_Int limit 0 then
    (([@stop_split] [@expl:lemma_count_ge_prefix_nonnegative requires] [%#sconsensus'0] 0 <= limit - 1
        /\ limit - 1 <= Seq.length s + 1)
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sconsensus] limit) ([%#sconsensus] limit - 1)))
    /\ (([@stop_split] [@expl:lemma_count_ge_prefix_nonnegative ensures] [%#sconsensus'1] ge_log_Int (count_ge_prefix log_end s v (limit
      - 1)) 0)
    -> (let _ = lemma_count_ge_prefix_nonnegative log_end s v (limit
    - 1) in [@stop_split] [@expl:lemma_count_ge_prefix_nonnegative ensures] [%#sconsensus'1] ge_log_Int (count_ge_prefix log_end s v limit) 0))
  else
    [@stop_split] [@expl:lemma_count_ge_prefix_nonnegative ensures] [%#sconsensus'1] ge_log_Int (count_ge_prefix log_end s v limit) 0
  )
