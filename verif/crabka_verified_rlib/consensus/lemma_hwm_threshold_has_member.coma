let lemma_hwm_threshold_has_member [#"/home/user/krabka-broker/crates/verified/src/consensus.rs" 162 0 162 79]
  (log_end: Int64.t) (s: Slice64.slice Int64.t) (majority: UInt64.t) (return (x: ())) =
{[@stop_split] [@expl:lemma_hwm_threshold_has_member requires] [%#sconsensus'0] 1 <= UInt64.t'int majority
  /\ UInt64.t'int majority <= Seq.length (Slice64.view s) + 1}
  (! bb0
  [ bb0 = s0
    [ s0 =
      {[@expl:assertion] [%#sconsensus] forall v: int. ge_log_Int (count_ge (Int64.to_int log_end) (Slice64.view s) v) (UInt64.t'int majority)
        -> (exists k: int. k
            = least_hwm_member_ge_index (Int64.to_int log_end) (Slice64.view s) v (Seq.length (Slice64.view s) + 1)
          /\ 0 <= k
          /\ k < Seq.length (Slice64.view s) + 1
