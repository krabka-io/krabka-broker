predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

function hwm_member_at [#"/home/user/krabka-broker/crates/verified/src/consensus.rs" 13 0 13 62] (log_end: int) (s: Seq.seq Int64.t) (k: int) : int
 = [%#sconsensus'11] if k = 0 then log_end else Int64.to_int (Seq.get s (k - 1))

function count_ge_prefix [#"/home/user/krabka-broker/crates/verified/src/consensus.rs" 22 0 22 76] (log_end: int) (s: Seq.seq Int64.t) (v: int) (limit: int) : int

axiom count_ge_prefix_def:
  forall log_end: int, s: Seq.seq Int64.t, v: int, limit: int [count_ge_prefix log_end s v limit]. count_ge_prefix log_end s v limit
    = ([%#sconsensus'13] if limit <= 0 then
      0
    else
      count_ge_prefix log_end s v (limit - 1) + (if ge_log_Int (hwm_member_at log_end s (limit - 1)) v then 1 else 0)
    )

function count_ge [#"/home/user/krabka-broker/crates/verified/src/consensus.rs" 36 0 36 57] (log_end: int) (s: Seq.seq Int64.t) (v: int) : int

axiom count_ge_def: forall log_end: int, s: Seq.seq Int64.t, v: int [count_ge log_end s v]. count_ge log_end s v
    = ([%#sconsensus'3] count_ge_prefix log_end s v (Seq.length s + 1))

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

function lemma_count_ge_prefix_monotone [#"/home/user/krabka-broker/crates/verified/src/consensus.rs" 46 0 46 97] (log_end: int) (s: Seq.seq Int64.t) (low: int) (high: int) (limit: int) : ()

axiom lemma_count_ge_prefix_monotone_def:
  forall log_end: int, s: Seq.seq Int64.t, low: int, high: int, limit: int [lemma_count_ge_prefix_monotone log_end s low high limit]. ([%#sconsensus'15] 0
        <= limit
      /\ limit <= Seq.length s + 1)
    -> ([%#sconsensus'16] low <= high)
    -> lemma_count_ge_prefix_monotone log_end s low high limit
    = ([%#sconsensus'18] if gt_log_Int limit 0 then
      let _ = lemma_count_ge_prefix_monotone log_end s low high (limit - 1) in ()
    else
      ()
    )

axiom lemma_count_ge_prefix_monotone_spec:
  forall log_end: int, s: Seq.seq Int64.t, low: int, high: int, limit: int. ([%#sconsensus'15] 0 <= limit
      /\ limit <= Seq.length s + 1)
    -> ([%#sconsensus'16] low <= high)
    -> ([%#sconsensus'17] ge_log_Int (count_ge_prefix log_end s low limit) (count_ge_prefix log_end s high limit))

function lemma_count_ge_prefix_nonnegative [#"/home/user/krabka-broker/crates/verified/src/consensus.rs" 57 0 57 87] (log_end: int) (s: Seq.seq Int64.t) (v: int) (limit: int) : ()

axiom lemma_count_ge_prefix_nonnegative_def:
  forall log_end: int, s: Seq.seq Int64.t, v: int, limit: int [lemma_count_ge_prefix_nonnegative log_end s v limit]. ([%#sconsensus'20] 0
        <= limit
      /\ limit <= Seq.length s + 1)
    -> lemma_count_ge_prefix_nonnegative log_end s v limit
    = ([%#sconsensus'22] if gt_log_Int limit 0 then
      let _ = lemma_count_ge_prefix_nonnegative log_end s v (limit - 1) in ()
    else
      ()
    )

axiom lemma_count_ge_prefix_nonnegative_spec:
  forall log_end: int, s: Seq.seq Int64.t, v: int, limit: int. ([%#sconsensus'20] 0 <= limit
      /\ limit <= Seq.length s + 1) -> ([%#sconsensus'21] ge_log_Int (count_ge_prefix log_end s v limit) 0)

function least_hwm_member_ge_index [#"/home/user/krabka-broker/crates/verified/src/consensus.rs" 72 0 72 86] (log_end: int) (s: Seq.seq Int64.t) (v: int) (limit: int) : int

axiom least_hwm_member_ge_index_def:
  forall log_end: int, s: Seq.seq Int64.t, v: int, limit: int [least_hwm_member_ge_index log_end s v limit]. ([%#sconsensus'5] 0
        < limit
      /\ limit <= Seq.length s + 1)
    -> ([%#sconsensus'6] ge_log_Int (count_ge_prefix log_end s v limit) 1)
    -> least_hwm_member_ge_index log_end s v limit
    = ([%#sconsensus'10] if limit <= 1 then
      0
    else
      let last_index = limit
      - 1 in let last_member = hwm_member_at log_end s last_index in let previous_count = count_ge_prefix log_end s v last_index in if ge_log_Int last_member v then
        if ge_log_Int previous_count 1 then
          let previous_index = least_hwm_member_ge_index log_end s v last_index in let previous_member = hwm_member_at log_end s previous_index in if last_member
          <= previous_member then
            let _ = lemma_count_ge_prefix_monotone log_end s last_member previous_member last_index in last_index
          else
            previous_index
        
        else
          let _ = lemma_count_ge_prefix_nonnegative log_end s v last_index in let _ = lemma_count_ge_prefix_nonnegative log_end s last_member last_index in last_index
      
      else
        least_hwm_member_ge_index log_end s v last_index
    
    )

axiom least_hwm_member_ge_index_spec:
  forall log_end: int, s: Seq.seq Int64.t, v: int, limit: int [least_hwm_member_ge_index log_end s v limit]. ([%#sconsensus'5] 0
        < limit
      /\ limit <= Seq.length s + 1)
    -> ([%#sconsensus'6] ge_log_Int (count_ge_prefix log_end s v limit) 1)
    -> ([%#sconsensus'7] 0 <= least_hwm_member_ge_index log_end s v limit
    /\ least_hwm_member_ge_index log_end s v limit < limit)

axiom least_hwm_member_ge_index_spec'0:
  forall log_end: int, s: Seq.seq Int64.t, v: int, limit: int [least_hwm_member_ge_index log_end s v limit]. ([%#sconsensus'5] 0
        < limit
      /\ limit <= Seq.length s + 1)
    -> ([%#sconsensus'6] ge_log_Int (count_ge_prefix log_end s v limit) 1)
    -> ([%#sconsensus'8] ge_log_Int (hwm_member_at log_end s (least_hwm_member_ge_index log_end s v limit)) v)

axiom least_hwm_member_ge_index_spec'1:
  forall log_end: int, s: Seq.seq Int64.t, v: int, limit: int [least_hwm_member_ge_index log_end s v limit]. ([%#sconsensus'5] 0
        < limit
      /\ limit <= Seq.length s + 1)
    -> ([%#sconsensus'6] ge_log_Int (count_ge_prefix log_end s v limit) 1)
    -> ([%#sconsensus'9] ge_log_Int (count_ge_prefix log_end s (hwm_member_at log_end s (least_hwm_member_ge_index log_end s v limit)) limit) (count_ge_prefix log_end s v limit))

