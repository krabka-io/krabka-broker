          /\ ge_log_Int (count_ge (Int64.to_int log_end) (Slice64.view s) (hwm_member_at (Int64.to_int log_end) (Slice64.view s) k)) (UInt64.t'int majority))}
      s1
    | s1 = return {_ret} ] ]
  [ & _ret: () = Any.any_l ()
  | & log_end: Int64.t = log_end
  | & s: Slice64.slice Int64.t = s
  | & majority: UInt64.t = majority ])
  [ return (result: ()) ->
  {[@stop_split] [@expl:lemma_hwm_threshold_has_member ensures] [%#sconsensus'1] forall v: int. ge_log_Int (count_ge (Int64.to_int log_end) (Slice64.view s) v) (UInt64.t'int majority)
      -> (exists k: int. 0 <= k
        /\ k < Seq.length (Slice64.view s) + 1
        /\ ge_log_Int (hwm_member_at (Int64.to_int log_end) (Slice64.view s) k) v
        /\ ge_log_Int (count_ge (Int64.to_int log_end) (Slice64.view s) (hwm_member_at (Int64.to_int log_end) (Slice64.view s) k)) (UInt64.t'int majority))}
    (! return {result}) ]
