function sum_prefix [#"/home/user/krabka-broker/crates/verified/src/stretch.rs" 21 0 21 49] (s: Seq.seq Int64.t) (limit: int) : int

axiom sum_prefix_def: forall s: Seq.seq Int64.t, limit: int [sum_prefix s limit]. sum_prefix s limit
    = ([%#sstretch'7] if limit <= 0 then 0 else sum_prefix s (limit - 1) + Int64.to_int (Seq.get s (limit - 1)))

function sum_all [#"/home/user/krabka-broker/crates/verified/src/stretch.rs" 34 0 34 34] (s: Seq.seq Int64.t) : int =
