      - UInt64.t'int i)}
      bb5invariant
    | bb5invariant = {[@expl:loop invariant #0] [%#sreassignment'3] UInt64.t'int i
      <= Seq.length (Slice64.view eligible_handoffs)}
      {[@expl:loop invariant #1] [%#sreassignment'2] forall j: int. 0 <= j /\ j < UInt64.t'int i
        -> not Seq.get (Slice64.view eligible_handoffs) j}
      (! [ &variant_old_bb5 <- [%#sreassignment'0] Seq.length (Slice64.view eligible_handoffs) - UInt64.t'int i ] s0)
      [ s0 = len_bool [%#sreassignment'1] {eligible_handoffs} (fun (_x: UInt64.t) -> [ &_34 <- _x ] s1)
      | s1 = [ &_32 <- UInt64.lt i _34 ] s2
      | s2 = any [ br0 -> {_32 = false} (! bb12) | br1 -> {_32} (! bb8) ] ]
      [ bb8 = s0
        [ s0 = [ &_38 <- i ] s1
        | s1 = [ &_39 <- Slice64.length eligible_handoffs ] s2
        | s2 = [ &_40 <- UInt64.lt _38 _39 ] s3
        | s3 = {[@expl:index in bounds] [%#sreassignment'4] _40} s4
        | s4 = Slice64.get [%#sreassignment'4] <bool> {eligible_handoffs} {_38} (fun (r: bool) -> [ &_37 <- r ] s5)
        | s5 = any [ br0 -> {_37 = false} (! bb11) | br1 -> {_37} (! bb10) ] ]
      | bb11 = s0
        [ s0 = UInt64.add [%#sreassignment'6] {i} {[%#sreassignment'5] (1: UInt64.t)}
            (fun (_x: UInt64.t) -> [ &i <- _x ] s1)
        | s1 = bb5 ] ] ]
  | bb10 = s0 [ s0 = [ &_ret <- Handoff i ] s1 | s1 = return {_ret} ]
  | bb12 = s0 [ s0 = [ &_ret <- WaitForLeader ] s1 | s1 = return {_ret} ]
  | bb4 = s0 [ s0 = [ &_ret <- Complete ] s1 | s1 = return {_ret} ]
  | bb1 = s0 [ s0 = [ &_ret <- WaitForReplication ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_ReassignmentAction = Any.any_l ()
  | & additions_caught_up: bool = additions_caught_up
  | & leader_removed: bool = leader_removed
  | & eligible_handoffs: Slice64.slice bool = eligible_handoffs
  | & i: UInt64.t = Any.any_l ()
  | & _32: bool = Any.any_l ()
  | & _34: UInt64.t = Any.any_l ()
  | & _37: bool = Any.any_l ()
  | & _38: UInt64.t = Any.any_l ()
  | & _39: UInt64.t = Any.any_l ()
  | & _40: bool = Any.any_l ()
  | & variant_old_bb5: int = Any.any_l () ])
  [ return (result: t_ReassignmentAction) ->
  {[@stop_split] [@expl:reassignment_action ensures] ([@stop_split] [@expl:reassignment_action ensures #0] [%#sreassignment'7] not additions_caught_up
      -> result = WaitForReplication)
    /\ ([@stop_split] [@expl:reassignment_action ensures #1] [%#sreassignment'8] additions_caught_up
        /\ not leader_removed -> result = Complete)
    /\ ([@stop_split] [@expl:reassignment_action ensures #2] [%#sreassignment'9] match result with
      | WaitForLeader -> additions_caught_up
      /\ leader_removed
      /\ (forall i: int. 0 <= i /\ i < Seq.length (Slice64.view eligible_handoffs)
