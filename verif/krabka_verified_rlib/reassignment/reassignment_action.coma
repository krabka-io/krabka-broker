use creusot.int.UInt64
use seq.Seq
use creusot.slice.Slice64
use creusot.prelude.Any
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

let len_bool (self_: Slice64.slice bool) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sslice] Seq.length (Slice64.view self_)
    = UInt64.t'int result}
    (! return {result}) ]

type t_ReassignmentAction = WaitForReplication | WaitForLeader | Handoff UInt64.t | Complete

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let reassignment_action [#"/home/matt/.codex/worktrees/e9db/krabka-broker/crates/verified/src/reassignment.rs" 35 0 39 23]
  (additions_caught_up: bool) (leader_removed: bool) (eligible_handoffs: Slice64.slice bool)
  (return (x: t_ReassignmentAction)) = (! bb0
  [ bb0 = any [ br0 -> {additions_caught_up = false} (! bb1) | br1 -> {additions_caught_up} (! bb2) ]
  | bb2 = any [ br0 -> {leader_removed = false} (! bb4) | br1 -> {leader_removed} (! bb3) ]
  | bb3 = s0 [ s0 = [ &i <- [%#sreassignment] (0: UInt64.t) ] s1 | s1 = bb5 ]
  | bb5 = bb5invariant
    [ bb5 =
