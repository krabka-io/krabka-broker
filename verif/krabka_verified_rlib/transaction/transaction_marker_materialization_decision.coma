  | bb2 = s0
    [ s0 = [ &_23 <- Int16.lt request.producer_epoch ([%#stransaction'0] (0: Int16.t)) ] s1
    | s1 = any [ br0 -> {_23 = false} (! bb4) | br1 -> {_23} (! bb13) ] ]
  | bb4 = s0
    [ s0 = [ &_25 <- Int32.lt request.coordinator_epoch ([%#stransaction'1] (-1: Int32.t)) ] s1
