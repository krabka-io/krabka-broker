    | br1 -> {current'.has_pending_transaction'0} (! bb11) ]
  | bb11 = s0
    [ s0 = [ &_32 <- current'.producer_epoch'0 = ([%#stransaction'4] (-1: Int16.t)) ] s1
    | s1 = any [ br0 -> {_32 = false} (! bb15) | br1 -> {_32} (! bb13) ] ]
  | bb13 = s0 [ s0 = [ &_ret <- RejectMalformed ] s1 | s1 = return {_ret} ]
  | bb15 = s0
    [ s0 = [ &_34 <- Int16.lt request.producer_epoch current'.producer_epoch'0 ] s1
    | s1 = any [ br0 -> {_34 = false} (! bb17) | br1 -> {_34} (! bb16) ] ]
  | bb16 = s0 [ s0 = [ &_ret <- RejectProducerEpoch ] s1 | s1 = return {_ret} ]
  | bb17 = s0
    [ s0 = [ &_37 <- Int32.lt request.coordinator_epoch current'.coordinator_epoch'0 ] s1
    | s1 = any [ br0 -> {_37 = false} (! bb19) | br1 -> {_37} (! bb18) ] ]
  | bb18 = s0 [ s0 = [ &_ret <- RejectCoordinatorEpoch ] s1 | s1 = return {_ret} ]
  | bb19 = any
