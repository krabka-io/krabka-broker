  | bb6 = s0
    [ s0 = [ &_27 <- Int16.lt current'.producer_epoch'0 ([%#stransaction'2] (-1: Int16.t)) ] s1
    | s1 = any [ br0 -> {_27 = false} (! bb8) | br1 -> {_27} (! bb13) ] ]
  | bb8 = s0
    [ s0 = [ &_29 <- Int32.lt current'.coordinator_epoch'0 ([%#stransaction'3] (-1: Int32.t)) ] s1
    | s1 = any [ br0 -> {_29 = false} (! bb10) | br1 -> {_29} (! bb13) ] ]
  | bb10 = any
