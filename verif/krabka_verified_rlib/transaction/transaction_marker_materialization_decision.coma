    | br1 -> {current'.has_pending_transaction'0} (! bb25) ]
  | bb20 = s0
    [ s0 = [ &_41 <- request.producer_epoch = current'.producer_epoch'0 ] s1
    | s1 = any [ br0 -> {_41 = false} (! bb25) | br1 -> {_41} (! bb21) ] ]
  | bb21 = s0
