use creusot.int.Int64
use creusot.int.Int16
use creusot.int.Int8
use creusot.prelude.Any
use int.Int

type t_TransactionSnapshot = { pid: Int64.t; epoch: Int16.t; state: Int8.t }

type t_TransactionReaperCompletionDecision =
  | RejectMalformed
  | RejectStaleIdentity
  | RejectChangedPreparedState
  | AlreadyComplete
  | Proceed

type t_TransactionIdentity = { pid'0: Int64.t; epoch'0: Int16.t }

let identity (self: t_TransactionSnapshot) (return (x: t_TransactionIdentity)) = any
  [ return (result: t_TransactionIdentity) -> {[@stop_split] [@expl:identity ensures] [%#stransaction] result.pid'0
      = self.pid
    /\ result.epoch'0 = self.epoch}
    (! return {result}) ]

type t_TransactionCompletionDecision = Proceed'0 | AlreadyComplete'0 | RejectStaleIdentity'0 | RejectState'0

predicate has_identity [#"/workspace/crates/verified/src/transaction/marker.rs" 189 0 189 89] (snapshot: t_TransactionSnapshot) (identity'0: t_TransactionIdentity) =
  [%#smarker'1] snapshot.pid = identity'0.pid'0 /\ snapshot.epoch = identity'0.epoch'0

let transaction_completion_decision (current': t_TransactionSnapshot) (expected: t_TransactionIdentity)
  (completion: t_TransactionIdentity) (prepare_state: Int8.t) (complete_state: Int8.t)
  (return (x: t_TransactionCompletionDecision)) =
{[@stop_split] [@expl:transaction_completion_decision requires] [%#sproducer_identity] prepare_state <> complete_state}
  any
  [ return (result: t_TransactionCompletionDecision) ->
  {[@stop_split] [@expl:transaction_completion_decision ensures] ([@stop_split] [@expl:transaction_completion_decision ensures #0] [%#sproducer_identity'0] (result
        = AlreadyComplete'0)
      = (has_identity current' completion /\ current'.state = complete_state))
    /\ ([@stop_split] [@expl:transaction_completion_decision ensures #1] [%#sproducer_identity'1] (result
        = RejectStaleIdentity'0)
      = (not (has_identity current' completion /\ current'.state = complete_state)
      /\ not has_identity current' expected))
    /\ ([@stop_split] [@expl:transaction_completion_decision ensures #2] [%#sproducer_identity'2] (result
        = RejectState'0)
      = (not (has_identity current' completion /\ current'.state = complete_state)
      /\ has_identity current' expected /\ current'.state <> prepare_state))
    /\ ([@stop_split] [@expl:transaction_completion_decision ensures #3] [%#sproducer_identity'3] (result = Proceed'0)
    = (has_identity current' expected /\ current'.state = prepare_state))}
    (! return {result}) ]

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate is_identity [#"/workspace/crates/verified/src/transaction/marker.rs" 180 0 180 57] (snapshot: t_TransactionSnapshot) =
  [%#smarker] ge_log_Int (Int64.to_int snapshot.pid) 0 /\ ge_log_Int (Int16.to_int snapshot.epoch) 0

predicate snapshot_eq [#"/workspace/crates/verified/src/transaction/marker.rs" 198 0 198 81] (left: t_TransactionSnapshot) (right: t_TransactionSnapshot) =
  [%#smarker'0] left.pid = right.pid /\ left.epoch = right.epoch /\ left.state = right.state

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let transaction_reaper_completion_decision [#"/workspace/crates/verified/src/transaction/reaper.rs" 53 0 58 40]
  (current': t_TransactionSnapshot) (prepared: t_TransactionSnapshot) (completion: t_TransactionSnapshot)
  (exact_prepared_snapshot: bool) (return (x: t_TransactionReaperCompletionDecision)) =
{[@stop_split] [@expl:transaction_reaper_completion_decision requires] [%#sreaper'8] prepared.state <> completion.state}
  (! bb0
  [ bb0 = s0
    [ s0 = [ &_31 <- Int64.lt current'.pid ([%#sreaper] (0: Int64.t)) ] s1
    | s1 = any [ br0 -> {_31 = false} (! bb2) | br1 -> {_31} (! bb12) ] ]
  | bb2 = s0
    [ s0 = [ &_33 <- Int16.lt current'.epoch ([%#sreaper'0] (0: Int16.t)) ] s1
    | s1 = any [ br0 -> {_33 = false} (! bb4) | br1 -> {_33} (! bb12) ] ]
  | bb4 = s0
    [ s0 = [ &_35 <- Int64.lt prepared.pid ([%#sreaper'1] (0: Int64.t)) ] s1
    | s1 = any [ br0 -> {_35 = false} (! bb6) | br1 -> {_35} (! bb12) ] ]
  | bb6 = s0
    [ s0 = [ &_37 <- Int16.lt prepared.epoch ([%#sreaper'2] (0: Int16.t)) ] s1
    | s1 = any [ br0 -> {_37 = false} (! bb8) | br1 -> {_37} (! bb12) ] ]
  | bb8 = s0
    [ s0 = [ &_39 <- Int64.lt completion.pid ([%#sreaper'3] (0: Int64.t)) ] s1
    | s1 = any [ br0 -> {_39 = false} (! bb10) | br1 -> {_39} (! bb12) ] ]
  | bb10 = s0
    [ s0 = [ &_41 <- Int16.lt completion.epoch ([%#sreaper'4] (0: Int16.t)) ] s1
    | s1 = any [ br0 -> {_41 = false} (! bb13) | br1 -> {_41} (! bb12) ] ]
  | bb12 = s0 [ s0 = [ &_ret <- RejectMalformed ] s1 | s1 = return {_ret} ]
  | bb13 = s0
    [ s0 = identity [%#sreaper'5] {prepared} (fun (_x: t_TransactionIdentity) -> [ &_46 <- _x ] s1)
    | s1 = identity [%#sreaper'6] {completion} (fun (_x: t_TransactionIdentity) -> [ &_48 <- _x ] s2)
    | s2 = transaction_completion_decision [%#sreaper'7] {current'} {_46} {_48} {prepared.state} {completion.state}
        (fun (_x: t_TransactionCompletionDecision) -> [ &_44 <- _x ] s3)
    | s3 = any
      [ br0 -> {_44 = Proceed'0} (! bb21)
      | br1 -> {_44 = AlreadyComplete'0} (! bb24)
      | br2 -> {_44 = RejectStaleIdentity'0} (! bb23)
      | br3 -> {_44 = RejectState'0} (! bb22) ] ]
  | bb22 = s0 [ s0 = [ &_ret <- RejectChangedPreparedState ] s1 | s1 = return {_ret} ]
  | bb23 = s0 [ s0 = [ &_ret <- RejectStaleIdentity ] s1 | s1 = return {_ret} ]
  | bb24 = s0 [ s0 = [ &_ret <- AlreadyComplete ] s1 | s1 = return {_ret} ]
  | bb21 = any [ br0 -> {exact_prepared_snapshot = false} (! bb26) | br1 -> {exact_prepared_snapshot} (! bb25) ]
  | bb25 = s0 [ s0 = [ &_ret <- Proceed ] s1 | s1 = return {_ret} ]
  | bb26 = s0 [ s0 = [ &_ret <- RejectChangedPreparedState ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_TransactionReaperCompletionDecision = Any.any_l ()
  | & current': t_TransactionSnapshot = current'
  | & prepared: t_TransactionSnapshot = prepared
  | & completion: t_TransactionSnapshot = completion
  | & exact_prepared_snapshot: bool = exact_prepared_snapshot
  | & _31: bool = Any.any_l ()
  | & _33: bool = Any.any_l ()
  | & _35: bool = Any.any_l ()
  | & _37: bool = Any.any_l ()
  | & _39: bool = Any.any_l ()
  | & _41: bool = Any.any_l ()
  | & _44: t_TransactionCompletionDecision = Any.any_l ()
  | & _46: t_TransactionIdentity = Any.any_l ()
  | & _48: t_TransactionIdentity = Any.any_l () ])
  [ return (result: t_TransactionReaperCompletionDecision) ->
  {[@stop_split] [@expl:transaction_reaper_completion_decision ensures] ([@stop_split] [@expl:transaction_reaper_completion_decision ensures #0] [%#sreaper'9] (result
        = RejectMalformed)
      = (not (is_identity current' /\ is_identity prepared /\ is_identity completion)))
    /\ ([@stop_split] [@expl:transaction_reaper_completion_decision ensures #1] [%#sreaper'10] (result
        = AlreadyComplete)
      = (is_identity current' /\ is_identity prepared /\ is_identity completion /\ snapshot_eq current' completion))
    /\ ([@stop_split] [@expl:transaction_reaper_completion_decision ensures #2] [%#sreaper'11] (result
        = RejectStaleIdentity)
      = (is_identity current'
      /\ is_identity prepared
      /\ is_identity completion
      /\ not snapshot_eq current' completion /\ not (current'.pid = prepared.pid /\ current'.epoch = prepared.epoch)))
    /\ ([@stop_split] [@expl:transaction_reaper_completion_decision ensures #3] [%#sreaper'12] (result
        = RejectChangedPreparedState)
      = (is_identity current'
      /\ is_identity prepared
      /\ is_identity completion
      /\ not snapshot_eq current' completion
      /\ current'.pid = prepared.pid
      /\ current'.epoch = prepared.epoch /\ not (current'.state = prepared.state /\ exact_prepared_snapshot)))
    /\ ([@stop_split] [@expl:transaction_reaper_completion_decision ensures #4] [%#sreaper'13] (result = Proceed)
    = (is_identity current'
    /\ is_identity prepared /\ is_identity completion /\ snapshot_eq current' prepared /\ exact_prepared_snapshot))}
    (! return {result}) ]
