use creusot.int.Int64
use creusot.int.Int16
use creusot.int.Int32
use creusot.prelude.Any
use int.Int

type t_TransactionMarkerRequest = {
  producer_id: Int64.t;
  producer_epoch: Int16.t;
  coordinator_epoch: Int32.t;
  is_commit: bool;
  is_offsets_partition: bool }

type t_TransactionMarkerPartitionState = {
  producer_epoch'0: Int16.t;
  coordinator_epoch'0: Int32.t;
  has_pending_transaction'0: bool }

type t_TransactionMarkerMaterializationDecision =
  | RejectMalformed
  | RejectProducerEpoch
  | RejectCoordinatorEpoch
  | Retry
  | AppendWithoutOffsetPublication
  | AppendAndPublishOffsets

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate marker_well_formed [#"/workspace/crates/verified/src/transaction/marker.rs" 57 0 60 9] (request: t_TransactionMarkerRequest) (current': t_TransactionMarkerPartitionState) =
  [%#smarker'11] ge_log_Int (Int64.to_int request.producer_id) 0
  /\ ge_log_Int (Int16.to_int request.producer_epoch) 0
  /\ ge_log_Int (Int32.to_int request.coordinator_epoch) (- 1)
  /\ ge_log_Int (Int16.to_int current'.producer_epoch'0) (- 1)
  /\ ge_log_Int (Int32.to_int current'.coordinator_epoch'0) (- 1)
  /\ (not current'.has_pending_transaction'0 \/ ge_log_Int (Int16.to_int current'.producer_epoch'0) 0)

predicate marker_completed_retry [#"/workspace/crates/verified/src/transaction/marker.rs" 90 0 93 9] (request: t_TransactionMarkerRequest) (current': t_TransactionMarkerPartitionState) =
  [%#smarker'12] not current'.has_pending_transaction'0
  /\ Int16.to_int request.producer_epoch = Int16.to_int current'.producer_epoch'0
  /\ Int32.to_int request.coordinator_epoch = Int32.to_int current'.coordinator_epoch'0

predicate marker_generation_current [#"/workspace/crates/verified/src/transaction/marker.rs" 76 0 79 9] (request: t_TransactionMarkerRequest) (current': t_TransactionMarkerPartitionState) =
  [%#smarker'13] ge_log_Int (Int16.to_int request.producer_epoch) (Int16.to_int current'.producer_epoch'0)
  /\ ge_log_Int (Int32.to_int request.coordinator_epoch) (Int32.to_int current'.coordinator_epoch'0)

predicate marker_publishes_offsets [#"/workspace/crates/verified/src/transaction/marker.rs" 105 0 108 9] (request: t_TransactionMarkerRequest) (current': t_TransactionMarkerPartitionState) =
  [%#smarker'14] current'.has_pending_transaction'0 /\ request.is_commit /\ request.is_offsets_partition

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

