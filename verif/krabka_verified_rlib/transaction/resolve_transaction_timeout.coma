      -> Int32.to_int min_timeout_ms <= Int32.to_int result /\ Int32.to_int result <= Int32.to_int max_timeout_ms)
    /\ ([@stop_split] [@expl:resolve_transaction_timeout ensures #2] [%#stransaction'5] not enable_2pc
