  | bb5 = s0 [ s0 = [ &_ret <- max_timeout_ms ] s1 | s1 = return {_ret} ]
  | bb6 = s0 [ s0 = [ &_ret <- requested_ms ] s1 | s1 = return {_ret} ] ]
  [ & _ret: Int32.t = Any.any_l ()
  | & enable_2pc: bool = enable_2pc
  | & requested_ms: Int32.t = requested_ms
  | & min_timeout_ms: Int32.t = min_timeout_ms
  | & max_timeout_ms: Int32.t = max_timeout_ms
  | & _32: bool = Any.any_l ()
  | & _35: bool = Any.any_l () ])
  [ return (result: Int32.t) ->
