use creusot.int.Int64
use creusot.int.Int128
use creusot.prelude.Any
use int.Int

type t_OpaCacheExpiry = DoNotCache | CacheUntil Int128.t

let from_i128 (small: Int64.t) (return (x: Int128.t)) = any
  [ return (result: Int128.t) -> {[@stop_split] [@expl:from ensures] [%#sconvert] result
    = Int128.of_int (Int64.to_int small)}
    (! return {result}) ]

type t_Option_i128 = None | Some Int128.t

constant const_MIN: Int128.t = (-170141183460469231731687303715884105728: Int128.t)

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

constant const_MAX: Int128.t = (170141183460469231731687303715884105727: Int128.t)

let checked_add (self_: Int128.t) (rhs: Int128.t) (return (x: t_Option_i128)) = any
  [ return (result: t_Option_i128) ->
  {[@stop_split] [@expl:checked_add ensures] ([@stop_split] [@expl:checked_add ensures #0] [%#snum] (result = None)
      = (Int128.to_int self_ + Int128.to_int rhs < Int128.to_int const_MIN
      \/ gt_log_Int (Int128.to_int self_ + Int128.to_int rhs) (Int128.to_int const_MAX)))
    /\ ([@stop_split] [@expl:checked_add ensures #1] [%#snum'0] forall r: Int128.t. result = Some r
      -> Int128.to_int r = Int128.to_int self_ + Int128.to_int rhs)}
    (! return {result}) ]

let elim_Some (_x: t_Option_i128) (return (f0: Int128.t)) = any
  [ _k (f0: Int128.t) -> {Some f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
      | _ -> false
      end}
    any) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let opa_cache_expiry [#"/workspace/crates/verified/src/opa.rs" 62 0 62 68] (now_ms: Int128.t) (ttl_ms: Int64.t)
  (return (x: t_OpaCacheExpiry)) = (! bb0
  [ bb0 = s0
    [ s0 = [ &_7 <- Int64.le ttl_ms ([%#sopa] (0: Int64.t)) ] s1
    | s1 = any [ br0 -> {_7 = false} (! bb2) | br1 -> {_7} (! bb1) ] ]
  | bb1 = s0 [ s0 = [ &_ret <- DoNotCache ] s1 | s1 = return {_ret} ]
  | bb2 = s0
    [ s0 = from_i128 [%#sopa'0] {ttl_ms} (fun (_x: Int128.t) -> [ &_12 <- _x ] s1)
    | s1 = checked_add [%#sopa'1] {now_ms} {_12} (fun (_x: t_Option_i128) -> [ &_10 <- _x ] s2)
    | s2 = any [ br0 -> {_10 = None} (! bb7) | br1 (x0: Int128.t) -> {_10 = Some x0} (! bb8) ] ]
  | bb8 = s0
    [ s0 = elim_Some {_10} (fun (r0: Int128.t) -> [ &expires_at_ms <- r0 ] s1)
    | s1 = [ &_ret <- CacheUntil expires_at_ms ] s2
    | s2 = return {_ret} ]
  | bb7 = s0 [ s0 = [ &_ret <- DoNotCache ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_OpaCacheExpiry = Any.any_l ()
  | & now_ms: Int128.t = now_ms
  | & ttl_ms: Int64.t = ttl_ms
  | & _7: bool = Any.any_l ()
  | & _10: t_Option_i128 = Any.any_l ()
  | & _12: Int128.t = Any.any_l ()
  | & expires_at_ms: Int128.t = Any.any_l () ])
  [ return (result: t_OpaCacheExpiry) -> {[@stop_split] [@expl:opa_cache_expiry ensures] [%#sopa'2] match result with
      | DoNotCache -> true
      | CacheUntil expires_at_ms -> gt_log_Int (Int64.to_int ttl_ms) 0
      /\ Int128.to_int expires_at_ms = Int128.to_int now_ms + Int64.to_int ttl_ms
      end}
    (! return {result}) ]
