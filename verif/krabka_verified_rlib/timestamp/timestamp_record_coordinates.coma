constant const_MIN: Int64.t = (-9223372036854775808: Int64.t)

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

constant const_MAX: Int64.t = (9223372036854775807: Int64.t)

let checked_add (self_: Int64.t) (rhs: Int64.t) (return (x: t_Option_i64)) = any
  [ return (result: t_Option_i64) ->
  {[@stop_split] [@expl:checked_add ensures] ([@stop_split] [@expl:checked_add ensures #0] [%#snum] (result = None)
      = (Int64.to_int self_ + Int64.to_int rhs < Int64.to_int const_MIN
      \/ gt_log_Int (Int64.to_int self_ + Int64.to_int rhs) (Int64.to_int const_MAX)))
    /\ ([@stop_split] [@expl:checked_add ensures #1] [%#snum'0] forall r: Int64.t. result = Some r
      -> Int64.to_int r = Int64.to_int self_ + Int64.to_int rhs)}
