        | s2 = [ &_39 <- UInt64.lt _37 _38 ] s3
        | s3 = {[@expl:index in bounds] [%#stimestamp'9] _39} s4
        | s4 = Slice64.get [%#stimestamp'9] <Int64.t> {timestamps} {_37} (fun (r: Int64.t) -> [ &_36 <- r ] s5)
        | s5 = [ &_41 <- best ] s6
        | s6 = [ &_42 <- Slice64.length timestamps ] s7
        | s7 = [ &_43 <- UInt64.lt _41 _42 ] s8
        | s8 = {[@expl:index in bounds] [%#stimestamp'10] _43} s9
        | s9 = Slice64.get [%#stimestamp'10] <Int64.t> {timestamps} {_41} (fun (r: Int64.t) -> [ &_40 <- r ] s10)
        | s10 = [ &_35 <- Int64.gt _36 _40 ] s11
        | s11 = any [ br0 -> {_35 = false} (! bb12) | br1 -> {_35} (! bb10) ] ]
      | bb10 = s0 [ s0 = [ &best <- index ] s1 | s1 = bb12 ]
      | bb12 = s0
        [ s0 = UInt64.add [%#stimestamp'12] {index} {[%#stimestamp'11] (1: UInt64.t)}
