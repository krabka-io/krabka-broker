        | s1 = bb8 ] ] ]
  | bb17 = s0 [ s0 = [ &_ret <- Some best ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_Option_usize = Any.any_l ()
  | & timestamps: Slice64.slice Int64.t = timestamps
  | & _5: bool = Any.any_l ()
  | & _6: UInt64.t = Any.any_l ()
  | & best: UInt64.t = Any.any_l ()
  | & index: UInt64.t = Any.any_l ()
  | & _30: bool = Any.any_l ()
  | & _32: UInt64.t = Any.any_l ()
  | & _35: bool = Any.any_l ()
  | & _36: Int64.t = Any.any_l ()
  | & _37: UInt64.t = Any.any_l ()
  | & _38: UInt64.t = Any.any_l ()
