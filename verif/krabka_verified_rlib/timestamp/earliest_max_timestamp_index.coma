      {[@expl:loop invariant #1] [%#stimestamp'7] UInt64.t'int index <= Seq.length (Slice64.view timestamps)}
      {[@expl:loop invariant #2] [%#stimestamp'6] forall i: int. 0 <= i /\ i < UInt64.t'int index
        -> Int64.to_int (Seq.get (Slice64.view timestamps) i)
