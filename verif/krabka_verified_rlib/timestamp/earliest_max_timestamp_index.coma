      (! [ &variant_old_bb4 <- [%#stimestamp'3] Seq.length (Slice64.view timestamps) - UInt64.t'int index ] s0)
      [ s0 = len_i64 [%#stimestamp'4] {timestamps} (fun (_x: UInt64.t) -> [ &_32 <- _x ] s1)
      | s1 = [ &_30 <- UInt64.lt index _32 ] s2
      | s2 = any [ br0 -> {_30 = false} (! bb13) | br1 -> {_30} (! bb7) ] ]
      [ bb7 = s0
