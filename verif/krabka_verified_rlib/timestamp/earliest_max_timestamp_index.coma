      - UInt64.t'int index)}
      bb8invariant
    | bb8invariant = {[@expl:loop invariant #0] [%#stimestamp'7] UInt64.t'int best < UInt64.t'int index}
      {[@expl:loop invariant #1] [%#stimestamp'6] UInt64.t'int index <= Seq.length (Slice64.view timestamps)}
      {[@expl:loop invariant #2] [%#stimestamp'5] forall i: int. 0 <= i /\ i < UInt64.t'int index
        -> Int64.to_int (Seq.get (Slice64.view timestamps) i)
        <= Int64.to_int (Seq.get (Slice64.view timestamps) (UInt64.t'int best))}
      {[@expl:loop invariant #3] [%#stimestamp'4] forall i: int. 0 <= i /\ i < UInt64.t'int best
        -> Int64.to_int (Seq.get (Slice64.view timestamps) i)
        < Int64.to_int (Seq.get (Slice64.view timestamps) (UInt64.t'int best))}
      (! [ &variant_old_bb8 <- [%#stimestamp'2] Seq.length (Slice64.view timestamps) - UInt64.t'int index ] s0)
      [ s0 = len_i64 [%#stimestamp'3] {timestamps} (fun (_x: UInt64.t) -> [ &_32 <- _x ] s1)
      | s1 = [ &_30 <- UInt64.lt index _32 ] s2
      | s2 = any [ br0 -> {_30 = false} (! bb17) | br1 -> {_30} (! bb11) ] ]
      [ bb11 = s0
        [ s0 = [ &_37 <- index ] s1
        | s1 = [ &_38 <- Slice64.length timestamps ] s2
        | s2 = [ &_39 <- UInt64.lt _37 _38 ] s3
        | s3 = {[@expl:index in bounds] [%#stimestamp'8] _39} s4
        | s4 = Slice64.get [%#stimestamp'8] <Int64.t> {timestamps} {_37} (fun (r: Int64.t) -> [ &_36 <- r ] s5)
        | s5 = [ &_41 <- best ] s6
        | s6 = [ &_42 <- Slice64.length timestamps ] s7
        | s7 = [ &_43 <- UInt64.lt _41 _42 ] s8
        | s8 = {[@expl:index in bounds] [%#stimestamp'9] _43} s9
        | s9 = Slice64.get [%#stimestamp'9] <Int64.t> {timestamps} {_41} (fun (r: Int64.t) -> [ &_40 <- r ] s10)
        | s10 = [ &_35 <- Int64.gt _36 _40 ] s11
        | s11 = any [ br0 -> {_35 = false} (! bb16) | br1 -> {_35} (! bb14) ] ]
      | bb14 = s0 [ s0 = [ &best <- index ] s1 | s1 = bb16 ]
      | bb16 = s0
        [ s0 = UInt64.add [%#stimestamp'11] {index} {[%#stimestamp'10] (1: UInt64.t)}
