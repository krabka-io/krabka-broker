use creusot.int.UInt64
use seq.Seq
use creusot.slice.Slice64
use creusot.int.Int64
use creusot.prelude.Any
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

let len_i64 (self_: Slice64.slice Int64.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sslice] Seq.length (Slice64.view self_)
    = UInt64.t'int result}
    (! return {result}) ]

type t_Option_usize = None | Some UInt64.t

predicate first_timestamp_match [#"/workspace/crates/verified/src/timestamp.rs" 9 0 13 9] (timestamps: Seq.seq Int64.t) (target: int) (matched: t_Option_usize) =
  [%#stimestamp'8] match matched with
    | Some index -> UInt64.t'int index < Seq.length timestamps
    /\ ge_log_Int (Int64.to_int (Seq.get timestamps (UInt64.t'int index))) target
    /\ (forall i: int. 0 <= i /\ i < UInt64.t'int index -> Int64.to_int (Seq.get timestamps i) < target)
    | None -> forall i: int. 0 <= i /\ i < Seq.length timestamps -> Int64.to_int (Seq.get timestamps i) < target
    end

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let first_timestamp_index [#"/workspace/crates/verified/src/timestamp.rs" 28 0 28 78]
  (timestamps: Slice64.slice Int64.t) (target: Int64.t) (return (x: t_Option_usize)) = (! bb0
  [ bb0 = s0 [ s0 = [ &index <- [%#stimestamp] (0: UInt64.t) ] s1 | s1 = bb1 ]
  | bb1 = bb1invariant
    [ bb1 =
      {[@expl:loop variant] well_founded_relation_Int variant_old_bb1 ([%#stimestamp'0] Seq.length (Slice64.view timestamps)
      - UInt64.t'int index)}
      bb1invariant
    | bb1invariant = {[@expl:loop invariant #0] [%#stimestamp'3] UInt64.t'int index
      <= Seq.length (Slice64.view timestamps)}
      {[@expl:loop invariant #1] [%#stimestamp'2] forall i: int. 0 <= i /\ i < UInt64.t'int index
        -> Int64.to_int (Seq.get (Slice64.view timestamps) i) < Int64.to_int target}
      (! [ &variant_old_bb1 <- [%#stimestamp'0] Seq.length (Slice64.view timestamps) - UInt64.t'int index ] s0)
      [ s0 = len_i64 [%#stimestamp'1] {timestamps} (fun (_x: UInt64.t) -> [ &_22 <- _x ] s1)
      | s1 = [ &_20 <- UInt64.lt index _22 ] s2
      | s2 = any [ br0 -> {_20 = false} (! bb8) | br1 -> {_20} (! bb4) ] ]
      [ bb4 = s0
        [ s0 = [ &_27 <- index ] s1
        | s1 = [ &_28 <- Slice64.length timestamps ] s2
        | s2 = [ &_29 <- UInt64.lt _27 _28 ] s3
        | s3 = {[@expl:index in bounds] [%#stimestamp'4] _29} s4
        | s4 = Slice64.get [%#stimestamp'4] <Int64.t> {timestamps} {_27} (fun (r: Int64.t) -> [ &_26 <- r ] s5)
        | s5 = [ &_25 <- Int64.ge _26 target ] s6
        | s6 = any [ br0 -> {_25 = false} (! bb7) | br1 -> {_25} (! bb6) ] ]
      | bb7 = s0
        [ s0 = UInt64.add [%#stimestamp'6] {index} {[%#stimestamp'5] (1: UInt64.t)}
            (fun (_x: UInt64.t) -> [ &index <- _x ] s1)
        | s1 = bb1 ] ] ]
  | bb6 = s0 [ s0 = [ &_ret <- Some index ] s1 | s1 = return {_ret} ]
  | bb8 = s0 [ s0 = [ &_ret <- None ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_Option_usize = Any.any_l ()
  | & timestamps: Slice64.slice Int64.t = timestamps
  | & target: Int64.t = target
  | & index: UInt64.t = Any.any_l ()
  | & _20: bool = Any.any_l ()
  | & _22: UInt64.t = Any.any_l ()
  | & _25: bool = Any.any_l ()
  | & _26: Int64.t = Any.any_l ()
  | & _27: UInt64.t = Any.any_l ()
  | & _28: UInt64.t = Any.any_l ()
  | & _29: bool = Any.any_l ()
  | & variant_old_bb1: int = Any.any_l () ])
  [ return (result: t_Option_usize) ->
  {[@stop_split] [@expl:first_timestamp_index ensures] [%#stimestamp'7] first_timestamp_match (Slice64.view timestamps) (Int64.to_int target) result}
    (! return {result}) ]
