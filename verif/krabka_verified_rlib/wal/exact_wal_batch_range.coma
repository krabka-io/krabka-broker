let len_i64 (self_: Slice64.slice Int64.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sslice] Seq.length (Slice64.view self_)
    = UInt64.t'int result}
    (! return {result}) ]

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

constant const_MAX: Int64.t = (9223372036854775807: Int64.t)

predicate exact_wal_batch_suffix [#"/workspace/crates/verified/src/wal.rs" 15 0 21 9] (bases: Seq.seq Int64.t) (lasts: Seq.seq Int64.t) (index: int) (expected: int) (target: int)

axiom exact_wal_batch_suffix_def:
  forall bases: Seq.seq Int64.t, lasts: Seq.seq Int64.t, index: int, expected: int, target: int [exact_wal_batch_suffix bases lasts index expected target]. ([%#swal'26] Seq.length bases
      = Seq.length lasts)
    -> ([%#swal'27] 0 <= index /\ index <= Seq.length bases)
    -> exact_wal_batch_suffix bases lasts index expected target
    = ([%#swal'28] if index = Seq.length bases then
      expected = target
    else
      Int64.to_int (Seq.get bases index) = expected
      /\ Int64.le (Seq.get bases index) (Seq.get lasts index)
      /\ Int64.lt (Seq.get lasts index) const_MAX
      /\ exact_wal_batch_suffix bases lasts (index + 1) (Int64.to_int (Seq.get lasts index) + 1) target
    )

type t_Option_i64 = None | Some Int64.t

constant const_MIN: Int64.t = (-9223372036854775808: Int64.t)

let checked_add (self_: Int64.t) (rhs: Int64.t) (return (x: t_Option_i64)) = any
  [ return (result: t_Option_i64) ->
  {[@stop_split] [@expl:checked_add ensures] ([@stop_split] [@expl:checked_add ensures #0] [%#snum] (result = None)
      = (Int64.to_int self_ + Int64.to_int rhs < Int64.to_int const_MIN
      \/ gt_log_Int (Int64.to_int self_ + Int64.to_int rhs) (Int64.to_int const_MAX)))
    /\ ([@stop_split] [@expl:checked_add ensures #1] [%#snum'0] forall r: Int64.t. result = Some r
      -> Int64.to_int r = Int64.to_int self_ + Int64.to_int rhs)}
    (! return {result}) ]

let elim_Some (_x: t_Option_i64) (return (f0: Int64.t)) = any
  [ _k (f0: Int64.t) -> {Some f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
      | _ -> false
      end}
    any) ]

predicate wal_batch_layout [#"/workspace/crates/verified/src/wal.rs" 44 0 44 90] (bases: Seq.seq Int64.t) (lasts: Seq.seq Int64.t) (start: int) (target: int) =
  [%#swal'29] Seq.length bases = Seq.length lasts
  /\ (if start = target then
    Seq.length bases = 0
  else
    (forall i: int. 0 <= i /\ i < Seq.length bases
        -> Int64.le (Seq.get bases i) (Seq.get lasts i)
        /\ Int64.lt (Seq.get lasts i) const_MAX
        /\ Int64.to_int (Seq.get bases i) = (if i = 0 then start else Int64.to_int (Seq.get lasts (i - 1)) + 1))
    /\ target = (if Seq.length bases = 0 then start else Int64.to_int (Seq.get lasts (Seq.length bases - 1)) + 1)
  )

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

