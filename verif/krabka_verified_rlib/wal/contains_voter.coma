use creusot.int.UInt64
use seq.Seq
use creusot.slice.Slice64
use creusot.prelude.Any
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

let len_u64 (self_: Slice64.slice UInt64.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sslice] Seq.length (Slice64.view self_)
    = UInt64.t'int result}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let contains_voter [#"/home/matt/.codex/worktrees/e9db/krabka-broker/crates/verified/src/wal.rs" 36 0 36 52]
  (voters: Slice64.slice UInt64.t) (node: UInt64.t) (return (x: bool)) = (! bb0
  [ bb0 = s0 [ s0 = [ &i <- [%#swal] (0: UInt64.t) ] s1 | s1 = bb1 ]
  | bb1 = bb1invariant
    [ bb1 = {[@expl:loop variant] well_founded_relation_Int variant_old_bb1 ([%#swal'0] Seq.length (Slice64.view voters)
      - UInt64.t'int i)}
      bb1invariant
    | bb1invariant = {[@expl:loop invariant #0] [%#swal'3] UInt64.t'int i <= Seq.length (Slice64.view voters)}
      {[@expl:loop invariant #1] [%#swal'2] forall k: int. 0 <= k /\ k < UInt64.t'int i
        -> Seq.get (Slice64.view voters) k <> node}
      (! [ &variant_old_bb1 <- [%#swal'0] Seq.length (Slice64.view voters) - UInt64.t'int i ] s0)
      [ s0 = len_u64 [%#swal'1] {voters} (fun (_x: UInt64.t) -> [ &_22 <- _x ] s1)
      | s1 = [ &_20 <- UInt64.lt i _22 ] s2
      | s2 = any [ br0 -> {_20 = false} (! bb8) | br1 -> {_20} (! bb4) ] ]
      [ bb4 = s0
        [ s0 = [ &_27 <- i ] s1
        | s1 = [ &_28 <- Slice64.length voters ] s2
        | s2 = [ &_29 <- UInt64.lt _27 _28 ] s3
        | s3 = {[@expl:index in bounds] [%#swal'4] _29} s4
        | s4 = Slice64.get [%#swal'4] <UInt64.t> {voters} {_27} (fun (r: UInt64.t) -> [ &_26 <- r ] s5)
        | s5 = [ &_25 <- _26 = node ] s6
        | s6 = any [ br0 -> {_25 = false} (! bb7) | br1 -> {_25} (! bb6) ] ]
      | bb7 = s0
        [ s0 = UInt64.add [%#swal'6] {i} {[%#swal'5] (1: UInt64.t)} (fun (_x: UInt64.t) -> [ &i <- _x ] s1)
        | s1 = bb1 ] ] ]
  | bb6 = s0 [ s0 = [ &_ret <- [%#swal'7] true ] s1 | s1 = return {_ret} ]
  | bb8 = s0 [ s0 = [ &_ret <- [%#swal'8] false ] s1 | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l ()
  | & voters: Slice64.slice UInt64.t = voters
  | & node: UInt64.t = node
  | & i: UInt64.t = Any.any_l ()
  | & _20: bool = Any.any_l ()
  | & _22: UInt64.t = Any.any_l ()
  | & _25: bool = Any.any_l ()
  | & _26: UInt64.t = Any.any_l ()
  | & _27: UInt64.t = Any.any_l ()
  | & _28: UInt64.t = Any.any_l ()
  | & _29: bool = Any.any_l ()
  | & variant_old_bb1: int = Any.any_l () ])
  [ return (result: bool) -> {[@stop_split] [@expl:contains_voter ensures] [%#swal'9] result
    = (exists i: int. 0 <= i /\ i < Seq.length (Slice64.view voters) /\ Seq.get (Slice64.view voters) i = node)}
    (! return {result}) ]
