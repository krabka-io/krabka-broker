            /\ Seq.get (Slice64.view used_nodes) j = (Seq.get (Slice64.view candidates) i).f0)
        \/ (exists j: int. 0 <= j
            /\ j < Seq.length (Slice64.view used_racks)
            /\ Seq.get (Slice64.view used_racks) j = (Seq.get (Slice64.view candidates) i).f1)
        \/ require_local /\ (Seq.get (Slice64.view candidates) i).f0 <> local_node
      | Some index -> UInt64.t'int index < Seq.length (Slice64.view candidates)
      /\ (forall j: int. 0 <= j /\ j < Seq.length (Slice64.view used_nodes)
          -> Seq.get (Slice64.view used_nodes) j <> (Seq.get (Slice64.view candidates) (UInt64.t'int index)).f0)
      /\ (forall j: int. 0 <= j /\ j < Seq.length (Slice64.view used_racks)
          -> Seq.get (Slice64.view used_racks) j <> (Seq.get (Slice64.view candidates) (UInt64.t'int index)).f1)
      /\ (not require_local \/ (Seq.get (Slice64.view candidates) (UInt64.t'int index)).f0 = local_node)
      /\ (forall i: int. 0 <= i /\ i < UInt64.t'int index
        -> (exists j: int. 0 <= j
            /\ j < Seq.length (Slice64.view used_nodes)
            /\ Seq.get (Slice64.view used_nodes) j = (Seq.get (Slice64.view candidates) i).f0)
        \/ (exists j: int. 0 <= j
            /\ j < Seq.length (Slice64.view used_racks)
            /\ Seq.get (Slice64.view used_racks) j = (Seq.get (Slice64.view candidates) i).f1)
        \/ require_local /\ (Seq.get (Slice64.view candidates) i).f0 <> local_node)
      end}
    (! return {result}) ]
