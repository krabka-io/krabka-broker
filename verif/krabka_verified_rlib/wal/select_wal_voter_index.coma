  | & variant_old_bb1: int = Any.any_l () ])
  [ return (result: t_Option_usize) ->
  {[@stop_split] [@expl:select_wal_voter_index ensures] [%#swal'10] match result with
      | None -> forall i: int. 0 <= i /\ i < Seq.length (Slice64.view candidates)
