let len_i64 (self_: Slice64.slice Int64.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sslice] Seq.length (Slice64.view self_)
    = UInt64.t'int result}
    (! return {result}) ]

type t_Option_i64 = None | Some Int64.t

constant const_MAX: Int64.t = (9223372036854775807: Int64.t)

predicate exact_wal_batch_suffix [#"/workspace/crates/verified/src/wal/batch_equal.rs" 10 0 16 9] (bases: Seq.seq Int64.t) (lasts: Seq.seq Int64.t) (index: int) (expected: int) (target: int)

axiom exact_wal_batch_suffix_def:
  forall bases: Seq.seq Int64.t, lasts: Seq.seq Int64.t, index: int, expected: int, target: int [exact_wal_batch_suffix bases lasts index expected target]. ([%#sbatch_equal'23] Seq.length bases
      = Seq.length lasts)
    -> ([%#sbatch_equal'24] 0 <= index /\ index <= Seq.length bases)
    -> exact_wal_batch_suffix bases lasts index expected target
    = ([%#sbatch_equal'25] if index = Seq.length bases then
      expected = target
    else
      Int64.to_int (Seq.get bases index) = expected
      /\ Int64.le (Seq.get bases index) (Seq.get lasts index)
      /\ Int64.lt (Seq.get lasts index) const_MAX
      /\ exact_wal_batch_suffix bases lasts (index + 1) (Int64.to_int (Seq.get lasts index) + 1) target
    )

predicate wal_batch_layout [#"/workspace/crates/verified/src/wal/batch_equal.rs" 84 0 84 90] (bases: Seq.seq Int64.t) (lasts: Seq.seq Int64.t) (start: int) (target: int) =
  [%#sbatch_equal'21] Seq.length bases = Seq.length lasts
  /\ (if start = target then
    Seq.length bases = 0
  else
    (forall i: int. 0 <= i /\ i < Seq.length bases
        -> Int64.le (Seq.get bases i) (Seq.get lasts i)
        /\ Int64.lt (Seq.get lasts i) const_MAX
        /\ Int64.to_int (Seq.get bases i) = (if i = 0 then start else Int64.to_int (Seq.get lasts (i - 1)) + 1))
    /\ target = (if Seq.length bases = 0 then start else Int64.to_int (Seq.get lasts (Seq.length bases - 1)) + 1)
  )

let exact_wal_batch_range (bases: Slice64.slice Int64.t) (lasts: Slice64.slice Int64.t) (start: Int64.t)
  (target: Int64.t) (return (x: bool)) = any
  [ return (result: bool) ->
  {[@stop_split] [@expl:exact_wal_batch_range ensures] ([@stop_split] [@expl:exact_wal_batch_range ensures #0] [%#sbatch_equal'18] result
      = (Seq.length (Slice64.view bases) = Seq.length (Slice64.view lasts)
      /\ (if Int64.to_int start = Int64.to_int target then
        Seq.length (Slice64.view bases) = 0
      else
        exact_wal_batch_suffix (Slice64.view bases) (Slice64.view lasts) 0 (Int64.to_int start) (Int64.to_int target)
      )))
    /\ ([@stop_split] [@expl:exact_wal_batch_range ensures #1] [%#sbatch_equal'19] result
      = wal_batch_layout (Slice64.view bases) (Slice64.view lasts) (Int64.to_int start) (Int64.to_int target))
    /\ ([@stop_split] [@expl:exact_wal_batch_range ensures #2] [%#sbatch_equal'20] result
    -> (forall i: int. 0 <= i /\ i < Seq.length (Slice64.view bases)
      -> Int64.to_int start <= Int64.to_int (Seq.get (Slice64.view bases) i)
      /\ Int64.to_int (Seq.get (Slice64.view bases) i) <= Int64.to_int (Seq.get (Slice64.view lasts) i)
      /\ Int64.to_int (Seq.get (Slice64.view lasts) i) < Int64.to_int target))}
    (! return {result}) ]

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

