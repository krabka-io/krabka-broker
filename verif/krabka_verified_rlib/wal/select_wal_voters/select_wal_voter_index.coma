predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

type tup2_u64_u64 = { f0: UInt64.t; f1: UInt64.t }

let len_tup2_u64_u64 (self_: Slice64.slice tup2_u64_u64) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sslice] Seq.length (Slice64.view self_)
    = UInt64.t'int result}
    (! return {result}) ]

predicate voter_blocked [#"/workspace/crates/verified/src/wal/select_wal_voters.rs" 47 0 53 9] (candidate: tup2_u64_u64) (used_nodes: Seq.seq UInt64.t) (used_racks: Seq.seq UInt64.t) (local_node: UInt64.t) (require_local: bool) =
  [%#sselect_wal_voters'10] (exists j: int. 0 <= j /\ j < Seq.length used_nodes /\ Seq.get used_nodes j = candidate.f0)
  \/ (exists j: int. 0 <= j /\ j < Seq.length used_racks /\ Seq.get used_racks j = candidate.f1)
  \/ require_local /\ candidate.f0 <> local_node

let contains (values: Slice64.slice UInt64.t) (value: UInt64.t) (return (x: bool)) = any
  [ return (result: bool) -> {[@stop_split] [@expl:contains ensures] [%#sselect_wal_voters'11] result
    = (exists i: int. 0 <= i /\ i < Seq.length (Slice64.view values) /\ Seq.get (Slice64.view values) i = value)}
    (! return {result}) ]

type t_Option_usize = None | Some UInt64.t

