let len_u64 (self_: Slice64.slice UInt64.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sslice] Seq.length (Slice64.view self_)
    = UInt64.t'int result}
    (! return {result}) ]

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

type t_RangeTo_usize = { end': UInt64.t }

predicate in_bounds_RangeTo_usize (self: t_RangeTo_usize) (seq: Seq.seq UInt64.t) =
  [%#sslice'2] UInt64.t'int self.end' <= Seq.length seq

predicate has_value_RangeTo_usize (self: t_RangeTo_usize) (seq: Seq.seq UInt64.t) (out: Slice64.slice UInt64.t) =
  [%#sslice'3] Seq.([..]) seq 0 (UInt64.t'int self.end') = Slice64.view out

let index_slice_u64 (self_: Slice64.slice UInt64.t) (ix: t_RangeTo_usize) (return (x: Slice64.slice UInt64.t)) =
{[@stop_split] [@expl:index requires] [%#sslice'0] in_bounds_RangeTo_usize ix (Slice64.view self_)}
  any
  [ return (result: Slice64.slice UInt64.t) ->
  {[@stop_split] [@expl:index ensures] [%#sslice'1] has_value_RangeTo_usize ix (Slice64.view self_) result}
    (! return {result}) ]

let contains (values: Slice64.slice UInt64.t) (value: UInt64.t) (return (x: bool)) = any
  [ return (result: bool) -> {[@stop_split] [@expl:contains ensures] [%#sselect_wal_voters'17] result
    = (exists i: int. 0 <= i /\ i < Seq.length (Slice64.view values) /\ Seq.get (Slice64.view values) i = value)}
    (! return {result}) ]

type tup2_u64_u64 = { f0: UInt64.t; f1: UInt64.t }

predicate pairwise_u64 [#"/workspace/crates/verified/src/sequence.rs" 20 0 20 95] (values: Seq.seq UInt64.t) (relation: Map.map tup2_u64_u64 bool) =
  [%#ssequence'0] forall i: int, j: int. 0 <= i /\ i < j /\ j < Seq.length values
    -> Map.get relation { f0 = Seq.get values i; f1 = Seq.get values j }

predicate distinct_u64 [#"/workspace/crates/verified/src/sequence.rs" 6 0 6 42] (values: Seq.seq UInt64.t) =
  [%#ssequence] pairwise_u64 values (fun (__0: tup2_u64_u64) -> let {f0 = left; f1 = right} = __0 in left <> right)

