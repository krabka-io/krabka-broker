  {[@stop_split] [@expl:first_u64 ensures] ([@stop_split] [@expl:first ensures #0] [%#sslice] result = None'1
      -> Seq.length (Slice64.view self_) = 0)
    /\ ([@stop_split] [@expl:first ensures #1] [%#sslice'0] forall x: UInt64.t. result = Some'1 x
      -> index_slice_u64 self_ 0 = x)}
