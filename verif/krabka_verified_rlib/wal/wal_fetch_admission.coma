let contains_voter (voters: Slice64.slice UInt64.t) (node: UInt64.t) (return (x: bool)) = any
  [ return (result: bool) -> {[@stop_split] [@expl:contains_voter ensures] [%#swal'8] result
    = (exists i: int. 0 <= i /\ i < Seq.length (Slice64.view voters) /\ Seq.get (Slice64.view voters) i = node)}
    (! return {result}) ]

type t_WalFetchAdmission = Denied | FencedLeaderEpoch | UnknownLeaderEpoch | Serve

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate wal_fetch_authorized [#"/home/matt/.codex/worktrees/e9db/krabka-broker/crates/verified/src/wal.rs" 20 0 25 9] (authenticated_node: t_Option_u64) (claimed_node: UInt64.t) (local_node: UInt64.t) (voters: Seq.seq UInt64.t) =
  [%#swal'9] authenticated_node = Some claimed_node
  /\ gt_log_Int (Seq.length voters) 0
  /\ Seq.get voters 0 = local_node
  /\ (exists i: int. 0 <= i /\ i < Seq.length voters /\ Seq.get voters i = claimed_node)

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

