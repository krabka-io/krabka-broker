  [ & _ret: t_WalFetchAdmission = Any.any_l ()
  | & authenticated_node: t_Option_u64 = authenticated_node
  | & claimed_node: UInt64.t = claimed_node
  | & local_node: UInt64.t = local_node
  | & voters: Slice64.slice UInt64.t = voters
