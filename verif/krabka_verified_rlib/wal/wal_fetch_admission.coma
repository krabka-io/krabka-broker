type t_Option_u64 = None | Some UInt64.t

type t_Option_Int = None'0 | Some'0 int

function deep_model_u64 [@inline:trivial] (self: UInt64.t) : int = [%#snum] UInt64.t'int self

meta "rewrite_def" function deep_model_u64

function deep_model_Option_u64 [@inline:trivial] (self: t_Option_u64) : t_Option_Int = [%#soption] match self with
    | Some t -> Some'0 (deep_model_u64 t)
    | None -> None'0
    end

meta "rewrite_def" function deep_model_Option_u64

function deep_model_ref_Option_u64 [@inline:trivial] (self: t_Option_u64) : t_Option_Int =
