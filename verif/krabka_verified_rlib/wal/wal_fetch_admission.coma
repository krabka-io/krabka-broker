function deep_model_ref_u64 [@inline:trivial] (self: UInt64.t) : int = [%#smodel] deep_model_u64 self

meta "rewrite_def" function deep_model_ref_u64

function deep_model_Option_ref_u64 [@inline:trivial] (self: t_Option_ref_u64) : t_Option_Int =
