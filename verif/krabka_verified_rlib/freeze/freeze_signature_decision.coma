      /\ (not facts.replaces \/ gt_log_Int (Int64.to_int facts.set_at_ms) (Int64.to_int facts.replaced_set_at_ms))
      /\ not facts.signature_valid
      | Admit'0 -> facts.identity = Bound
      /\ freeze_timestamp_in_window_model facts.set_at_ms facts.now_ms facts.max_skew_ms
      /\ (not facts.replaces \/ gt_log_Int (Int64.to_int facts.set_at_ms) (Int64.to_int facts.replaced_set_at_ms))
      /\ facts.signature_valid
