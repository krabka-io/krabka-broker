    | br1 -> {facts.identity = WrongKeyPrincipal} (! bb7)
    | br2 -> {facts.identity = WrongConnectionPrincipal} (! bb6)
    | br3 -> {facts.identity = Bound} (! bb5) ]
  | bb5 = s0
    [ s0 = freeze_timestamp_in_window [%#sfreeze] {facts.set_at_ms} {facts.now_ms} {facts.max_skew_ms}
        (fun (_x: bool) -> [ &_11 <- _x ] s1)
    | s1 = any [ br0 -> {_11 = false} (! bb11) | br1 -> {_11} (! bb10) ] ]
  | bb10 = any [ br0 -> {facts.replaces = false} (! bb15) | br1 -> {facts.replaces} (! bb12) ]
  | bb12 = s0
    [ s0 = [ &_16 <- Int64.le facts.set_at_ms facts.replaced_set_at_ms ] s1
    | s1 = any [ br0 -> {_16 = false} (! bb15) | br1 -> {_16} (! bb13) ] ]
  | bb13 = s0 [ s0 = [ &_ret <- TimestampNotNewer'0 ] s1 | s1 = return {_ret} ]
  | bb15 = any [ br0 -> {facts.signature_valid = false} (! bb16) | br1 -> {facts.signature_valid} (! bb17) ]
  | bb17 = s0 [ s0 = [ &_ret <- Admit'0 ] s1 | s1 = return {_ret} ]
  | bb16 = s0 [ s0 = [ &_ret <- SignatureInvalid'0 ] s1 | s1 = return {_ret} ]
  | bb11 = s0 [ s0 = [ &_ret <- TimestampOutsideSkewWindow'0 ] s1 | s1 = return {_ret} ]
  | bb6 = s0 [ s0 = [ &_ret <- AuthorIsNotConnectionPrincipal'0 ] s1 | s1 = return {_ret} ]
  | bb7 = s0 [ s0 = [ &_ret <- AuthorIsNotKeyPrincipal'0 ] s1 | s1 = return {_ret} ]
  | bb8 = s0 [ s0 = [ &_ret <- UnknownKey'0 ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_FreezeSignatureDecision = Any.any_l ()
  | & facts: t_FreezeSignatureFacts = facts
  | & _11: bool = Any.any_l ()
  | & _16: bool = Any.any_l () ])
  [ return (result: t_FreezeSignatureDecision) ->
  {[@stop_split] [@expl:freeze_signature_decision ensures] [%#sfreeze'0] match result with
      | UnknownKey'0 -> facts.identity = UnknownKey
      | AuthorIsNotKeyPrincipal'0 -> facts.identity = WrongKeyPrincipal
      | AuthorIsNotConnectionPrincipal'0 -> facts.identity = WrongConnectionPrincipal
      | TimestampOutsideSkewWindow'0 -> facts.identity = Bound
      /\ not freeze_timestamp_in_window_model facts.set_at_ms facts.now_ms facts.max_skew_ms
      | TimestampNotNewer'0 -> facts.identity = Bound
      /\ freeze_timestamp_in_window_model facts.set_at_ms facts.now_ms facts.max_skew_ms
