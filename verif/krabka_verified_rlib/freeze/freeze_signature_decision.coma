use creusot.int.Int64
use creusot.prelude.Any
use int.Int

type t_FreezeIdentityState = UnknownKey | WrongKeyPrincipal | WrongConnectionPrincipal | Bound

type t_FreezeSignatureFacts = {
  identity: t_FreezeIdentityState;
  set_at_ms: Int64.t;
  now_ms: Int64.t;
  max_skew_ms: Int64.t;
  replaces: bool;
  replaced_set_at_ms: Int64.t;
  signature_valid: bool }

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate freeze_timestamp_in_window_model [#"/workspace/crates/verified/src/freeze.rs" 49 0 49 94] (set_at_ms'0: Int64.t) (now_ms'0: Int64.t) (max_skew_ms'0: Int64.t) =
  [%#sfreeze'2] ge_log_Int (Int64.to_int max_skew_ms'0) 0
  /\ ge_log_Int (Int64.to_int set_at_ms'0) (Int64.to_int now_ms'0 - Int64.to_int max_skew_ms'0)
  /\ Int64.to_int set_at_ms'0 <= Int64.to_int now_ms'0 + Int64.to_int max_skew_ms'0

let freeze_timestamp_in_window (set_at_ms'0: Int64.t) (now_ms'0: Int64.t) (max_skew_ms'0: Int64.t) (return (x: bool)) =
any
  [ return (result: bool) -> {[@stop_split] [@expl:freeze_timestamp_in_window ensures] [%#sfreeze'1] result
    = freeze_timestamp_in_window_model set_at_ms'0 now_ms'0 max_skew_ms'0}
    (! return {result}) ]

type t_FreezeSignatureDecision =
  | UnknownKey'0
  | AuthorIsNotKeyPrincipal'0
  | AuthorIsNotConnectionPrincipal'0
  | TimestampOutsideSkewWindow'0
  | TimestampNotNewer'0
  | SignatureInvalid'0
  | Admit'0

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

