use creusot.int.Int64
use creusot.prelude.Any
use int.Int

type t_FreezeStoredState = Missing | Present Int64.t

type t_FreezeReplacementFacts = {
  stored: t_FreezeStoredState;
  incoming_frozen: bool;
  incoming_set_at_ms: Int64.t;
  uncommitted_tail: bool }

let elim_Present (_x: t_FreezeStoredState) (return (set_at_ms: Int64.t)) = any
  [ _k (set_at_ms: Int64.t) -> {Present set_at_ms = _x} (! return {set_at_ms})
  | _chk -> (! {[@expl:elim Present] match _x with
      | Present _ -> true
      | _ -> false
      end}
    any) ]

type t_FreezeReplacementDecision = Missing'0 | Stale'0 | InFlight'0 | Append'0

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

function freeze_replacement_model [#"/workspace/crates/verified/src/freeze/replacement_decision.rs" 17 0 17 87] (facts: t_FreezeReplacementFacts) : t_FreezeReplacementDecision
 = [%#sreplacement_decision'0] let admissible = match facts.stored with
    | Missing -> facts.incoming_frozen
    | Present set_at_ms -> gt_log_Int (Int64.to_int facts.incoming_set_at_ms) (Int64.to_int set_at_ms)
    end in if not admissible then
    match facts.stored with
      | Missing -> Missing'0
      | Present _ -> Stale'0
      end
  else
    if facts.uncommitted_tail then InFlight'0 else Append'0


