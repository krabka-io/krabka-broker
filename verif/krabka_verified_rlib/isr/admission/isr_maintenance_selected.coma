(* #"/workspace/crates/verified/src/isr/admission.rs" 143 0 143 62 *)

let%span sadmission = "/workspace/crates/verified/src/isr/admission.rs" 148 44 148 96
let%span sadmission'0 = "/workspace/crates/verified/src/isr/admission.rs" 147 41 147 99
let%span sadmission'1 = "/workspace/crates/verified/src/isr/admission.rs" 146 33 146 37
let%span sadmission'2 = "/workspace/crates/verified/src/isr/admission.rs" 145 37 145 42
let%span sadmission'3 = "/workspace/crates/verified/src/isr/admission.rs" 135 10 141 1
let%span sadmission'4 = "/workspace/crates/verified/src/isr/admission.rs" 123 16 123 74

use creusot.prelude.Any

type t_IsrMemberRole = Unassigned | Leader | InSyncFollower | OutOfSyncFollower

type t_IsrMemberFacts = {
  role: t_IsrMemberRole;
  log_end_matches_leader: bool;
  caught_up_within_lag: bool;
  fetch_within_lag: bool }

predicate kafka_is_caught_up [#"/workspace/crates/verified/src/isr/admission.rs" 122 0 122 52] (facts: t_IsrMemberFacts) =
  [%#sadmission'4] facts.log_end_matches_leader \/ facts.caught_up_within_lag

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let isr_maintenance_selected [#"/workspace/crates/verified/src/isr/admission.rs" 143 0 143 62] (facts: t_IsrMemberFacts)
  (return (x: bool)) = (! bb0
  [ bb0 = any
    [ br0 -> {facts.role = Unassigned} (! bb8)
    | br1 -> {facts.role = Leader} (! bb7)
    | br2 -> {facts.role = InSyncFollower} (! bb6)
    | br3 -> {facts.role = OutOfSyncFollower} (! bb5) ]
  | bb5 = any [ br0 -> {facts.fetch_within_lag = false} (! bb13) | br1 -> {facts.fetch_within_lag} (! bb12) ]
  | bb12 = s0 [ s0 = [ &_ret <- facts.caught_up_within_lag ] s1 | s1 = return {_ret} ]
  | bb13 = s0 [ s0 = [ &_ret <- [%#sadmission] false ] s1 | s1 = return {_ret} ]
  | bb6 = any [ br0 -> {facts.log_end_matches_leader = false} (! bb10) | br1 -> {facts.log_end_matches_leader} (! bb9) ]
  | bb9 = s0 [ s0 = [ &_ret <- [%#sadmission'0] true ] s1 | s1 = return {_ret} ]
  | bb10 = s0 [ s0 = [ &_ret <- facts.caught_up_within_lag ] s1 | s1 = return {_ret} ]
  | bb7 = s0 [ s0 = [ &_ret <- [%#sadmission'1] true ] s1 | s1 = return {_ret} ]
  | bb8 = s0 [ s0 = [ &_ret <- [%#sadmission'2] false ] s1 | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l () | & facts: t_IsrMemberFacts = facts ])
  [ return (result: bool) ->
  {[@stop_split] [@expl:isr_maintenance_selected ensures] [%#sadmission'3] match facts.role with
      | Unassigned -> not result
      | Leader -> result
      | InSyncFollower -> result = kafka_is_caught_up facts
      | OutOfSyncFollower -> result = (facts.fetch_within_lag /\ facts.caught_up_within_lag)
      end}
    (! return {result}) ]
