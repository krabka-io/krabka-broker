(* #"/workspace/crates/verified/src/isr.rs" 470 0 470 91 *)

let%span sord = "/root/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/creusot-std-0.13.0/src/logic/ord.rs" 34 8 34 21
let%span sord'0 = "/root/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/creusot-std-0.13.0/src/logic/ord.rs" 22 8 22 20
let%span swell_founded = "/root/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/creusot-std-0.13.0/src/logic/well_founded.rs" 43 8 43 33
let%span sisr = "/workspace/crates/verified/src/isr.rs" 469 10 469 11
let%span sisr'0 = "/workspace/crates/verified/src/isr.rs" 456 8 458 70
let%span sisr'1 = "/workspace/crates/verified/src/isr.rs" 306 16 306 74
let%span sisr'2 = "/workspace/crates/verified/src/isr.rs" 282 8 289 13

use creusot.int.Int64
use seq.Seq
use int.Int

type t_Option_i64 = None | Some Int64.t

type t_IsrEligibilityFacts = {
  fenced: bool;
  shutting_down: bool;
  fetch_broker_epoch: t_Option_i64;
  alive_broker_epoch: t_Option_i64 }

type t_HwmReplica = { log_end: Int64.t; in_isr: bool; caught_up_within_lag: bool; eligibility: t_IsrEligibilityFacts }

predicate kafka_replica_is_caught_up [#"/workspace/crates/verified/src/isr.rs" 301 0 305 9] (follower_log_end: int) (leader_log_end: int) (caught_up_within_lag'0: bool) =
  [%#sisr'1] follower_log_end = leader_log_end \/ caught_up_within_lag'0

predicate kafka_is_replica_isr_eligible [#"/workspace/crates/verified/src/isr.rs" 280 0 280 68] (facts: t_IsrEligibilityFacts) =
  [%#sisr'2] not facts.fenced
  /\ not facts.shutting_down
  /\ match facts.fetch_broker_epoch with
    | Some stored -> match facts.alive_broker_epoch with
      | Some alive -> Int64.to_int stored = - 1 \/ Int64.to_int stored = Int64.to_int alive
      | None -> false
      end
    | None -> false
    end

predicate kafka_holds_watermark [#"/workspace/crates/verified/src/isr.rs" 454 0 454 74] (replica: t_HwmReplica) (leader_log_end: int) =
  [%#sisr'0] replica.in_isr
  \/ kafka_replica_is_caught_up (Int64.to_int replica.log_end) leader_log_end replica.caught_up_within_lag
  /\ kafka_is_replica_isr_eligible replica.eligibility

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant leader_log_end : int

constant replicas : Seq.seq t_HwmReplica

constant n : int

function kafka_watermark_candidate [#"/workspace/crates/verified/src/isr.rs" 470 0 470 91] (leader_log_end: int) (replicas: Seq.seq t_HwmReplica) (n: int) : int

goal vc_kafka_watermark_candidate: if n <= 0 then
    true
  else
    if kafka_holds_watermark (Seq.get replicas (n - 1)) leader_log_end then
      ([@expl:variant decreases] well_founded_relation_Int ([%#sisr] n) ([%#sisr] n - 1))
      /\ (if Int64.to_int (Seq.get replicas (n - 1)).log_end
      < kafka_watermark_candidate leader_log_end replicas (n - 1) then
        true
      else
        [@expl:variant decreases] well_founded_relation_Int ([%#sisr] n) ([%#sisr] n - 1)
      )
    else
      [@expl:variant decreases] well_founded_relation_Int ([%#sisr] n) ([%#sisr] n - 1)
  
  
