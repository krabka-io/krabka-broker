  [ bb0 = s0 [ s0 = [ &_ret <- self ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_IsrAdmission = Any.any_l () | & self: t_IsrAdmission = self ])
  [ return (result: t_IsrAdmission) -> (! return {result}) ]
