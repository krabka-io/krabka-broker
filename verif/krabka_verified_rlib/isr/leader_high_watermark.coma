use creusot.int.Int64
use creusot.int.UInt64
use seq.Seq
use creusot.slice.Slice64
use creusot.prelude.Any
use int.Int

type t_HighWatermarkFacts = {
  current': Int64.t;
  leader_log_end: Int64.t;
  isr_size: UInt64.t;
  effective_min_isr: UInt64.t }

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

type t_Option_i64 = None | Some Int64.t

type t_IsrEligibilityFacts = {
  fenced: bool;
  shutting_down: bool;
  fetch_broker_epoch: t_Option_i64;
  alive_broker_epoch: t_Option_i64 }

type t_HwmReplica = { log_end: Int64.t; in_isr: bool; caught_up_within_lag: bool; eligibility: t_IsrEligibilityFacts }

let len_HwmReplica (self_: Slice64.slice t_HwmReplica) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sslice] Seq.length (Slice64.view self_)
    = UInt64.t'int result}
    (! return {result}) ]

predicate kafka_replica_is_caught_up [#"/workspace/crates/verified/src/isr.rs" 301 0 305 9] (follower_log_end: int) (leader_log_end'0: int) (caught_up_within_lag'0: bool) =
  [%#sisr'23] follower_log_end = leader_log_end'0 \/ caught_up_within_lag'0

predicate kafka_is_replica_isr_eligible [#"/workspace/crates/verified/src/isr.rs" 280 0 280 68] (facts: t_IsrEligibilityFacts) =
  [%#sisr'22] not facts.fenced
  /\ not facts.shutting_down
  /\ match facts.fetch_broker_epoch with
    | Some stored -> match facts.alive_broker_epoch with
      | Some alive -> Int64.to_int stored = - 1 \/ Int64.to_int stored = Int64.to_int alive
      | None -> false
      end
    | None -> false
    end

predicate kafka_holds_watermark [#"/workspace/crates/verified/src/isr.rs" 454 0 454 74] (replica: t_HwmReplica) (leader_log_end'0: int) =
  [%#sisr'21] replica.in_isr
  \/ kafka_replica_is_caught_up (Int64.to_int replica.log_end) leader_log_end'0 replica.caught_up_within_lag
  /\ kafka_is_replica_isr_eligible replica.eligibility

function kafka_watermark_candidate [#"/workspace/crates/verified/src/isr.rs" 470 0 470 91] (leader_log_end'0: int) (replicas: Seq.seq t_HwmReplica) (n: int) : int

axiom kafka_watermark_candidate_def:
  forall leader_log_end'0: int, replicas: Seq.seq t_HwmReplica, n: int [kafka_watermark_candidate leader_log_end'0 replicas n]. kafka_watermark_candidate leader_log_end'0 replicas n
    = ([%#sisr'17] if n <= 0 then
      leader_log_end'0
    else
      if kafka_holds_watermark (Seq.get replicas (n - 1)) leader_log_end'0
      /\ Int64.to_int (Seq.get replicas (n - 1)).log_end
      < kafka_watermark_candidate leader_log_end'0 replicas (n - 1) then
        Int64.to_int (Seq.get replicas (n - 1)).log_end
      else
        kafka_watermark_candidate leader_log_end'0 replicas (n - 1)
    
    )

let replica_isr_eligible (facts: t_IsrEligibilityFacts) (return (x: bool)) = any
  [ return (result: bool) -> {[@stop_split] [@expl:replica_isr_eligible ensures] [%#sisr'18] result
    = kafka_is_replica_isr_eligible facts}
    (! return {result}) ]

predicate kafka_is_under_min_isr [#"/workspace/crates/verified/src/isr.rs" 442 0 442 60] (facts: t_HighWatermarkFacts) =
  [%#sisr'20] UInt64.t'int facts.isr_size < UInt64.t'int facts.effective_min_isr

function kafka_leader_high_watermark [#"/workspace/crates/verified/src/isr.rs" 494 0 494 91] (facts: t_HighWatermarkFacts) (replicas: Seq.seq t_HwmReplica) : int
 = [%#sisr'19] if kafka_is_under_min_isr facts then
    Int64.to_int facts.current'
  else
    if gt_log_Int (kafka_watermark_candidate (Int64.to_int facts.leader_log_end) replicas (Seq.length replicas)) (Int64.to_int facts.current') then
      kafka_watermark_candidate (Int64.to_int facts.leader_log_end) replicas (Seq.length replicas)
    else
      Int64.to_int facts.current'
  


meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

