predicate kafka_is_under_min_isr [#"/workspace/crates/verified/src/isr/watermark.rs" 117 0 117 60] (facts: t_HighWatermarkFacts) =
  [%#swatermark'20] UInt64.t'int facts.isr_size < UInt64.t'int facts.effective_min_isr

function kafka_leader_high_watermark [#"/workspace/crates/verified/src/isr/watermark.rs" 169 0 169 91] (facts: t_HighWatermarkFacts) (replicas: Seq.seq t_HwmReplica) : int
 = [%#swatermark'19] if kafka_is_under_min_isr facts then
    Int64.to_int facts.current'
  else
    if gt_log_Int (kafka_watermark_candidate (Int64.to_int facts.leader_log_end) replicas (Seq.length replicas)) (Int64.to_int facts.current') then
      kafka_watermark_candidate (Int64.to_int facts.leader_log_end) replicas (Seq.length replicas)
    else
      Int64.to_int facts.current'



