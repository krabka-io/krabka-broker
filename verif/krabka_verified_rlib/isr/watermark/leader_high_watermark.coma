predicate kafka_replica_is_caught_up [#"/workspace/crates/verified/src/isr/watermark.rs" 35 0 39 9] (follower_log_end: int) (leader_log_end'0: int) (caught_up_within_lag'0: bool) =
  [%#swatermark'23] follower_log_end = leader_log_end'0 \/ caught_up_within_lag'0

predicate kafka_is_replica_isr_eligible [#"/workspace/crates/verified/src/isr/watermark.rs" 14 0 14 68] (facts: t_IsrEligibilityFacts) =
  [%#swatermark'22] not facts.fenced
  /\ not facts.shutting_down
  /\ match facts.fetch_broker_epoch with
    | Some stored -> match facts.alive_broker_epoch with
      | Some alive -> Int64.to_int stored = - 1 \/ Int64.to_int stored = Int64.to_int alive
      | None -> false
      end
    | None -> false
    end

predicate kafka_holds_watermark [#"/workspace/crates/verified/src/isr/watermark.rs" 129 0 129 74] (replica: t_HwmReplica) (leader_log_end'0: int) =
  [%#swatermark'21] replica.in_isr
  \/ kafka_replica_is_caught_up (Int64.to_int replica.log_end) leader_log_end'0 replica.caught_up_within_lag
  /\ kafka_is_replica_isr_eligible replica.eligibility

function kafka_watermark_candidate [#"/workspace/crates/verified/src/isr/watermark.rs" 145 0 145 91] (leader_log_end'0: int) (replicas: Seq.seq t_HwmReplica) (n: int) : int

axiom kafka_watermark_candidate_def:
  forall leader_log_end'0: int, replicas: Seq.seq t_HwmReplica, n: int [kafka_watermark_candidate leader_log_end'0 replicas n]. kafka_watermark_candidate leader_log_end'0 replicas n
    = ([%#swatermark'17] if n <= 0 then
      leader_log_end'0
    else
      if kafka_holds_watermark (Seq.get replicas (n - 1)) leader_log_end'0
      /\ Int64.to_int (Seq.get replicas (n - 1)).log_end
      < kafka_watermark_candidate leader_log_end'0 replicas (n - 1) then
        Int64.to_int (Seq.get replicas (n - 1)).log_end
      else
        kafka_watermark_candidate leader_log_end'0 replicas (n - 1)

    )

let replica_isr_eligible (facts: t_IsrEligibilityFacts) (return (x: bool)) = any
  [ return (result: bool) -> {[@stop_split] [@expl:replica_isr_eligible ensures] [%#swatermark'18] result
    = kafka_is_replica_isr_eligible facts}
