(* #"/workspace/crates/verified/src/isr/watermark.rs" 47 0 47 63 *)

let%span swatermark = "/workspace/crates/verified/src/isr/watermark.rs" 49 15 49 20
let%span swatermark'0 = "/workspace/crates/verified/src/isr/watermark.rs" 53 13 53 18
let%span swatermark'1 = "/workspace/crates/verified/src/isr/watermark.rs" 52 49 52 51
let%span swatermark'2 = "/workspace/crates/verified/src/isr/watermark.rs" 52 39 52 70
let%span swatermark'3 = "/workspace/crates/verified/src/isr/watermark.rs" 45 10 45 56
let%span swatermark'4 = "/workspace/crates/verified/src/isr/watermark.rs" 16 8 23 13

use creusot.int.Int64
use creusot.prelude.Any
use int.Int

type t_Option_i64 = None | Some Int64.t

type t_IsrEligibilityFacts = {
  fenced: bool;
  shutting_down: bool;
  fetch_broker_epoch: t_Option_i64;
  alive_broker_epoch: t_Option_i64 }

type tup2_Option_i64_Option_i64 = { f0: t_Option_i64; f1: t_Option_i64 }

let elim_Some (_x: t_Option_i64) (return (f0'0: Int64.t)) = any
  [ _k (f0'0: Int64.t) -> {Some f0'0 = _x} (! return {f0'0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
      | _ -> false
      end}
    any) ]

predicate kafka_is_replica_isr_eligible [#"/workspace/crates/verified/src/isr/watermark.rs" 14 0 14 68] (facts: t_IsrEligibilityFacts) =
  [%#swatermark'4] not facts.fenced
  /\ not facts.shutting_down
  /\ match facts.fetch_broker_epoch with
    | Some stored -> match facts.alive_broker_epoch with
      | Some alive -> Int64.to_int stored = - 1 \/ Int64.to_int stored = Int64.to_int alive
      | None -> false
      end
    | None -> false
    end

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let replica_isr_eligible [#"/workspace/crates/verified/src/isr/watermark.rs" 47 0 47 63] (facts: t_IsrEligibilityFacts)
  (return (x: bool)) = (! bb0
  [ bb0 = any [ br0 -> {facts.fenced = false} (! bb1) | br1 -> {facts.fenced} (! bb2) ]
  | bb1 = any [ br0 -> {facts.shutting_down = false} (! bb3) | br1 -> {facts.shutting_down} (! bb2) ]
  | bb2 = s0 [ s0 = [ &_ret <- [%#swatermark] false ] s1 | s1 = return {_ret} ]
  | bb3 = s0
    [ s0 = [ &_8 <- { f0 = facts.fetch_broker_epoch; f1 = facts.alive_broker_epoch } ] s1
    | s1 = any [ br0 -> {_8.f0 = None} (! bb4) | br1 (x0: Int64.t) -> {_8.f0 = Some x0} (! bb5) ] ]
  | bb5 = any [ br0 -> {_8.f1 = None} (! bb4) | br1 (x0: Int64.t) -> {_8.f1 = Some x0} (! bb7) ]
  | bb4 = s0 [ s0 = [ &_ret <- [%#swatermark'0] false ] s1 | s1 = return {_ret} ]
  | bb7 = s0
    [ s0 = elim_Some {_8.f0} (fun (r0: Int64.t) -> [ &stored <- r0 ] s1)
    | s1 = elim_Some {_8.f1} (fun (r0: Int64.t) -> [ &alive <- r0 ] s2)
    | s2 = [ &_15 <- stored = ([%#swatermark'1] (-1: Int64.t)) ] s3
    | s3 = any [ br0 -> {_15 = false} (! bb9) | br1 -> {_15} (! bb8) ] ]
  | bb8 = s0 [ s0 = [ &_ret <- [%#swatermark'2] true ] s1 | s1 = return {_ret} ]
  | bb9 = s0 [ s0 = [ &_ret <- stored = alive ] s1 | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l ()
  | & facts: t_IsrEligibilityFacts = facts
  | & _8: tup2_Option_i64_Option_i64 = Any.any_l ()
  | & stored: Int64.t = Any.any_l ()
  | & alive: Int64.t = Any.any_l ()
  | & _15: bool = Any.any_l () ])
  [ return (result: bool) -> {[@stop_split] [@expl:replica_isr_eligible ensures] [%#swatermark'3] result
    = kafka_is_replica_isr_eligible facts}
    (! return {result}) ]
