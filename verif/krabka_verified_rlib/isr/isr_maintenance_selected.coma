(* #"/workspace/crates/verified/src/isr.rs" 245 0 245 62 *)

let%span sisr = "/workspace/crates/verified/src/isr.rs" 250 44 250 96
let%span sisr'0 = "/workspace/crates/verified/src/isr.rs" 249 41 249 99
let%span sisr'1 = "/workspace/crates/verified/src/isr.rs" 248 33 248 37
let%span sisr'2 = "/workspace/crates/verified/src/isr.rs" 247 37 247 42
let%span sisr'3 = "/workspace/crates/verified/src/isr.rs" 237 10 243 1
let%span sisr'4 = "/workspace/crates/verified/src/isr.rs" 225 16 225 74

use creusot.prelude.Any

type t_IsrMemberRole = Unassigned | Leader | InSyncFollower | OutOfSyncFollower

type t_IsrMemberFacts = {
  role: t_IsrMemberRole;
  log_end_matches_leader: bool;
  caught_up_within_lag: bool;
  fetch_within_lag: bool }

predicate kafka_is_caught_up [#"/workspace/crates/verified/src/isr.rs" 224 0 224 52] (facts: t_IsrMemberFacts) =
  [%#sisr'4] facts.log_end_matches_leader \/ facts.caught_up_within_lag

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let isr_maintenance_selected [#"/workspace/crates/verified/src/isr.rs" 245 0 245 62] (facts: t_IsrMemberFacts)
  (return (x: bool)) = (! bb0
  [ bb0 = any
    [ br0 -> {facts.role = Unassigned} (! bb8)
    | br1 -> {facts.role = Leader} (! bb7)
    | br2 -> {facts.role = InSyncFollower} (! bb6)
    | br3 -> {facts.role = OutOfSyncFollower} (! bb5) ]
  | bb5 = any [ br0 -> {facts.fetch_within_lag = false} (! bb13) | br1 -> {facts.fetch_within_lag} (! bb12) ]
  | bb12 = s0 [ s0 = [ &_ret <- facts.caught_up_within_lag ] s1 | s1 = return {_ret} ]
  | bb13 = s0 [ s0 = [ &_ret <- [%#sisr] false ] s1 | s1 = return {_ret} ]
  | bb6 = any [ br0 -> {facts.log_end_matches_leader = false} (! bb10) | br1 -> {facts.log_end_matches_leader} (! bb9) ]
  | bb9 = s0 [ s0 = [ &_ret <- [%#sisr'0] true ] s1 | s1 = return {_ret} ]
  | bb10 = s0 [ s0 = [ &_ret <- facts.caught_up_within_lag ] s1 | s1 = return {_ret} ]
  | bb7 = s0 [ s0 = [ &_ret <- [%#sisr'1] true ] s1 | s1 = return {_ret} ]
  | bb8 = s0 [ s0 = [ &_ret <- [%#sisr'2] false ] s1 | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l () | & facts: t_IsrMemberFacts = facts ])
  [ return (result: bool) -> {[@stop_split] [@expl:isr_maintenance_selected ensures] [%#sisr'3] match facts.role with
      | Unassigned -> not result
      | Leader -> result
      | InSyncFollower -> result = kafka_is_caught_up facts
      | OutOfSyncFollower -> result = (facts.fetch_within_lag /\ facts.caught_up_within_lag)
      end}
    (! return {result}) ]
