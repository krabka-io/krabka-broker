use creusot.int.Int64
use creusot.int.UInt64
use int.ComputerDivision
use creusot.prelude.Any
use int.Int

type t_JwksCacheFacts = {
  generation_before: UInt64.t;
  generation_after: UInt64.t;
  last_successful_fetch_ms: Int64.t;
  now_ms: Int64.t;
  expiry_enabled: bool;
  expiry_ms: Int64.t }

type t_Option_JwksCacheFacts = None | Some t_JwksCacheFacts

let elim_Some (_x: t_Option_JwksCacheFacts) (return (f0: t_JwksCacheFacts)) = any
  [ _k (f0: t_JwksCacheFacts) -> {Some f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
      | _ -> false
      end}
    any) ]

type t_JwksCacheDecision = Reject | Admit

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

let jwks_cache_admission (facts: t_JwksCacheFacts) (return (x: t_JwksCacheDecision)) = any
  [ return (result: t_JwksCacheDecision) -> {[@stop_split] [@expl:jwks_cache_admission ensures] [%#sjwks] (result
      = Admit)
    = (ComputerDivision.mod (UInt64.t'int facts.generation_before) 2 = 0
    /\ UInt64.t'int facts.generation_before = UInt64.t'int facts.generation_after
    /\ (not facts.expiry_enabled
    \/ ge_log_Int (Int64.to_int facts.expiry_ms) 0
    /\ gt_log_Int (Int64.to_int facts.last_successful_fetch_ms) 0
    /\ ge_log_Int (Int64.to_int facts.now_ms) (Int64.to_int facts.last_successful_fetch_ms)
    /\ Int64.to_int facts.now_ms - Int64.to_int facts.last_successful_fetch_ms <= Int64.to_int facts.expiry_ms))}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let oauth_validation_admission [#"/workspace/crates/verified/src/oauth/completion.rs" 18 0 22 9] (started_ms: Int64.t)
  (completed_ms: Int64.t) (cache: t_Option_JwksCacheFacts) (return (x: bool)) = (! bb0
  [ bb0 = s0
    [ s0 = [ &_9 <- Int64.lt started_ms ([%#scompletion] (0: Int64.t)) ] s1
    | s1 = any [ br0 -> {_9 = false} (! bb2) | br1 -> {_9} (! bb4) ] ]
  | bb2 = s0
    [ s0 = [ &_11 <- Int64.lt completed_ms started_ms ] s1
    | s1 = any [ br0 -> {_11 = false} (! bb5) | br1 -> {_11} (! bb4) ] ]
  | bb4 = s0 [ s0 = [ &_ret <- [%#scompletion'0] false ] s1 | s1 = return {_ret} ]
  | bb5 = any [ br0 -> {cache = None} (! bb9) | br1 (x0: t_JwksCacheFacts) -> {cache = Some x0} (! bb8) ]
  | bb8 = s0
    [ s0 = elim_Some {cache} (fun (r0: t_JwksCacheFacts) -> [ &facts <- r0 ] s1)
    | s1 = [ &facts <- { facts with now_ms = completed_ms } ] s2
    | s2 = jwks_cache_admission [%#scompletion'1] {facts} (fun (_x: t_JwksCacheDecision) -> [ &_18 <- _x ] s3)
    | s3 = any [ br0 -> {_18 = Reject} (! bb11) | br1 -> {_18 = Admit} (! bb13) ] ]
  | bb11 = s0 [ s0 = [ &_ret <- false ] s1 | s1 = return {_ret} ]
  | bb13 = s0 [ s0 = [ &_ret <- true ] s1 | s1 = return {_ret} ]
  | bb9 = s0 [ s0 = [ &_ret <- [%#scompletion'2] true ] s1 | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l ()
  | & started_ms: Int64.t = started_ms
  | & completed_ms: Int64.t = completed_ms
  | & cache: t_Option_JwksCacheFacts = cache
  | & _9: bool = Any.any_l ()
  | & _11: bool = Any.any_l ()
  | & facts: t_JwksCacheFacts = Any.any_l ()
  | & _18: t_JwksCacheDecision = Any.any_l () ])
  [ return (result: bool) -> {[@stop_split] [@expl:oauth_validation_admission ensures] [%#scompletion'3] result
    = (ge_log_Int (Int64.to_int started_ms) 0
    /\ ge_log_Int (Int64.to_int completed_ms) (Int64.to_int started_ms)
    /\ match cache with
      | None -> true
      | Some facts -> ComputerDivision.mod (UInt64.t'int facts.generation_before) 2 = 0
      /\ UInt64.t'int facts.generation_before = UInt64.t'int facts.generation_after
      /\ (not facts.expiry_enabled
      \/ ge_log_Int (Int64.to_int facts.expiry_ms) 0
      /\ gt_log_Int (Int64.to_int facts.last_successful_fetch_ms) 0
      /\ ge_log_Int (Int64.to_int completed_ms) (Int64.to_int facts.last_successful_fetch_ms)
      /\ Int64.to_int completed_ms - Int64.to_int facts.last_successful_fetch_ms <= Int64.to_int facts.expiry_ms)
      end)}
    (! return {result}) ]
