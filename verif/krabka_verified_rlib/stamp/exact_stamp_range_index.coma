      {[@expl:loop invariant #2] [%#sstamp'2] forall i: int. 0 <= i /\ i < UInt64.t'int index
        -> Int64.to_int (Seq.get (Slice64.view bases) i) <> Int64.to_int target_base
        \/ Int64.to_int (Seq.get (Slice64.view lasts) i) <> Int64.to_int target_last}
