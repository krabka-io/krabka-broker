use creusot.int.UInt64
use seq.Seq
use creusot.slice.Slice64
use creusot.int.Int64
use creusot.prelude.Any
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

let len_i64 (self_: Slice64.slice Int64.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sslice] Seq.length (Slice64.view self_)
    = UInt64.t'int result}
    (! return {result}) ]

predicate no_covering_stamp_range [#"/workspace/crates/verified/src/stamp.rs" 158 0 158 93] (bases: Seq.seq Int64.t) (lasts: Seq.seq Int64.t) (count: int) (offset: int) =
  [%#sstamp'11] forall i: int. 0 <= i /\ i < count
    -> offset < Int64.to_int (Seq.get bases i) \/ Int64.to_int (Seq.get lasts i) < offset

predicate stamp_range_arrays_parallel [#"/workspace/crates/verified/src/stamp.rs" 138 0 138 72] (bases: Seq.seq Int64.t) (lasts: Seq.seq Int64.t) =
  [%#sstamp'12] Seq.length bases = Seq.length lasts

type t_Option_usize = None | Some UInt64.t

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let covering_stamp_range_index [#"/workspace/crates/verified/src/stamp.rs" 121 0 121 93] (bases: Slice64.slice Int64.t)
  (lasts: Slice64.slice Int64.t) (offset: Int64.t) (return (x: t_Option_usize)) =
{[@stop_split] [@expl:covering_stamp_range_index requires] [%#sstamp'9] stamp_range_arrays_parallel (Slice64.view bases) (Slice64.view lasts)}
  (! bb0
  [ bb0 = s0 [ s0 = [ &index <- [%#sstamp] (0: UInt64.t) ] s1 | s1 = bb1 ]
  | bb1 = bb1invariant
    [ bb1 =
      {[@expl:loop variant] well_founded_relation_Int variant_old_bb1 ([%#sstamp'0] Seq.length (Slice64.view bases)
      - UInt64.t'int index)}
      bb1invariant
    | bb1invariant = {[@expl:loop invariant #0] [%#sstamp'4] UInt64.t'int index <= Seq.length (Slice64.view bases)}
      {[@expl:loop invariant #1] [%#sstamp'3] stamp_range_arrays_parallel (Slice64.view bases) (Slice64.view lasts)}
      {[@expl:loop invariant #2] [%#sstamp'2] no_covering_stamp_range (Slice64.view bases) (Slice64.view lasts) (UInt64.t'int index) (Int64.to_int offset)}
      (! [ &variant_old_bb1 <- [%#sstamp'0] Seq.length (Slice64.view bases) - UInt64.t'int index ] s0)
      [ s0 = len_i64 [%#sstamp'1] {bases} (fun (_x: UInt64.t) -> [ &_31 <- _x ] s1)
      | s1 = [ &_29 <- UInt64.lt index _31 ] s2
      | s2 = any [ br0 -> {_29 = false} (! bb12) | br1 -> {_29} (! bb4) ] ]
      [ bb4 = s0
        [ s0 = [ &_36 <- index ] s1
        | s1 = [ &_37 <- Slice64.length bases ] s2
        | s2 = [ &_38 <- UInt64.lt _36 _37 ] s3
        | s3 = {[@expl:index in bounds] [%#sstamp'5] _38} s4
        | s4 = Slice64.get [%#sstamp'5] <Int64.t> {bases} {_36} (fun (r: Int64.t) -> [ &_35 <- r ] s5)
        | s5 = [ &_34 <- Int64.le _35 offset ] s6
        | s6 = any [ br0 -> {_34 = false} (! bb11) | br1 -> {_34} (! bb6) ] ]
      | bb6 = s0
        [ s0 = [ &_43 <- index ] s1
        | s1 = [ &_44 <- Slice64.length lasts ] s2
        | s2 = [ &_45 <- UInt64.lt _43 _44 ] s3
        | s3 = {[@expl:index in bounds] [%#sstamp'6] _45} s4
        | s4 = Slice64.get [%#sstamp'6] <Int64.t> {lasts} {_43} (fun (r: Int64.t) -> [ &_42 <- r ] s5)
        | s5 = [ &_40 <- Int64.le offset _42 ] s6
        | s6 = any [ br0 -> {_40 = false} (! bb11) | br1 -> {_40} (! bb8) ] ]
      | bb11 = s0
        [ s0 = UInt64.add [%#sstamp'8] {index} {[%#sstamp'7] (1: UInt64.t)} (fun (_x: UInt64.t) -> [ &index <- _x ] s1)
        | s1 = bb1 ] ] ]
  | bb8 = s0 [ s0 = [ &_ret <- Some index ] s1 | s1 = return {_ret} ]
  | bb12 = s0 [ s0 = [ &_ret <- None ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_Option_usize = Any.any_l ()
  | & bases: Slice64.slice Int64.t = bases
  | & lasts: Slice64.slice Int64.t = lasts
  | & offset: Int64.t = offset
  | & index: UInt64.t = Any.any_l ()
  | & _29: bool = Any.any_l ()
  | & _31: UInt64.t = Any.any_l ()
  | & _34: bool = Any.any_l ()
  | & _35: Int64.t = Any.any_l ()
  | & _36: UInt64.t = Any.any_l ()
  | & _37: UInt64.t = Any.any_l ()
  | & _38: bool = Any.any_l ()
  | & _40: bool = Any.any_l ()
  | & _42: Int64.t = Any.any_l ()
  | & _43: UInt64.t = Any.any_l ()
  | & _44: UInt64.t = Any.any_l ()
  | & _45: bool = Any.any_l ()
  | & variant_old_bb1: int = Any.any_l () ])
  [ return (result: t_Option_usize) ->
  {[@stop_split] [@expl:covering_stamp_range_index ensures] [%#sstamp'10] match result with
      | Some index -> UInt64.t'int index < Seq.length (Slice64.view bases)
      /\ Int64.to_int (Seq.get (Slice64.view bases) (UInt64.t'int index)) <= Int64.to_int offset
      /\ Int64.to_int offset <= Int64.to_int (Seq.get (Slice64.view lasts) (UInt64.t'int index))
      /\ no_covering_stamp_range (Slice64.view bases) (Slice64.view lasts) (UInt64.t'int index) (Int64.to_int offset)
      | None -> no_covering_stamp_range (Slice64.view bases) (Slice64.view lasts) (Seq.length (Slice64.view bases)) (Int64.to_int offset)
      end}
    (! return {result}) ]
