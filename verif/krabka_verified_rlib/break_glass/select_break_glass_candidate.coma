predicate lex_le [#"/workspace/crates/verified/src/break_glass.rs" 95 0 95 61] (a: tup3_i64_u64_u64) (b: tup3_i64_u64_u64) =
  [%#sbreak_glass'10] Int64.to_int a.f0 < Int64.to_int b.f0
  \/ Int64.to_int a.f0 = Int64.to_int b.f0
  /\ (UInt64.t'int a.f1 < UInt64.t'int b.f1
  \/ UInt64.t'int a.f1 = UInt64.t'int b.f1 /\ UInt64.t'int a.f2 <= UInt64.t'int b.f2)

predicate is_min_by [#"/workspace/crates/verified/src/break_glass.rs" 109 0 109 73] (keys: Seq.seq tup3_i64_u64_u64) (best: int) (len: int) =
  [%#sbreak_glass'9] 0 <= best
  /\ best < len
  /\ len <= Seq.length keys
  /\ (forall j: int. 0 <= j /\ j < len -> lex_le (Seq.get keys best) (Seq.get keys j))
  /\ (forall j: int. 0 <= j /\ j < best -> not lex_le (Seq.get keys j) (Seq.get keys best))

let elim_Some (_x: t_Option_usize) (return (f0'0: UInt64.t)) = any
