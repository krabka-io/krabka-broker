  | bb10 = s0 [ s0 = [ &_ret <- Unsigned ] s1 | s1 = return {_ret} ]
  | bb11 = s0 [ s0 = [ &_ret <- Usable ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_BreakGlassAdmission = Any.any_l ()
  | & withdrawn: bool = withdrawn
  | & consumed: bool = consumed
  | & expired: bool = expired
  | & held: UInt64.t = held
  | & required: UInt64.t = required
  | & signature_required: bool = signature_required
