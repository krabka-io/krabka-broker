    [ s0 = [ &_10 <- voters.kraft_version <> ([%#sreconfiguration] (1: UInt16.t)) ] s1
    | s1 = any [ br0 -> {_10 = false} (! bb2) | br1 -> {_10} (! bb1) ] ]
  | bb1 = s0 [ s0 = [ &_ret <- UnsupportedKraftVersion ] s1 | s1 = return {_ret} ]
  | bb2 = any
