    | br1 -> {target.membership = PresentUnknownDirectory} (! bb3)
    | br2 -> {target.membership = PresentSameDirectory} (! bb5)
    | br3 -> {target.membership = PresentOtherDirectory} (! bb3) ]
  | bb3 = s0 [ s0 = [ &_14 <- false ] s1 | s1 = bb6 ]
  | bb5 = s0 [ s0 = [ &_14 <- true ] s1 | s1 = bb6 ]
  | bb6 = any [ br0 -> {_14 = false} (! bb9) | br1 -> {_14} (! bb7) ]
  | bb7 = s0
    [ s0 = [ &_16 <- voters.voter_count = ([%#sreconfiguration'0] (1: UInt64.t)) ] s1
    | s1 = any [ br0 -> {_16 = false} (! bb10) | br1 -> {_16} (! bb9) ] ]
  | bb10 = s0
    [ s0 = UInt64.sub [%#sreconfiguration'2] {voters.voter_count} {[%#sreconfiguration'1] (1: UInt64.t)}
        (fun (_x: UInt64.t) -> [ &_20 <- _x ] s1)
    | s1 = [ &_19 <- { next_voter_count = _20;
                       next_kraft_version = voters.kraft_version;
                       write_voters = ([%#sreconfiguration'3] true);
                       write_kraft_version = ([%#sreconfiguration'4] false);
                       preflight_only = ([%#sreconfiguration'5] false) } ] s2
    | s2 = [ &_ret <- Admit _19 ] s3
    | s3 = return {_ret} ]
