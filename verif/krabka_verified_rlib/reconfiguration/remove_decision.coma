  [ & _ret: t_VoterReconfigurationDecision = Any.any_l ()
  | & voters: t_CurrentVoterSet = voters
  | & target: t_TargetVoter = target
  | & _10: bool = Any.any_l ()
  | & _14: bool = Any.any_l ()
  | & _16: bool = Any.any_l ()
  | & _19: t_VoterReconfigurationPlan = Any.any_l ()
  | & _20: UInt64.t = Any.any_l () ])
  [ return (result: t_VoterReconfigurationDecision) ->
  {[@stop_split] [@expl:remove_decision ensures] [%#sreconfiguration'7] match result with
      | Admit plan -> UInt16.t'int voters.kraft_version = 1
      /\ voter_set_removes target.membership voters /\ admitted_plan voters (Remove) plan
