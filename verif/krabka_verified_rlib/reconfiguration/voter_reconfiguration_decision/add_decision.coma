use creusot.int.UInt64
use creusot.int.UInt16
use creusot.prelude.Any
use int.Int

type t_CurrentVoterSet = {
  voter_count: UInt64.t;
  kraft_version: UInt16.t;
  latest_controls_committed: bool;
  all_voters_support_requested: bool }

type t_VoterReconfigurationPlan = {
  next_voter_count: UInt64.t;
  next_kraft_version: UInt16.t;
  write_voters: bool;
  write_kraft_version: bool;
  preflight_only: bool }

type t_VoterReconfigurationDecision =
  | NotLeader
  | InProgress
  | EpochUncommitted
  | EmptyCurrentVoterSet
  | UnsupportedKraftVersion
  | DuplicateVoter
  | IncompatibleVoter
  | VoterNotCaughtUp
  | VoterNotFound
  | DirectoryMismatch
  | InvalidVersionTransition
  | Admit t_VoterReconfigurationPlan

type t_TargetMembership = Absent | PresentUnknownDirectory | PresentSameDirectory | PresentOtherDirectory

type t_TargetVoter = { membership: t_TargetMembership; version_compatible: bool; caught_up: bool }

type t_Option_usize = None | Some UInt64.t

constant const_MIN: UInt64.t = (0: UInt64.t)

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

let checked_add (self_: UInt64.t) (rhs: UInt64.t) (return (x: t_Option_usize)) = any
  [ return (result: t_Option_usize) ->
  {[@stop_split] [@expl:checked_add ensures] ([@stop_split] [@expl:checked_add ensures #0] [%#snum] (result = None)
      = (UInt64.t'int self_ + UInt64.t'int rhs < UInt64.t'int const_MIN
      \/ gt_log_Int (UInt64.t'int self_ + UInt64.t'int rhs) (UInt64.t'int const_MAX)))
    /\ ([@stop_split] [@expl:checked_add ensures #1] [%#snum'0] forall r: UInt64.t. result = Some r
      -> UInt64.t'int r = UInt64.t'int self_ + UInt64.t'int rhs)}
    (! return {result}) ]

let elim_Some (_x: t_Option_usize) (return (f0: UInt64.t)) = any
  [ _k (f0: UInt64.t) -> {Some f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
      | _ -> false
      end}
    any) ]

predicate decision_voter_set_valid [#"/workspace/crates/verified/src/reconfiguration/voter_reconfiguration_decision.rs" 223 0 223 60] (voters: t_CurrentVoterSet) =
  [%#svoter_reconfiguration_decision'7] gt_log_Int (UInt64.t'int voters.voter_count) 0
  /\ UInt16.t'int voters.kraft_version <= 1

type t_VoterChangeKind = Add | Remove | Update | FinalizeKraftVersion

predicate admitted_plan [#"/workspace/crates/verified/src/reconfiguration/admitted_plan.rs" 158 0 162 9] (voters: t_CurrentVoterSet) (kind: t_VoterChangeKind) (plan: t_VoterReconfigurationPlan) =
  [%#sadmitted_plan] match kind with
    | Add -> UInt64.t'int plan.next_voter_count = UInt64.t'int voters.voter_count + 1
    /\ plan.next_kraft_version = voters.kraft_version
    /\ plan.write_voters /\ not plan.write_kraft_version /\ not plan.preflight_only
    | Remove -> UInt64.t'int plan.next_voter_count + 1 = UInt64.t'int voters.voter_count
    /\ plan.next_kraft_version = voters.kraft_version
    /\ plan.write_voters /\ not plan.write_kraft_version /\ not plan.preflight_only
    | Update -> plan.next_voter_count = voters.voter_count
    /\ plan.next_kraft_version = voters.kraft_version
    /\ plan.write_voters = (UInt16.t'int voters.kraft_version <> 0)
    /\ not plan.write_kraft_version /\ plan.preflight_only = (UInt16.t'int voters.kraft_version = 0)
    | FinalizeKraftVersion -> plan.next_voter_count = voters.voter_count
    /\ UInt16.t'int plan.next_kraft_version = 1
    /\ plan.write_voters /\ plan.write_kraft_version /\ not plan.preflight_only
    end

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let add_decision [#"/workspace/crates/verified/src/reconfiguration/voter_reconfiguration_decision.rs" 104 0 104 93]
  (voters: t_CurrentVoterSet) (target: t_TargetVoter) (return (x: t_VoterReconfigurationDecision)) =
{[@stop_split] [@expl:add_decision requires] [%#svoter_reconfiguration_decision'5] decision_voter_set_valid voters}
  (! bb0
  [ bb0 = s0
    [ s0 = [ &_11 <- voters.kraft_version <> ([%#svoter_reconfiguration_decision] (1: UInt16.t)) ] s1
    | s1 = any [ br0 -> {_11 = false} (! bb2) | br1 -> {_11} (! bb1) ] ]
  | bb1 = s0 [ s0 = [ &_ret <- UnsupportedKraftVersion ] s1 | s1 = return {_ret} ]
  | bb2 = any
    [ br0 -> {target.membership = Absent} (! bb5)
    | br1 -> {target.membership = PresentUnknownDirectory} (! bb3)
    | br2 -> {target.membership = PresentSameDirectory} (! bb3)
    | br3 -> {target.membership = PresentOtherDirectory} (! bb3) ]
  | bb3 = s0 [ s0 = [ &_15 <- false ] s1 | s1 = bb6 ]
  | bb5 = s0 [ s0 = [ &_15 <- true ] s1 | s1 = bb6 ]
  | bb6 = any [ br0 -> {_15 = false} (! bb7) | br1 -> {_15} (! bb8) ]
  | bb8 = any [ br0 -> {target.version_compatible = false} (! bb10) | br1 -> {target.version_compatible} (! bb9) ]
  | bb9 = any [ br0 -> {target.caught_up = false} (! bb12) | br1 -> {target.caught_up} (! bb11) ]
  | bb11 = s0
    [ s0 = checked_add [%#svoter_reconfiguration_decision'1] {voters.voter_count}
        {[%#svoter_reconfiguration_decision'0] (1: UInt64.t)} (fun (_x: t_Option_usize) -> [ &_26 <- _x ] s1)
    | s1 = any [ br0 -> {_26 = None} (! bb16) | br1 (x0: UInt64.t) -> {_26 = Some x0} (! bb15) ] ]
  | bb16 = s0 [ s0 = [ &_ret <- InvalidVersionTransition ] s1 | s1 = return {_ret} ]
  | bb15 = s0
    [ s0 = elim_Some {_26} (fun (r0: UInt64.t) -> [ &next_voter_count'0 <- r0 ] s1)
    | s1 = [ &_29 <- { next_voter_count = next_voter_count'0;
                       next_kraft_version = voters.kraft_version;
                       write_voters = ([%#svoter_reconfiguration_decision'2] true);
                       write_kraft_version = ([%#svoter_reconfiguration_decision'3] false);
                       preflight_only = ([%#svoter_reconfiguration_decision'4] false) } ] s2
    | s2 = [ &_ret <- Admit _29 ] s3
    | s3 = return {_ret} ]
  | bb12 = s0 [ s0 = [ &_ret <- VoterNotCaughtUp ] s1 | s1 = return {_ret} ]
  | bb10 = s0 [ s0 = [ &_ret <- IncompatibleVoter ] s1 | s1 = return {_ret} ]
  | bb7 = s0 [ s0 = [ &_ret <- DuplicateVoter ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_VoterReconfigurationDecision = Any.any_l ()
  | & voters: t_CurrentVoterSet = voters
  | & target: t_TargetVoter = target
  | & _11: bool = Any.any_l ()
  | & _15: bool = Any.any_l ()
  | & next_voter_count'0: UInt64.t = Any.any_l ()
  | & _26: t_Option_usize = Any.any_l ()
  | & _29: t_VoterReconfigurationPlan = Any.any_l () ])
  [ return (result: t_VoterReconfigurationDecision) ->
  {[@stop_split] [@expl:add_decision ensures] [%#svoter_reconfiguration_decision'6] match result with
      | Admit plan -> UInt16.t'int voters.kraft_version = 1
      /\ target.membership = Absent
      /\ target.version_compatible
      /\ target.caught_up /\ UInt64.t'int voters.voter_count < UInt64.t'int const_MAX /\ admitted_plan voters (Add) plan
