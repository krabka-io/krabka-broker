use creusot.int.UInt64
use creusot.int.UInt16
use creusot.prelude.Any
use int.Int

type t_CurrentVoterSet = {
  voter_count: UInt64.t;
  kraft_version: UInt16.t;
  latest_controls_committed: bool;
  all_voters_support_requested: bool }

type t_VoterChangeKind = Add | Remove | Update | FinalizeKraftVersion

type t_VoterChangeRequest = { kind: t_VoterChangeKind; requested_kraft_version: UInt16.t }

type t_VoterReconfigurationPlan = {
  next_voter_count: UInt64.t;
  next_kraft_version: UInt16.t;
  write_voters: bool;
  write_kraft_version: bool;
  preflight_only: bool }

type t_VoterReconfigurationDecision =
  | NotLeader
  | InProgress
  | EpochUncommitted
  | EmptyCurrentVoterSet
  | UnsupportedKraftVersion
  | DuplicateVoter
  | IncompatibleVoter
  | VoterNotCaughtUp
  | VoterNotFound
  | DirectoryMismatch
  | InvalidVersionTransition
  | Admit t_VoterReconfigurationPlan

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

predicate admitted_plan [#"/workspace/crates/verified/src/reconfiguration/admitted_plan.rs" 171 0 175 9] (voters: t_CurrentVoterSet) (kind'0: t_VoterChangeKind) (plan: t_VoterReconfigurationPlan) =
  [%#sadmitted_plan] match kind'0 with
    | Add -> UInt64.t'int plan.next_voter_count = UInt64.t'int voters.voter_count + 1
    /\ plan.next_kraft_version = voters.kraft_version
    /\ plan.write_voters /\ not plan.write_kraft_version /\ not plan.preflight_only
    | Remove -> UInt64.t'int plan.next_voter_count + 1 = UInt64.t'int voters.voter_count
    /\ plan.next_kraft_version = voters.kraft_version
    /\ plan.write_voters /\ not plan.write_kraft_version /\ not plan.preflight_only
    | Update -> plan.next_voter_count = voters.voter_count
    /\ plan.next_kraft_version = voters.kraft_version
    /\ plan.write_voters = (UInt16.t'int voters.kraft_version <> 0)
    /\ not plan.write_kraft_version /\ plan.preflight_only = (UInt16.t'int voters.kraft_version = 0)
    | FinalizeKraftVersion -> plan.next_voter_count = voters.voter_count
    /\ UInt16.t'int plan.next_kraft_version = 1
    /\ plan.write_voters /\ plan.write_kraft_version /\ not plan.preflight_only
    end

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let finalize_decision [#"/workspace/crates/verified/src/reconfiguration/voter_reconfiguration_decision.rs" 201 0 204 33]
  (voters: t_CurrentVoterSet) (request: t_VoterChangeRequest) (return (x: t_VoterReconfigurationDecision)) =
{[@stop_split] [@expl:finalize_decision requires] [%#svoter_reconfiguration_decision'5] gt_log_Int (UInt64.t'int voters.voter_count) 0}
  (! bb0
  [ bb0 = s0
    [ s0 = [ &_9 <- voters.kraft_version <> ([%#svoter_reconfiguration_decision] (0: UInt16.t)) ] s1
    | s1 = any [ br0 -> {_9 = false} (! bb2) | br1 -> {_9} (! bb4) ] ]
  | bb2 = s0
    [ s0 = [ &_11 <- request.requested_kraft_version <> ([%#svoter_reconfiguration_decision'0] (1: UInt16.t)) ] s1
    | s1 = any [ br0 -> {_11 = false} (! bb5) | br1 -> {_11} (! bb4) ] ]
  | bb4 = s0 [ s0 = [ &_ret <- InvalidVersionTransition ] s1 | s1 = return {_ret} ]
  | bb5 = any
    [ br0 -> {voters.all_voters_support_requested = false} (! bb7)
    | br1 -> {voters.all_voters_support_requested} (! bb6) ]
  | bb6 = s0
    [ s0 = [ &_17 <- { next_voter_count = voters.voter_count;
                       next_kraft_version = ([%#svoter_reconfiguration_decision'1] (1: UInt16.t));
                       write_voters = ([%#svoter_reconfiguration_decision'2] true);
                       write_kraft_version = ([%#svoter_reconfiguration_decision'3] true);
                       preflight_only = ([%#svoter_reconfiguration_decision'4] false) } ] s1
    | s1 = [ &_ret <- Admit _17 ] s2
    | s2 = return {_ret} ]
  | bb7 = s0 [ s0 = [ &_ret <- IncompatibleVoter ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_VoterReconfigurationDecision = Any.any_l ()
  | & voters: t_CurrentVoterSet = voters
  | & request: t_VoterChangeRequest = request
  | & _9: bool = Any.any_l ()
  | & _11: bool = Any.any_l ()
  | & _17: t_VoterReconfigurationPlan = Any.any_l () ])
  [ return (result: t_VoterReconfigurationDecision) ->
  {[@stop_split] [@expl:finalize_decision ensures] [%#svoter_reconfiguration_decision'6] match result with
      | Admit plan -> UInt16.t'int voters.kraft_version = 0
      /\ UInt16.t'int request.requested_kraft_version = 1
      /\ voters.all_voters_support_requested /\ admitted_plan voters (FinalizeKraftVersion) plan
      | InvalidVersionTransition -> UInt16.t'int voters.kraft_version <> 0
      \/ UInt16.t'int request.requested_kraft_version <> 1
      | IncompatibleVoter -> UInt16.t'int voters.kraft_version = 0
      /\ UInt16.t'int request.requested_kraft_version = 1 /\ not voters.all_voters_support_requested
      | _ -> false
      end}
    (! return {result}) ]
