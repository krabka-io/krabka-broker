  [ bb0 = any [ br0 -> {leadership.is_leader = false} (! bb1) | br1 -> {leadership.is_leader} (! bb2) ]
  | bb2 = any [ br0 -> {leadership.no_pending_change = false} (! bb4) | br1 -> {leadership.no_pending_change} (! bb3) ]
