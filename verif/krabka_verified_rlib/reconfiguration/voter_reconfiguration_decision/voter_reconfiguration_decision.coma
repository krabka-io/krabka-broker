use creusot.int.UInt64
use creusot.int.UInt16
use creusot.prelude.Any
use int.Int

type t_ReconfigurationLeadership = { is_leader: bool; no_pending_change: bool; epoch_committed: bool }

type t_CurrentVoterSet = {
  voter_count: UInt64.t;
  kraft_version: UInt16.t;
  latest_controls_committed: bool;
  all_voters_support_requested: bool }

type t_VoterReconfigurationPlan = {
  next_voter_count: UInt64.t;
  next_kraft_version: UInt16.t;
  write_voters: bool;
  write_kraft_version: bool;
  preflight_only: bool }

type t_VoterReconfigurationDecision =
  | NotLeader
  | InProgress
  | EpochUncommitted
  | EmptyCurrentVoterSet
  | UnsupportedKraftVersion
  | DuplicateVoter
  | IncompatibleVoter
  | VoterNotCaughtUp
  | VoterNotFound
  | DirectoryMismatch
  | InvalidVersionTransition
  | Admit t_VoterReconfigurationPlan

type t_VoterChangeKind = Add | Remove | Update | FinalizeKraftVersion

type t_VoterChangeRequest = { kind: t_VoterChangeKind; requested_kraft_version: UInt16.t }

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

predicate admitted_plan [#"/workspace/crates/verified/src/reconfiguration/admitted_plan.rs" 170 0 174 9] (voters: t_CurrentVoterSet) (kind'0: t_VoterChangeKind) (plan: t_VoterReconfigurationPlan) =
  [%#sadmitted_plan'0] match kind'0 with
    | Add -> UInt64.t'int plan.next_voter_count = UInt64.t'int voters.voter_count + 1
    /\ plan.next_kraft_version = voters.kraft_version
    /\ plan.write_voters /\ not plan.write_kraft_version /\ not plan.preflight_only
    | Remove -> UInt64.t'int plan.next_voter_count + 1 = UInt64.t'int voters.voter_count
    /\ plan.next_kraft_version = voters.kraft_version
    /\ plan.write_voters /\ not plan.write_kraft_version /\ not plan.preflight_only
    | Update -> plan.next_voter_count = voters.voter_count
    /\ plan.next_kraft_version = voters.kraft_version
    /\ plan.write_voters = (UInt16.t'int voters.kraft_version <> 0)
    /\ not plan.write_kraft_version /\ plan.preflight_only = (UInt16.t'int voters.kraft_version = 0)
    | FinalizeKraftVersion -> plan.next_voter_count = voters.voter_count
    /\ UInt16.t'int plan.next_kraft_version = 1
    /\ plan.write_voters /\ plan.write_kraft_version /\ not plan.preflight_only
    end

let finalize_decision (voters: t_CurrentVoterSet) (request: t_VoterChangeRequest)
  (return (x: t_VoterReconfigurationDecision)) =
{[@stop_split] [@expl:finalize_decision requires] [%#svoter_reconfiguration_decision'8] gt_log_Int (UInt64.t'int voters.voter_count) 0}
  any
  [ return (result: t_VoterReconfigurationDecision) ->
  {[@stop_split] [@expl:finalize_decision ensures] [%#svoter_reconfiguration_decision'9] match result with
      | Admit plan -> UInt16.t'int voters.kraft_version = 0
      /\ UInt16.t'int request.requested_kraft_version = 1
      /\ voters.all_voters_support_requested /\ admitted_plan voters (FinalizeKraftVersion) plan
      | InvalidVersionTransition -> UInt16.t'int voters.kraft_version <> 0
      \/ UInt16.t'int request.requested_kraft_version <> 1
      | IncompatibleVoter -> UInt16.t'int voters.kraft_version = 0
      /\ UInt16.t'int request.requested_kraft_version = 1 /\ not voters.all_voters_support_requested
      | _ -> false
      end}
    (! return {result}) ]

type t_TargetMembership = Absent | PresentUnknownDirectory | PresentSameDirectory | PresentOtherDirectory

type t_TargetVoter = { membership: t_TargetMembership; version_compatible: bool; caught_up: bool }

predicate update_key_matches [#"/workspace/crates/verified/src/reconfiguration/admitted_plan.rs" 67 0 67 63] (membership'0: t_TargetMembership) =
  [%#sadmitted_plan'3] membership'0 = PresentUnknownDirectory \/ membership'0 = PresentSameDirectory

let update_decision (voters: t_CurrentVoterSet) (target: t_TargetVoter) (return (x: t_VoterReconfigurationDecision)) =
{[@stop_split] [@expl:update_decision requires] [%#svoter_reconfiguration_decision'10] gt_log_Int (UInt64.t'int voters.voter_count) 0
  /\ UInt16.t'int voters.kraft_version <= 1}
  any
  [ return (result: t_VoterReconfigurationDecision) ->
  {[@stop_split] [@expl:update_decision ensures] [%#svoter_reconfiguration_decision'11] match result with
      | Admit plan -> target.version_compatible
      /\ update_key_matches target.membership /\ admitted_plan voters (Update) plan
      | IncompatibleVoter -> not target.version_compatible
      | VoterNotFound -> target.version_compatible /\ target.membership = Absent
      | DirectoryMismatch -> target.version_compatible
      /\ target.membership <> Absent /\ not update_key_matches target.membership
      | _ -> false
      end}
    (! return {result}) ]

predicate voter_set_removes [#"/workspace/crates/verified/src/reconfiguration/admitted_plan.rs" 48 0 48 87] (membership'0: t_TargetMembership) (voters: t_CurrentVoterSet) =
  [%#sadmitted_plan'4] membership'0 = PresentSameDirectory /\ gt_log_Int (UInt64.t'int voters.voter_count) 1

let remove_decision (voters: t_CurrentVoterSet) (target: t_TargetVoter) (return (x: t_VoterReconfigurationDecision)) =
{[@stop_split] [@expl:remove_decision requires] [%#svoter_reconfiguration_decision'12] gt_log_Int (UInt64.t'int voters.voter_count) 0
  /\ UInt16.t'int voters.kraft_version <= 1}
  any
  [ return (result: t_VoterReconfigurationDecision) ->
  {[@stop_split] [@expl:remove_decision ensures] [%#svoter_reconfiguration_decision'13] match result with
      | Admit plan -> UInt16.t'int voters.kraft_version = 1
      /\ voter_set_removes target.membership voters /\ admitted_plan voters (Remove) plan
      | UnsupportedKraftVersion -> UInt16.t'int voters.kraft_version <> 1
      | VoterNotFound -> UInt16.t'int voters.kraft_version = 1 /\ not voter_set_removes target.membership voters
      | _ -> false
      end}
    (! return {result}) ]

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

let add_decision (voters: t_CurrentVoterSet) (target: t_TargetVoter) (return (x: t_VoterReconfigurationDecision)) =
{[@stop_split] [@expl:add_decision requires] [%#svoter_reconfiguration_decision'14] gt_log_Int (UInt64.t'int voters.voter_count) 0
  /\ UInt16.t'int voters.kraft_version <= 1}
  any
  [ return (result: t_VoterReconfigurationDecision) ->
  {[@stop_split] [@expl:add_decision ensures] [%#svoter_reconfiguration_decision'15] match result with
      | Admit plan -> UInt16.t'int voters.kraft_version = 1
      /\ target.membership = Absent
      /\ target.version_compatible
      /\ target.caught_up /\ UInt64.t'int voters.voter_count < UInt64.t'int const_MAX /\ admitted_plan voters (Add) plan
      | UnsupportedKraftVersion -> UInt16.t'int voters.kraft_version <> 1
      | DuplicateVoter -> UInt16.t'int voters.kraft_version = 1 /\ target.membership <> Absent
      | IncompatibleVoter -> UInt16.t'int voters.kraft_version = 1
      /\ target.membership = Absent /\ not target.version_compatible
      | VoterNotCaughtUp -> UInt16.t'int voters.kraft_version = 1
      /\ target.membership = Absent /\ target.version_compatible /\ not target.caught_up
      | InvalidVersionTransition -> UInt16.t'int voters.kraft_version = 1
      /\ target.membership = Absent
      /\ target.version_compatible /\ target.caught_up /\ UInt64.t'int voters.voter_count = UInt64.t'int const_MAX
      | _ -> false
      end}
    (! return {result}) ]

type t_Option_VoterReconfigurationDecision = None | Some t_VoterReconfigurationDecision

function voter_reconfiguration_rejection [#"/workspace/crates/verified/src/reconfiguration/admitted_plan.rs" 92 0 97 41] (leadership: t_ReconfigurationLeadership) (voters: t_CurrentVoterSet) (request: t_VoterChangeRequest) (target: t_TargetVoter) : t_Option_VoterReconfigurationDecision
 = [%#sadmitted_plan] if not leadership.is_leader then
    Some (NotLeader)
  else
    if not leadership.no_pending_change then
      Some (InProgress)
    else
      if not leadership.epoch_committed then
        Some (EpochUncommitted)
      else
        if not voters.latest_controls_committed then
          Some (InProgress)
        else
          if UInt64.t'int voters.voter_count = 0 then
            Some (EmptyCurrentVoterSet)
          else
            if gt_log_Int (UInt16.t'int voters.kraft_version) 1 then
              Some (InvalidVersionTransition)
            else
              match request.kind with
                | Add -> if UInt16.t'int voters.kraft_version <> 1 then
                  Some (UnsupportedKraftVersion)
                else
                  if target.membership <> Absent then
                    Some (DuplicateVoter)
                  else
                    if not target.version_compatible then
                      Some (IncompatibleVoter)
                    else
                      if not target.caught_up then
                        Some (VoterNotCaughtUp)
                      else
                        if UInt64.t'int voters.voter_count = UInt64.t'int const_MAX then
                          Some (InvalidVersionTransition)
                        else
                          None





                | Remove -> if UInt16.t'int voters.kraft_version <> 1 then
                  Some (UnsupportedKraftVersion)
                else
                  if not voter_set_removes target.membership voters then Some (VoterNotFound) else None

                | Update -> if not target.version_compatible then
                  Some (IncompatibleVoter)
                else
                  if target.membership = Absent then
                    Some (VoterNotFound)
                  else
                    if not update_key_matches target.membership then Some (DirectoryMismatch) else None


                | FinalizeKraftVersion -> if UInt16.t'int voters.kraft_version <> 0
                \/ UInt16.t'int request.requested_kraft_version <> 1 then
                  Some (InvalidVersionTransition)
                else
                  if not voters.all_voters_support_requested then Some (IncompatibleVoter) else None

                end







predicate is_admit [#"/workspace/crates/verified/src/reconfiguration/admitted_plan.rs" 30 0 30 63] (decision: t_VoterReconfigurationDecision) =
  [%#sadmitted_plan'1] match decision with
    | Admit _ -> true
    | _ -> false
    end

predicate may_reconfigure [#"/workspace/crates/verified/src/reconfiguration/admitted_plan.rs" 16 0 16 94] (leadership: t_ReconfigurationLeadership) (voters: t_CurrentVoterSet) =
  [%#sadmitted_plan'2] leadership.is_leader
  /\ leadership.no_pending_change /\ leadership.epoch_committed /\ voters.latest_controls_committed

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

