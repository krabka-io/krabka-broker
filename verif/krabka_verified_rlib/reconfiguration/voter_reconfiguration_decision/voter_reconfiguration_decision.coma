  | bb12 = any
    [ br0 -> {request.kind = Add} (! bb20)
    | br1 -> {request.kind = Remove} (! bb19)
    | br2 -> {request.kind = Update} (! bb18)
    | br3 -> {request.kind = FinalizeKraftVersion} (! bb17) ]
  | bb17 = s0
    [ s0 = finalize_decision [%#svoter_reconfiguration_decision'1] {voters} {request}
        (fun (_x: t_VoterReconfigurationDecision) -> [ &_ret <- _x ] s1)
    | s1 = return {_ret} ]
  | bb18 = s0
