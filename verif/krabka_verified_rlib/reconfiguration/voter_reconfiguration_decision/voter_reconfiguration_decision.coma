    | s1 = return {_ret} ]
  | bb8 = s0 [ s0 = [ &_ret <- InProgress ] s1 | s1 = return {_ret} ]
  | bb6 = s0 [ s0 = [ &_ret <- EpochUncommitted ] s1 | s1 = return {_ret} ]
  | bb4 = s0 [ s0 = [ &_ret <- InProgress ] s1 | s1 = return {_ret} ]
  | bb1 = s0 [ s0 = [ &_ret <- NotLeader ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_VoterReconfigurationDecision = Any.any_l ()
  | & leadership: t_ReconfigurationLeadership = leadership
  | & voters: t_CurrentVoterSet = voters
  | & request: t_VoterChangeRequest = request
  | & target: t_TargetVoter = target
  | & _27: bool = Any.any_l ()
  | & _31: bool = Any.any_l () ])
  [ return (result: t_VoterReconfigurationDecision) ->
