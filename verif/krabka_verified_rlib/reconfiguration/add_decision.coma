use creusot.int.UInt64
use creusot.int.UInt16
use creusot.prelude.Any
use int.Int

type t_CurrentVoterSet = {
  voter_count: UInt64.t;
  kraft_version: UInt16.t;
  latest_controls_committed: bool;
  all_voters_support_requested: bool }

type t_VoterReconfigurationPlan = {
  next_voter_count: UInt64.t;
  next_kraft_version: UInt16.t;
  write_voters: bool;
  write_kraft_version: bool;
  preflight_only: bool }

type t_VoterReconfigurationDecision =
  | NotLeader
  | InProgress
  | EpochUncommitted
  | EmptyCurrentVoterSet
  | UnsupportedKraftVersion
  | DuplicateVoter
  | IncompatibleVoter
  | VoterNotCaughtUp
  | VoterNotFound
  | DirectoryMismatch
  | InvalidVersionTransition
  | Admit t_VoterReconfigurationPlan

type t_TargetMembership = Absent | PresentUnknownDirectory | PresentSameDirectory | PresentOtherDirectory

type t_TargetVoter = { membership: t_TargetMembership; version_compatible: bool; caught_up: bool }

type t_Option_usize = None | Some UInt64.t

constant const_MIN: UInt64.t = (0: UInt64.t)

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

let checked_add (self_: UInt64.t) (rhs: UInt64.t) (return (x: t_Option_usize)) = any
