      \/ gt_log_Int (UInt64.t'int self_ + UInt64.t'int rhs) (UInt64.t'int const_MAX)))
    /\ ([@stop_split] [@expl:checked_add ensures #1] [%#snum'0] forall r: UInt64.t. result = Some r
      -> UInt64.t'int r = UInt64.t'int self_ + UInt64.t'int rhs)}
    (! return {result}) ]

let elim_Some (_x: t_Option_usize) (return (f0: UInt64.t)) = any
  [ _k (f0: UInt64.t) -> {Some f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
      | _ -> false
      end}
    any) ]

type t_VoterChangeKind = Add | Remove | Update | FinalizeKraftVersion

predicate admitted_plan [#"/workspace/crates/verified/src/reconfiguration.rs" 277 0 281 9] (voters: t_CurrentVoterSet) (kind: t_VoterChangeKind) (plan: t_VoterReconfigurationPlan) =
  [%#sreconfiguration'7] match kind with
    | Add -> UInt64.t'int plan.next_voter_count = UInt64.t'int voters.voter_count + 1
    /\ plan.next_kraft_version = voters.kraft_version
    /\ plan.write_voters /\ not plan.write_kraft_version /\ not plan.preflight_only
    | Remove -> UInt64.t'int plan.next_voter_count + 1 = UInt64.t'int voters.voter_count
    /\ plan.next_kraft_version = voters.kraft_version
    /\ plan.write_voters /\ not plan.write_kraft_version /\ not plan.preflight_only
    | Update -> plan.next_voter_count = voters.voter_count
    /\ plan.next_kraft_version = voters.kraft_version
    /\ plan.write_voters = (UInt16.t'int voters.kraft_version <> 0)
    /\ not plan.write_kraft_version /\ plan.preflight_only = (UInt16.t'int voters.kraft_version = 0)
    | FinalizeKraftVersion -> plan.next_voter_count = voters.voter_count
    /\ UInt16.t'int plan.next_kraft_version = 1
    /\ plan.write_voters /\ plan.write_kraft_version /\ not plan.preflight_only
    end

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

