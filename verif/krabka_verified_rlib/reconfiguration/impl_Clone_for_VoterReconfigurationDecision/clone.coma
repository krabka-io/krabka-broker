  (self: t_VoterReconfigurationDecision) (return (x: t_VoterReconfigurationDecision)) = (! bb0
  [ bb0 = s0 [ s0 = [ &_ret <- self ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_VoterReconfigurationDecision = Any.any_l () | & self: t_VoterReconfigurationDecision = self ])
  [ return (result: t_VoterReconfigurationDecision) -> (! return {result}) ]
