(* #"/workspace/crates/verified/src/vote.rs" 159 0 162 26 *)

let%span svote = "/workspace/crates/verified/src/vote.rs" 144 10 145 74
let%span svote'0 = "/workspace/crates/verified/src/vote.rs" 146 10 151 1
let%span svote'1 = "/workspace/crates/verified/src/vote.rs" 152 10 157 1

use creusot.int.UInt64
use creusot.prelude.Any

type t_VoteTarget = { voter_id: UInt64.t; local_id: UInt64.t; directory_matches: bool }

type t_VoteMembership = { cluster_matches: bool; local_is_voter: bool; candidate_is_voter: bool }

type t_VoteAdmissionDecision = IgnoreWrongTarget | Deny | Consider

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let vote_admission_decision [#"/workspace/crates/verified/src/vote.rs" 159 0 162 26] (target: t_VoteTarget)
  (membership: t_VoteMembership) (return (x: t_VoteAdmissionDecision)) = (! bb0
  [ bb0 = s0
    [ s0 = [ &_21 <- target.voter_id <> target.local_id ] s1
    | s1 = any [ br0 -> {_21 = false} (! bb2) | br1 -> {_21} (! bb3) ] ]
  | bb2 = any [ br0 -> {target.directory_matches = false} (! bb3) | br1 -> {target.directory_matches} (! bb4) ]
  | bb4 = any [ br0 -> {membership.cluster_matches = false} (! bb7) | br1 -> {membership.cluster_matches} (! bb5) ]
  | bb5 = any [ br0 -> {membership.local_is_voter = false} (! bb7) | br1 -> {membership.local_is_voter} (! bb6) ]
  | bb6 = any
    [ br0 -> {membership.candidate_is_voter = false} (! bb7) | br1 -> {membership.candidate_is_voter} (! bb8) ]
  | bb8 = s0 [ s0 = [ &_ret <- Consider ] s1 | s1 = return {_ret} ]
  | bb7 = s0 [ s0 = [ &_ret <- Deny ] s1 | s1 = return {_ret} ]
  | bb3 = s0 [ s0 = [ &_ret <- IgnoreWrongTarget ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_VoteAdmissionDecision = Any.any_l ()
  | & target: t_VoteTarget = target
  | & membership: t_VoteMembership = membership
  | & _21: bool = Any.any_l () ])
  [ return (result: t_VoteAdmissionDecision) ->
  {[@stop_split] [@expl:vote_admission_decision ensures] ([@stop_split] [@expl:vote_admission_decision ensures #0] [%#svote] (result
        = IgnoreWrongTarget)
      = (UInt64.t'int target.voter_id <> UInt64.t'int target.local_id \/ not target.directory_matches))
    /\ ([@stop_split] [@expl:vote_admission_decision ensures #1] [%#svote'0] (result = Deny)
      = (UInt64.t'int target.voter_id = UInt64.t'int target.local_id
      /\ target.directory_matches
      /\ (not membership.cluster_matches \/ not membership.local_is_voter \/ not membership.candidate_is_voter)))
    /\ ([@stop_split] [@expl:vote_admission_decision ensures #2] [%#svote'1] (result = Consider)
    = (UInt64.t'int target.voter_id = UInt64.t'int target.local_id
    /\ target.directory_matches
    /\ membership.cluster_matches /\ membership.local_is_voter /\ membership.candidate_is_voter))}
    (! return {result}) ]
