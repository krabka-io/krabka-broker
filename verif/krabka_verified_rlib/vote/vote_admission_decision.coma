let%span svote = "/home/matt/.codex/worktrees/e9db/krabka-broker/crates/verified/src/vote.rs" 92 10 93 60
let%span svote'0 = "/home/matt/.codex/worktrees/e9db/krabka-broker/crates/verified/src/vote.rs" 94 10 97 1
let%span svote'1 = "/home/matt/.codex/worktrees/e9db/krabka-broker/crates/verified/src/vote.rs" 98 10 101 1

use creusot.prelude.Any
use creusot.int.UInt64

type t_VoteAdmissionDecision = IgnoreWrongTarget | Deny | Consider

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let vote_admission_decision [#"/home/matt/.codex/worktrees/e9db/krabka-broker/crates/verified/src/vote.rs" 107 0 114 26]
  (voter_id: UInt64.t) (local_id: UInt64.t) (target_directory_matches: bool) (cluster_matches: bool)
  (local_is_voter: bool) (candidate_is_voter: bool) (return (x: t_VoteAdmissionDecision)) = (! bb0
  [ bb0 = s0
    [ s0 = [ &_25 <- voter_id <> local_id ] s1 | s1 = any [ br0 -> {_25 = false} (! bb2) | br1 -> {_25} (! bb3) ] ]
  | bb2 = any [ br0 -> {target_directory_matches = false} (! bb3) | br1 -> {target_directory_matches} (! bb4) ]
  | bb4 = any [ br0 -> {cluster_matches = false} (! bb7) | br1 -> {cluster_matches} (! bb5) ]
  | bb5 = any [ br0 -> {local_is_voter = false} (! bb7) | br1 -> {local_is_voter} (! bb6) ]
  | bb6 = any [ br0 -> {candidate_is_voter = false} (! bb7) | br1 -> {candidate_is_voter} (! bb8) ]
  | bb8 = s0 [ s0 = [ &_ret <- Consider ] s1 | s1 = return {_ret} ]
  | bb7 = s0 [ s0 = [ &_ret <- Deny ] s1 | s1 = return {_ret} ]
  | bb3 = s0 [ s0 = [ &_ret <- IgnoreWrongTarget ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_VoteAdmissionDecision = Any.any_l ()
  | & voter_id: UInt64.t = voter_id
  | & local_id: UInt64.t = local_id
  | & target_directory_matches: bool = target_directory_matches
  | & cluster_matches: bool = cluster_matches
  | & local_is_voter: bool = local_is_voter
  | & candidate_is_voter: bool = candidate_is_voter
  | & _25: bool = Any.any_l () ])
  [ return (result: t_VoteAdmissionDecision) ->
  {[@stop_split] [@expl:vote_admission_decision ensures] ([@stop_split] [@expl:vote_admission_decision ensures #0] [%#svote] (result
        = IgnoreWrongTarget)
      = (UInt64.t'int voter_id <> UInt64.t'int local_id \/ not target_directory_matches))
    /\ ([@stop_split] [@expl:vote_admission_decision ensures #1] [%#svote'0] (result = Deny)
      = (UInt64.t'int voter_id = UInt64.t'int local_id
      /\ target_directory_matches /\ (not cluster_matches \/ not local_is_voter \/ not candidate_is_voter)))
    /\ ([@stop_split] [@expl:vote_admission_decision ensures #2] [%#svote'1] (result = Consider)
    = (UInt64.t'int voter_id = UInt64.t'int local_id
    /\ target_directory_matches /\ cluster_matches /\ local_is_voter /\ candidate_is_voter))}
    (! return {result}) ]
