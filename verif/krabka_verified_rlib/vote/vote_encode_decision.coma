  | bb6 = s0
    [ s0 = [ &_16 <- UInt32.gt last_epoch ([%#svote'2] (2147483647: UInt32.t)) ] s1
    | s1 = any [ br0 -> {_16 = false} (! bb9) | br1 -> {_16} (! bb8) ] ]
  | bb8 = s0 [ s0 = [ &_ret <- Reject ] s1 | s1 = return {_ret} ]
  | bb9 = s0 [ s0 = [ &_ret <- Accept ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_VoteEncodeDecision = Any.any_l ()
  | & voter_id: UInt64.t = voter_id
  | & candidate_id: UInt64.t = candidate_id
  | & candidate_epoch: UInt32.t = candidate_epoch
  | & last_epoch: UInt32.t = last_epoch
  | & _10: bool = Any.any_l ()
  | & _12: bool = Any.any_l ()
  | & _14: bool = Any.any_l ()
  | & _16: bool = Any.any_l () ])
  [ return (result: t_VoteEncodeDecision) -> {[@stop_split] [@expl:vote_encode_decision ensures] [%#svote'3] (result
      = Accept)
