meta "select_lsinst" "all"

let vote_encode_decision [#"/workspace/crates/verified/src/vote.rs" 48 0 53 23] (voter_id: UInt64.t)
  (candidate_id: UInt64.t) (candidate_epoch: UInt32.t) (last_epoch: UInt32.t) (return (x: t_VoteEncodeDecision)) =
(! bb0
  [ bb0 = s0
    [ s0 = [ &_10 <- UInt64.gt voter_id ([%#svote] (2147483647: UInt64.t)) ] s1
    | s1 = any [ br0 -> {_10 = false} (! bb2) | br1 -> {_10} (! bb8) ] ]
  | bb2 = s0
    [ s0 = [ &_12 <- UInt64.gt candidate_id ([%#svote'0] (2147483647: UInt64.t)) ] s1
