constant const_MAX: Int32.t = (2147483647: Int32.t)

predicate vote_fields_fit_int32 [#"/workspace/crates/verified/src/vote.rs" 28 0 33 9] (voter_id: UInt64.t) (candidate_id: UInt64.t) (candidate_epoch: UInt32.t) (last_epoch: UInt32.t) =
