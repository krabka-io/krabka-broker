(* #"/workspace/crates/verified/src/storage.rs" 112 0 112 73 *)

let%span sstorage = "/workspace/crates/verified/src/storage.rs" 110 10 110 40

use creusot.int.Int64
use creusot.prelude.Any
use int.Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let truncation_batch_retained [#"/workspace/crates/verified/src/storage.rs" 112 0 112 73] (batch_last: Int64.t)
  (cut: Int64.t) (return (x: bool)) = (! bb0
  [ bb0 = s0 [ s0 = [ &_ret <- Int64.lt batch_last cut ] s1 | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l () | & batch_last: Int64.t = batch_last | & cut: Int64.t = cut ])
  [ return (result: bool) -> {[@stop_split] [@expl:truncation_batch_retained ensures] [%#sstorage] result
    = (Int64.to_int batch_last < Int64.to_int cut)}
    (! return {result}) ]
