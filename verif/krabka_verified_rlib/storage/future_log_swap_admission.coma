let future_log_swap_admission [#"/home/matt/.codex/worktrees/e9db/krabka-broker/crates/verified/src/storage.rs" 8 0 8 81]
  (current_leo: Int64.t) (future_leo: Int64.t) (return (x: bool)) = (! bb0
  [ bb0 = s0 [ s0 = [ &_ret <- current_leo = future_leo ] s1 | s1 = return {_ret} ] ]
