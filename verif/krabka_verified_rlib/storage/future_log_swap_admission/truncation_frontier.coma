(* #"/workspace/crates/verified/src/storage/future_log_swap_admission.rs" 111 0 111 68 *)

let%span sfuture_log_swap_admission = "/workspace/crates/verified/src/storage/future_log_swap_admission.rs" 107 10 107 30
let%span sfuture_log_swap_admission'0 = "/workspace/crates/verified/src/storage/future_log_swap_admission.rs" 108 10 108 29
let%span sfuture_log_swap_admission'1 = "/workspace/crates/verified/src/storage/future_log_swap_admission.rs" 109 10 109 53

use creusot.int.Int64
use creusot.prelude.Any
use int.Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let truncation_frontier [#"/workspace/crates/verified/src/storage/future_log_swap_admission.rs" 111 0 111 68]
  (frontier: Int64.t) (new_end: Int64.t) (return (x: Int64.t)) = (! bb0
  [ bb0 = s0
    [ s0 = [ &_10 <- Int64.lt frontier new_end ] s1 | s1 = any [ br0 -> {_10 = false} (! bb2) | br1 -> {_10} (! bb1) ] ]
  | bb1 = s0 [ s0 = [ &_ret <- frontier ] s1 | s1 = return {_ret} ]
  | bb2 = s0 [ s0 = [ &_ret <- new_end ] s1 | s1 = return {_ret} ] ]
  [ & _ret: Int64.t = Any.any_l ()
  | & frontier: Int64.t = frontier
  | & new_end: Int64.t = new_end
  | & _10: bool = Any.any_l () ])
  [ return (result: Int64.t) ->
  {[@stop_split] [@expl:truncation_frontier ensures] ([@stop_split] [@expl:truncation_frontier ensures #0] [%#sfuture_log_swap_admission] Int64.to_int result
      <= Int64.to_int frontier)
    /\ ([@stop_split] [@expl:truncation_frontier ensures #1] [%#sfuture_log_swap_admission'0] Int64.to_int result
      <= Int64.to_int new_end)
    /\ ([@stop_split] [@expl:truncation_frontier ensures #2] [%#sfuture_log_swap_admission'1] Int64.to_int result
      = Int64.to_int frontier
    \/ Int64.to_int result = Int64.to_int new_end)}
    (! return {result}) ]
