function abs_diff (self: int) (other: int) : int = [%#sint] if self < other then other - self else self - other

let abs_diff'0 (self_: Int64.t) (other: Int64.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:abs_diff ensures] [%#snum] UInt64.t'int result
    = abs_diff (Int64.to_int self_) (Int64.to_int other)}
    (! return {result}) ]

constant const_MAX: UInt32.t = (4294967295: UInt32.t)

let from_u64 (small: UInt32.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:from ensures] [%#sconvert] result
    = UInt64.of_int (UInt32.t'int small)}
