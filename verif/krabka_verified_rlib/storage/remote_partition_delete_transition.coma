type tup2_Option_RemotePartitionDeleteLifecycle_RemotePartitionDeleteLifecycle = {
  f0: t_Option_RemotePartitionDeleteLifecycle;
  f1: t_RemotePartitionDeleteLifecycle }

let elim_Some (_x: t_Option_RemotePartitionDeleteLifecycle) (return (f0'0: t_RemotePartitionDeleteLifecycle)) = any
  [ _k (f0'0: t_RemotePartitionDeleteLifecycle) -> {Some f0'0 = _x} (! return {f0'0})
  | _chk -> (! {[@expl:elim Some] match _x with
