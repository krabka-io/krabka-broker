    any) ]

type tup2_RemotePartitionDeleteLifecycle_RemotePartitionDeleteLifecycle = {
  f0'0: t_RemotePartitionDeleteLifecycle;
  f1'0: t_RemotePartitionDeleteLifecycle }

predicate partition_delete_forward_edge [#"/workspace/crates/verified/src/storage.rs" 185 0 188 9] (from: t_RemotePartitionDeleteLifecycle) (to': t_RemotePartitionDeleteLifecycle) =
  [%#sstorage'0] match { f0'0 = from; f1'0 = to' } with
    | {f0'0 = Marked; f1'0 = Started} | {f0'0 = Started; f1'0 = Finished} -> true
    | _ -> false
    end

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let remote_partition_delete_transition [#"/workspace/crates/verified/src/storage.rs" 236 0 239 9]
  (from: t_Option_RemotePartitionDeleteLifecycle) (to': t_RemotePartitionDeleteLifecycle) (return (x: bool)) = (! bb0
  [ bb0 = s0
    [ s0 = [ &_6 <- { f0 = from; f1 = to' } ] s1
    | s1 = any
      [ br0 -> {_6.f0 = None} (! bb2) | br1 (x0: t_RemotePartitionDeleteLifecycle) -> {_6.f0 = Some x0} (! bb3) ] ]
  | bb3 = elim_Some {_6.f0}
      (fun (r0: t_RemotePartitionDeleteLifecycle) ->
        any [ br0 -> {r0 = Marked} (! bb4) | br1 -> {r0 = Started} (! bb5) | br2 -> {r0 = Finished} (! bb6) ])
  | bb6 = any [ br0 -> {_6.f1 = Marked} (! bb1) | br1 -> {_6.f1 = Started} (! bb1) | br2 -> {_6.f1 = Finished} (! bb8) ]
  | bb5 = any [ br0 -> {_6.f1 = Marked} (! bb1) | br1 -> {_6.f1 = Started} (! bb8) | br2 -> {_6.f1 = Finished} (! bb8) ]
  | bb4 = any [ br0 -> {_6.f1 = Marked} (! bb8) | br1 -> {_6.f1 = Started} (! bb8) | br2 -> {_6.f1 = Finished} (! bb1) ]
  | bb2 = any [ br0 -> {_6.f1 = Marked} (! bb8) | br1 -> {_6.f1 = Started} (! bb1) | br2 -> {_6.f1 = Finished} (! bb1) ]
  | bb1 = s0 [ s0 = [ &_ret <- false ] s1 | s1 = return {_ret} ]
  | bb8 = s0 [ s0 = [ &_ret <- true ] s1 | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l ()
  | & from: t_Option_RemotePartitionDeleteLifecycle = from
  | & to': t_RemotePartitionDeleteLifecycle = to'
  | & _6: tup2_Option_RemotePartitionDeleteLifecycle_RemotePartitionDeleteLifecycle = Any.any_l () ])
  [ return (result: bool) -> {[@stop_split] [@expl:remote_partition_delete_transition ensures] [%#sstorage] result
    = match from with
