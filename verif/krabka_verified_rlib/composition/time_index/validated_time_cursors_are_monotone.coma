type t_Option_i64 = None | Some Int64.t

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

constant const_MAX: UInt32.t = (4294967295: UInt32.t)

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

let restore_index_frontier (segment_base: Int64.t) (segment_end: Int64.t) (return (x: t_Option_i64)) = any
  [ return (result: t_Option_i64) ->
  {[@stop_split] [@expl:restore_index_frontier ensures] [%#srestore_producer_ids_strict] match result with
      | Some frontier -> ge_log_Int (Int64.to_int segment_base) 0
      /\ ge_log_Int (Int64.to_int segment_end) (Int64.to_int segment_base)
      /\ Int64.to_int frontier = Int64.to_int segment_end - Int64.to_int segment_base
      /\ Int64.to_int frontier <= UInt32.t'int const_MAX
      | None -> Int64.to_int segment_base < 0
      \/ Int64.to_int segment_end < Int64.to_int segment_base
      \/ gt_log_Int (Int64.to_int segment_end - Int64.to_int segment_base) (UInt32.t'int const_MAX)
      end}
    (! return {result}) ]

let elim_Some (_x: t_Option_i64) (return (f0: Int64.t)) = any
  [ _k (f0: Int64.t) -> {Some f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
      | _ -> false
      end}
    any) ]

type tup2_i64_u32 = { f0: Int64.t; f1: UInt32.t }

type t_Option_tup2_i64_u32 = None'0 | Some'0 tup2_i64_u32

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

