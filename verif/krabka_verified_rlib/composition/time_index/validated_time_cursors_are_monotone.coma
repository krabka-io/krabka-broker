  {[@stop_split] [@expl:restore_time_index_entry_valid ensures] [%#srestore_producer_ids_strict'0] result
    = (UInt32.t'int relative_offset <= Int64.to_int max_relative
    /\ match previous with
      | Some'0 {f0 = previous_timestamp; f1 = previous_relative} -> Int64.to_int previous_timestamp
        <= Int64.to_int timestamp
      /\ UInt32.t'int previous_relative < UInt32.t'int relative_offset
      | None'0 -> true
      end)}
    (! return {result}) ]

