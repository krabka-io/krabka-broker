type tup2_Option_i64_Option_i64 = { f0'0: t_Option_i64; f1'0: t_Option_i64 }

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

constant const_MAX: Int64.t = (9223372036854775807: Int64.t)

let sasl_session_expiry (now_ms: Int64.t) (credential_expiry_ms: t_Option_i64) (reauth_ms: t_Option_i64)
  (return (x: tup2_Option_i64_i64)) = any
  [ return (result: tup2_Option_i64_i64) ->
  {[@stop_split] [@expl:sasl_session_expiry ensures] ([@stop_split] [@expl:sasl_session_expiry ensures #0] [%#ssession] (result.f0
        = None)
      = (credential_expiry_ms = None
      /\ match reauth_ms with
        | None -> true
        | Some cap -> Int64.to_int cap <= 0
        end))
    /\ ([@stop_split] [@expl:sasl_session_expiry ensures #1] [%#ssession'0] match { f0'0 = credential_expiry_ms;
                                                                                    f1'0 = result.f0 } with
        | {f0'0 = Some credential; f1'0 = Some at'} -> Int64.to_int at' <= Int64.to_int credential
        | _ -> true
        end)
    /\ ([@stop_split] [@expl:sasl_session_expiry ensures #2] [%#ssession'1] match { f0'0 = reauth_ms;
                                                                                    f1'0 = result.f0 } with
        | {f0'0 = Some cap; f1'0 = Some at'} -> gt_log_Int (Int64.to_int cap) 0
        -> Int64.to_int at' <= Int64.to_int now_ms + Int64.to_int cap
        | _ -> true
        end)
    /\ ([@stop_split] [@expl:sasl_session_expiry ensures #3] [%#ssession'2] match result.f0 with
        | None -> true
        | Some at' -> credential_expiry_ms = Some at'
        \/ match reauth_ms with
          | None -> false
          | Some cap -> gt_log_Int (Int64.to_int cap) 0
          /\ (Int64.to_int at' = Int64.to_int now_ms + Int64.to_int cap \/ Int64.to_int at' = Int64.to_int const_MAX)
          end
        end)
    /\ ([@stop_split] [@expl:sasl_session_expiry ensures #4] [%#ssession'3] match result.f0 with
      | None -> Int64.to_int result.f1 = 0
      | Some at' -> Int64.to_int result.f1
      = (if Int64.to_int at' <= Int64.to_int now_ms then
        0
      else
        if gt_log_Int (Int64.to_int at' - Int64.to_int now_ms) (Int64.to_int const_MAX) then
          Int64.to_int const_MAX
        else
          Int64.to_int at' - Int64.to_int now_ms

      )
      end)}
    (! return {result}) ]

let unwrap_i64 (self_: t_Option_i64) (return (x: Int64.t)) = {[@stop_split] [@expl:unwrap requires] [%#soption] self_
  <> None}
  any
  [ return (result: Int64.t) -> {[@stop_split] [@expl:unwrap ensures] [%#soption'0] Some result = self_}
    (! return {result}) ]

type t_RequestAuthState = PreHandshake | Exchanging | Failed | Authenticated

let request_auth_admission (state: t_RequestAuthState) (api_key: Int16.t) (return (x: bool)) = any
  [ return (result: bool) ->
  {[@stop_split] [@expl:request_auth_admission ensures] ([@stop_split] [@expl:request_auth_admission ensures #0] [%#sacl_decision] state
        = Authenticated -> result)
    /\ ([@stop_split] [@expl:request_auth_admission ensures #1] [%#sacl_decision'0] state = Failed -> not result)
    /\ ([@stop_split] [@expl:request_auth_admission ensures #2] [%#sacl_decision'1] state = Exchanging
      -> result = (Int16.to_int api_key = 36))
    /\ ([@stop_split] [@expl:request_auth_admission ensures #3] [%#sacl_decision'2] state = PreHandshake
    -> result = (Int16.to_int api_key = 17 \/ Int16.to_int api_key = 18))}
    (! return {result}) ]

let session_expired_for_request (expiry_ms: t_Option_i64) (api_key: Int16.t) (now_ms: Int64.t) (return (x: bool)) = any
  [ return (result: bool) -> {[@stop_split] [@expl:session_expired_for_request ensures] [%#ssession'4] result
    = (Int16.to_int api_key <> 17
    /\ Int16.to_int api_key <> 36
    /\ match expiry_ms with
      | None -> false
      | Some at' -> Int64.to_int at' <= Int64.to_int now_ms
      end)}
    (! return {result}) ]

