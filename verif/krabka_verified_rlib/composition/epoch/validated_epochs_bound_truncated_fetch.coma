type tup2_i32_i64 = { f0: Int32.t; f1: Int64.t }

type t_Option_tup2_i32_i64 = None | Some tup2_i32_i64

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

type t_LeaderEpoch = { f0'0: Int32.t }

type t_Offset = { f0'1: Int64.t }

type t_EpochEntry = { epoch: t_LeaderEpoch; start_offset: t_Offset }

let len_EpochEntry (self_: Slice64.slice t_EpochEntry) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sslice] Seq.length (Slice64.view self_)
    = UInt64.t'int result}
    (! return {result}) ]

type t_FetchWatermarks = { log_start: Int64.t; hw: Int64.t; lso: Int64.t; log_end: Int64.t; deliverable: Int64.t }

let restore_leader_epoch_entry_valid (previous: t_Option_tup2_i32_i64) (epoch'0: Int32.t) (start_offset'0: Int64.t)
  (segment_base: Int64.t) (segment_end: Int64.t) (return (x: bool)) = any
  [ return (result: bool) ->
  {[@stop_split] [@expl:restore_leader_epoch_entry_valid ensures] [%#srestore_producer_ids_strict] result
    = (ge_log_Int (Int32.to_int epoch'0) 0
    /\ ge_log_Int (Int64.to_int segment_base) 0
    /\ Int64.to_int segment_base <= Int64.to_int start_offset'0
    /\ Int64.to_int start_offset'0 <= Int64.to_int segment_end
    /\ match previous with
      | Some {f0 = previous_epoch; f1 = previous_start} -> Int32.to_int previous_epoch < Int32.to_int epoch'0
      /\ Int64.to_int previous_start < Int64.to_int start_offset'0
      | None -> true
      end)}
    (! return {result}) ]

type tup2_LeaderEpoch_Offset = { f0'2: t_LeaderEpoch; f1'2: t_Offset }

predicate no_higher_entry [#"/workspace/crates/verified/src/leader_epoch.rs" 46 0 46 72] (entries: Seq.seq t_EpochEntry) (requested: int) =
  [%#sleader_epoch'2] forall i: int. 0 <= i /\ i < Seq.length entries
    -> Int32.to_int (Seq.get entries i).epoch.f0'0 <= requested

predicate higher_entry_at [#"/workspace/crates/verified/src/leader_epoch.rs" 32 0 32 80] (entries: Seq.seq t_EpochEntry) (requested: int) (h: int) =
  [%#sleader_epoch'3] 0 <= h
  /\ h < Seq.length entries
  /\ gt_log_Int (Int32.to_int (Seq.get entries h).epoch.f0'0) requested
  /\ (forall j: int. 0 <= j /\ j < h -> Int32.to_int (Seq.get entries j).epoch.f0'0 <= requested)

predicate kafka_end_offset_for [#"/workspace/crates/verified/src/leader_epoch.rs" 70 0 76 9] (entries: Seq.seq t_EpochEntry) (requested: int) (log_end'0: int) (found: int) (end': int) =
  [%#sleader_epoch'1] if requested = - 1 then
    found = - 1 /\ end' = - 1
  else
    if gt_log_Int (Seq.length entries) 0
    /\ Int32.to_int (Seq.get entries (Seq.length entries - 1)).epoch.f0'0 = requested then
      found = requested /\ end' = log_end'0
    else
      if no_higher_entry entries requested then
        found = - 1 /\ end' = - 1
      else
        exists h: int. higher_entry_at entries requested h
          /\ end' = Int64.to_int (Seq.get entries h).start_offset.f0'1
          /\ found = (if h = 0 then requested else Int32.to_int (Seq.get entries (h - 1)).epoch.f0'0)




let epoch_and_offset_for_entries (entries: Slice64.slice t_EpochEntry) (requested_epoch: t_LeaderEpoch)
  (log_end_offset: t_Offset) (return (x: tup2_LeaderEpoch_Offset)) =
{[@stop_split] [@expl:epoch_and_offset_for_entries requires] [%#sleader_epoch] forall i: int, j: int. 0 <= i
      /\ i < j /\ j < Seq.length (Slice64.view entries)
    -> Int32.to_int (Seq.get (Slice64.view entries) i).epoch.f0'0
      < Int32.to_int (Seq.get (Slice64.view entries) j).epoch.f0'0
    /\ Int64.to_int (Seq.get (Slice64.view entries) i).start_offset.f0'1
    < Int64.to_int (Seq.get (Slice64.view entries) j).start_offset.f0'1}
  any
  [ return (result: tup2_LeaderEpoch_Offset) ->
  {[@stop_split] [@expl:epoch_and_offset_for_entries ensures] [%#sleader_epoch'0] kafka_end_offset_for (Slice64.view entries) (Int32.to_int requested_epoch.f0'0) (Int64.to_int log_end_offset.f0'1) (Int32.to_int result.f0'2.f0'0) (Int64.to_int result.f1'2.f0'1)}
    (! return {result}) ]

let truncation_frontier (frontier: Int64.t) (new_end: Int64.t) (return (x: Int64.t)) = any
  [ return (result: Int64.t) ->
  {[@stop_split] [@expl:truncation_frontier ensures] ([@stop_split] [@expl:truncation_frontier ensures #0] [%#sfuture_log_swap_admission] Int64.to_int result
      <= Int64.to_int frontier)
    /\ ([@stop_split] [@expl:truncation_frontier ensures #1] [%#sfuture_log_swap_admission'0] Int64.to_int result
      <= Int64.to_int new_end)
    /\ ([@stop_split] [@expl:truncation_frontier ensures #2] [%#sfuture_log_swap_admission'1] Int64.to_int result
      = Int64.to_int frontier
    \/ Int64.to_int result = Int64.to_int new_end)}
    (! return {result}) ]

type t_FetchVisibility = {
  out_of_range: bool;
  empty: bool;
  limit_offset: Int64.t;
  effective_lso: Int64.t;
  read_committed_aborts: bool;
  response_hw: Int64.t;
  response_lso: Int64.t }

function offset_min [#"/workspace/crates/verified/src/broker/fetch.rs" 125 0 125 40] (a: int) (b: int) : int
 = [%#sfetch'7] if a <= b then a else b

function fetch_limit_model [#"/workspace/crates/verified/src/broker/fetch.rs" 139 0 139 92] (is_follower: bool) (read_committed: bool) (w: t_FetchWatermarks) : int
 = [%#sfetch'8] if is_follower then
    Int64.to_int w.log_end
  else
    if read_committed then
      offset_min (offset_min (Int64.to_int w.hw) (Int64.to_int w.deliverable)) (Int64.to_int w.lso)
    else
      offset_min (Int64.to_int w.hw) (Int64.to_int w.deliverable)



let fetch_visibility (is_follower: bool) (read_committed: bool) (w: t_FetchWatermarks) (fetch_offset: Int64.t)
  (return (x: t_FetchVisibility)) = any
  [ return (result: t_FetchVisibility) ->
  {[@stop_split] [@expl:fetch_visibility ensures] ([@stop_split] [@expl:fetch_visibility ensures #0] [%#sfetch] result.out_of_range
      = (Int64.to_int fetch_offset < Int64.to_int w.log_start))
    /\ ([@stop_split] [@expl:fetch_visibility ensures #1] [%#sfetch'0] result.empty
      = (not result.out_of_range
      /\ ge_log_Int (Int64.to_int fetch_offset) (if is_follower then
        Int64.to_int w.log_end
      else
        offset_min (Int64.to_int w.hw) (Int64.to_int w.deliverable)
      )))
    /\ ([@stop_split] [@expl:fetch_visibility ensures #2] [%#sfetch'1] Int64.to_int result.limit_offset
      = fetch_limit_model is_follower read_committed w)
    /\ ([@stop_split] [@expl:fetch_visibility ensures #3] [%#sfetch'2] not is_follower
      -> Int64.to_int result.limit_offset <= Int64.to_int w.hw
      /\ Int64.to_int result.limit_offset <= Int64.to_int w.deliverable
      /\ (read_committed -> Int64.to_int result.limit_offset <= Int64.to_int w.lso))
    /\ ([@stop_split] [@expl:fetch_visibility ensures #4] [%#sfetch'3] result.read_committed_aborts
      = (read_committed /\ not is_follower))
    /\ ([@stop_split] [@expl:fetch_visibility ensures #5] [%#sfetch'4] Int64.to_int result.effective_lso
      = (if result.read_committed_aborts then
        offset_min (Int64.to_int w.lso) (Int64.to_int w.hw)
      else
        Int64.to_int w.lso
      ))
    /\ ([@stop_split] [@expl:fetch_visibility ensures #6] [%#sfetch'5] result.response_hw = w.hw)
    /\ ([@stop_split] [@expl:fetch_visibility ensures #7] [%#sfetch'6] Int64.to_int result.response_lso
    = offset_min (Int64.to_int w.lso) (Int64.to_int w.hw))}
    (! return {result}) ]

