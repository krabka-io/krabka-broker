  | & _91: bool = Any.any_l ()
  | & _92: UInt64.t = Any.any_l ()
  | & _93: UInt64.t = Any.any_l ()
  | & _94: bool = Any.any_l ()
  | & _95: t_DeleteRecordsTrimApplication = Any.any_l ()
  | & frontier: Int64.t = Any.any_l ()
  | & frontier'0: Int64.t = Any.any_l ()
  | & variant_old_bb3: int = Any.any_l () ])
  [ return (result: tup2_i64_i64) ->
  {[@stop_split] [@expl:trim_steps_converge ensures] ([@stop_split] [@expl:trim_steps_converge ensures #0] [%#scomposition'17] Int64.to_int wal_start
        <= Int64.to_int result.f0
      /\ Int64.to_int local_start <= Int64.to_int result.f1)
    /\ ([@stop_split] [@expl:trim_steps_converge ensures #1] [%#scomposition'18] gt_log_Int (Int64.to_int result.f1) (Int64.to_int local_start)
