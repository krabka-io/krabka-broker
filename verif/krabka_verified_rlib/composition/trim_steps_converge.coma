predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

function deep_model_i64 [@inline:trivial] (self: Int64.t) : int = [%#snum] Int64.to_int self

meta "rewrite_def" function deep_model_i64

let max_i64 (self_: Int64.t) (o: Int64.t) (return (x: Int64.t)) = any
  [ return (result: Int64.t) ->
  {[@stop_split] [@expl:max_i64 ensures] ([@stop_split] [@expl:max ensures #0] [%#scmp] ge_log_Int (deep_model_i64 result) (deep_model_i64 self_))
    /\ ([@stop_split] [@expl:max ensures #1] [%#scmp'0] ge_log_Int (deep_model_i64 result) (deep_model_i64 o))
    /\ ([@stop_split] [@expl:max ensures #2] [%#scmp'1] result = self_ \/ result = o)
    /\ ([@stop_split] [@expl:max ensures #3] [%#scmp'2] deep_model_i64 self_ <= deep_model_i64 o -> result = o)
    /\ ([@stop_split] [@expl:max ensures #4] [%#scmp'3] deep_model_i64 o < deep_model_i64 self_ -> result = self_)}
    (! return {result}) ]

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

let len_bool (self_: Slice64.slice bool) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sslice] Seq.length (Slice64.view self_)
    = UInt64.t'int result}
    (! return {result}) ]

type t_DeleteRecordsTrimApplication = RejectMalformed | TrimWal Int64.t | TrimLocal Int64.t | Complete Int64.t

let delete_records_trim_application (requested: Int64.t) (wal_start: Int64.t) (local_start: Int64.t)
  (return (x: t_DeleteRecordsTrimApplication)) = any
  [ return (result: t_DeleteRecordsTrimApplication) ->
  {[@stop_split] [@expl:delete_records_trim_application ensures] [%#sbroker] let frontier = if gt_log_Int (Int64.to_int requested) (Int64.to_int wal_start) then
      if gt_log_Int (Int64.to_int requested) (Int64.to_int local_start) then
        Int64.to_int requested
      else
        Int64.to_int local_start

    else
      if gt_log_Int (Int64.to_int wal_start) (Int64.to_int local_start) then
        Int64.to_int wal_start
      else
        Int64.to_int local_start

     in match result with
      | RejectMalformed -> Int64.to_int requested < 0 \/ Int64.to_int wal_start < 0 \/ Int64.to_int local_start < 0
      | TrimWal next -> ge_log_Int (Int64.to_int requested) 0
      /\ ge_log_Int (Int64.to_int wal_start) 0
      /\ ge_log_Int (Int64.to_int local_start) 0 /\ Int64.to_int wal_start < frontier /\ Int64.to_int next = frontier
      | TrimLocal next -> ge_log_Int (Int64.to_int requested) 0
      /\ ge_log_Int (Int64.to_int wal_start) 0
      /\ ge_log_Int (Int64.to_int local_start) 0
      /\ Int64.to_int wal_start = frontier /\ Int64.to_int local_start < frontier /\ Int64.to_int next = frontier
      | Complete done' -> ge_log_Int (Int64.to_int requested) 0
      /\ ge_log_Int (Int64.to_int wal_start) 0
      /\ ge_log_Int (Int64.to_int local_start) 0
      /\ Int64.to_int wal_start = frontier /\ Int64.to_int local_start = frontier /\ Int64.to_int done' = frontier
      end}
    (! return {result}) ]

let elim_TrimLocal (_x: t_DeleteRecordsTrimApplication) (return (frontier: Int64.t)) = any
  [ _k (frontier: Int64.t) -> {TrimLocal frontier = _x} (! return {frontier})
  | _chk -> (! {[@expl:elim TrimLocal] match _x with
      | TrimLocal _ -> true
      | _ -> false
      end}
    any) ]

let elim_TrimWal (_x: t_DeleteRecordsTrimApplication) (return (frontier: Int64.t)) = any
  [ _k (frontier: Int64.t) -> {TrimWal frontier = _x} (! return {frontier})
  | _chk -> (! {[@expl:elim TrimWal] match _x with
      | TrimWal _ -> true
      | _ -> false
      end}
    any) ]

type tup2_i64_i64 = { f0: Int64.t; f1: Int64.t }

