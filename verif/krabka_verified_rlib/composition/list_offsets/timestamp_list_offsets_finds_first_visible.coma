type t_ListOffsetsKind =
  | Unsupported
  | Earliest
  | Latest
  | MaxTimestamp
  | EarliestLocal
  | LatestTiered
  | EarliestPendingUpload
  | Timestamp

let list_offsets_kind (timestamp: Int64.t) (version: Int16.t) (return (x: t_ListOffsetsKind)) = any
  [ return (result: t_ListOffsetsKind) ->
  {[@stop_split] [@expl:list_offsets_kind ensures] [%#sselection_model'0] match result with
