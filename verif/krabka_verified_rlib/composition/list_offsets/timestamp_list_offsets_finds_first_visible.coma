      /\ (exists i: int. 0 <= i
          /\ i < Seq.length (Slice64.view starts) /\ Int64.to_int lso = Int64.to_int (Seq.get (Slice64.view starts) i))
      /\ (forall i: int. 0 <= i /\ i < Seq.length (Slice64.view starts)
        -> Int64.to_int lso <= Int64.to_int (Seq.get (Slice64.view starts) i)))
      | None -> exists i: int. 0 <= i
        /\ i < Seq.length (Slice64.view starts)
