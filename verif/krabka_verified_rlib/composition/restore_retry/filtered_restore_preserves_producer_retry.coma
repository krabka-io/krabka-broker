          <= Int64.to_int (Seq.get (view_Vec_tup3_usize_i64_i64_Global result.f0'6) i).f1'3
        /\ Int64.to_int (Seq.get (view_Vec_tup3_usize_i64_i64_Global result.f0'6) i).f1'3 < Int64.to_int result.f1'6
        /\ Int64.to_int (Seq.get (view_Vec_tup3_usize_i64_i64_Global result.f0'6) i).f2'3
        <= Int64.to_int frame.max_timestamp)
    /\ (forall i: int, j: int. 0 <= i /\ i < j /\ j < Seq.length (view_Vec_tup3_usize_i64_i64_Global result.f0'6)
        -> UInt64.t'int (Seq.get (view_Vec_tup3_usize_i64_i64_Global result.f0'6) i).f0'3
        < UInt64.t'int (Seq.get (view_Vec_tup3_usize_i64_i64_Global result.f0'6) j).f0'3)
    /\ (forall i: int. 0 <= i /\ i < Seq.length (Slice64.view records)
      -> (exists j: int. 0 <= j
          /\ j < Seq.length (view_Vec_tup3_usize_i64_i64_Global result.f0'6)
          /\ UInt64.t'int (Seq.get (view_Vec_tup3_usize_i64_i64_Global result.f0'6) j).f0'3 = i)
      = restore_source_selected frame (Seq.get (Slice64.view records) i) bounds.f0'0 bounds.f1'0))}
    (! return {result}) ]
