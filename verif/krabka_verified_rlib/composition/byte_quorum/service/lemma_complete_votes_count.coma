(* #"/workspace/crates/verified/src/composition/byte_quorum/service.rs" 12 0 17 1 *)

let%span sord = "/root/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/creusot-std-0.13.0/src/logic/ord.rs" 34 8 34 21
let%span sord'0 = "/root/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/creusot-std-0.13.0/src/logic/ord.rs" 22 8 22 20
let%span swell_founded = "/root/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/creusot-std-0.13.0/src/logic/well_founded.rs" 43 8 43 33
let%span sservice = "/workspace/crates/verified/src/composition/byte_quorum/service.rs" 11 10 11 15
let%span sservice'0 = "/workspace/crates/verified/src/composition/byte_quorum/service.rs" 8 11 8 47
let%span sservice'1 = "/workspace/crates/verified/src/composition/byte_quorum/service.rs" 9 11 9 74
let%span sservice'2 = "/workspace/crates/verified/src/composition/byte_quorum/service.rs" 10 10 10 81
let%span sfailover = "/workspace/crates/verified/src/consensus/failover.rs" 186 10 186 15
let%span sfailover'0 = "/workspace/crates/verified/src/consensus/failover.rs" 189 8 195 9
let%span sfailover'1 = "/workspace/crates/verified/src/consensus/failover.rs" 178 8 178 48

use creusot.int.Int64
use seq.Seq
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

function hwm_member_at [#"/workspace/crates/verified/src/consensus/failover.rs" 176 0 176 62] (log_end: int) (s: Seq.seq Int64.t) (k: int) : int
 = [%#sfailover'1] if k = 0 then log_end else Int64.to_int (Seq.get s (k - 1))

function count_ge_prefix [#"/workspace/crates/verified/src/consensus/failover.rs" 187 0 187 97] (log_end: int) (s: Seq.seq Int64.t) (v: int) (limit: int) (leader_counts: bool) : int

axiom count_ge_prefix_def:
  forall log_end: int, s: Seq.seq Int64.t, v: int, limit: int, leader_counts: bool [count_ge_prefix log_end s v limit leader_counts]. count_ge_prefix log_end s v limit leader_counts
    = ([%#sfailover'0] if limit <= 0 then
      0
    else
      count_ge_prefix log_end s v (limit - 1) leader_counts
      + (if (leader_counts \/ gt_log_Int limit 1) /\ ge_log_Int (hwm_member_at log_end s (limit - 1)) v then 1 else 0)
    )

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant log_end : int

constant reports : Seq.seq Int64.t

constant threshold : int

constant count : int

function lemma_complete_votes_count [#"/workspace/crates/verified/src/composition/byte_quorum/service.rs" 12 0 17 1] (log_end: int) (reports: Seq.seq Int64.t) (threshold: int) (count: int) : ()

goal vc_lemma_complete_votes_count: ([%#sservice'0] 0 <= count /\ count <= Seq.length reports)
  -> ([%#sservice'1] forall i: int. 0 <= i /\ i < count -> ge_log_Int (Int64.to_int (Seq.get reports i)) threshold)
  -> (if gt_log_Int count 0 then
    (([@stop_split] [@expl:lemma_complete_votes_count requires] ([@stop_split] [@expl:lemma_complete_votes_count requires #0] [%#sservice'0] 0
            <= count - 1
          /\ count - 1 <= Seq.length reports)
        /\ ([@stop_split] [@expl:lemma_complete_votes_count requires #1] [%#sservice'1] forall i: int. 0 <= i
            /\ i < count - 1 -> ge_log_Int (Int64.to_int (Seq.get reports i)) threshold))
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sservice] count) ([%#sservice] count - 1)))
    /\ (([@stop_split] [@expl:lemma_complete_votes_count ensures] [%#sservice'2] count_ge_prefix log_end reports threshold (count
          - 1
        + 1) false
      = count - 1)
    -> (let _ = lemma_complete_votes_count log_end reports threshold (count
    - 1) in [@stop_split] [@expl:lemma_complete_votes_count ensures] [%#sservice'2] count_ge_prefix log_end reports threshold (count
      + 1) false
    = count))
  else
    [@stop_split] [@expl:lemma_complete_votes_count ensures] [%#sservice'2] count_ge_prefix log_end reports threshold (count
      + 1) false
    = count
  )
