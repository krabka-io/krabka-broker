      | Some receipt -> (gt_log_Int (Int64.to_int times.f2) (Int64.to_int receipt.f0'1)
          \/ gt_log_Int (Int64.to_int times.f2) (Int64.to_int receipt.f1'1)
          \/ gt_log_Int (Int64.to_int periods.f3'0) 0
          /\ gt_log_Int (Int64.to_int times.f2) (Int64.to_int times.f1 + Int64.to_int periods.f3'0)
        -> receipt.f4'1 = (Int16.to_int api_key = 17))
      /\ (Int64.to_int times.f2 <= Int64.to_int receipt.f0'1
        /\ (Int64.to_int periods.f3'0 <= 0
        \/ Int64.to_int times.f2 <= Int64.to_int times.f1 + Int64.to_int periods.f3'0) -> receipt.f4'1)
      end)}
    (! return {result}) ]
