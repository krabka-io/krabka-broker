predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

predicate valid_old [#"/workspace/crates/verified/src/composition/reconfiguration/spec.rs" 19 0 19 41] (nodes: Seq.seq UInt64.t) =
  [%#sspec] gt_log_Int (Seq.length nodes) 0
  /\ (forall i: int, j: int. 0 <= i /\ i < j /\ j < Seq.length nodes -> Seq.get nodes i <> Seq.get nodes j)

predicate has_node [#"/workspace/crates/verified/src/composition/reconfiguration/spec.rs" 11 0 11 63] (nodes: Seq.seq UInt64.t) (count: int) (node: UInt64.t) =
  [%#sspec'5] exists i: int. 0 <= i /\ i < count /\ Seq.get nodes i = node

predicate membership_coherent [#"/workspace/crates/verified/src/composition/reconfiguration/spec.rs" 28 0 33 9] (nodes: Seq.seq UInt64.t) (node: UInt64.t) (membership'0: t_TargetMembership) (kind'0: t_VoterChangeKind) =
  [%#sspec'0] kind'0 = FinalizeKraftVersion \/ has_node nodes (Seq.length nodes) node = (membership'0 <> Absent)

type t_VoterReconfigurationDecision =
  | NotLeader
  | InProgress
  | EpochUncommitted
  | EmptyCurrentVoterSet
  | UnsupportedKraftVersion
  | DuplicateVoter
  | IncompatibleVoter
  | VoterNotCaughtUp
  | VoterNotFound
  | DirectoryMismatch
  | InvalidVersionTransition
  | Admit t_VoterReconfigurationPlan

type t_Option_VoterReconfigurationDecision = None'1 | Some'1 t_VoterReconfigurationDecision

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

predicate voter_set_removes [#"/workspace/crates/verified/src/reconfiguration/admitted_plan.rs" 49 0 49 87] (membership'0: t_TargetMembership) (voters: t_CurrentVoterSet) =
  [%#sadmitted_plan'1] membership'0 = PresentSameDirectory /\ gt_log_Int (UInt64.t'int voters.voter_count) 1

predicate update_key_matches [#"/workspace/crates/verified/src/reconfiguration/admitted_plan.rs" 68 0 68 63] (membership'0: t_TargetMembership) =
  [%#sadmitted_plan'2] membership'0 = PresentUnknownDirectory \/ membership'0 = PresentSameDirectory

function voter_reconfiguration_rejection [#"/workspace/crates/verified/src/reconfiguration/admitted_plan.rs" 93 0 98 41] (leadership: t_ReconfigurationLeadership) (voters: t_CurrentVoterSet) (request: t_VoterChangeRequest) (target: t_TargetVoter) : t_Option_VoterReconfigurationDecision
 = [%#sadmitted_plan] if not leadership.is_leader then
    Some'1 (NotLeader)
  else
    if not leadership.no_pending_change then
      Some'1 (InProgress)
    else
      if not leadership.epoch_committed then
        Some'1 (EpochUncommitted)
      else
        if not voters.latest_controls_committed then
          Some'1 (InProgress)
        else
          if UInt64.t'int voters.voter_count = 0 then
            Some'1 (EmptyCurrentVoterSet)
          else
            if gt_log_Int (UInt16.t'int voters.kraft_version) 1 then
              Some'1 (InvalidVersionTransition)
            else
              match request.kind with
                | Add -> if UInt16.t'int voters.kraft_version <> 1 then
                  Some'1 (UnsupportedKraftVersion)
                else
                  if target.membership <> Absent then
                    Some'1 (DuplicateVoter)
                  else
                    if not target.version_compatible then
                      Some'1 (IncompatibleVoter)
                    else
                      if not target.caught_up then
                        Some'1 (VoterNotCaughtUp)
                      else
                        if UInt64.t'int voters.voter_count = UInt64.t'int const_MAX then
                          Some'1 (InvalidVersionTransition)
                        else
                          None'1





                | Remove -> if UInt16.t'int voters.kraft_version <> 1 then
                  Some'1 (UnsupportedKraftVersion)
                else
                  if not voter_set_removes target.membership voters then Some'1 (VoterNotFound) else None'1

                | Update -> if not target.version_compatible then
                  Some'1 (IncompatibleVoter)
                else
                  if target.membership = Absent then
                    Some'1 (VoterNotFound)
                  else
                    if not update_key_matches target.membership then Some'1 (DirectoryMismatch) else None'1


                | FinalizeKraftVersion -> if UInt16.t'int voters.kraft_version <> 0
                \/ UInt16.t'int request.requested_kraft_version <> 1 then
                  Some'1 (InvalidVersionTransition)
                else
                  if not voters.all_voters_support_requested then Some'1 (IncompatibleVoter) else None'1

                end







function control_record_count [#"/workspace/crates/verified/src/composition/reconfiguration/control_support/spec.rs" 10 0 10 71] (version: UInt16.t) (kind'0: t_VoterChangeKind) : int
 = [%#sspec'1] match kind'0 with
    | FinalizeKraftVersion -> 2
    | Update -> if UInt16.t'int version = 0 then 0 else 1
    | Add | Remove -> 1
    end

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

constant const_MAX'0: Int64.t = (9223372036854775807: Int64.t)

predicate expected_member [#"/workspace/crates/verified/src/composition/reconfiguration/spec.rs" 42 0 48 9] (nodes: Seq.seq UInt64.t) (count: int) (kind'0: t_VoterChangeKind) (target: UInt64.t) (node: UInt64.t) =
  [%#sspec'6] match kind'0 with
    | Add -> has_node nodes count node \/ node = target
    | Remove -> has_node nodes count node /\ node <> target
    | Update | FinalizeKraftVersion -> has_node nodes count node
    end

function prefix_count [#"/workspace/crates/verified/src/composition/reconfiguration/control_support/spec.rs" 33 0 41 8] (old': Seq.seq UInt64.t) (reports: Seq.seq tup2_i64_i64) (kind'0: t_VoterChangeKind) (node: UInt64.t) (end': int) (new: bool) (count: int) : int

axiom prefix_count_def:
  forall old': Seq.seq UInt64.t, reports: Seq.seq tup2_i64_i64, kind'0: t_VoterChangeKind, node: UInt64.t, end': int, new: bool, count: int [prefix_count old' reports kind'0 node end' new count]. prefix_count old' reports kind'0 node end' new count
    = ([%#sspec'3] if count <= 0 then
      0
    else
      prefix_count old' reports kind'0 node end' new (count - 1)
      + (if count - 1 < Seq.length old' then
        if new then
          if ge_log_Int (Int64.to_int (Seq.get reports (count - 1)).f1'1) end'
          /\ expected_member old' (Seq.length old') kind'0 node (Seq.get old' (count - 1)) then
            1
          else
            0

        else
          if ge_log_Int (Int64.to_int (Seq.get reports (count - 1)).f0'1) end' then 1 else 0

      else
        if new
        /\ ge_log_Int (Int64.to_int (Seq.get reports (count - 1)).f1'1) end'
        /\ not has_node old' (Seq.length old') node /\ expected_member old' (Seq.length old') kind'0 node node then
          1
        else
          0

      )
    )

function next_size [#"/workspace/crates/verified/src/composition/reconfiguration/control_support/spec.rs" 22 0 22 58] (count: int) (kind'0: t_VoterChangeKind) : int
 = [%#sspec'4] match kind'0 with
    | Add -> count + 1
    | Remove -> count - 1
    | _ -> count
    end

predicate admitted_plan [#"/workspace/crates/verified/src/reconfiguration/admitted_plan.rs" 171 0 175 9] (voters: t_CurrentVoterSet) (kind'0: t_VoterChangeKind) (plan: t_VoterReconfigurationPlan) =
  [%#sadmitted_plan'0] match kind'0 with
    | Add -> UInt64.t'int plan.next_voter_count = UInt64.t'int voters.voter_count + 1
    /\ plan.next_kraft_version = voters.kraft_version
    /\ plan.write_voters /\ not plan.write_kraft_version /\ not plan.preflight_only
    | Remove -> UInt64.t'int plan.next_voter_count + 1 = UInt64.t'int voters.voter_count
    /\ plan.next_kraft_version = voters.kraft_version
    /\ plan.write_voters /\ not plan.write_kraft_version /\ not plan.preflight_only
    | Update -> plan.next_voter_count = voters.voter_count
    /\ plan.next_kraft_version = voters.kraft_version
    /\ plan.write_voters = (UInt16.t'int voters.kraft_version <> 0)
    /\ not plan.write_kraft_version /\ plan.preflight_only = (UInt16.t'int voters.kraft_version = 0)
    | FinalizeKraftVersion -> plan.next_voter_count = voters.voter_count
    /\ UInt16.t'int plan.next_kraft_version = 1
    /\ plan.write_voters /\ plan.write_kraft_version /\ not plan.preflight_only
    end

function view_Vec_u64_Global (self: t_Vec_u64_Global) : Seq.seq UInt64.t

axiom view_Vec_u64_Global_spec:
  forall self: t_Vec_u64_Global [view_Vec_u64_Global self]. [%#svec'0] Seq.length (view_Vec_u64_Global self)
    <= UInt64.t'int const_MAX

function view_Vec_i32_Global (self: t_Vec_i32_Global) : Seq.seq Int32.t

axiom view_Vec_i32_Global_spec:
  forall self: t_Vec_i32_Global [view_Vec_i32_Global self]. [%#svec'0] Seq.length (view_Vec_i32_Global self)
    <= UInt64.t'int const_MAX

let reconfiguration_control_prefix_support (old': Slice64.slice UInt64.t)
  (state: tup2_ReconfigurationLeadership_CurrentVoterSet) (request: t_VoterChangeRequest) (node: UInt64.t)
  (target: t_TargetVoter) (base: Int64.t) (reports: Slice64.slice tup2_i64_i64)
  (return (x: t_Option_tup4_VoterReconfigurationPlan_Vec_u64_Global_Vec_i32_Global_Option_tup3_i64_tup2_usize_usize_u64)) =
{[@stop_split] [@expl:reconfiguration_control_prefix_support requires] ([@stop_split] [@expl:reconfiguration_control_prefix_support requires #0] [%#sprepare] UInt64.t'int state.f1'0.voter_count
    = Seq.length (Slice64.view old'))
  /\ ([@stop_split] [@expl:reconfiguration_control_prefix_support requires #1] [%#sprepare'0] Seq.length (Slice64.view reports)
  = Seq.length (Slice64.view old') + 1)}
  any
  [ return
    (result: t_Option_tup4_VoterReconfigurationPlan_Vec_u64_Global_Vec_i32_Global_Option_tup3_i64_tup2_usize_usize_u64) ->
