meta "rewrite_def" predicate gt_log_Int

let wal_voter_set_valid (voters: Slice64.slice UInt64.t) (local_node: UInt64.t) (expected: UInt64.t)
  (return (x: bool)) = any
  [ return (result: bool) -> {[@stop_split] [@expl:wal_voter_set_valid ensures] [%#sselect_wal_voters] result
    = (gt_log_Int (UInt64.t'int expected) 0
    /\ Seq.length (Slice64.view voters) = UInt64.t'int expected
    /\ Seq.get (Slice64.view voters) 0 = local_node
    /\ (forall i: int, j: int. 0 <= i /\ i < j /\ j < Seq.length (Slice64.view voters)
      -> Seq.get (Slice64.view voters) i <> Seq.get (Slice64.view voters) j))}
    (! return {result}) ]

