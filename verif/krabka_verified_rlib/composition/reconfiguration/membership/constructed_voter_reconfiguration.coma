  [%#sspec] exists i: int. 0 <= i /\ i < count /\ Seq.get nodes i = node

function prefix_node_extend [#"/workspace/crates/verified/src/composition/reconfiguration/spec.rs" 97 0 97 54] (nodes: Seq.seq UInt64.t) (count: int) : ()

axiom prefix_node_extend_spec: forall nodes: Seq.seq UInt64.t, count: int. ([%#sspec'0] 0 <= count
      /\ count < Seq.length nodes)
    -> ([%#sspec'1] forall id: UInt64.t. has_node nodes (count + 1) id
      = (has_node nodes count id \/ Seq.get nodes count = id))

type t_VoterChangeKind = Add | Remove | Update | FinalizeKraftVersion

type t_VoterChangeRequest = { kind: t_VoterChangeKind; requested_kraft_version: UInt16.t }

type t_TargetMembership = Absent | PresentUnknownDirectory | PresentSameDirectory | PresentOtherDirectory

type t_TargetVoter = { membership: t_TargetMembership; version_compatible: bool; caught_up: bool }

type t_ReconfigurationLeadership = { is_leader: bool; no_pending_change: bool; epoch_committed: bool }

type t_CurrentVoterSet = {
  voter_count: UInt64.t;
  kraft_version: UInt16.t;
  latest_controls_committed: bool;
  all_voters_support_requested: bool }

type t_VoterReconfigurationDecision =
  | NotLeader
  | InProgress
  | EpochUncommitted
  | EmptyCurrentVoterSet
  | UnsupportedKraftVersion
  | DuplicateVoter
  | IncompatibleVoter
  | VoterNotCaughtUp
  | VoterNotFound
  | DirectoryMismatch
  | InvalidVersionTransition
  | Admit t_VoterReconfigurationPlan

type t_Option_VoterReconfigurationDecision = None'2 | Some'2 t_VoterReconfigurationDecision

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

predicate voter_set_removes [#"/workspace/crates/verified/src/reconfiguration/admitted_plan.rs" 49 0 49 87] (membership'0: t_TargetMembership) (voters: t_CurrentVoterSet) =
  [%#sadmitted_plan'3] membership'0 = PresentSameDirectory /\ gt_log_Int (UInt64.t'int voters.voter_count) 1

predicate update_key_matches [#"/workspace/crates/verified/src/reconfiguration/admitted_plan.rs" 68 0 68 63] (membership'0: t_TargetMembership) =
  [%#sadmitted_plan'4] membership'0 = PresentUnknownDirectory \/ membership'0 = PresentSameDirectory

function voter_reconfiguration_rejection [#"/workspace/crates/verified/src/reconfiguration/admitted_plan.rs" 93 0 98 41] (leadership: t_ReconfigurationLeadership) (voters: t_CurrentVoterSet) (request: t_VoterChangeRequest) (target: t_TargetVoter) : t_Option_VoterReconfigurationDecision
 = [%#sadmitted_plan] if not leadership.is_leader then
    Some'2 (NotLeader)
  else
    if not leadership.no_pending_change then
      Some'2 (InProgress)
    else
      if not leadership.epoch_committed then
        Some'2 (EpochUncommitted)
      else
        if not voters.latest_controls_committed then
          Some'2 (InProgress)
        else
          if UInt64.t'int voters.voter_count = 0 then
            Some'2 (EmptyCurrentVoterSet)
          else
            if gt_log_Int (UInt16.t'int voters.kraft_version) 1 then
              Some'2 (InvalidVersionTransition)
            else
              match request.kind with
                | Add -> if UInt16.t'int voters.kraft_version <> 1 then
                  Some'2 (UnsupportedKraftVersion)
                else
                  if target.membership <> Absent then
                    Some'2 (DuplicateVoter)
                  else
                    if not target.version_compatible then
                      Some'2 (IncompatibleVoter)
                    else
                      if not target.caught_up then
                        Some'2 (VoterNotCaughtUp)
                      else
                        if UInt64.t'int voters.voter_count = UInt64.t'int const_MAX then
                          Some'2 (InvalidVersionTransition)
                        else
                          None'2





                | Remove -> if UInt16.t'int voters.kraft_version <> 1 then
                  Some'2 (UnsupportedKraftVersion)
                else
                  if not voter_set_removes target.membership voters then Some'2 (VoterNotFound) else None'2

                | Update -> if not target.version_compatible then
                  Some'2 (IncompatibleVoter)
                else
                  if target.membership = Absent then
                    Some'2 (VoterNotFound)
                  else
                    if not update_key_matches target.membership then Some'2 (DirectoryMismatch) else None'2


                | FinalizeKraftVersion -> if UInt16.t'int voters.kraft_version <> 0
                \/ UInt16.t'int request.requested_kraft_version <> 1 then
                  Some'2 (InvalidVersionTransition)
                else
                  if not voters.all_voters_support_requested then Some'2 (IncompatibleVoter) else None'2

                end







predicate admitted_plan [#"/workspace/crates/verified/src/reconfiguration/admitted_plan.rs" 171 0 175 9] (voters: t_CurrentVoterSet) (kind'0: t_VoterChangeKind) (plan: t_VoterReconfigurationPlan) =
  [%#sadmitted_plan'0] match kind'0 with
    | Add -> UInt64.t'int plan.next_voter_count = UInt64.t'int voters.voter_count + 1
    /\ plan.next_kraft_version = voters.kraft_version
    /\ plan.write_voters /\ not plan.write_kraft_version /\ not plan.preflight_only
    | Remove -> UInt64.t'int plan.next_voter_count + 1 = UInt64.t'int voters.voter_count
    /\ plan.next_kraft_version = voters.kraft_version
    /\ plan.write_voters /\ not plan.write_kraft_version /\ not plan.preflight_only
    | Update -> plan.next_voter_count = voters.voter_count
    /\ plan.next_kraft_version = voters.kraft_version
    /\ plan.write_voters = (UInt16.t'int voters.kraft_version <> 0)
    /\ not plan.write_kraft_version /\ plan.preflight_only = (UInt16.t'int voters.kraft_version = 0)
    | FinalizeKraftVersion -> plan.next_voter_count = voters.voter_count
    /\ UInt16.t'int plan.next_kraft_version = 1
    /\ plan.write_voters /\ plan.write_kraft_version /\ not plan.preflight_only
    end

predicate is_admit [#"/workspace/crates/verified/src/reconfiguration/admitted_plan.rs" 31 0 31 63] (decision: t_VoterReconfigurationDecision) =
  [%#sadmitted_plan'2] match decision with
    | Admit _ -> true
    | _ -> false
    end

predicate may_reconfigure [#"/workspace/crates/verified/src/reconfiguration/admitted_plan.rs" 17 0 17 94] (leadership: t_ReconfigurationLeadership) (voters: t_CurrentVoterSet) =
  [%#sadmitted_plan'1] leadership.is_leader
  /\ leadership.no_pending_change /\ leadership.epoch_committed /\ voters.latest_controls_committed

let voter_reconfiguration_decision (leadership: t_ReconfigurationLeadership) (voters: t_CurrentVoterSet)
  (request: t_VoterChangeRequest) (target: t_TargetVoter) (return (x: t_VoterReconfigurationDecision)) = any
  [ return (result: t_VoterReconfigurationDecision) ->
  {[@stop_split] [@expl:voter_reconfiguration_decision ensures] ([@stop_split] [@expl:voter_reconfiguration_decision ensures #0] [%#svoter_reconfiguration_decision] match voter_reconfiguration_rejection leadership voters request target with
        | Some'2 rejection -> result = rejection
        | None'2 -> match result with
          | Admit plan -> admitted_plan voters request.kind plan
          | _ -> false
          end
        end)
    /\ ([@stop_split] [@expl:voter_reconfiguration_decision ensures #1] [%#svoter_reconfiguration_decision'0] is_admit result
      -> may_reconfigure leadership voters)
    /\ ([@stop_split] [@expl:voter_reconfiguration_decision ensures #2] [%#svoter_reconfiguration_decision'1] forall plan: t_VoterReconfigurationPlan. result
        = Admit plan -> gt_log_Int (UInt64.t'int plan.next_voter_count) 0 /\ UInt16.t'int plan.next_kraft_version <= 1)}
    (! return {result}) ]

let elim_Admit (_x: t_VoterReconfigurationDecision) (return (f0'0: t_VoterReconfigurationPlan)) = any
  [ _k (f0'0: t_VoterReconfigurationPlan) -> {Admit f0'0 = _x} (! return {f0'0})
  | _chk -> (! {[@expl:elim Admit] match _x with
      | Admit _ -> true
      | _ -> false
