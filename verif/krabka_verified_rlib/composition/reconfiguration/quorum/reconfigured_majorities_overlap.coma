predicate expected_member [#"/workspace/crates/verified/src/composition/reconfiguration/spec.rs" 42 0 48 9] (nodes: Seq.seq UInt64.t) (count: int) (kind'0: t_VoterChangeKind) (target: UInt64.t) (node: UInt64.t) =
  [%#sspec'7] match kind'0 with
    | Add -> has_node nodes count node \/ node = target
    | Remove -> has_node nodes count node /\ node <> target
    | Update | FinalizeKraftVersion -> has_node nodes count node
    end

predicate single_change_shape [#"/workspace/crates/verified/src/composition/reconfiguration/spec.rs" 100 0 105 9] (old': Seq.seq UInt64.t) (next: Seq.seq UInt64.t) (kind'0: t_VoterChangeKind) (node: UInt64.t) =
  [%#sspec'6] Seq.length old' - 1 <= Seq.length next
  /\ Seq.length next <= Seq.length old' + 1
  /\ (forall id: UInt64.t. has_node next (Seq.length next) id = expected_member old' (Seq.length old') kind'0 node id)
  /\ (forall i: int, j: int. 0 <= i /\ i < j /\ j < Seq.length next -> Seq.get next i <> Seq.get next j)

let constructed_voter_reconfiguration (old': Slice64.slice UInt64.t) (leadership: t_ReconfigurationLeadership)
  (context: t_CurrentVoterSet) (request: t_VoterChangeRequest) (node: UInt64.t) (target: t_TargetVoter)
  (return (x: t_Option_tup2_VoterReconfigurationPlan_Vec_u64_Global)) =
{[@stop_split] [@expl:constructed_voter_reconfiguration requires] [%#smembership] UInt64.t'int context.voter_count
  = Seq.length (Slice64.view old')}
  any
  [ return (result: t_Option_tup2_VoterReconfigurationPlan_Vec_u64_Global) ->
  {[@stop_split] [@expl:constructed_voter_reconfiguration ensures] ([@stop_split] [@expl:constructed_voter_reconfiguration ensures #0] [%#smembership'0] match result with
          | None -> false
          | Some _ -> true
