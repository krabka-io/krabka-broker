(* #"/workspace/crates/verified/src/composition/reconfiguration/spec.rs" 71 0 78 8 *)

let%span sord = "/root/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/creusot-std-0.13.0/src/logic/ord.rs" 34 8 34 21
let%span sord'0 = "/root/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/creusot-std-0.13.0/src/logic/ord.rs" 22 8 22 20
let%span swell_founded = "/root/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/creusot-std-0.13.0/src/logic/well_founded.rs" 43 8 43 33
let%span sspec = "/workspace/crates/verified/src/composition/reconfiguration/spec.rs" 70 10 70 15
let%span sspec'0 = "/workspace/crates/verified/src/composition/reconfiguration/spec.rs" 12 16 12 70

use creusot.int.UInt64
use seq.Seq
use int.Int

type tup2_bool_bool = { f0: bool; f1: bool }

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

predicate has_node [#"/workspace/crates/verified/src/composition/reconfiguration/spec.rs" 11 0 11 63] (nodes: Seq.seq UInt64.t) (count: int) (node: UInt64.t) =
  [%#sspec'0] exists i: int. 0 <= i /\ i < count /\ Seq.get nodes i = node

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant old' : Seq.seq UInt64.t

constant next : Seq.seq UInt64.t

constant votes : Seq.seq tup2_bool_bool

constant node : UInt64.t

constant new : bool

constant count : int

function grant_count [#"/workspace/crates/verified/src/composition/reconfiguration/spec.rs" 71 0 78 8] (old': Seq.seq UInt64.t) (next: Seq.seq UInt64.t) (votes: Seq.seq tup2_bool_bool) (node: UInt64.t) (new: bool) (count: int) : int

goal vc_grant_count: if count <= 0 then
    true
  else
    [@expl:variant decreases] well_founded_relation_Int ([%#sspec] count) ([%#sspec] count - 1)
