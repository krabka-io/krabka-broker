  [ return (result: tup2_bool_Vec_usize_Global) ->
  {[@stop_split] [@expl:producer_completion_window ensures] ([@stop_split] [@expl:producer_completion_window ensures #0] [%#scompletion'2] result.f0
      = match current' with
        | None -> true
        | Some value -> Int16.to_int value <= Int16.to_int epoch
        end)
    /\ ([@stop_split] [@expl:producer_completion_window ensures #1] [%#scompletion'3] Seq.length (view_Vec_usize_Global result.f1)
        <= 5
