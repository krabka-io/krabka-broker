        -> UInt64.t'int (Seq.get (view_Vec_usize_Global result.f1) j) <= Seq.length (Slice64.view ends)
        /\ (UInt64.t'int (Seq.get (view_Vec_usize_Global result.f1) j) < Seq.length (Slice64.view ends)
          -> current' <> None
