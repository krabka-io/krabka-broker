            | {f0'5 = Some'2 a; f1'5 = Some'2 b} -> UInt64.t'int a < UInt64.t'int b
            | _ -> true
            end)
      /\ (Seq.length (view_Vec_Option_usize_Global origins) = 0 -> UInt64.t'int first = 0)
      /\ (gt_log_Int (Seq.length (view_Vec_Option_usize_Global origins)) 0
        -> UInt64.t'int first < Seq.length (view_Vec_Option_usize_Global origins)
        /\ match replay_data_row loaded (Slice64.view tail) (Seq.get (view_Vec_Option_usize_Global origins) (Seq.length (view_Vec_Option_usize_Global origins)
        - 1)) with
          | None -> false
          | Some last -> (forall j: int. UInt64.t'int first <= j
                /\ j < Seq.length (view_Vec_Option_usize_Global origins)
              -> match replay_data_row loaded (Slice64.view tail) (Seq.get (view_Vec_Option_usize_Global origins) j) with
                | None -> false
                | Some row -> row.producer_epoch = last.producer_epoch
                end)
          /\ (gt_log_Int (UInt64.t'int first) 0
            /\ Seq.length (view_Vec_Option_usize_Global origins) - UInt64.t'int first < 5
          -> match replay_data_row loaded (Slice64.view tail) (Seq.get (view_Vec_Option_usize_Global origins) (UInt64.t'int first
          - 1)) with
            | None -> false
            | Some row -> row.producer_epoch <> last.producer_epoch
            end)
          end)
      /\ match decision with
            | Duplicate _ -> true
            | _ -> false
            end
        = (exists j: int. UInt64.t'int first <= j
          /\ j < Seq.length (view_Vec_Option_usize_Global origins)
          /\ retry_matches_row (replay_data_row loaded (Slice64.view tail) (Seq.get (view_Vec_Option_usize_Global origins) j)) request)
      /\ match witness with
          | None'3 -> match decision with
            | Duplicate _ -> false
            | _ -> true
            end
          | Some'3 {f0'2 = source; f1'2 = base; f2'2 = frontier; f3'2 = ready} -> 0 <= Int64.to_int base
          /\ Int64.to_int base < Int64.to_int frontier
          /\ Int64.to_int frontier <= Int64.to_int result.f0'4
          /\ ready = ge_log_Int (Int64.to_int bounds.f1) (Int64.to_int frontier)
          /\ (exists j: int. UInt64.t'int first <= j
              /\ j < Seq.length (view_Vec_Option_usize_Global origins)
              /\ Seq.get (view_Vec_Option_usize_Global origins) j = source
              /\ match decision with
                  | Duplicate slot -> UInt64.t'int slot
                  = (if j + 1 = Seq.length (view_Vec_Option_usize_Global origins) then 4 else j - UInt64.t'int first)
                  | _ -> false
                  end
              /\ (forall k: int. UInt64.t'int first <= k /\ k < j
                -> not retry_matches_row (replay_data_row loaded (Slice64.view tail) (Seq.get (view_Vec_Option_usize_Global origins) k)) request))
          /\ match replay_data_row loaded (Slice64.view tail) source with
            | None -> false
            | Some row -> Int64.to_int base = Int64.to_int row.last_offset - Int32.to_int row.offset_delta
            /\ Int64.to_int frontier = Int64.to_int row.last_offset + 1 /\ retry_matches_row (Some row) request
            end
          end
      /\ (Seq.length (view_Vec_Option_usize_Global origins) = 0
        -> decision
        = (if request.f3'6 /\ Int64.to_int result.f0'4 = 0 /\ Int32.to_int request.f1'6 <> 0 then
          OutOfOrder
        else
          Append
        ))
      /\ (gt_log_Int (Seq.length (view_Vec_Option_usize_Global origins)) 0 /\ witness = None'3
      -> match replay_data_row loaded (Slice64.view tail) (Seq.get (view_Vec_Option_usize_Global origins) (Seq.length (view_Vec_Option_usize_Global origins)
      - 1)) with
        | None -> false
        | Some last -> decision
        = (if Int16.to_int request.f0'6 < Int16.to_int last.producer_epoch then
          Fenced
        else
          if gt_log_Int (Int16.to_int request.f0'6) (Int16.to_int last.producer_epoch) then
            if Int32.to_int request.f1'6 = 0 then Append else OutOfOrder
          else
            if Int32.to_int request.f1'6 = sequence_modulo_2_31 (Int32.to_int last.last_sequence + 1) then
              Append
            else
              OutOfOrder


        )
        end)
      end)}
    (! return {result}) ]
