use creusot.int.UInt64
use creusot.prelude.Any
use int.Int

type t_AuditLosses = { generation: UInt64.t; count: UInt64.t }

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

let settle_loss_batch (state: t_AuditLosses) (batch: t_AuditLosses) (return (x: t_AuditLosses)) = any
  [ return (result: t_AuditLosses) ->
  {[@stop_split] [@expl:settle_loss_batch ensures] ([@stop_split] [@expl:settle_loss_batch ensures #0] [%#saudit] state.generation
        <> batch.generation -> result.generation = state.generation /\ result.count = state.count)
    /\ ([@stop_split] [@expl:settle_loss_batch ensures #1] [%#saudit'0] state.generation = batch.generation
        /\ UInt64.t'int batch.count <= UInt64.t'int state.count
      -> UInt64.t'int result.count + UInt64.t'int batch.count = UInt64.t'int state.count)
    /\ ([@stop_split] [@expl:settle_loss_batch ensures #2] [%#saudit'1] state.generation = batch.generation
        /\ gt_log_Int (UInt64.t'int batch.count) (UInt64.t'int state.count) -> UInt64.t'int result.count = 0)
    /\ ([@stop_split] [@expl:settle_loss_batch ensures #3] [%#saudit'2] state.generation = batch.generation
      -> (result.generation <> state.generation)
      = (gt_log_Int (UInt64.t'int result.count) 0 /\ UInt64.t'int state.generation < UInt64.t'int const_MAX))
    /\ ([@stop_split] [@expl:settle_loss_batch ensures #4] [%#saudit'3] result.generation <> state.generation
    -> UInt64.t'int result.generation = UInt64.t'int state.generation + 1)}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let loss_settlement_is_idempotent [#"/workspace/crates/verified/src/composition.rs" 435 0 435 81]
  (state: t_AuditLosses) (marker: t_AuditLosses) (return (x: bool)) =
{[@stop_split] [@expl:loss_settlement_is_idempotent requires] [%#scomposition'2] UInt64.t'int state.generation
  < UInt64.t'int const_MAX}
  (! bb0
  [ bb0 = s0
    [ s0 = settle_loss_batch [%#scomposition] {state} {marker} (fun (_x: t_AuditLosses) -> [ &settled <- _x ] s1)
    | s1 = settle_loss_batch [%#scomposition'0] {settled} {marker} (fun (_x: t_AuditLosses) -> [ &replayed <- _x ] s2)
    | s2 = [ &_12 <- settled.count = replayed.count ] s3
    | s3 = any [ br0 -> {_12 = false} (! bb4) | br1 -> {_12} (! bb3) ] ]
  | bb3 = s0 [ s0 = [ &_ret <- settled.generation = replayed.generation ] s1 | s1 = return {_ret} ]
  | bb4 = s0 [ s0 = [ &_ret <- [%#scomposition'1] false ] s1 | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l ()
  | & state: t_AuditLosses = state
  | & marker: t_AuditLosses = marker
  | & settled: t_AuditLosses = Any.any_l ()
  | & replayed: t_AuditLosses = Any.any_l ()
  | & _12: bool = Any.any_l () ])
  [ return (result: bool) -> {[@stop_split] [@expl:loss_settlement_is_idempotent ensures] [%#scomposition'3] result}
    (! return {result}) ]
