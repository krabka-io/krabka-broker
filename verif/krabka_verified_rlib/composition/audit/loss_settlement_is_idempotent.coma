use creusot.int.UInt64
use creusot.prelude.Any
use int.Int

type t_AuditLosses = { generation: UInt64.t; count: UInt64.t }

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

let settle_loss_batch (state: t_AuditLosses) (batch: t_AuditLosses) (return (x: t_AuditLosses)) = any
  [ return (result: t_AuditLosses) ->
  {[@stop_split] [@expl:settle_loss_batch ensures] ([@stop_split] [@expl:settle_loss_batch ensures #0] [%#sspool_append_decision] state.generation
        <> batch.generation -> result.generation = state.generation /\ result.count = state.count)
    /\ ([@stop_split] [@expl:settle_loss_batch ensures #1] [%#sspool_append_decision'0] state.generation
          = batch.generation
        /\ UInt64.t'int batch.count <= UInt64.t'int state.count
      -> UInt64.t'int result.count + UInt64.t'int batch.count = UInt64.t'int state.count)
    /\ ([@stop_split] [@expl:settle_loss_batch ensures #2] [%#sspool_append_decision'1] state.generation
          = batch.generation
        /\ gt_log_Int (UInt64.t'int batch.count) (UInt64.t'int state.count) -> UInt64.t'int result.count = 0)
    /\ ([@stop_split] [@expl:settle_loss_batch ensures #3] [%#sspool_append_decision'2] state.generation
        = batch.generation
      -> (result.generation <> state.generation)
      = (gt_log_Int (UInt64.t'int result.count) 0 /\ UInt64.t'int state.generation < UInt64.t'int const_MAX))
    /\ ([@stop_split] [@expl:settle_loss_batch ensures #4] [%#sspool_append_decision'3] result.generation
      <> state.generation -> UInt64.t'int result.generation = UInt64.t'int state.generation + 1)}
    (! return {result}) ]

type tup2_AuditLosses_AuditLosses = { f0: t_AuditLosses; f1: t_AuditLosses }

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let loss_settlement_is_idempotent [#"/workspace/crates/verified/src/composition/audit.rs" 16 0 19 31]
  (state: t_AuditLosses) (marker: t_AuditLosses) (return (x: tup2_AuditLosses_AuditLosses)) =
{[@stop_split] [@expl:loss_settlement_is_idempotent requires] [%#saudit'1] UInt64.t'int state.generation
  < UInt64.t'int const_MAX}
  (! bb0
  [ bb0 = s0
    [ s0 = settle_loss_batch [%#saudit] {state} {marker} (fun (_x: t_AuditLosses) -> [ &settled <- _x ] s1)
    | s1 = settle_loss_batch [%#saudit'0] {settled} {marker} (fun (_x: t_AuditLosses) -> [ &replayed <- _x ] s2)
    | s2 = [ &_ret <- { f0 = settled; f1 = replayed } ] s3
    | s3 = return {_ret} ] ]
  [ & _ret: tup2_AuditLosses_AuditLosses = Any.any_l ()
  | & state: t_AuditLosses = state
  | & marker: t_AuditLosses = marker
  | & settled: t_AuditLosses = Any.any_l ()
  | & replayed: t_AuditLosses = Any.any_l () ])
  [ return (result: tup2_AuditLosses_AuditLosses) ->
  {[@stop_split] [@expl:loss_settlement_is_idempotent ensures] ([@stop_split] [@expl:loss_settlement_is_idempotent ensures #0] [%#saudit'2] result.f0.count
        = result.f1.count
      /\ result.f0.generation = result.f1.generation)
    /\ ([@stop_split] [@expl:loss_settlement_is_idempotent ensures #1] [%#saudit'3] UInt64.t'int result.f0.count
      = (if state.generation = marker.generation then
        if UInt64.t'int marker.count <= UInt64.t'int state.count then
          UInt64.t'int state.count - UInt64.t'int marker.count
        else
          0

      else
        UInt64.t'int state.count
      ))
    /\ ([@stop_split] [@expl:loss_settlement_is_idempotent ensures #2] [%#saudit'4] UInt64.t'int result.f0.generation
    = (if state.generation = marker.generation /\ UInt64.t'int marker.count < UInt64.t'int state.count then
      UInt64.t'int state.generation + 1
    else
      UInt64.t'int state.generation
    ))}
    (! return {result}) ]
