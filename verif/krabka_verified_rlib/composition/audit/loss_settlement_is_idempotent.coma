let%span sspool_append_decision = "/workspace/crates/verified/src/audit/spool_append_decision.rs" 84 10 85 76
let%span sspool_append_decision'0 = "/workspace/crates/verified/src/audit/spool_append_decision.rs" 86 10 87 52
let%span sspool_append_decision'1 = "/workspace/crates/verified/src/audit/spool_append_decision.rs" 88 10 89 26
let%span sspool_append_decision'2 = "/workspace/crates/verified/src/audit/spool_append_decision.rs" 90 10 92 63
let%span sspool_append_decision'3 = "/workspace/crates/verified/src/audit/spool_append_decision.rs" 93 10 94 51
let%span sord = "/root/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/creusot-std-0.13.0/src/logic/ord.rs" 22 8 22 20
let%span saudit = "/workspace/crates/verified/src/composition/audit.rs" 9 18 9 50
let%span saudit'0 = "/workspace/crates/verified/src/composition/audit.rs" 10 19 10 53
