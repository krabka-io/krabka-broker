constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function successful_fetches [#"/workspace/crates/verified/src/composition/jwks_publication.rs" 23 0 23 61] (fetches: Seq.seq bool) (prefix: int) : int

axiom successful_fetches_def:
  forall fetches: Seq.seq bool, prefix: int [successful_fetches fetches prefix]. ([%#sjwks_publication'20] 0 <= prefix
      /\ prefix <= Seq.length fetches)
    -> successful_fetches fetches prefix
    = ([%#sjwks_publication'23] if prefix = 0 then
      0
    else
      successful_fetches fetches (prefix - 1) + (if Seq.get fetches (prefix - 1) then 1 else 0)
    )

axiom successful_fetches_spec:
  forall fetches: Seq.seq bool, prefix: int [successful_fetches fetches prefix]. ([%#sjwks_publication'20] 0 <= prefix
      /\ prefix <= Seq.length fetches)
    -> ([%#sjwks_publication'21] 0 <= successful_fetches fetches prefix /\ successful_fetches fetches prefix <= prefix)

axiom successful_fetches_spec'0:
  forall fetches: Seq.seq bool, prefix: int [successful_fetches fetches prefix]. ([%#sjwks_publication'20] 0 <= prefix
      /\ prefix <= Seq.length fetches)
    -> ([%#sjwks_publication'22] (successful_fetches fetches prefix = 0)
    = (forall i: int. 0 <= i /\ i < prefix -> not Seq.get fetches i))

type tup2_u64_u64 = { f0: UInt64.t; f1: UInt64.t }

type t_Option_tup2_u64_u64 = None | Some tup2_u64_u64

let jwks_publication_generations (generation: UInt64.t) (return (x: t_Option_tup2_u64_u64)) = any
  [ return (result: t_Option_tup2_u64_u64) ->
  {[@stop_split] [@expl:jwks_publication_generations ensures] ([@stop_split] [@expl:jwks_publication_generations ensures #0] [%#spublication] (result
        = None)
      = (ComputerDivision.mod (UInt64.t'int generation) 2 <> 0
      \/ gt_log_Int (UInt64.t'int generation) (UInt64.t'int const_MAX - 2)))
    /\ ([@stop_split] [@expl:jwks_publication_generations ensures #1] [%#spublication'0] match result with
      | None -> true
      | Some {f0 = writing; f1 = committed} -> UInt64.t'int writing = UInt64.t'int generation + 1
      /\ UInt64.t'int committed = UInt64.t'int generation + 2
      /\ ComputerDivision.mod (UInt64.t'int generation) 2 = 0
      /\ ComputerDivision.mod (UInt64.t'int writing) 2 = 1 /\ ComputerDivision.mod (UInt64.t'int committed) 2 = 0
      end)}
    (! return {result}) ]

let elim_Some (_x: t_Option_tup2_u64_u64) (return (f0'0: tup2_u64_u64)) = any
  [ _k (f0'0: tup2_u64_u64) -> {Some f0'0 = _x} (! return {f0'0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
