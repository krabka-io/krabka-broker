type t_DisklessTrimDecision = { should_trim: bool; target: Int64.t }

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

function effective_trim_lag [#"/workspace/crates/verified/src/diskless.rs" 383 0 383 45] (safety_lag: Int64.t) : int
 = [%#sdiskless'4] if Int64.to_int safety_lag < 0 then 0 else Int64.to_int safety_lag

function trim_target [#"/workspace/crates/verified/src/diskless.rs" 391 0 391 74] (frontier: Int64.t) (high_watermark: Int64.t) (safety_lag: Int64.t) : int

let diskless_trim_decision (frontier: Int64.t) (high_watermark: Int64.t) (safety_lag: Int64.t) (current_start: Int64.t)
  (return (x: t_DisklessTrimDecision)) = any
  [ return (result: t_DisklessTrimDecision) ->
  {[@stop_split] [@expl:diskless_trim_decision ensures] ([@stop_split] [@expl:diskless_trim_decision ensures #0] [%#sdiskless] result.should_trim
      = (ge_log_Int (Int64.to_int frontier) 0
      /\ ge_log_Int (Int64.to_int high_watermark) 0
      /\ ge_log_Int (Int64.to_int current_start) 0
      /\ effective_trim_lag safety_lag <= Int64.to_int high_watermark
      /\ Int64.to_int current_start < trim_target frontier high_watermark safety_lag))
    /\ ([@stop_split] [@expl:diskless_trim_decision ensures #1] [%#sdiskless'0] Int64.to_int result.target
      = (if result.should_trim then trim_target frontier high_watermark safety_lag else Int64.to_int current_start))
    /\ ([@stop_split] [@expl:diskless_trim_decision ensures #2] [%#sdiskless'1] ge_log_Int (Int64.to_int result.target) (Int64.to_int current_start))
    /\ ([@stop_split] [@expl:diskless_trim_decision ensures #3] [%#sdiskless'2] result.should_trim
      -> Int64.to_int result.target <= Int64.to_int frontier)
    /\ ([@stop_split] [@expl:diskless_trim_decision ensures #4] [%#sdiskless'3] result.should_trim
    -> Int64.to_int result.target + effective_trim_lag safety_lag <= Int64.to_int high_watermark)}
    (! return {result}) ]

function deep_model_i64 [@inline:trivial] (self: Int64.t) : int = [%#snum] Int64.to_int self

meta "rewrite_def" function deep_model_i64

let max_i64 (self_: Int64.t) (o: Int64.t) (return (x: Int64.t)) = any
  [ return (result: Int64.t) ->
  {[@stop_split] [@expl:max_i64 ensures] ([@stop_split] [@expl:max ensures #0] [%#scmp] ge_log_Int (deep_model_i64 result) (deep_model_i64 self_))
    /\ ([@stop_split] [@expl:max ensures #1] [%#scmp'0] ge_log_Int (deep_model_i64 result) (deep_model_i64 o))
    /\ ([@stop_split] [@expl:max ensures #2] [%#scmp'1] result = self_ \/ result = o)
    /\ ([@stop_split] [@expl:max ensures #3] [%#scmp'2] deep_model_i64 self_ <= deep_model_i64 o -> result = o)
    /\ ([@stop_split] [@expl:max ensures #4] [%#scmp'3] deep_model_i64 o < deep_model_i64 self_ -> result = self_)}
    (! return {result}) ]

type tup2_i64_i64 = { f0: Int64.t; f1: Int64.t }

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

let trim_steps_converge (requested: Int64.t) (wal_start: Int64.t) (local_start: Int64.t) (applied: Slice64.slice bool)
  (return (x: tup2_i64_i64)) =
{[@stop_split] [@expl:trim_steps_converge requires] [%#scomposition'10] ge_log_Int (Int64.to_int requested) 0
  /\ ge_log_Int (Int64.to_int wal_start) 0 /\ ge_log_Int (Int64.to_int local_start) 0}
  any
  [ return (result: tup2_i64_i64) ->
  {[@stop_split] [@expl:trim_steps_converge ensures] ([@stop_split] [@expl:trim_steps_converge ensures #0] [%#scomposition'11] Int64.to_int wal_start
        <= Int64.to_int result.f0
      /\ Int64.to_int local_start <= Int64.to_int result.f1)
    /\ ([@stop_split] [@expl:trim_steps_converge ensures #1] [%#scomposition'12] gt_log_Int (Int64.to_int result.f1) (Int64.to_int local_start)
      -> Int64.to_int result.f0
      = MinMax.max (MinMax.max (Int64.to_int requested) (Int64.to_int wal_start)) (Int64.to_int local_start))
    /\ ([@stop_split] [@expl:trim_steps_converge ensures #2] [%#scomposition'13] Int64.to_int result.f0
        <= MinMax.max (MinMax.max (Int64.to_int requested) (Int64.to_int wal_start)) (Int64.to_int local_start)
      /\ Int64.to_int result.f1
      <= MinMax.max (MinMax.max (Int64.to_int requested) (Int64.to_int wal_start)) (Int64.to_int local_start))
    /\ ([@stop_split] [@expl:trim_steps_converge ensures #3] [%#scomposition'14] (exists i: int. 0 <= i
          /\ i < Seq.length (Slice64.view applied) /\ Seq.get (Slice64.view applied) i)
      -> Int64.to_int result.f0
      = MinMax.max (MinMax.max (Int64.to_int requested) (Int64.to_int wal_start)) (Int64.to_int local_start))
    /\ ([@stop_split] [@expl:trim_steps_converge ensures #4] [%#scomposition'15] (exists i: int, j: int. 0 <= i
          /\ i < j
          /\ j < Seq.length (Slice64.view applied)
          /\ Seq.get (Slice64.view applied) i /\ Seq.get (Slice64.view applied) j)
      -> result.f0 = result.f1
      /\ Int64.to_int result.f1
      = MinMax.max (MinMax.max (Int64.to_int requested) (Int64.to_int wal_start)) (Int64.to_int local_start))
    /\ ([@stop_split] [@expl:trim_steps_converge ensures #5] [%#scomposition'16] (forall i: int. 0 <= i
          /\ i < Seq.length (Slice64.view applied) -> not Seq.get (Slice64.view applied) i)
    -> result = { f0 = wal_start; f1 = local_start })}
    (! return {result}) ]

