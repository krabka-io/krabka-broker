constant const_MAX: Int64.t = (9223372036854775807: Int64.t)

let local_append_coordinates (expected_base: Int64.t) (supplied_base: Int64.t) (last_offset_delta: Int32.t)
  (return (x: t_Option_tup2_i64_i64)) = any
