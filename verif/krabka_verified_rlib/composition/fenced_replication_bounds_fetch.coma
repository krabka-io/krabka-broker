function offset_min [#"/workspace/crates/verified/src/broker.rs" 226 0 226 40] (a: int) (b: int) : int
 = [%#sbroker'9] if a <= b then a else b

function fetch_limit_model [#"/workspace/crates/verified/src/broker.rs" 240 0 240 92] (is_follower: bool) (read_committed: bool) (w: t_FetchWatermarks) : int
 = [%#sbroker'10] if is_follower then
    Int64.to_int w.log_end
  else
    if read_committed then
      offset_min (offset_min (Int64.to_int w.hw) (Int64.to_int w.deliverable)) (Int64.to_int w.lso)
    else
      offset_min (Int64.to_int w.hw) (Int64.to_int w.deliverable)



let fetch_visibility (is_follower: bool) (read_committed: bool) (w: t_FetchWatermarks) (fetch_offset: Int64.t)
  (return (x: t_FetchVisibility)) = any
  [ return (result: t_FetchVisibility) ->
  {[@stop_split] [@expl:fetch_visibility ensures] ([@stop_split] [@expl:fetch_visibility ensures #0] [%#sbroker'0] result.out_of_range
      = (Int64.to_int fetch_offset < Int64.to_int w.log_start))
    /\ ([@stop_split] [@expl:fetch_visibility ensures #1] [%#sbroker'1] result.empty
      = (not result.out_of_range
      /\ ge_log_Int (Int64.to_int fetch_offset) (if is_follower then
        Int64.to_int w.log_end
      else
        offset_min (Int64.to_int w.hw) (Int64.to_int w.deliverable)
      )))
    /\ ([@stop_split] [@expl:fetch_visibility ensures #2] [%#sbroker'2] Int64.to_int result.limit_offset
      = fetch_limit_model is_follower read_committed w)
    /\ ([@stop_split] [@expl:fetch_visibility ensures #3] [%#sbroker'3] not is_follower
      -> Int64.to_int result.limit_offset <= Int64.to_int w.hw
      /\ Int64.to_int result.limit_offset <= Int64.to_int w.deliverable
      /\ (read_committed -> Int64.to_int result.limit_offset <= Int64.to_int w.lso))
    /\ ([@stop_split] [@expl:fetch_visibility ensures #4] [%#sbroker'4] result.read_committed_aborts
      = (read_committed /\ not is_follower))
    /\ ([@stop_split] [@expl:fetch_visibility ensures #5] [%#sbroker'5] Int64.to_int result.effective_lso
      = (if result.read_committed_aborts then
        offset_min (Int64.to_int w.lso) (Int64.to_int w.hw)
      else
        Int64.to_int w.lso
      ))
    /\ ([@stop_split] [@expl:fetch_visibility ensures #6] [%#sbroker'6] result.response_hw = w.hw)
    /\ ([@stop_split] [@expl:fetch_visibility ensures #7] [%#sbroker'7] Int64.to_int result.response_lso
    = offset_min (Int64.to_int w.lso) (Int64.to_int w.hw))}
    (! return {result}) ]

