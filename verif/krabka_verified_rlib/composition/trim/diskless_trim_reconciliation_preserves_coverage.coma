use creusot.int.Int64
use creusot.slice.Slice64
use int.MinMax
use seq.Seq
use creusot.prelude.Any
use int.Int

type t_DisklessTrimDecision = { should_trim: bool; target: Int64.t }

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

function effective_trim_lag [#"/workspace/crates/verified/src/diskless/trim_decision.rs" 130 0 130 49] (safety_lag: Int64.t) : int
 = [%#strim_decision'4] if Int64.to_int safety_lag < 0 then 0 else Int64.to_int safety_lag

function trim_target [#"/workspace/crates/verified/src/diskless/trim_decision.rs" 138 0 138 74] (frontier: Int64.t) (high_watermark: Int64.t) (safety_lag: Int64.t) : int
 = [%#strim_decision'5] let high_watermark_floor = Int64.to_int high_watermark
  - effective_trim_lag safety_lag in if Int64.to_int frontier < high_watermark_floor then
    Int64.to_int frontier
  else
    high_watermark_floor


let diskless_trim_decision (frontier: Int64.t) (high_watermark: Int64.t) (safety_lag: Int64.t) (current_start: Int64.t)
  (return (x: t_DisklessTrimDecision)) = any
  [ return (result: t_DisklessTrimDecision) ->
  {[@stop_split] [@expl:diskless_trim_decision ensures] ([@stop_split] [@expl:diskless_trim_decision ensures #0] [%#strim_decision] result.should_trim
      = (ge_log_Int (Int64.to_int frontier) 0
      /\ ge_log_Int (Int64.to_int high_watermark) 0
      /\ ge_log_Int (Int64.to_int current_start) 0
      /\ effective_trim_lag safety_lag <= Int64.to_int high_watermark
      /\ Int64.to_int current_start < trim_target frontier high_watermark safety_lag))
    /\ ([@stop_split] [@expl:diskless_trim_decision ensures #1] [%#strim_decision'0] Int64.to_int result.target
      = (if result.should_trim then trim_target frontier high_watermark safety_lag else Int64.to_int current_start))
    /\ ([@stop_split] [@expl:diskless_trim_decision ensures #2] [%#strim_decision'1] ge_log_Int (Int64.to_int result.target) (Int64.to_int current_start))
    /\ ([@stop_split] [@expl:diskless_trim_decision ensures #3] [%#strim_decision'2] result.should_trim
      -> Int64.to_int result.target <= Int64.to_int frontier)
    /\ ([@stop_split] [@expl:diskless_trim_decision ensures #4] [%#strim_decision'3] result.should_trim
    -> Int64.to_int result.target + effective_trim_lag safety_lag <= Int64.to_int high_watermark)}
    (! return {result}) ]

type tup2_i64_i64 = { f0: Int64.t; f1: Int64.t }

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

let trim_steps_converge (requested: Int64.t) (wal_start: Int64.t) (local_start: Int64.t) (applied: Slice64.slice bool)
  (return (x: tup2_i64_i64)) =
{[@stop_split] [@expl:trim_steps_converge requires] [%#strim'6] ge_log_Int (Int64.to_int requested) 0
  /\ ge_log_Int (Int64.to_int wal_start) 0 /\ ge_log_Int (Int64.to_int local_start) 0}
  any
  [ return (result: tup2_i64_i64) ->
  {[@stop_split] [@expl:trim_steps_converge ensures] ([@stop_split] [@expl:trim_steps_converge ensures #0] [%#strim'7] Int64.to_int wal_start
        <= Int64.to_int result.f0
      /\ Int64.to_int local_start <= Int64.to_int result.f1)
    /\ ([@stop_split] [@expl:trim_steps_converge ensures #1] [%#strim'8] gt_log_Int (Int64.to_int result.f1) (Int64.to_int local_start)
      -> Int64.to_int result.f0
      = MinMax.max (MinMax.max (Int64.to_int requested) (Int64.to_int wal_start)) (Int64.to_int local_start))
    /\ ([@stop_split] [@expl:trim_steps_converge ensures #2] [%#strim'9] Int64.to_int result.f0
        <= MinMax.max (MinMax.max (Int64.to_int requested) (Int64.to_int wal_start)) (Int64.to_int local_start)
      /\ Int64.to_int result.f1
      <= MinMax.max (MinMax.max (Int64.to_int requested) (Int64.to_int wal_start)) (Int64.to_int local_start))
    /\ ([@stop_split] [@expl:trim_steps_converge ensures #3] [%#strim'10] (exists i: int. 0 <= i
          /\ i < Seq.length (Slice64.view applied) /\ Seq.get (Slice64.view applied) i)
      -> Int64.to_int result.f0
      = MinMax.max (MinMax.max (Int64.to_int requested) (Int64.to_int wal_start)) (Int64.to_int local_start))
    /\ ([@stop_split] [@expl:trim_steps_converge ensures #4] [%#strim'11] (exists i: int, j: int. 0 <= i
          /\ i < j
          /\ j < Seq.length (Slice64.view applied)
          /\ Seq.get (Slice64.view applied) i /\ Seq.get (Slice64.view applied) j)
      -> result.f0 = result.f1
      /\ Int64.to_int result.f1
      = MinMax.max (MinMax.max (Int64.to_int requested) (Int64.to_int wal_start)) (Int64.to_int local_start))
    /\ ([@stop_split] [@expl:trim_steps_converge ensures #5] [%#strim'12] (forall i: int. 0 <= i
          /\ i < Seq.length (Slice64.view applied) -> not Seq.get (Slice64.view applied) i)
    -> result = { f0 = wal_start; f1 = local_start })}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let diskless_trim_reconciliation_preserves_coverage [#"/workspace/crates/verified/src/composition/trim.rs" 169 0 176 15]
  (indexed_frontier: Int64.t) (high_watermark: Int64.t) (safety_lag: Int64.t) (wal_start: Int64.t)
  (local_start: Int64.t) (applied: Slice64.slice bool) (return (x: tup2_i64_i64)) =
{[@stop_split] [@expl:diskless_trim_reconciliation_preserves_coverage requires] ([@stop_split] [@expl:diskless_trim_reconciliation_preserves_coverage requires #0] [%#strim'1] 0
      <= Int64.to_int wal_start
    /\ Int64.to_int wal_start <= Int64.to_int indexed_frontier)
  /\ ([@stop_split] [@expl:diskless_trim_reconciliation_preserves_coverage requires #1] [%#strim'2] Int64.to_int wal_start
    + (if Int64.to_int safety_lag < 0 then 0 else Int64.to_int safety_lag)
  <= Int64.to_int high_watermark)}
  (! bb0
  [ bb0 = s0
    [ s0 = diskless_trim_decision [%#strim] {indexed_frontier} {high_watermark} {safety_lag} {local_start}
        (fun (_x: t_DisklessTrimDecision) -> [ &plan <- _x ] s1)
    | s1 = any [ br0 -> {plan.should_trim = false} (! bb2) | br1 -> {plan.should_trim} (! bb3) ] ]
  | bb3 = s0
    [ s0 = trim_steps_converge [%#strim'0] {plan.target} {wal_start} {local_start} {applied}
        (fun (_x: tup2_i64_i64) -> [ &_ret <- _x ] s1)
    | s1 = return {_ret} ]
  | bb2 = s0 [ s0 = [ &_ret <- { f0 = wal_start; f1 = local_start } ] s1 | s1 = return {_ret} ] ]
  [ & _ret: tup2_i64_i64 = Any.any_l ()
  | & indexed_frontier: Int64.t = indexed_frontier
  | & high_watermark: Int64.t = high_watermark
  | & safety_lag: Int64.t = safety_lag
  | & wal_start: Int64.t = wal_start
  | & local_start: Int64.t = local_start
  | & applied: Slice64.slice bool = applied
  | & plan: t_DisklessTrimDecision = Any.any_l () ])
  [ return (result: tup2_i64_i64) ->
  {[@stop_split] [@expl:diskless_trim_reconciliation_preserves_coverage ensures] ([@stop_split] [@expl:diskless_trim_reconciliation_preserves_coverage ensures #0] [%#strim'3] ge_log_Int (Int64.to_int result.f0) (Int64.to_int wal_start))
    /\ ([@stop_split] [@expl:diskless_trim_reconciliation_preserves_coverage ensures #1] [%#strim'4] ge_log_Int (Int64.to_int result.f1) (Int64.to_int local_start))
    /\ ([@stop_split] [@expl:diskless_trim_reconciliation_preserves_coverage ensures #2] [%#strim'5] let lag = MinMax.max (Int64.to_int safety_lag) 0 in let enabled = ge_log_Int (Int64.to_int local_start) 0
    /\ Int64.to_int local_start
    < MinMax.min (Int64.to_int indexed_frontier) (Int64.to_int high_watermark - lag) in if not enabled then
      result = { f0 = wal_start; f1 = local_start }
    else
      let frontier = MinMax.max (MinMax.min (Int64.to_int indexed_frontier) (Int64.to_int high_watermark
      - lag)) (Int64.to_int wal_start) in Int64.to_int result.f0 <= frontier
      /\ Int64.to_int result.f1 <= frontier
      /\ Int64.to_int result.f0 <= Int64.to_int indexed_frontier
      /\ Int64.to_int result.f1 <= Int64.to_int indexed_frontier
      /\ Int64.to_int result.f0 + lag <= Int64.to_int high_watermark
      /\ Int64.to_int result.f1 + lag <= Int64.to_int high_watermark
      /\ ((exists i: int. 0 <= i /\ i < Seq.length (Slice64.view applied) /\ Seq.get (Slice64.view applied) i)
        -> Int64.to_int result.f0 = frontier)
      /\ ((exists i: int, j: int. 0 <= i
            /\ i < j
            /\ j < Seq.length (Slice64.view applied)
            /\ Seq.get (Slice64.view applied) i /\ Seq.get (Slice64.view applied) j)
        -> Int64.to_int result.f0 = frontier /\ Int64.to_int result.f1 = frontier)
      /\ ((forall i: int. 0 <= i /\ i < Seq.length (Slice64.view applied) -> not Seq.get (Slice64.view applied) i)
      -> result = { f0 = wal_start; f1 = local_start })
    )}
    (! return {result}) ]
