type t_FetchWatermarks = { log_start: Int64.t; hw: Int64.t; lso: Int64.t; log_end: Int64.t; deliverable: Int64.t }

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

function hwm_member_at [#"/workspace/crates/verified/src/consensus.rs" 245 0 245 62] (log_end'0: int) (s: Seq.seq Int64.t) (k: int) : int
 = [%#sconsensus'15] if k = 0 then log_end'0 else Int64.to_int (Seq.get s (k - 1))

function count_ge_prefix [#"/workspace/crates/verified/src/consensus.rs" 256 0 256 97] (log_end'0: int) (s: Seq.seq Int64.t) (v: int) (limit: int) (leader_counts: bool) : int

axiom count_ge_prefix_def:
  forall log_end'0: int, s: Seq.seq Int64.t, v: int, limit: int, leader_counts: bool [count_ge_prefix log_end'0 s v limit leader_counts]. count_ge_prefix log_end'0 s v limit leader_counts
    = ([%#sconsensus'14] if limit <= 0 then
      0
    else
      count_ge_prefix log_end'0 s v (limit - 1) leader_counts
      + (if (leader_counts \/ gt_log_Int limit 1) /\ ge_log_Int (hwm_member_at log_end'0 s (limit - 1)) v then 1 else 0)
    )

function count_ge [#"/workspace/crates/verified/src/consensus.rs" 273 0 273 78] (log_end'0: int) (s: Seq.seq Int64.t) (v: int) (leader_counts: bool) : int

axiom count_ge_def:
  forall log_end'0: int, s: Seq.seq Int64.t, v: int, leader_counts: bool [count_ge log_end'0 s v leader_counts]. count_ge log_end'0 s v leader_counts
    = ([%#sconsensus'12] count_ge_prefix log_end'0 s v (Seq.length s + 1) leader_counts)

let recompute_high_watermark (log_end'0: Int64.t) (follower_offsets: Slice64.slice Int64.t) (majority: UInt64.t)
  (epoch_start_offset: Int64.t) (current_hwm: Int64.t) (leader_counts: bool) (return (x: Int64.t)) =
{[@stop_split] [@expl:recompute_high_watermark requires] ([@stop_split] [@expl:recompute_high_watermark requires #0] [%#sconsensus] 1
      <= UInt64.t'int majority
    /\ UInt64.t'int majority <= Seq.length (Slice64.view follower_offsets) + 1)
  /\ ([@stop_split] [@expl:recompute_high_watermark requires #1] [%#sconsensus'0] leader_counts
    \/ UInt64.t'int majority <= Seq.length (Slice64.view follower_offsets))
  /\ ([@stop_split] [@expl:recompute_high_watermark requires #2] [%#sconsensus'1] Int64.to_int current_hwm
    <= Int64.to_int log_end'0)
  /\ ([@stop_split] [@expl:recompute_high_watermark requires #3] [%#sconsensus'2] forall k: int. 0 <= k
      /\ k < Seq.length (Slice64.view follower_offsets)
    -> Int64.to_int (Seq.get (Slice64.view follower_offsets) k) <= Int64.to_int log_end'0)}
  any
  [ return (result: Int64.t) ->
  {[@stop_split] [@expl:recompute_high_watermark ensures] ([@stop_split] [@expl:recompute_high_watermark ensures #0] [%#sconsensus'3] ge_log_Int (Int64.to_int result) (Int64.to_int current_hwm))
    /\ ([@stop_split] [@expl:recompute_high_watermark ensures #1] [%#sconsensus'4] Int64.to_int result
      <= Int64.to_int log_end'0)
    /\ ([@stop_split] [@expl:recompute_high_watermark ensures #2] [%#sconsensus'5] forall v: int. gt_log_Int v (Int64.to_int epoch_start_offset)
          /\ ge_log_Int (count_ge (Int64.to_int log_end'0) (Slice64.view follower_offsets) v leader_counts) (UInt64.t'int majority)
        -> v <= Int64.to_int result)
    /\ ([@stop_split] [@expl:recompute_high_watermark ensures #3] [%#sconsensus'6] gt_log_Int (Int64.to_int result) (Int64.to_int current_hwm)
    -> gt_log_Int (Int64.to_int result) (Int64.to_int epoch_start_offset)
    /\ ge_log_Int (count_ge (Int64.to_int log_end'0) (Slice64.view follower_offsets) (Int64.to_int result) leader_counts) (UInt64.t'int majority))}
    (! return {result}) ]

type t_FetchVisibility = {
  out_of_range: bool;
  empty: bool;
  limit_offset: Int64.t;
  effective_lso: Int64.t;
  read_committed_aborts: bool;
  response_hw: Int64.t;
  response_lso: Int64.t }

function offset_min [#"/workspace/crates/verified/src/broker.rs" 225 0 225 40] (a: int) (b: int) : int
 = [%#sbroker'7] if a <= b then a else b

function fetch_limit_model [#"/workspace/crates/verified/src/broker.rs" 239 0 239 92] (is_follower: bool) (read_committed: bool) (w: t_FetchWatermarks) : int
 = [%#sbroker'8] if is_follower then
    Int64.to_int w.log_end
  else
    if read_committed then
      offset_min (offset_min (Int64.to_int w.hw) (Int64.to_int w.deliverable)) (Int64.to_int w.lso)
    else
      offset_min (Int64.to_int w.hw) (Int64.to_int w.deliverable)



let fetch_visibility (is_follower: bool) (read_committed: bool) (w: t_FetchWatermarks) (fetch_offset: Int64.t)
  (return (x: t_FetchVisibility)) = any
  [ return (result: t_FetchVisibility) ->
  {[@stop_split] [@expl:fetch_visibility ensures] ([@stop_split] [@expl:fetch_visibility ensures #0] [%#sbroker] result.out_of_range
      = (Int64.to_int fetch_offset < Int64.to_int w.log_start))
    /\ ([@stop_split] [@expl:fetch_visibility ensures #1] [%#sbroker'0] result.empty
      = (not result.out_of_range
      /\ ge_log_Int (Int64.to_int fetch_offset) (if is_follower then
        Int64.to_int w.log_end
      else
        offset_min (Int64.to_int w.hw) (Int64.to_int w.deliverable)
      )))
    /\ ([@stop_split] [@expl:fetch_visibility ensures #2] [%#sbroker'1] Int64.to_int result.limit_offset
      = fetch_limit_model is_follower read_committed w)
    /\ ([@stop_split] [@expl:fetch_visibility ensures #3] [%#sbroker'2] not is_follower
      -> Int64.to_int result.limit_offset <= Int64.to_int w.hw
      /\ Int64.to_int result.limit_offset <= Int64.to_int w.deliverable
      /\ (read_committed -> Int64.to_int result.limit_offset <= Int64.to_int w.lso))
    /\ ([@stop_split] [@expl:fetch_visibility ensures #4] [%#sbroker'3] result.read_committed_aborts
      = (read_committed /\ not is_follower))
    /\ ([@stop_split] [@expl:fetch_visibility ensures #5] [%#sbroker'4] Int64.to_int result.effective_lso
      = (if result.read_committed_aborts then
        offset_min (Int64.to_int w.lso) (Int64.to_int w.hw)
      else
        Int64.to_int w.lso
      ))
    /\ ([@stop_split] [@expl:fetch_visibility ensures #6] [%#sbroker'5] result.response_hw = w.hw)
    /\ ([@stop_split] [@expl:fetch_visibility ensures #7] [%#sbroker'6] Int64.to_int result.response_lso
    = offset_min (Int64.to_int w.lso) (Int64.to_int w.hw))}
    (! return {result}) ]

function lemma_count_ge_prefix_monotone [#"/workspace/crates/verified/src/consensus.rs" 308 0 315 1] (log_end'0: int) (s: Seq.seq Int64.t) (low: int) (high: int) (limit: int) (leader_counts: bool) : ()

axiom lemma_count_ge_prefix_monotone_spec:
  forall log_end'0: int, s: Seq.seq Int64.t, low: int, high: int, limit: int, leader_counts: bool. ([%#sconsensus'8] 0
        <= limit
      /\ limit <= Seq.length s + 1)
    -> ([%#sconsensus'9] low <= high)
    -> ([%#sconsensus'10] ge_log_Int (count_ge_prefix log_end'0 s low limit leader_counts) (count_ge_prefix log_end'0 s high limit leader_counts))

type tup2_i64_i64 = { f0: Int64.t; f1: Int64.t }

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let quorum_commit_bounds_fetch [#"/workspace/crates/verified/src/composition.rs" 139 0 146 15]
  (followers: Slice64.slice Int64.t) (majority: UInt64.t) (epoch_start: Int64.t) (current': Int64.t)
  (leader_counts: bool) (w: t_FetchWatermarks) (return (x: tup2_i64_i64)) =
{[@stop_split] [@expl:quorum_commit_bounds_fetch requires] ([@stop_split] [@expl:quorum_commit_bounds_fetch requires #0] [%#scomposition'4] 1
      <= UInt64.t'int majority
    /\ UInt64.t'int majority <= Seq.length (Slice64.view followers) + 1)
  /\ ([@stop_split] [@expl:quorum_commit_bounds_fetch requires #1] [%#scomposition'5] leader_counts
    \/ UInt64.t'int majority <= Seq.length (Slice64.view followers))
  /\ ([@stop_split] [@expl:quorum_commit_bounds_fetch requires #2] [%#scomposition'6] Int64.to_int current'
    <= Int64.to_int w.log_end)
  /\ ([@stop_split] [@expl:quorum_commit_bounds_fetch requires #3] [%#scomposition'7] forall i: int. 0 <= i
      /\ i < Seq.length (Slice64.view followers)
    -> Int64.to_int (Seq.get (Slice64.view followers) i) <= Int64.to_int w.log_end)}
  (! bb0
  [ bb0 = s0
    [ s0 = recompute_high_watermark [%#scomposition] {w.log_end} {followers} {majority} {epoch_start} {current'}
        {leader_counts} (fun (_x: Int64.t) -> [ &hw'0 <- _x ] s1)
    | s1 = [ &_48 <- { log_start = w.log_start;
                       hw = hw'0;
                       lso = w.lso;
                       log_end = w.log_end;
                       deliverable = w.deliverable } ] s2
    | s2 = fetch_visibility [%#scomposition'2] {[%#scomposition'0] false} {[%#scomposition'1] true} {_48} {w.log_start}
        (fun (_x: t_FetchVisibility) -> [ &_47 <- _x ] s3)
    | s3 = [ &limit <- _47.limit_offset ] s4
    | s4 = [ &_52 <- Int64.gt hw'0 current' ] s5
    | s5 = any [ br0 -> {_52 = false} (! bb5) | br1 -> {_52} (! bb3) ] ]
  | bb3 = s0
    [ s0 =
      {[@expl:assertion] [%#scomposition'3] let _ = lemma_count_ge_prefix_monotone (Int64.to_int w.log_end) (Slice64.view followers) (Int64.to_int limit) (Int64.to_int hw'0) (Seq.length (Slice64.view followers)
      + 1) leader_counts in ge_log_Int (count_ge (Int64.to_int w.log_end) (Slice64.view followers) (Int64.to_int limit) leader_counts) (UInt64.t'int majority)}
      s1
    | s1 = bb5 ]
  | bb5 = s0 [ s0 = [ &_ret <- { f0 = hw'0; f1 = limit } ] s1 | s1 = return {_ret} ] ]
  [ & _ret: tup2_i64_i64 = Any.any_l ()
  | & followers: Slice64.slice Int64.t = followers
  | & majority: UInt64.t = majority
  | & epoch_start: Int64.t = epoch_start
  | & current': Int64.t = current'
  | & leader_counts: bool = leader_counts
  | & w: t_FetchWatermarks = w
  | & hw'0: Int64.t = Any.any_l ()
  | & limit: Int64.t = Any.any_l ()
  | & _47: t_FetchVisibility = Any.any_l ()
  | & _48: t_FetchWatermarks = Any.any_l ()
  | & _52: bool = Any.any_l () ])
  [ return (result: tup2_i64_i64) ->
  {[@stop_split] [@expl:quorum_commit_bounds_fetch ensures] ([@stop_split] [@expl:quorum_commit_bounds_fetch ensures #0] [%#scomposition'8] Int64.to_int current'
        <= Int64.to_int result.f0
      /\ Int64.to_int result.f0 <= Int64.to_int w.log_end)
    /\ ([@stop_split] [@expl:quorum_commit_bounds_fetch ensures #1] [%#scomposition'9] Int64.to_int result.f1
      <= Int64.to_int result.f0)
    /\ ([@stop_split] [@expl:quorum_commit_bounds_fetch ensures #2] [%#scomposition'10] Int64.to_int result.f1
      = MinMax.min (MinMax.min (Int64.to_int result.f0) (Int64.to_int w.lso)) (Int64.to_int w.deliverable))
    /\ ([@stop_split] [@expl:quorum_commit_bounds_fetch ensures #3] [%#scomposition'11] forall v: int. gt_log_Int v (Int64.to_int epoch_start)
          /\ ge_log_Int (count_ge (Int64.to_int w.log_end) (Slice64.view followers) v leader_counts) (UInt64.t'int majority)
        -> v <= Int64.to_int result.f0)
    /\ ([@stop_split] [@expl:quorum_commit_bounds_fetch ensures #4] [%#scomposition'12] gt_log_Int (Int64.to_int result.f0) (Int64.to_int current')
    -> ge_log_Int (count_ge (Int64.to_int w.log_end) (Slice64.view followers) (Int64.to_int result.f1) leader_counts) (UInt64.t'int majority))}
    (! return {result}) ]
