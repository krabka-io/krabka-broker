meta "rewrite_def" predicate well_founded_relation_Int

predicate in_bounds_usize [@inline:trivial] (self: UInt64.t) (seq: Seq.seq tup2_u64_u64) =
  [%#sslice] UInt64.t'int self < Seq.length seq

