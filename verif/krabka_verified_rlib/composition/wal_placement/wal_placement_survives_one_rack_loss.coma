let select_wal_voters (candidates: Slice64.slice tup2_u64_u64) (local_node: UInt64.t) (requested: UInt64.t)
  (return (x: t_Vec_tup2_u64_u64_Global)) = any
  [ return (result: t_Vec_tup2_u64_u64_Global) ->
