      \/ (forall i: int. 0 <= i /\ i < Seq.length (Slice64.view candidates)
        -> (Seq.get (Slice64.view candidates) i).f0 <> local_node)))
    /\ ([@stop_split] [@expl:select_wal_voters ensures #2] [%#sselect_wal_voters'1] gt_log_Int (Seq.length (view_Vec_tup2_u64_u64_Global result)) 0
      -> (Seq.get (view_Vec_tup2_u64_u64_Global result) 0).f0 = local_node)
    /\ ([@stop_split] [@expl:select_wal_voters ensures #3] [%#sselect_wal_voters'2] forall i: int. 0 <= i
          /\ i < Seq.length (view_Vec_tup2_u64_u64_Global result)
        -> (exists j: int. 0 <= j
          /\ j < Seq.length (Slice64.view candidates)
          /\ Seq.get (view_Vec_tup2_u64_u64_Global result) i = Seq.get (Slice64.view candidates) j))
    /\ ([@stop_split] [@expl:select_wal_voters ensures #4] [%#sselect_wal_voters'3] forall i: int, j: int. 0 <= i
          /\ i < j /\ j < Seq.length (view_Vec_tup2_u64_u64_Global result)
        -> (Seq.get (view_Vec_tup2_u64_u64_Global result) i).f0 <> (Seq.get (view_Vec_tup2_u64_u64_Global result) j).f0
        /\ (Seq.get (view_Vec_tup2_u64_u64_Global result) i).f1 <> (Seq.get (view_Vec_tup2_u64_u64_Global result) j).f1)
    /\ ([@stop_split] [@expl:select_wal_voters ensures #5] [%#sselect_wal_voters'4] 0
        < Seq.length (view_Vec_tup2_u64_u64_Global result)
      /\ Seq.length (view_Vec_tup2_u64_u64_Global result) < UInt64.t'int requested
    -> (forall i: int. 0 <= i /\ i < Seq.length (Slice64.view candidates)
      -> (exists j: int. 0 <= j
        /\ j < Seq.length (view_Vec_tup2_u64_u64_Global result)
        /\ ((Seq.get (Slice64.view candidates) i).f0 = (Seq.get (view_Vec_tup2_u64_u64_Global result) j).f0
        \/ (Seq.get (Slice64.view candidates) i).f1 = (Seq.get (view_Vec_tup2_u64_u64_Global result) j).f1))))}
    (! return {result}) ]

