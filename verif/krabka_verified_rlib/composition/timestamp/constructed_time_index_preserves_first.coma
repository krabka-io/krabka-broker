        -> Int64.to_int (Seq.get (view_Vec_tup2_i64_u32_Global result.f0'1) i).f0
          <= Int64.to_int (Seq.get (view_Vec_tup2_i64_u32_Global result.f0'1) j).f0
        /\ UInt32.t'int (Seq.get (view_Vec_tup2_i64_u32_Global result.f0'1) i).f1
        < UInt32.t'int (Seq.get (view_Vec_tup2_i64_u32_Global result.f0'1) j).f1)
    /\ ([@stop_split] [@expl:constructed_time_index_preserves_first ensures #3] [%#stimestamp'25] forall i: int, j: int. 0
            <= i
          /\ i < Seq.length (view_Vec_tup2_i64_u32_Global result.f0'1)
          /\ 0 <= j
          /\ j < Seq.length (Slice64.view offsets)
          /\ UInt32.t'int (Seq.get (Slice64.view offsets) j)
          <= UInt32.t'int (Seq.get (view_Vec_tup2_i64_u32_Global result.f0'1) i).f1
        -> Int64.to_int (Seq.get (Slice64.view timestamps) j)
        <= Int64.to_int (Seq.get (view_Vec_tup2_i64_u32_Global result.f0'1) i).f0)
    /\ ([@stop_split] [@expl:constructed_time_index_preserves_first ensures #4] [%#stimestamp'26] match result.f1'1 with
      | Some index -> UInt64.t'int index < Seq.length (Slice64.view timestamps)
      /\ ge_log_Int (Int64.to_int (Seq.get (Slice64.view timestamps) (UInt64.t'int index))) (Int64.to_int target)
      /\ (forall i: int. 0 <= i /\ i < UInt64.t'int index
        -> Int64.to_int (Seq.get (Slice64.view timestamps) i) < Int64.to_int target)
      | None -> forall i: int. 0 <= i /\ i < Seq.length (Slice64.view timestamps)
        -> Int64.to_int (Seq.get (Slice64.view timestamps) i) < Int64.to_int target
      end)}
    (! return {result}) ]
