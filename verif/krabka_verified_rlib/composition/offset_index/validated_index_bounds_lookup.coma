  {[@stop_split] [@expl:restore_offset_index_entry_valid ensures] [%#srestore_producer_ids_strict] result
    = (UInt32.t'int relative_offset <= Int64.to_int max_relative
    /\ UInt32.t'int position < UInt64.t'int log_bytes
    /\ match previous with
      | Some {f0 = previous_relative; f1 = previous_position} -> UInt32.t'int previous_relative
        < UInt32.t'int relative_offset
      /\ UInt32.t'int previous_position < UInt32.t'int position
      | None -> true
