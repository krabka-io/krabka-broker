          -> gt_log_Int (UInt32.t'int (Seq.get (Slice64.view entries) j).f0) (UInt32.t'int target))))
    /\ ([@stop_split] [@expl:offset_index_lookup ensures #1] [%#slog_index'1] (forall i: int. 0 <= i
          /\ i < Seq.length (Slice64.view entries)
        -> gt_log_Int (UInt32.t'int (Seq.get (Slice64.view entries) i).f0) (UInt32.t'int target))
    -> UInt32.t'int result = 0)}
    (! return {result}) ]

