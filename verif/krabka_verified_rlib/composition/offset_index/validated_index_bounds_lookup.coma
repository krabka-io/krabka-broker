let restore_offset_index_entry_valid (previous: t_Option_tup2_u32_u32) (relative_offset: UInt32.t) (position: UInt32.t)
  (max_relative: Int64.t) (log_bytes: UInt64.t) (return (x: bool)) = any
  [ return (result: bool) ->
  {[@stop_split] [@expl:restore_offset_index_entry_valid ensures] [%#srestore_producer_ids_strict] result
    = (UInt32.t'int relative_offset <= Int64.to_int max_relative
    /\ UInt32.t'int position < UInt64.t'int log_bytes
    /\ match previous with
      | Some {f0 = previous_relative; f1 = previous_position} -> UInt32.t'int previous_relative
        < UInt32.t'int relative_offset
      /\ UInt32.t'int previous_position < UInt32.t'int position
      | None -> true
      end)}
    (! return {result}) ]

let offset_index_lookup (entries: Slice64.slice tup2_u32_u32) (target: UInt32.t) (return (x: UInt32.t)) =
{[@stop_split] [@expl:offset_index_lookup requires] [%#slog_index] forall i: int, j: int. 0 <= i
