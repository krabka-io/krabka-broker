predicate wal_batch_layout [#"/workspace/crates/verified/src/wal.rs" 44 0 44 90] (bases: Seq.seq Int64.t) (lasts: Seq.seq Int64.t) (start: int) (target: int) =
  [%#swal'1] Seq.length bases = Seq.length lasts
  /\ (if start = target then
    Seq.length bases = 0
  else
    (forall i: int. 0 <= i /\ i < Seq.length bases
        -> Int64.le (Seq.get bases i) (Seq.get lasts i)
        /\ Int64.lt (Seq.get lasts i) const_MAX'0
        /\ Int64.to_int (Seq.get bases i) = (if i = 0 then start else Int64.to_int (Seq.get lasts (i - 1)) + 1))
    /\ target = (if Seq.length bases = 0 then start else Int64.to_int (Seq.get lasts (Seq.length bases - 1)) + 1)
  )

let wal_covering_batch_range (bases: Slice64.slice Int64.t) (lasts: Slice64.slice Int64.t) (start: Int64.t)
  (target: Int64.t) (return (x: t_Option_i64)) = any
  [ return (result: t_Option_i64) ->
  {[@stop_split] [@expl:wal_covering_batch_range ensures] ([@stop_split] [@expl:wal_covering_batch_range ensures #0] [%#swal] match result with
          | None'3 -> false
          | Some'3 _ -> true
          end
      = (0 <= Int64.to_int start
      /\ Int64.to_int start <= Int64.to_int target
      /\ Seq.length (Slice64.view bases) = Seq.length (Slice64.view lasts)
      /\ (if start = target then
        Seq.length (Slice64.view bases) = 0
      else
        gt_log_Int (Seq.length (Slice64.view bases)) 0
        /\ 0 <= Int64.to_int (Seq.get (Slice64.view bases) 0)
        /\ Int64.to_int (Seq.get (Slice64.view bases) 0) <= Int64.to_int start
        /\ Int64.to_int start <= Int64.to_int (Seq.get (Slice64.view lasts) 0)
        /\ wal_batch_layout (Slice64.view bases) (Slice64.view lasts) (Int64.to_int (Seq.get (Slice64.view bases) 0)) (Int64.to_int target)
      )))
    /\ ([@stop_split] [@expl:wal_covering_batch_range ensures #1] [%#swal'0] match result with
      | None'3 -> true
      | Some'3 physical -> Int64.to_int physical
        = (if Seq.length (Slice64.view bases) = 0 then
          Int64.to_int start
        else
          Int64.to_int (Seq.get (Slice64.view bases) 0)
        )
      /\ 0 <= Int64.to_int physical
      /\ Int64.to_int physical <= Int64.to_int start
      /\ Int64.to_int start <= Int64.to_int target
      /\ wal_batch_layout (Slice64.view bases) (Slice64.view lasts) (Int64.to_int physical) (Int64.to_int target)
      /\ (forall i: int. 0 <= i /\ i < Seq.length (Slice64.view bases)
        -> Int64.to_int physical <= Int64.to_int (Seq.get (Slice64.view bases) i)
        /\ Int64.to_int (Seq.get (Slice64.view bases) i) <= Int64.to_int (Seq.get (Slice64.view lasts) i)
        /\ Int64.to_int (Seq.get (Slice64.view lasts) i) < Int64.to_int target)
      end)}
    (! return {result}) ]

