      /\ Int64.to_int (Seq.get (Slice64.view activations) i) + Int64.to_int uncertainty <= Int64.to_int const_MAX
      /\ Int64.to_int (Seq.get (Slice64.view activations) i) + Int64.to_int uncertainty <= Int64.to_int now)}
    (! return {result}) ]

