        + UInt32.t'int (Seq.get (Slice64.view window.f0'2) i)) (Int64.to_int bounds.f1))
      | Ok'1 {f0'5 = lower_cursor; f1'5 = upper_cursor; f2'5 = scan; f3'5 = selected} -> time_segment_valid (Int64.to_int bounds.f0) (Int64.to_int bounds.f1)
      /\ (forall i: int. 0 <= i /\ i < Seq.length (Slice64.view window.f0'2)
          -> Int64.to_int bounds.f0 + UInt32.t'int (Seq.get (Slice64.view window.f0'2) i) <= Int64.to_int bounds.f1)
      /\ Int64.to_int bounds.f0 <= Int64.to_int scan
      /\ Int64.to_int scan <= Int64.to_int lower_cursor
      /\ Int64.to_int lower_cursor <= Int64.to_int upper_cursor
      /\ Int64.to_int upper_cursor <= Int64.to_int bounds.f1
      /\ (forall i: int. 0 <= i
            /\ i < Seq.length (Slice64.view window.f0'2)
            /\ Int64.to_int bounds.f0 + UInt32.t'int (Seq.get (Slice64.view window.f0'2) i) < Int64.to_int scan
          -> Int64.to_int (Seq.get (Slice64.view window.f1'2) i) < Int64.to_int targets.f0'0)
      /\ match selected with
        | None -> forall i: int. 0 <= i /\ i < Seq.length (Slice64.view window.f0'2)
          -> Int64.to_int bounds.f0 + UInt32.t'int (Seq.get (Slice64.view window.f0'2) i) < Int64.to_int bounds.f2
          \/ Int64.to_int (Seq.get (Slice64.view window.f1'2) i) < Int64.to_int targets.f0'0
          \/ gt_log_Int (Int64.to_int (Seq.get (Slice64.view window.f1'2) i)) (Int64.to_int targets.f1'0)
        | Some index -> UInt64.t'int index < Seq.length (Slice64.view window.f0'2)
        /\ ge_log_Int (Int64.to_int bounds.f0
          + UInt32.t'int (Seq.get (Slice64.view window.f0'2) (UInt64.t'int index))) (Int64.to_int bounds.f2)
        /\ ge_log_Int (Int64.to_int bounds.f0
          + UInt32.t'int (Seq.get (Slice64.view window.f0'2) (UInt64.t'int index))) (Int64.to_int scan)
        /\ Int64.to_int targets.f0'0 <= Int64.to_int (Seq.get (Slice64.view window.f1'2) (UInt64.t'int index))
        /\ Int64.to_int (Seq.get (Slice64.view window.f1'2) (UInt64.t'int index)) <= Int64.to_int targets.f1'0
        /\ (forall i: int. 0 <= i /\ i < UInt64.t'int index
          -> Int64.to_int bounds.f0 + UInt32.t'int (Seq.get (Slice64.view window.f0'2) i) < Int64.to_int bounds.f2
          \/ Int64.to_int (Seq.get (Slice64.view window.f1'2) i) < Int64.to_int targets.f0'0
          \/ gt_log_Int (Int64.to_int (Seq.get (Slice64.view window.f1'2) i)) (Int64.to_int targets.f1'0))
        end
      end}
    (! return {result}) ]
