type tup2_i64_u32 = { f0: Int64.t; f1: UInt32.t }

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

let time_index_scan_start (entries: Slice64.slice tup2_i64_u32) (target_timestamp: Int64.t) (return (x: UInt32.t)) =
{[@stop_split] [@expl:time_index_scan_start requires] [%#slog_index] forall i: int, j: int. 0 <= i
      /\ i < j /\ j < Seq.length (Slice64.view entries)
    -> Int64.to_int (Seq.get (Slice64.view entries) i).f0 <= Int64.to_int (Seq.get (Slice64.view entries) j).f0}
  any
  [ return (result: UInt32.t) ->
  {[@stop_split] [@expl:time_index_scan_start ensures] ([@stop_split] [@expl:time_index_scan_start ensures #0] [%#slog_index'0] (exists i: int. 0
            <= i
          /\ i < Seq.length (Slice64.view entries)
          /\ Int64.to_int (Seq.get (Slice64.view entries) i).f0 < Int64.to_int target_timestamp)
      -> (exists i: int. 0 <= i
        /\ i < Seq.length (Slice64.view entries)
        /\ Int64.to_int (Seq.get (Slice64.view entries) i).f0 < Int64.to_int target_timestamp
        /\ UInt32.t'int result = UInt32.t'int (Seq.get (Slice64.view entries) i).f1
        /\ (forall j: int. i < j /\ j < Seq.length (Slice64.view entries)
          -> ge_log_Int (Int64.to_int (Seq.get (Slice64.view entries) j).f0) (Int64.to_int target_timestamp))))
    /\ ([@stop_split] [@expl:time_index_scan_start ensures #1] [%#slog_index'1] (forall i: int. 0 <= i
          /\ i < Seq.length (Slice64.view entries)
        -> ge_log_Int (Int64.to_int (Seq.get (Slice64.view entries) i).f0) (Int64.to_int target_timestamp))
    -> UInt32.t'int result = 0)}
    (! return {result}) ]

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

let len_u32 (self_: Slice64.slice UInt32.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sslice] Seq.length (Slice64.view self_)
    = UInt64.t'int result}
    (! return {result}) ]

type t_RangeFrom_usize = { start: UInt64.t }

predicate in_bounds_RangeFrom_usize (self: t_RangeFrom_usize) (seq: Seq.seq Int64.t) =
  [%#sslice'2] UInt64.t'int self.start <= Seq.length seq

predicate has_value_RangeFrom_usize (self: t_RangeFrom_usize) (seq: Seq.seq Int64.t) (out: Slice64.slice Int64.t) =
  [%#sslice'3] Seq.([..]) seq (UInt64.t'int self.start) (Seq.length seq) = Slice64.view out

let index_slice_i64 (self_: Slice64.slice Int64.t) (ix: t_RangeFrom_usize) (return (x: Slice64.slice Int64.t)) =
{[@stop_split] [@expl:index requires] [%#sslice'0] in_bounds_RangeFrom_usize ix (Slice64.view self_)}
  any
  [ return (result: Slice64.slice Int64.t) ->
  {[@stop_split] [@expl:index ensures] [%#sslice'1] has_value_RangeFrom_usize ix (Slice64.view self_) result}
    (! return {result}) ]

type t_Option_usize = None | Some UInt64.t

let first_timestamp_index (timestamps: Slice64.slice Int64.t) (target: Int64.t) (return (x: t_Option_usize)) = any
  [ return (result: t_Option_usize) ->
  {[@stop_split] [@expl:first_timestamp_index ensures] [%#stimestamp] match result with
      | Some index -> UInt64.t'int index < Seq.length (Slice64.view timestamps)
      /\ ge_log_Int (Int64.to_int (Seq.get (Slice64.view timestamps) (UInt64.t'int index))) (Int64.to_int target)
      /\ (forall i: int. 0 <= i /\ i < UInt64.t'int index
        -> Int64.to_int (Seq.get (Slice64.view timestamps) i) < Int64.to_int target)
      | None -> forall i: int. 0 <= i /\ i < Seq.length (Slice64.view timestamps)
        -> Int64.to_int (Seq.get (Slice64.view timestamps) i) < Int64.to_int target
      end}
    (! return {result}) ]

type t_Option_Infallible = None'0 | Some'0 ()

type t_ControlFlow_Option_Infallible_usize = Continue UInt64.t | Break t_Option_Infallible

predicate inv_Infallible [@inline:trivial] (_1: ()) = false

meta "rewrite_def" predicate inv_Infallible

predicate inv_Option_Infallible (_1: t_Option_Infallible)

axiom inv_axiom [@rewrite]: forall x: t_Option_Infallible [inv_Option_Infallible x]. inv_Option_Infallible x
    = match x with
      | None'0 -> true
      | Some'0 f0'0 -> inv_Infallible f0'0
      end

predicate inv_ControlFlow_Option_Infallible_usize (_1: t_ControlFlow_Option_Infallible_usize)

axiom inv_axiom'0 [@rewrite]:
  forall x: t_ControlFlow_Option_Infallible_usize [inv_ControlFlow_Option_Infallible_usize x]. inv_ControlFlow_Option_Infallible_usize x
    = match x with
      | Continue f0'0 -> true
      | Break f0'0 -> inv_Option_Infallible f0'0
      end

let branch_Option_usize (self_: t_Option_usize) (return (x: t_ControlFlow_Option_Infallible_usize)) = any
  [ return (result: t_ControlFlow_Option_Infallible_usize) ->
  {[@stop_split] [@expl:branch_Option_usize ensures] ([@stop_split] [@expl:branch result type invariant] inv_ControlFlow_Option_Infallible_usize result)
    /\ ([@stop_split] [@expl:branch ensures] [%#sops] match self_ with
      | Some v -> result = Continue v
      | None -> result = Break (None'0)
      end)}
    (! return {result}) ]

let elim_Break (_x: t_ControlFlow_Option_Infallible_usize) (return (f0'0: t_Option_Infallible)) = any
  [ _k (f0'0: t_Option_Infallible) -> {Break f0'0 = _x} (! return {f0'0})
  | _chk -> (! {[@expl:elim Break] match _x with
      | Break _ -> true
      | _ -> false
      end}
    any) ]

let from_residual_Option_usize (residual: t_Option_Infallible) (return (x: t_Option_usize)) =
{[@stop_split] [@expl:from_residual 'residual' type invariant] [%#sops'0] inv_Option_Infallible residual}
  any
  [ return (result: t_Option_usize) -> {[@stop_split] [@expl:from_residual ensures] [%#sops'1] result = None}
    (! return {result}) ]

let elim_Continue (_x: t_ControlFlow_Option_Infallible_usize) (return (f0'0: UInt64.t)) = any
  [ _k (f0'0: UInt64.t) -> {Continue f0'0 = _x} (! return {f0'0})
  | _chk -> (! {[@expl:elim Continue] match _x with
      | Continue _ -> true
