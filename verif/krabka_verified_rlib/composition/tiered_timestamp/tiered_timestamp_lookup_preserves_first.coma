          /\ i < Seq.length (Slice64.view local)
          /\ ge_log_Int (Int64.to_int (Seq.get (Slice64.view local) i).f0) (Int64.to_int minimum)
          /\ ge_log_Int (Int64.to_int (Seq.get (Slice64.view local) i).f1) (Int64.to_int target)
        -> Int64.to_int offset <= Int64.to_int (Seq.get (Slice64.view local) i).f0)
      | Unknown -> (forall i: int. 0 <= i /\ i < Seq.length (Slice64.view remote)
          -> Int64.to_int (Seq.get (Slice64.view remote) i).f0 < Int64.to_int minimum
          \/ Int64.to_int (Seq.get (Slice64.view remote) i).f1 < Int64.to_int target
          \/ ge_log_Int (Int64.to_int (Seq.get (Slice64.view remote) i).f0) (Int64.to_int bound))
      /\ (forall i: int. 0 <= i /\ i < Seq.length (Slice64.view local)
        -> Int64.to_int (Seq.get (Slice64.view local) i).f0 < Int64.to_int minimum
        \/ Int64.to_int (Seq.get (Slice64.view local) i).f1 < Int64.to_int target
        \/ ge_log_Int (Int64.to_int (Seq.get (Slice64.view local) i).f0) (Int64.to_int bound))
      end}
    (! return {result}) ]
