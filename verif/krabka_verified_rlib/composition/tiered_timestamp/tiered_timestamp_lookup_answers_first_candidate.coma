type t_ListOffsetsKind =
  | Unsupported
  | Earliest
  | Latest
  | MaxTimestamp
  | EarliestLocal
  | LatestTiered
  | EarliestPendingUpload
  | Timestamp

let list_offsets_kind (timestamp: Int64.t) (version: Int16.t) (return (x: t_ListOffsetsKind)) = any
  [ return (result: t_ListOffsetsKind) ->
  {[@stop_split] [@expl:list_offsets_kind ensures] [%#sselection_model] match result with
      | Earliest -> Int64.to_int timestamp = - 2
      | Latest -> Int64.to_int timestamp = - 1
      | MaxTimestamp -> Int64.to_int timestamp = - 3 /\ ge_log_Int (Int16.to_int version) 7
      | EarliestLocal -> Int64.to_int timestamp = - 4 /\ ge_log_Int (Int16.to_int version) 8
      | LatestTiered -> Int64.to_int timestamp = - 5 /\ ge_log_Int (Int16.to_int version) 9
      | EarliestPendingUpload -> Int64.to_int timestamp = - 6 /\ ge_log_Int (Int16.to_int version) 11
      | Timestamp -> ge_log_Int (Int64.to_int timestamp) 0
      | Unsupported -> Int64.to_int timestamp < - 6
      \/ Int64.to_int timestamp = - 6 /\ Int16.to_int version < 11
      \/ Int64.to_int timestamp = - 5 /\ Int16.to_int version < 9
      \/ Int64.to_int timestamp = - 4 /\ Int16.to_int version < 8
      \/ Int64.to_int timestamp = - 3 /\ Int16.to_int version < 7
      end}
    (! return {result}) ]

type t_ListOffsetsSelectionFacts = {
  kind: t_ListOffsetsKind;
  candidate_offset: Int64.t;
  candidate_timestamp: Int64.t;
  candidate_epoch: Int32.t;
  last_fetchable: Int64.t }

type t_ListOffsetsSelectionDecision = RejectMalformed | Unknown | Resolved Int64.t Int64.t Int32.t

function list_offsets_selection_model [#"/workspace/crates/verified/src/list_offsets/selection_model.rs" 158 0 160 33] (facts: t_ListOffsetsSelectionFacts) : t_ListOffsetsSelectionDecision
 = [%#sselection_model'0] if facts.kind = Unsupported
  \/ Int64.to_int facts.candidate_offset < - 1
  \/ Int32.to_int facts.candidate_epoch < - 1 \/ Int64.to_int facts.last_fetchable < 0 then
    RejectMalformed
  else
    if Int64.to_int facts.candidate_offset = - 1 then
      Unknown
    else
      if facts.kind = Earliest \/ facts.kind = EarliestLocal then
        Resolved (facts.candidate_offset) (facts.candidate_timestamp) (facts.candidate_epoch)
      else
        if facts.kind = Latest then
          Resolved (if Int64.to_int facts.last_fetchable < Int64.to_int facts.candidate_offset then
            facts.last_fetchable
          else
            facts.candidate_offset
          ) (facts.candidate_timestamp) (facts.candidate_epoch)
        else
          if Int64.to_int facts.candidate_offset < Int64.to_int facts.last_fetchable then
            Resolved (facts.candidate_offset) (facts.candidate_timestamp) (facts.candidate_epoch)
          else
            Unknown
        
      
    
  


