let%span swal_copy'1 = "/workspace/crates/verified/src/composition/wal_copy.rs" 21 10 21 21

use creusot.int.Int64
use creusot.int.Int32
use seq.Seq
use creusot.int.UInt8
use creusot.int.UInt64
use int.Int

type t_Vec_u8_Global

type tup3_i64_i32_Vec_u8_Global = { f0: Int64.t; f1: Int32.t; f2: t_Vec_u8_Global }

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_u8_Global (self: t_Vec_u8_Global) : Seq.seq UInt8.t

axiom view_Vec_u8_Global_spec:
  forall self: t_Vec_u8_Global [view_Vec_u8_Global self]. [%#svec] Seq.length (view_Vec_u8_Global self)
    <= UInt64.t'int const_MAX

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant batches : Seq.seq tup3_i64_i32_Vec_u8_Global

constant count : int

function wal_copy_byte_count [#"/workspace/crates/verified/src/composition/wal_copy.rs" 23 0 23 80] (batches: Seq.seq tup3_i64_i32_Vec_u8_Global) (count: int) : int

goal vc_wal_copy_byte_count: ([%#swal_copy'0] 0 <= count /\ count <= Seq.length batches)
  -> (if count = 0 then
    [@stop_split] [@expl:wal_copy_byte_count ensures] [%#swal_copy'1] ge_log_Int 0 0
  else
    (([@stop_split] [@expl:wal_copy_byte_count requires] [%#swal_copy'0] 0 <= count - 1
        /\ count - 1 <= Seq.length batches)
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#swal_copy] count) ([%#swal_copy] count - 1)))
    /\ (([@stop_split] [@expl:wal_copy_byte_count ensures] [%#swal_copy'1] ge_log_Int (wal_copy_byte_count batches (count
      - 1)) 0)
    -> ([@stop_split] [@expl:view ensures] [%#svec] Seq.length (view_Vec_u8_Global (Seq.get batches (count - 1)).f2)
      <= UInt64.t'int const_MAX)
    -> ([@stop_split] [@expl:wal_copy_byte_count ensures] [%#swal_copy'1] ge_log_Int (wal_copy_byte_count batches (count
      - 1)
    + Seq.length (view_Vec_u8_Global (Seq.get batches (count - 1)).f2)) 0))
  )
