    any) ]

let elim_Other (_x: t_FeatureKind) (return (dependencies_met: bool)) = any
  [ _k (dependencies_met: bool) -> {Other dependencies_met = _x} (! return {dependencies_met})
  | _chk -> (! {[@expl:elim Other] match _x with
      | Other _ -> true
      | _ -> false
      end}
    any) ]

let elim_MetadataVersion (_x: t_FeatureKind) (return (metadata_changed: bool)) = any
  [ _k (metadata_changed: bool) -> {MetadataVersion metadata_changed = _x} (! return {metadata_changed})
  | _chk -> (! {[@expl:elim MetadataVersion] match _x with
