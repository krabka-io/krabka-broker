predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

function feature_update_model [#"/workspace/crates/verified/src/features/feature_update_decision.rs" 14 0 14 79] (facts: t_FeatureUpdateFacts) : t_FeatureUpdateDecision
 = [%#sfeature_update_decision'2] match facts.update_type with
    | None -> UnknownUpdateType
    | Some update_type'0 -> let requested'0 = Int16.to_int facts.levels.requested in let current''0 = Int16.to_int facts.levels.current' in if requested'0
    < 0 then
      NegativeLevel
    else
      if not facts.all_nodes_support then
        UnsupportedByNode
      else
        if requested'0 < current''0 /\ update_type'0 = Upgrade then
          DowngradeWithoutFlag
        else
          if gt_log_Int requested'0 current''0 /\ update_type'0 <> Upgrade then
            DowngradeToNewerLevel
          else
            match facts.kind with
              | MetadataVersion metadata_changed -> if requested'0 < current''0 /\ metadata_changed then
                if update_type'0 = UnsafeDowngrade then UnsafeMetadataDowngrade else LossyMetadataDowngrade
              else
                EmitFeature

              | KRaftVersion -> if update_type'0 = Upgrade then
                UpgradeKRaft
              else
                if requested'0 <> current''0 then KRaftDowngrade else NoChange

              | Other dependencies_met -> if dependencies_met then EmitFeature else DependencyUnmet
              end




    end

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

meta "compute_max_steps" 1000000

