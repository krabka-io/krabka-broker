type t_FeatureUpdateType = Upgrade | SafeDowngrade | UnsafeDowngrade

type t_Option_FeatureUpdateType = None | Some t_FeatureUpdateType

type t_FeatureLevels = { requested: Int16.t; current': Int16.t }

type t_FeatureKind = MetadataVersion bool | KRaftVersion | Other bool

type t_FeatureUpdateFacts = {
  update_type: t_Option_FeatureUpdateType;
  levels: t_FeatureLevels;
  all_nodes_support: bool;
  kind: t_FeatureKind }

type t_FeatureUpdateDecision =
  | UnknownUpdateType
  | NegativeLevel
  | UnsupportedByNode
  | DowngradeWithoutFlag
  | DowngradeToNewerLevel
  | UnsafeMetadataDowngrade
  | LossyMetadataDowngrade
  | KRaftDowngrade
  | DependencyUnmet
  | EmitFeature
  | UpgradeKRaft
  | NoChange

let elim_Some (_x: t_Option_FeatureUpdateType) (return (f0: t_FeatureUpdateType)) = any
  [ _k (f0: t_FeatureUpdateType) -> {Some f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
      | _ -> false
