let is_none_i16 (self_: t_Option_i16) (return (x: bool)) = any
  [ return (result: bool) -> {[@stop_split] [@expl:is_none ensures] [%#soption'1] result = (self_ = None'0)}
    (! return {result}) ]

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

function finalized_or_zero [#"/workspace/crates/verified/src/features.rs" 107 0 107 54] (levels'0: t_FeatureLevels) : int
 = [%#sfeatures'17] match levels'0.finalized with
    | Some'0 level -> Int16.to_int level
    | None'0 -> 0
    end

predicate is_downgrade [#"/workspace/crates/verified/src/features.rs" 121 0 121 50] (levels'0: t_FeatureLevels) =
  [%#sfeatures'13] Int16.to_int levels'0.requested < finalized_or_zero levels'0

predicate direction_valid [#"/workspace/crates/verified/src/features.rs" 131 0 131 85] (update_type'0: t_FeatureUpdateType) (levels'0: t_FeatureLevels) =
  [%#sfeatures'14] if is_downgrade levels'0 then
    update_type'0 <> Upgrade
  else
    if gt_log_Int (Int16.to_int levels'0.requested) (finalized_or_zero levels'0) then update_type'0 = Upgrade else true


predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate metadata_downgrade_gates_hold [#"/workspace/crates/verified/src/features.rs" 149 0 149 71] (facts: t_FeatureUpdateFacts) =
  [%#sfeatures'15] match facts.metadata_version with
    | Some'1 mv -> not is_downgrade facts.levels
    \/ ge_log_Int (Int16.to_int facts.levels.requested) (Int16.to_int mv.online_downgrade_min_level)
    /\ mv.all_controllers_registered /\ mv.all_nodes_downgrade_capable
    | None'1 -> true
    end

predicate cleanup_required'0 [#"/workspace/crates/verified/src/features.rs" 179 0 179 58] (facts: t_FeatureUpdateFacts) =
  [%#sfeatures'12] match facts.metadata_version with
    | Some'1 mv -> mv.cleanup_required
    | None'1 -> false
    end

function feature_update_model [#"/workspace/crates/verified/src/features.rs" 217 0 217 79] (facts: t_FeatureUpdateFacts) : t_FeatureUpdateDecision
 = [%#sfeatures'9] match facts.update_type with
    | None -> UnknownUpdateType
    | Some update_type'0 -> let levels'0 = facts.levels in if Int16.to_int levels'0.requested < 0
    \/ gt_log_Int (Int16.to_int levels'0.requested) (Int16.to_int levels'0.max_supported) then
      OutOfSupportedRange
    else
      if not facts.cluster.all_nodes_support then
        UnsupportedByNode
      else
        if is_downgrade levels'0 /\ update_type'0 = Upgrade then
          DowngradeWithoutFlag
        else
          if not direction_valid update_type'0 levels'0 then
            DowngradeToNewerLevel
          else
            if not metadata_downgrade_gates_hold facts then
              match facts.metadata_version with
                | Some'1 mv -> if Int16.to_int levels'0.requested < Int16.to_int mv.online_downgrade_min_level then
                  OnlineDowngradeUnsupported
                else
                  if not mv.all_controllers_registered then UnregisteredController else NodeCannotDowngrade
                
                | None'1 -> NodeCannotDowngrade
                end
            else
              if gt_log_Int (Int16.to_int levels'0.requested) 0
              /\ Int16.to_int levels'0.requested < Int16.to_int levels'0.floor then
                BelowFloor
              else
                if not facts.cluster.dependencies_met then
                  DependencyUnmet
                else
                  if Int16.to_int levels'0.requested = 0 /\ levels'0.finalized = None'0 then
                    DeleteMissingFeature
                  else
                    if Int16.to_int levels'0.requested = 0 /\ update_type'0 = Upgrade then
                      DeleteWithoutFlag
                    else
                      if cleanup_required'0 facts /\ update_type'0 <> UnsafeDowngrade then
                        LossyDowngradeNotUnsafe
                      else
                        if cleanup_required'0 facts then EmitCleanupThenFeature else EmitFeature
                    
                  
                
              
            
          
        
      
    
    
    end

predicate emits [#"/workspace/crates/verified/src/features.rs" 269 0 269 53] (decision: t_FeatureUpdateDecision) =
  [%#sfeatures'10] decision = EmitFeature \/ decision = EmitCleanupThenFeature

predicate delete_valid [#"/workspace/crates/verified/src/features.rs" 167 0 167 82] (update_type'0: t_FeatureUpdateType) (levels'0: t_FeatureLevels) =
  [%#sfeatures'16] Int16.to_int levels'0.requested <> 0 \/ levels'0.finalized <> None'0 /\ update_type'0 <> Upgrade

predicate feature_update_admissible [#"/workspace/crates/verified/src/features.rs" 193 0 193 67] (facts: t_FeatureUpdateFacts) =
  [%#sfeatures'11] match facts.update_type with
    | None -> false
    | Some update_type'0 -> 0 <= Int16.to_int facts.levels.requested
    /\ Int16.to_int facts.levels.requested <= Int16.to_int facts.levels.max_supported
    /\ facts.cluster.all_nodes_support
    /\ direction_valid update_type'0 facts.levels
    /\ metadata_downgrade_gates_hold facts
    /\ (Int16.to_int facts.levels.requested = 0
      \/ ge_log_Int (Int16.to_int facts.levels.requested) (Int16.to_int facts.levels.floor))
    /\ facts.cluster.dependencies_met
    /\ delete_valid update_type'0 facts.levels /\ (not cleanup_required'0 facts \/ update_type'0 = UnsafeDowngrade)
    end

