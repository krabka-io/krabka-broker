use creusot.int.Int16
use creusot.prelude.Any
use int.Int

type t_FeatureUpdateType = Upgrade | SafeDowngrade | UnsafeDowngrade

type t_Option_FeatureUpdateType = None | Some t_FeatureUpdateType

type t_Option_i16 = None'0 | Some'0 Int16.t

type t_FeatureLevels = { requested: Int16.t; finalized: t_Option_i16; max_supported: Int16.t; floor: Int16.t }

type t_FeatureClusterFacts = { all_nodes_support: bool; dependencies_met: bool }

type t_MetadataVersionFacts = {
  online_downgrade_min_level: Int16.t;
  all_controllers_registered: bool;
  all_nodes_downgrade_capable: bool;
  cleanup_required: bool }

type t_Option_MetadataVersionFacts = None'1 | Some'1 t_MetadataVersionFacts

type t_FeatureUpdateFacts = {
  update_type: t_Option_FeatureUpdateType;
  levels: t_FeatureLevels;
  cluster: t_FeatureClusterFacts;
  metadata_version: t_Option_MetadataVersionFacts }

type t_FeatureUpdateDecision =
  | UnknownUpdateType
  | OutOfSupportedRange
  | UnsupportedByNode
  | DowngradeWithoutFlag
  | DowngradeToNewerLevel
  | OnlineDowngradeUnsupported
  | UnregisteredController
  | NodeCannotDowngrade
  | BelowFloor
  | DependencyUnmet
  | DeleteMissingFeature
  | DeleteWithoutFlag
  | LossyDowngradeNotUnsafe
  | EmitFeature
  | EmitCleanupThenFeature

let elim_Some (_x: t_Option_FeatureUpdateType) (return (f0: t_FeatureUpdateType)) = any
  [ _k (f0: t_FeatureUpdateType) -> {Some f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
      | _ -> false
      end}
    any) ]

predicate resolve_i16 [@inline:trivial] (_1: Int16.t) = true

meta "rewrite_def" predicate resolve_i16

let unwrap_or_i16 (self_: t_Option_i16) (default: Int16.t) (return (x: Int16.t)) = any
  [ return (result: Int16.t) ->
  {[@stop_split] [@expl:unwrap_or_i16 ensures] ([@stop_split] [@expl:unwrap_or ensures #0] [%#soption] self_ = None'0
      -> result = default)
    /\ ([@stop_split] [@expl:unwrap_or ensures #1] [%#soption'0] self_ = None'0
    \/ self_ = Some'0 result /\ resolve_i16 default)}
    (! return {result}) ]

let elim_Some'0 (_x: t_Option_MetadataVersionFacts) (return (f0: t_MetadataVersionFacts)) = any
  [ _k (f0: t_MetadataVersionFacts) -> {Some'1 f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some'1 _ -> true
      | _ -> false
