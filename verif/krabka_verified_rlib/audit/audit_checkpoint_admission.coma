    /\ ([@stop_split] [@expl:audit_checkpoint_admission ensures #2] [%#saudit'4] (result = RejectHead)
      = (signature_valid /\ not head_matches))
    /\ ([@stop_split] [@expl:audit_checkpoint_admission ensures #3] [%#saudit'5] (result = RejectSequence)
    = (signature_valid
    /\ head_matches
    /\ (UInt64.t'int expected_seq = 0 \/ UInt64.t'int checkpoint_seq_high + 1 <> UInt64.t'int expected_seq)))}
    (! return {result}) ]
