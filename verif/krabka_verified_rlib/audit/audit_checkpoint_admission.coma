  | bb6 = s0
    [ s0 = UInt64.sub [%#saudit'1] {expected_seq} {[%#saudit'0] (1: UInt64.t)} (fun (_x: UInt64.t) -> [ &_26 <- _x ] s1)
    | s1 = [ &_24 <- checkpoint_seq_high <> _26 ] s2
    | s2 = any [ br0 -> {_24 = false} (! bb9) | br1 -> {_24} (! bb8) ] ]
  | bb8 = s0 [ s0 = [ &_ret <- RejectSequence ] s1 | s1 = return {_ret} ]
  | bb9 = s0 [ s0 = [ &_ret <- Admit ] s1 | s1 = return {_ret} ]
  | bb3 = s0 [ s0 = [ &_ret <- RejectHead ] s1 | s1 = return {_ret} ]
  | bb1 = s0 [ s0 = [ &_ret <- RejectSignature ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_AuditCheckpointAdmission = Any.any_l ()
  | & signature_valid: bool = signature_valid
  | & head_matches: bool = head_matches
  | & expected_seq: UInt64.t = expected_seq
  | & checkpoint_seq_high: UInt64.t = checkpoint_seq_high
  | & _22: bool = Any.any_l ()
  | & _24: bool = Any.any_l ()
  | & _26: UInt64.t = Any.any_l () ])
  [ return (result: t_AuditCheckpointAdmission) ->
  {[@stop_split] [@expl:audit_checkpoint_admission ensures] ([@stop_split] [@expl:audit_checkpoint_admission ensures #0] [%#saudit'2] (result
        = Admit)
      = (signature_valid
      /\ head_matches
      /\ gt_log_Int (UInt64.t'int expected_seq) 0 /\ UInt64.t'int checkpoint_seq_high + 1 = UInt64.t'int expected_seq))
    /\ ([@stop_split] [@expl:audit_checkpoint_admission ensures #1] [%#saudit'3] (result = RejectSignature)
