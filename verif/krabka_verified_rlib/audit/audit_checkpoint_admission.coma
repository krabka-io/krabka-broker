  (return (x: t_AuditCheckpointAdmission)) = (! bb0
  [ bb0 = any [ br0 -> {signature_valid = false} (! bb1) | br1 -> {signature_valid} (! bb2) ]
  | bb2 = any [ br0 -> {head_matches = false} (! bb3) | br1 -> {head_matches} (! bb4) ]
