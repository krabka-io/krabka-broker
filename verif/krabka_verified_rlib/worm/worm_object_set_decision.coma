(* #"/workspace/crates/verified/src/worm.rs" 123 0 123 83 *)

let%span sworm = "/workspace/crates/verified/src/worm.rs" 124 29 124 30
let%span sworm'0 = "/workspace/crates/verified/src/worm.rs" 121 10 121 48
let%span sworm'1 = "/workspace/crates/verified/src/worm.rs" 99 8 115 9

use creusot.int.UInt64
use creusot.prelude.Any

type t_WormObjectIdentityFacts = { unique_keys: bool; coordinates_match: bool }

type t_WormObjectAvailabilityFacts = { all_present: bool; sizes_match: bool }

type t_WormDigestFacts = { require_digests: bool; digests_match: bool }

type t_WormObjectSetFacts = {
  object_count: UInt64.t;
  listed_count: UInt64.t;
  identity: t_WormObjectIdentityFacts;
  availability: t_WormObjectAvailabilityFacts;
  digests: t_WormDigestFacts }

type t_WormObjectSetDecision =
  | Empty
  | DuplicateKey
  | CoordinateMismatch
  | MissingObject
  | CountMismatch
  | SizeMismatch
  | DigestMismatch
  | Admit

function worm_object_set_model [#"/workspace/crates/verified/src/worm.rs" 97 0 97 76] (facts: t_WormObjectSetFacts) : t_WormObjectSetDecision
 = [%#sworm'1] if UInt64.t'int facts.object_count = 0 then
    Empty
  else
    if not facts.identity.unique_keys then
      DuplicateKey
    else
      if not facts.identity.coordinates_match then
        CoordinateMismatch
      else
        if not facts.availability.all_present then
          MissingObject
        else
          if UInt64.t'int facts.object_count <> UInt64.t'int facts.listed_count then
            CountMismatch
          else
            if not facts.availability.sizes_match then
              SizeMismatch
            else
              if facts.digests.require_digests /\ not facts.digests.digests_match then DigestMismatch else Admit
          
        
      
    
  


meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let worm_object_set_decision [#"/workspace/crates/verified/src/worm.rs" 123 0 123 83] (facts: t_WormObjectSetFacts)
  (return (x: t_WormObjectSetDecision)) = (! bb0
  [ bb0 = s0
    [ s0 = [ &_4 <- facts.object_count = ([%#sworm] (0: UInt64.t)) ] s1
    | s1 = any [ br0 -> {_4 = false} (! bb2) | br1 -> {_4} (! bb1) ] ]
  | bb1 = s0 [ s0 = [ &_ret <- Empty ] s1 | s1 = return {_ret} ]
  | bb2 = any [ br0 -> {facts.identity.unique_keys = false} (! bb3) | br1 -> {facts.identity.unique_keys} (! bb4) ]
  | bb4 = any
    [ br0 -> {facts.identity.coordinates_match = false} (! bb5) | br1 -> {facts.identity.coordinates_match} (! bb6) ]
  | bb6 = any
    [ br0 -> {facts.availability.all_present = false} (! bb7) | br1 -> {facts.availability.all_present} (! bb8) ]
  | bb8 = s0
    [ s0 = [ &_9 <- facts.object_count <> facts.listed_count ] s1
    | s1 = any [ br0 -> {_9 = false} (! bb10) | br1 -> {_9} (! bb9) ] ]
  | bb9 = s0 [ s0 = [ &_ret <- CountMismatch ] s1 | s1 = return {_ret} ]
  | bb10 = any
    [ br0 -> {facts.availability.sizes_match = false} (! bb11) | br1 -> {facts.availability.sizes_match} (! bb12) ]
  | bb12 = any
    [ br0 -> {facts.digests.require_digests = false} (! bb15) | br1 -> {facts.digests.require_digests} (! bb13) ]
  | bb13 = any [ br0 -> {facts.digests.digests_match = false} (! bb14) | br1 -> {facts.digests.digests_match} (! bb15) ]
  | bb14 = s0 [ s0 = [ &_ret <- DigestMismatch ] s1 | s1 = return {_ret} ]
  | bb15 = s0 [ s0 = [ &_ret <- Admit ] s1 | s1 = return {_ret} ]
  | bb11 = s0 [ s0 = [ &_ret <- SizeMismatch ] s1 | s1 = return {_ret} ]
  | bb7 = s0 [ s0 = [ &_ret <- MissingObject ] s1 | s1 = return {_ret} ]
  | bb5 = s0 [ s0 = [ &_ret <- CoordinateMismatch ] s1 | s1 = return {_ret} ]
  | bb3 = s0 [ s0 = [ &_ret <- DuplicateKey ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_WormObjectSetDecision = Any.any_l ()
  | & facts: t_WormObjectSetFacts = facts
  | & _4: bool = Any.any_l ()
  | & _9: bool = Any.any_l () ])
  [ return (result: t_WormObjectSetDecision) ->
  {[@stop_split] [@expl:worm_object_set_decision ensures] [%#sworm'0] result = worm_object_set_model facts}
    (! return {result}) ]
