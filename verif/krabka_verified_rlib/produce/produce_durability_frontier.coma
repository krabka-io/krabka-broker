let from_residual_Option_i64 (residual: t_Option_Infallible) (return (x: t_Option_i64)) =
{[@stop_split] [@expl:from_residual 'residual' type invariant] [%#sops'0] inv_Option_Infallible residual}
  any
  [ return (result: t_Option_i64) -> {[@stop_split] [@expl:from_residual ensures] [%#sops'1] result = None}
