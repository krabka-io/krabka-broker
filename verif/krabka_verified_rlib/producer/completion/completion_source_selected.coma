(* #"/workspace/crates/verified/src/producer/completion.rs" 20 0 20 76 *)

let%span scompletion = "/workspace/crates/verified/src/producer/completion.rs" 19 10 19 91

use creusot.int.UInt64
use seq.Seq
use int.Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant selected : Seq.seq UInt64.t

constant source : int

predicate completion_source_selected [#"/workspace/crates/verified/src/producer/completion.rs" 20 0 20 76] (selected: Seq.seq UInt64.t) (source: int)

goal vc_completion_source_selected:
  [@stop_split] [@expl:completion_source_selected ensures] [%#scompletion] (exists j: int. 0 <= j
      /\ j < Seq.length selected /\ UInt64.t'int (Seq.get selected j) = source)
  = (exists j: int. 0 <= j /\ j < Seq.length selected /\ UInt64.t'int (Seq.get selected j) = source)
