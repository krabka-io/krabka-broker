let len_i64 (self_: Slice64.slice Int64.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sslice] Seq.length (Slice64.view self_)
    = UInt64.t'int result}
    (! return {result}) ]

type t_Option_i16 = None | Some Int16.t

let elim_Some (_x: t_Option_i16) (return (f0: Int16.t)) = any
  [ _k (f0: Int16.t) -> {Some f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
      | _ -> false
      end}
    any) ]

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

let from_usize (small: bool) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:from ensures] [%#sconvert] result = UInt64.of_bool small}
    (! return {result}) ]

constant const_MIN: UInt64.t = (0: UInt64.t)

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

let saturating_sub (self_: UInt64.t) (rhs: UInt64.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:saturating_sub ensures] ([@stop_split] [@expl:saturating_sub ensures #0] [%#snum] ge_log_Int (UInt64.t'int self_
          - UInt64.t'int rhs) (UInt64.t'int const_MIN)
        /\ UInt64.t'int self_ - UInt64.t'int rhs <= UInt64.t'int const_MAX
      -> UInt64.t'int result = UInt64.t'int self_ - UInt64.t'int rhs)
    /\ ([@stop_split] [@expl:saturating_sub ensures #1] [%#snum'0] UInt64.t'int self_ - UInt64.t'int rhs
        < UInt64.t'int const_MIN -> UInt64.t'int result = UInt64.t'int const_MIN)
    /\ ([@stop_split] [@expl:saturating_sub ensures #2] [%#snum'1] gt_log_Int (UInt64.t'int self_
      - UInt64.t'int rhs) (UInt64.t'int const_MAX) -> UInt64.t'int result = UInt64.t'int const_MAX)}
    (! return {result}) ]

type t_Vec_usize_Global

function view_Vec_usize_Global (self: t_Vec_usize_Global) : Seq.seq UInt64.t

axiom view_Vec_usize_Global_spec:
  forall self: t_Vec_usize_Global [view_Vec_usize_Global self]. [%#svec'0] Seq.length (view_Vec_usize_Global self)
    <= UInt64.t'int const_MAX

let with_capacity_usize (capacity: UInt64.t) (return (x: t_Vec_usize_Global)) = any
  [ return (result: t_Vec_usize_Global) ->
  {[@stop_split] [@expl:with_capacity ensures] [%#svec] Seq.length (view_Vec_usize_Global result) = 0}
    (! return {result}) ]

let push_usize (self_: MutBorrow.t t_Vec_usize_Global) (v: UInt64.t) (return (x: ())) = any
  [ return (result: ()) -> {[@stop_split] [@expl:push ensures] [%#svec'1] view_Vec_usize_Global self_.final
    = Seq.snoc (view_Vec_usize_Global self_.current) v}
    (! return {result}) ]

type tup2_i64_i64 = { f0: Int64.t; f1: Int64.t }

predicate pairwise_i64 [#"/workspace/crates/verified/src/sequence.rs" 20 0 20 95] (values: Seq.seq Int64.t) (relation: Map.map tup2_i64_i64 bool) =
  [%#ssequence'0] forall i: int, j: int. 0 <= i /\ i < j /\ j < Seq.length values
    -> Map.get relation { f0 = Seq.get values i; f1 = Seq.get values j }

predicate strictly_increasing_i64 [#"/workspace/crates/verified/src/sequence.rs" 13 0 13 73] (values: Seq.seq Int64.t) =
  [%#ssequence] pairwise_i64 values (fun (__0: tup2_i64_i64) -> let {f0 = left; f1 = right} = __0 in Int64.to_int left
  < Int64.to_int right)

predicate insertion_ordered [#"/workspace/crates/verified/src/producer/completion/coverage/order.rs" 13 0 13 85] (ends: Seq.seq Int64.t) (incoming: Int64.t) (position: int) =
  [%#sorder] strictly_increasing_i64 ends
  /\ (forall i: int. 0 <= i /\ i < position -> Int64.to_int (Seq.get ends i) < Int64.to_int incoming)
  /\ (forall i: int. position <= i /\ i < Seq.length ends -> Int64.to_int incoming < Int64.to_int (Seq.get ends i))

function completion_offset [#"/workspace/crates/verified/src/producer/completion.rs" 7 0 7 74] (ends: Seq.seq Int64.t) (incoming: Int64.t) (index: int) : int
 = [%#scompletion'51] if index = Seq.length ends then Int64.to_int incoming else Int64.to_int (Seq.get ends index)

predicate five_completions_above [#"/workspace/crates/verified/src/producer/completion.rs" 141 0 146 9] (ends: Seq.seq Int64.t) (incoming: Int64.t) (selected: Seq.seq UInt64.t) (candidate: int) =
  [%#scompletion'52] Seq.length selected = 5
  /\ (forall j: int. 0 <= j /\ j < Seq.length selected
    -> candidate < completion_offset ends incoming (UInt64.t'int (Seq.get selected j)))

predicate lemma_inserted_window [#"/workspace/crates/verified/src/producer/completion/coverage.rs" 48 0 54 9] (ends: Seq.seq Int64.t) (incoming: Int64.t) (position: int) (first: int) (selected: Seq.seq UInt64.t)

axiom lemma_inserted_window_spec:
  forall ends: Seq.seq Int64.t, incoming: Int64.t, position: int, first: int, selected: Seq.seq UInt64.t [lemma_inserted_window ends incoming position first selected]. ([%#scoverage] Seq.length ends
        <= 5
      /\ 0 <= position /\ position <= Seq.length ends)
    -> ([%#scoverage'0] first = (if Seq.length ends = 5 then 1 else 0))
    -> ([%#scoverage'1] Seq.length selected = Seq.length ends + 1 - first)
    -> ([%#scoverage'2] insertion_ordered ends incoming position)
    -> ([%#scoverage'3] forall j: int. 0 <= j /\ j < Seq.length selected
        -> UInt64.t'int (Seq.get selected j)
        = (if first + j = position then
          Seq.length ends
        else
          if gt_log_Int (first + j) position then first + j - 1 else first + j
        )) -> ([%#scoverage'4] lemma_inserted_window ends incoming position first selected)

axiom lemma_inserted_window_spec'0:
  forall ends: Seq.seq Int64.t, incoming: Int64.t, position: int, first: int, selected: Seq.seq UInt64.t [lemma_inserted_window ends incoming position first selected]. ([%#scoverage] Seq.length ends
        <= 5
      /\ 0 <= position /\ position <= Seq.length ends)
    -> ([%#scoverage'0] first = (if Seq.length ends = 5 then 1 else 0))
    -> ([%#scoverage'1] Seq.length selected = Seq.length ends + 1 - first)
    -> ([%#scoverage'2] insertion_ordered ends incoming position)
    -> ([%#scoverage'3] forall j: int. 0 <= j /\ j < Seq.length selected
        -> UInt64.t'int (Seq.get selected j)
        = (if first + j = position then
          Seq.length ends
        else
          if gt_log_Int (first + j) position then first + j - 1 else first + j
        ))
    -> ([%#scoverage'5] lemma_inserted_window ends incoming position first selected
    -> gt_log_Int (Seq.length selected) 0 /\ Seq.length selected <= 5)

axiom lemma_inserted_window_spec'1:
  forall ends: Seq.seq Int64.t, incoming: Int64.t, position: int, first: int, selected: Seq.seq UInt64.t [lemma_inserted_window ends incoming position first selected]. ([%#scoverage] Seq.length ends
        <= 5
      /\ 0 <= position /\ position <= Seq.length ends)
    -> ([%#scoverage'0] first = (if Seq.length ends = 5 then 1 else 0))
    -> ([%#scoverage'1] Seq.length selected = Seq.length ends + 1 - first)
    -> ([%#scoverage'2] insertion_ordered ends incoming position)
    -> ([%#scoverage'3] forall j: int. 0 <= j /\ j < Seq.length selected
        -> UInt64.t'int (Seq.get selected j)
        = (if first + j = position then
          Seq.length ends
        else
          if gt_log_Int (first + j) position then first + j - 1 else first + j
        ))
    -> ([%#scoverage'6] lemma_inserted_window ends incoming position first selected
    -> (forall j: int. 0 <= j /\ j < Seq.length selected -> UInt64.t'int (Seq.get selected j) <= Seq.length ends))

axiom lemma_inserted_window_spec'2:
  forall ends: Seq.seq Int64.t, incoming: Int64.t, position: int, first: int, selected: Seq.seq UInt64.t [lemma_inserted_window ends incoming position first selected]. ([%#scoverage] Seq.length ends
        <= 5
      /\ 0 <= position /\ position <= Seq.length ends)
    -> ([%#scoverage'0] first = (if Seq.length ends = 5 then 1 else 0))
    -> ([%#scoverage'1] Seq.length selected = Seq.length ends + 1 - first)
    -> ([%#scoverage'2] insertion_ordered ends incoming position)
    -> ([%#scoverage'3] forall j: int. 0 <= j /\ j < Seq.length selected
        -> UInt64.t'int (Seq.get selected j)
        = (if first + j = position then
          Seq.length ends
        else
          if gt_log_Int (first + j) position then first + j - 1 else first + j
        ))
    -> ([%#scoverage'7] lemma_inserted_window ends incoming position first selected
    -> (forall i: int, j: int. 0 <= i /\ i < j /\ j < Seq.length selected
      -> completion_offset ends incoming (UInt64.t'int (Seq.get selected i))
      < completion_offset ends incoming (UInt64.t'int (Seq.get selected j))))

axiom lemma_inserted_window_spec'3:
  forall ends: Seq.seq Int64.t, incoming: Int64.t, position: int, first: int, selected: Seq.seq UInt64.t [lemma_inserted_window ends incoming position first selected]. ([%#scoverage] Seq.length ends
        <= 5
      /\ 0 <= position /\ position <= Seq.length ends)
    -> ([%#scoverage'0] first = (if Seq.length ends = 5 then 1 else 0))
    -> ([%#scoverage'1] Seq.length selected = Seq.length ends + 1 - first)
    -> ([%#scoverage'2] insertion_ordered ends incoming position)
    -> ([%#scoverage'3] forall j: int. 0 <= j /\ j < Seq.length selected
        -> UInt64.t'int (Seq.get selected j)
        = (if first + j = position then
          Seq.length ends
        else
          if gt_log_Int (first + j) position then first + j - 1 else first + j
        ))
    -> ([%#scoverage'8] lemma_inserted_window ends incoming position first selected
    -> (forall i: int. 0 <= i
        /\ i < Seq.length ends
        /\ not (exists j: int. 0 <= j /\ j < Seq.length selected /\ UInt64.t'int (Seq.get selected j) = i)
      -> five_completions_above ends incoming selected (Int64.to_int (Seq.get ends i))))

axiom lemma_inserted_window_spec'4:
  forall ends: Seq.seq Int64.t, incoming: Int64.t, position: int, first: int, selected: Seq.seq UInt64.t [lemma_inserted_window ends incoming position first selected]. ([%#scoverage] Seq.length ends
        <= 5
      /\ 0 <= position /\ position <= Seq.length ends)
    -> ([%#scoverage'0] first = (if Seq.length ends = 5 then 1 else 0))
    -> ([%#scoverage'1] Seq.length selected = Seq.length ends + 1 - first)
    -> ([%#scoverage'2] insertion_ordered ends incoming position)
    -> ([%#scoverage'3] forall j: int. 0 <= j /\ j < Seq.length selected
        -> UInt64.t'int (Seq.get selected j)
        = (if first + j = position then
          Seq.length ends
        else
          if gt_log_Int (first + j) position then first + j - 1 else first + j
        ))
    -> ([%#scoverage'9] lemma_inserted_window ends incoming position first selected
    -> not (exists j: int. 0 <= j
        /\ j < Seq.length selected
        /\ completion_offset ends incoming (UInt64.t'int (Seq.get selected j)) = Int64.to_int incoming)
    -> five_completions_above ends incoming selected (Int64.to_int incoming))

