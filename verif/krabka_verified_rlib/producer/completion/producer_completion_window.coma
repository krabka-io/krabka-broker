        -> Int64.to_int (Seq.get ends i) < Int64.to_int (Seq.get ends j))
    -> ([%#scoverage'3] forall i: int. 0 <= i /\ i < position -> Int64.to_int (Seq.get ends i) < Int64.to_int incoming)
    -> ([%#scoverage'4] forall i: int. position <= i /\ i < Seq.length ends
