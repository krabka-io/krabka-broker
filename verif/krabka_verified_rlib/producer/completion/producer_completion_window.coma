let len_i64 (self_: Slice64.slice Int64.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sslice] Seq.length (Slice64.view self_)
    = UInt64.t'int result}
    (! return {result}) ]

type t_Option_i16 = None | Some Int16.t

let elim_Some (_x: t_Option_i16) (return (f0: Int16.t)) = any
  [ _k (f0: Int16.t) -> {Some f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
      | _ -> false
      end}
    any) ]

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

let from_usize (small: bool) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:from ensures] [%#sconvert] result = UInt64.of_bool small}
    (! return {result}) ]

constant const_MIN: UInt64.t = (0: UInt64.t)

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

let saturating_sub (self_: UInt64.t) (rhs: UInt64.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:saturating_sub ensures] ([@stop_split] [@expl:saturating_sub ensures #0] [%#snum] ge_log_Int (UInt64.t'int self_
          - UInt64.t'int rhs) (UInt64.t'int const_MIN)
        /\ UInt64.t'int self_ - UInt64.t'int rhs <= UInt64.t'int const_MAX
      -> UInt64.t'int result = UInt64.t'int self_ - UInt64.t'int rhs)
    /\ ([@stop_split] [@expl:saturating_sub ensures #1] [%#snum'0] UInt64.t'int self_ - UInt64.t'int rhs
        < UInt64.t'int const_MIN -> UInt64.t'int result = UInt64.t'int const_MIN)
    /\ ([@stop_split] [@expl:saturating_sub ensures #2] [%#snum'1] gt_log_Int (UInt64.t'int self_
      - UInt64.t'int rhs) (UInt64.t'int const_MAX) -> UInt64.t'int result = UInt64.t'int const_MAX)}
    (! return {result}) ]

type t_Vec_usize_Global

function view_Vec_usize_Global (self: t_Vec_usize_Global) : Seq.seq UInt64.t

axiom view_Vec_usize_Global_spec:
  forall self: t_Vec_usize_Global [view_Vec_usize_Global self]. [%#svec'0] Seq.length (view_Vec_usize_Global self)
    <= UInt64.t'int const_MAX

let new_usize (return (x: t_Vec_usize_Global)) = any
  [ return (result: t_Vec_usize_Global) ->
  {[@stop_split] [@expl:new ensures] [%#svec] Seq.length (view_Vec_usize_Global result) = 0}
    (! return {result}) ]

let push_usize (self_: MutBorrow.t t_Vec_usize_Global) (v: UInt64.t) (return (x: ())) = any
  [ return (result: ()) -> {[@stop_split] [@expl:push ensures] [%#svec'1] view_Vec_usize_Global self_.final
    = Seq.snoc (view_Vec_usize_Global self_.current) v}
    (! return {result}) ]

function completion_offset [#"/workspace/crates/verified/src/producer/completion.rs" 10 0 10 74] (ends: Seq.seq Int64.t) (incoming: Int64.t) (index: int) : int
 = [%#scompletion'45] if index = Seq.length ends then Int64.to_int incoming else Int64.to_int (Seq.get ends index)

predicate lemma_inserted_window [#"/workspace/crates/verified/src/producer/completion/coverage.rs" 52 0 58 9] (ends: Seq.seq Int64.t) (incoming: Int64.t) (position: int) (first: int) (selected: Seq.seq UInt64.t)

axiom lemma_inserted_window_spec:
  forall ends: Seq.seq Int64.t, incoming: Int64.t, position: int, first: int, selected: Seq.seq UInt64.t [lemma_inserted_window ends incoming position first selected]. ([%#scoverage] Seq.length ends
        <= 5
      /\ 0 <= position /\ position <= Seq.length ends)
    -> ([%#scoverage'0] first = (if Seq.length ends = 5 then 1 else 0))
    -> ([%#scoverage'1] Seq.length selected = Seq.length ends + 1 - first)
    -> ([%#scoverage'2] forall i: int, j: int. 0 <= i /\ i < j /\ j < Seq.length ends
        -> Int64.to_int (Seq.get ends i) < Int64.to_int (Seq.get ends j))
    -> ([%#scoverage'3] forall i: int. 0 <= i /\ i < position -> Int64.to_int (Seq.get ends i) < Int64.to_int incoming)
    -> ([%#scoverage'4] forall i: int. position <= i /\ i < Seq.length ends
        -> Int64.to_int incoming < Int64.to_int (Seq.get ends i))
    -> ([%#scoverage'5] forall j: int. 0 <= j /\ j < Seq.length selected
        -> UInt64.t'int (Seq.get selected j)
        = (if first + j = position then
          Seq.length ends
        else
          if gt_log_Int (first + j) position then first + j - 1 else first + j
        )) -> ([%#scoverage'6] lemma_inserted_window ends incoming position first selected)

axiom lemma_inserted_window_spec'0:
  forall ends: Seq.seq Int64.t, incoming: Int64.t, position: int, first: int, selected: Seq.seq UInt64.t [lemma_inserted_window ends incoming position first selected]. ([%#scoverage] Seq.length ends
        <= 5
