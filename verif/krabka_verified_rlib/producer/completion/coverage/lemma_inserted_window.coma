use creusot.int.Int64
use seq.Seq
use creusot.int.UInt64
use int.Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

function completion_offset [#"/workspace/crates/verified/src/producer/completion.rs" 10 0 10 74] (ends: Seq.seq Int64.t) (incoming: Int64.t) (index: int) : int
 = [%#scompletion] if index = Seq.length ends then Int64.to_int incoming else Int64.to_int (Seq.get ends index)

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

function old_source_slot [#"/workspace/crates/verified/src/producer/completion/coverage/witness.rs" 19 0 25 8] (selected: Seq.seq UInt64.t) (count: int) (position: int) (first: int) (source: int) : int

axiom old_source_slot_spec:
  forall selected: Seq.seq UInt64.t, count: int, position: int, first: int, source: int [old_source_slot selected count position first source]. ([%#switness] 0
        <= position
      /\ position <= count /\ 0 <= first)
    -> ([%#switness'0] 0 <= source /\ source < count)
    -> ([%#switness'1] if source < position then first <= source else first <= source + 1)
    -> ([%#switness'2] Seq.length selected = count + 1 - first)
    -> ([%#switness'3] forall j: int. 0 <= j /\ j < Seq.length selected
        -> UInt64.t'int (Seq.get selected j)
        = (if first + j = position then
          count
        else
          if gt_log_Int (first + j) position then first + j - 1 else first + j
        ))
    -> ([%#switness'4] 0 <= old_source_slot selected count position first source
    /\ old_source_slot selected count position first source < Seq.length selected)

axiom old_source_slot_spec'0:
  forall selected: Seq.seq UInt64.t, count: int, position: int, first: int, source: int [old_source_slot selected count position first source]. ([%#switness] 0
        <= position
      /\ position <= count /\ 0 <= first)
    -> ([%#switness'0] 0 <= source /\ source < count)
    -> ([%#switness'1] if source < position then first <= source else first <= source + 1)
    -> ([%#switness'2] Seq.length selected = count + 1 - first)
    -> ([%#switness'3] forall j: int. 0 <= j /\ j < Seq.length selected
        -> UInt64.t'int (Seq.get selected j)
        = (if first + j = position then
          count
        else
          if gt_log_Int (first + j) position then first + j - 1 else first + j
        ))
    -> ([%#switness'5] UInt64.t'int (Seq.get selected (old_source_slot selected count position first source)) = source)

function insertion_source [#"/workspace/crates/verified/src/producer/completion/coverage/order.rs" 9 0 9 71] (count: int) (position: int) (ordinal: int) : int
 = [%#sorder'6] if ordinal = position then count else if gt_log_Int ordinal position then ordinal - 1 else ordinal

predicate lemma_inserted_pair [#"/workspace/crates/verified/src/producer/completion/coverage/order.rs" 29 0 35 9] (ends: Seq.seq Int64.t) (incoming: Int64.t) (position: int) (lower: int) (upper: int)

axiom lemma_inserted_pair_spec:
  forall ends: Seq.seq Int64.t, incoming: Int64.t, position: int, lower: int, upper: int [lemma_inserted_pair ends incoming position lower upper]. ([%#sorder] 0
        <= position
      /\ position <= Seq.length ends)
    -> ([%#sorder'0] 0 <= lower /\ lower < upper /\ upper <= Seq.length ends)
    -> ([%#sorder'1] forall i: int, j: int. 0 <= i /\ i < j /\ j < Seq.length ends
        -> Int64.to_int (Seq.get ends i) < Int64.to_int (Seq.get ends j))
    -> ([%#sorder'2] forall i: int. 0 <= i /\ i < position -> Int64.to_int (Seq.get ends i) < Int64.to_int incoming)
    -> ([%#sorder'3] forall i: int. position <= i /\ i < Seq.length ends
        -> Int64.to_int incoming < Int64.to_int (Seq.get ends i))
    -> ([%#sorder'4] lemma_inserted_pair ends incoming position lower upper)

axiom lemma_inserted_pair_spec'0:
  forall ends: Seq.seq Int64.t, incoming: Int64.t, position: int, lower: int, upper: int [lemma_inserted_pair ends incoming position lower upper]. ([%#sorder] 0
        <= position
      /\ position <= Seq.length ends)
    -> ([%#sorder'0] 0 <= lower /\ lower < upper /\ upper <= Seq.length ends)
    -> ([%#sorder'1] forall i: int, j: int. 0 <= i /\ i < j /\ j < Seq.length ends
