use creusot.int.Int64
use seq.Seq
use map.Map
use int.Int

type tup2_i64_i64 = { f0: Int64.t; f1: Int64.t }

predicate pairwise_i64 [#"/workspace/crates/verified/src/sequence.rs" 20 0 20 95] (values: Seq.seq Int64.t) (relation: Map.map tup2_i64_i64 bool) =
  [%#ssequence'0] forall i: int, j: int. 0 <= i /\ i < j /\ j < Seq.length values
    -> Map.get relation { f0 = Seq.get values i; f1 = Seq.get values j }

predicate strictly_increasing_i64 [#"/workspace/crates/verified/src/sequence.rs" 13 0 13 73] (values: Seq.seq Int64.t) =
  [%#ssequence] pairwise_i64 values (fun (__0: tup2_i64_i64) -> let {f0 = left; f1 = right} = __0 in Int64.to_int left
  < Int64.to_int right)

predicate insertion_ordered [#"/workspace/crates/verified/src/producer/completion/coverage/order.rs" 13 0 13 85] (ends: Seq.seq Int64.t) (incoming: Int64.t) (position: int) =
  [%#sorder'4] strictly_increasing_i64 ends
  /\ (forall i: int. 0 <= i /\ i < position -> Int64.to_int (Seq.get ends i) < Int64.to_int incoming)
  /\ (forall i: int. position <= i /\ i < Seq.length ends -> Int64.to_int incoming < Int64.to_int (Seq.get ends i))

function completion_offset [#"/workspace/crates/verified/src/producer/completion.rs" 7 0 7 74] (ends: Seq.seq Int64.t) (incoming: Int64.t) (index: int) : int
 = [%#scompletion] if index = Seq.length ends then Int64.to_int incoming else Int64.to_int (Seq.get ends index)

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

function insertion_source [#"/workspace/crates/verified/src/producer/completion/coverage/order.rs" 6 0 6 71] (count: int) (position: int) (ordinal: int) : int
 = [%#sorder'5] if ordinal = position then count else if gt_log_Int ordinal position then ordinal - 1 else ordinal

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant ends : Seq.seq Int64.t

constant incoming : Int64.t

constant position : int

constant lower : int

constant upper : int

predicate lemma_inserted_pair [#"/workspace/crates/verified/src/producer/completion/coverage/order.rs" 35 0 41 9] (ends: Seq.seq Int64.t) (incoming: Int64.t) (position: int) (lower: int) (upper: int)

goal vc_lemma_inserted_pair: ([%#sorder] 0 <= position /\ position <= Seq.length ends)
  -> ([%#sorder'0] 0 <= lower /\ lower < upper /\ upper <= Seq.length ends)
  -> ([%#sorder'1] insertion_ordered ends incoming position)
  -> (let result = true in [@stop_split] [@expl:lemma_inserted_pair ensures] ([@stop_split] [@expl:lemma_inserted_pair ensures #0] [%#sorder'2] result)
  /\ ([@stop_split] [@expl:lemma_inserted_pair ensures #1] [%#sorder'3] result
  -> completion_offset ends incoming (insertion_source (Seq.length ends) position lower)
  < completion_offset ends incoming (insertion_source (Seq.length ends) position upper)))
