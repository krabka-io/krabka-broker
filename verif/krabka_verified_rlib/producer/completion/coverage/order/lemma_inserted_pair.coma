(* #"/workspace/crates/verified/src/producer/completion/coverage/order.rs" 29 0 35 9 *)

let%span sord = "/root/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/creusot-std-0.13.0/src/logic/ord.rs" 22 8 22 20
let%span scompletion = "/workspace/crates/verified/src/producer/completion.rs" 11 16 11 74
let%span sorder = "/workspace/crates/verified/src/producer/completion/coverage/order.rs" 21 11 21 50
