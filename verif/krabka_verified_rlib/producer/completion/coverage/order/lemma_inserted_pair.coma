let%span sorder'2 = "/workspace/crates/verified/src/producer/completion/coverage/order.rs" 24 11 24 73
let%span sorder'3 = "/workspace/crates/verified/src/producer/completion/coverage/order.rs" 25 11 25 82
let%span sorder'4 = "/workspace/crates/verified/src/producer/completion/coverage/order.rs" 26 10 26 16
