        if Int32.to_int base_sequence = 0 then Append else OutOfOrder
      else
        if Int32.to_int base_sequence = sequence_modulo_2_31 (Int32.to_int tracked.last_sequence + 1) then
          Append
        else
          OutOfOrder



    end

