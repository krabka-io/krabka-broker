    | None -> false
    end

predicate retained_duplicate_exists [#"/workspace/crates/verified/src/producer/sequence_decision.rs" 77 0 83 9] (entry: t_Option_ProducerEntryFacts) (retained: Seq.seq t_Option_RetainedSequenceRange) (producer_epoch: Int16.t) (base_sequence: Int32.t) (last_offset_delta: Int32.t) =
