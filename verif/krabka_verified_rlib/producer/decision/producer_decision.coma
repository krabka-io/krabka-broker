function sequence_decision [#"/workspace/crates/verified/src/producer/sequence_decision.rs" 122 0 128 21] (entry: t_Option_ProducerEntryFacts) (producer_epoch: Int16.t) (base_sequence: Int32.t) (log_empty: bool) (trunk_rules: bool) : t_ProducerDecision
 = [%#ssequence_decision'3] match entry with
    | None -> if trunk_rules /\ log_empty /\ Int32.to_int base_sequence <> 0 then OutOfOrder else Append
    | Some tracked -> if Int16.to_int producer_epoch < Int16.to_int tracked.epoch then
      Fenced
    else
