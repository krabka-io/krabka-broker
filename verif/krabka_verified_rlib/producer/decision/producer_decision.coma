predicate first_retained_duplicate [#"/workspace/crates/verified/src/producer/sequence_decision.rs" 98 0 105 9] (entry: t_Option_ProducerEntryFacts) (retained: Seq.seq t_Option_RetainedSequenceRange) (producer_epoch: Int16.t) (base_sequence: Int32.t) (last_offset_delta: Int32.t) (index: int) =
