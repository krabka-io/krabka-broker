function sequence_decision [#"/workspace/crates/verified/src/producer.rs" 158 0 162 21] (entry: t_Option_ProducerEntryFacts) (producer_epoch: Int16.t) (base_sequence: Int32.t) : t_ProducerDecision
 = [%#sproducer'18] match entry with
    | None -> Append
    | Some tracked -> if Int16.to_int producer_epoch < Int16.to_int tracked.epoch then
      Fenced
    else
