type t_Option_i32 = None | Some Int32.t

type t_ProducerBatch = { epoch: Int16.t; last_sequence: Int32.t; last_offset_delta: t_Option_i32; base_offset: Int64.t }

type t_Option_ProducerBatch = None'0 | Some'0 t_ProducerBatch

type t_ProducerDecision = Append | Duplicate Int64.t | OutOfOrder | Fenced

let elim_Some (_x: t_Option_ProducerBatch) (return (f0: t_ProducerBatch)) = any
  [ _k (f0: t_ProducerBatch) -> {Some'0 f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some'0 _ -> true
      | _ -> false
      end}
    any) ]

constant const_MAX: Int32.t = (2147483647: Int32.t)

function increment_sequence_model [#"/workspace/crates/verified/src/producer.rs" 33 0 33 65] (sequence: Int32.t) (increment: Int32.t) : Int32.t
 = [%#sproducer'12] Int32.bw_and (Int32.add sequence increment) const_MAX

let increment_sequence (sequence: Int32.t) (increment: Int32.t) (return (x: Int32.t)) = any
  [ return (result: Int32.t) -> {[@stop_split] [@expl:increment_sequence ensures] [%#sproducer'10] result
    = increment_sequence_model sequence increment}
    (! return {result}) ]

function decrement_sequence_model [#"/workspace/crates/verified/src/producer.rs" 48 0 48 65] (sequence: Int32.t) (decrement: Int32.t) : Int32.t
 = [%#sproducer'14] Int32.bw_and (Int32.sub sequence decrement) const_MAX

predicate matches_last_batch_model [#"/workspace/crates/verified/src/producer.rs" 63 0 67 9] (last: t_ProducerBatch) (base_sequence: Int32.t) (last_offset_delta'0: Int32.t) =
  [%#sproducer'13] exists committed_delta: Int32.t. last.last_offset_delta = Some committed_delta
    /\ base_sequence = decrement_sequence_model last.last_sequence committed_delta
    /\ increment_sequence_model base_sequence last_offset_delta'0 = last.last_sequence

let matches_last_batch (last: t_ProducerBatch) (base_sequence: Int32.t) (last_offset_delta'0: Int32.t)
  (return (x: bool)) = any
  [ return (result: bool) -> {[@stop_split] [@expl:matches_last_batch ensures] [%#sproducer'11] result
    = matches_last_batch_model last base_sequence last_offset_delta'0}
    (! return {result}) ]

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

