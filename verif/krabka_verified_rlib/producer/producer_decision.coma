predicate first_retained_duplicate [#"/workspace/crates/verified/src/producer.rs" 134 0 141 9] (entry: t_Option_ProducerEntryFacts) (retained: Seq.seq t_Option_RetainedSequenceRange) (producer_epoch: Int16.t) (base_sequence: Int32.t) (last_offset_delta: Int32.t) (index: int) =
  [%#sproducer'16] match entry with
    | Some tracked -> Int16.to_int tracked.epoch = Int16.to_int producer_epoch
    /\ 0 <= index
    /\ index < Seq.length retained
    /\ retained_matches (Seq.get retained index) base_sequence last_offset_delta
    /\ (forall j: int. 0 <= j /\ j < index -> not retained_matches (Seq.get retained j) base_sequence last_offset_delta)
