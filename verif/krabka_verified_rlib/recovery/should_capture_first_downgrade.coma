let%span srecovery = "/home/matt/.codex/worktrees/e9db/krabka-broker/crates/verified/src/recovery.rs" 80 4 80 35
let%span srecovery'0 = "/home/matt/.codex/worktrees/e9db/krabka-broker/crates/verified/src/recovery.rs" 77 10 77 53

use creusot.prelude.Any

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let should_capture_first_downgrade [#"/home/matt/.codex/worktrees/e9db/krabka-broker/crates/verified/src/recovery.rs" 79 0 79 93]
  (pending_exists: bool) (is_downgrade: bool) (return (x: bool)) = (! bb0
  [ bb0 = any [ br0 -> {pending_exists = false} (! bb1) | br1 -> {pending_exists} (! bb2) ]
  | bb2 = s0 [ s0 = [ &_ret <- [%#srecovery] false ] s1 | s1 = return {_ret} ]
  | bb1 = s0 [ s0 = [ &_ret <- is_downgrade ] s1 | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l () | & pending_exists: bool = pending_exists | & is_downgrade: bool = is_downgrade ])
  [ return (result: bool) -> {[@stop_split] [@expl:should_capture_first_downgrade ensures] [%#srecovery'0] result
    = (not pending_exists /\ is_downgrade)}
    (! return {result}) ]
