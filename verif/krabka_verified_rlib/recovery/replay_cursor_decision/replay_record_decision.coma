constant const_MAX: Int64.t = (9223372036854775807: Int64.t)

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate replay_record_admitted [#"/workspace/crates/verified/src/recovery/replay_cursor_decision.rs" 16 0 23 9] (batch_base: Int64.t) (record_delta: Int32.t) (from: Int64.t) (end': Int64.t) (control_batch: bool) (replay_control: bool) =
  [%#sreplay_cursor_decision'5] ge_log_Int (Int32.to_int record_delta) 0
  /\ control_batch = replay_control
  /\ Int64.to_int from <= Int64.to_int batch_base + Int32.to_int record_delta
  /\ Int64.to_int batch_base + Int32.to_int record_delta < Int64.to_int end'

