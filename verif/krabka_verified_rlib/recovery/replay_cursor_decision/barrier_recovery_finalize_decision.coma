use int.Int

type t_Option_i32 = None | Some Int32.t

type t_BarrierRecoveryFinalizeDecision =
  | NoPending
  | MalformedPending
  | UnknownCoordinator
  | FencedCoordinator
  | FinalizePartial

let elim_Some (_x: t_Option_i32) (return (f0: Int32.t)) = any
  [ _k (f0: Int32.t) -> {Some f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
      | _ -> false
      end}
    any) ]

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

