  | bb10 = s0 [ s0 = [ &_ret <- FencedCoordinator ] s1 | s1 = return {_ret} ]
  | bb11 = s0 [ s0 = [ &_ret <- FinalizePartial ] s1 | s1 = return {_ret} ]
