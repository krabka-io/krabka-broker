type t_Option_i64 = None | Some Int64.t

let elim_Some (_x: t_Option_i64) (return (f0: Int64.t)) = any
  [ _k (f0: Int64.t) -> {Some f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
      | _ -> false
      end}
    any) ]

type t_SnapshotChunkDecision = Restart | Continue Int64.t | Complete

constant const_MIN: Int64.t = (-9223372036854775808: Int64.t)

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

constant const_MAX: Int64.t = (9223372036854775807: Int64.t)

let checked_add (self_: Int64.t) (rhs: Int64.t) (return (x: t_Option_i64)) = any
  [ return (result: t_Option_i64) ->
  {[@stop_split] [@expl:checked_add ensures] ([@stop_split] [@expl:checked_add ensures #0] [%#snum] (result = None)
      = (Int64.to_int self_ + Int64.to_int rhs < Int64.to_int const_MIN
      \/ gt_log_Int (Int64.to_int self_ + Int64.to_int rhs) (Int64.to_int const_MAX)))
    /\ ([@stop_split] [@expl:checked_add ensures #1] [%#snum'0] forall r: Int64.t. result = Some r
      -> Int64.to_int r = Int64.to_int self_ + Int64.to_int rhs)}
    (! return {result}) ]

type t_Ordering = Less | Equal | Greater

function cmp_log_Int (self: int) (other: int) : t_Ordering = [%#sord'0] if self = other then
    Equal
  else
    if self < other then Less else Greater


function deep_model_i64 [@inline:trivial] (self: Int64.t) : int = [%#snum'1] Int64.to_int self

meta "rewrite_def" function deep_model_i64

let cmp_i64 (self_: Int64.t) (rhs: Int64.t) (return (x: t_Ordering)) = any
  [ return (result: t_Ordering) -> {[@stop_split] [@expl:cmp ensures] [%#scmp] result
    = cmp_log_Int (deep_model_i64 self_) (deep_model_i64 rhs)}
    (! return {result}) ]

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'1] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate snapshot_chunk_shape_valid [#"/workspace/crates/verified/src/snapshot.rs" 119 0 127 9] (identity_matches: bool) (fixed_size: t_Option_i64) (received: int) (declared_size: int) (position: int) (chunk_len: int) (max_size: int) =
  [%#ssnapshot'6] identity_matches
  /\ ge_log_Int received 0
  /\ ge_log_Int chunk_len 0
  /\ ge_log_Int max_size 0
