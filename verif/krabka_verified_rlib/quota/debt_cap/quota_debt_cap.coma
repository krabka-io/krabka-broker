use creusot.int.UInt64
use creusot.int.UInt128
use creusot.prelude.Any
use int.MinMax
use int.ComputerDivision
use int.Int

let from_u128 (small: UInt64.t) (return (x: UInt128.t)) = any
  [ return (result: UInt128.t) -> {[@stop_split] [@expl:from ensures] [%#sconvert] result
    = UInt128.of_int (UInt64.t'int small)}
    (! return {result}) ]

type t_Option_u128 = None | Some UInt128.t

constant const_MIN: UInt128.t = (0: UInt128.t)

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

constant const_MAX: UInt128.t = (340282366920938463463374607431768211455: UInt128.t)

let checked_mul (self_: UInt128.t) (rhs: UInt128.t) (return (x: t_Option_u128)) = any
  [ return (result: t_Option_u128) ->
  {[@stop_split] [@expl:checked_mul ensures] ([@stop_split] [@expl:checked_mul ensures #0] [%#snum] (result = None)
      = (UInt128.t'int self_ * UInt128.t'int rhs < UInt128.t'int const_MIN
      \/ gt_log_Int (UInt128.t'int self_ * UInt128.t'int rhs) (UInt128.t'int const_MAX)))
    /\ ([@stop_split] [@expl:checked_mul ensures #1] [%#snum'0] forall r: UInt128.t. result = Some r
      -> UInt128.t'int r = UInt128.t'int self_ * UInt128.t'int rhs)}
    (! return {result}) ]

constant const_MAX'0: UInt64.t = (18446744073709551615: UInt64.t)

let elim_Some (_x: t_Option_u128) (return (f0: UInt128.t)) = any
  [ _k (f0: UInt128.t) -> {Some f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
      | _ -> false
      end}
    any) ]

function deep_model_u128 [@inline:trivial] (self: UInt128.t) : int = [%#snum'1] UInt128.t'int self

meta "rewrite_def" function deep_model_u128

let min_u128 (self_: UInt128.t) (o: UInt128.t) (return (x: UInt128.t)) = any
  [ return (result: UInt128.t) ->
  {[@stop_split] [@expl:min_u128 ensures] ([@stop_split] [@expl:min ensures #0] [%#scmp] deep_model_u128 result
      <= deep_model_u128 self_)
    /\ ([@stop_split] [@expl:min ensures #1] [%#scmp'0] deep_model_u128 result <= deep_model_u128 o)
    /\ ([@stop_split] [@expl:min ensures #2] [%#scmp'1] result = self_ \/ result = o)
    /\ ([@stop_split] [@expl:min ensures #3] [%#scmp'2] deep_model_u128 self_ < deep_model_u128 o -> result = self_)
    /\ ([@stop_split] [@expl:min ensures #4] [%#scmp'3] deep_model_u128 o <= deep_model_u128 self_ -> result = o)}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let quota_debt_cap [#"/workspace/crates/verified/src/quota/debt_cap.rs" 8 0 8 57] (wait_nanos: UInt128.t)
  (rate: UInt64.t) (return (x: UInt64.t)) = (! bb0
  [ bb0 = s0
    [ s0 = from_u128 [%#sdebt_cap] {rate} (fun (_x: UInt128.t) -> [ &_10 <- _x ] s1)
    | s1 = checked_mul [%#sdebt_cap'0] {wait_nanos} {_10} (fun (_x: t_Option_u128) -> [ &_8 <- _x ] s2)
    | s2 = any [ br0 -> {_8 = None} (! bb5) | br1 (x0: UInt128.t) -> {_8 = Some x0} (! bb4) ] ]
  | bb5 = s0 [ s0 = [ &_ret <- [%#sdebt_cap'1] const_MAX'0 ] s1 | s1 = return {_ret} ]
  | bb4 = s0
    [ s0 = elim_Some {_8} (fun (r0: UInt128.t) -> [ &numerator <- r0 ] s1)
    | s1 = [ &_16 <- ([%#sdebt_cap'2] (1000000000: UInt128.t)) = ([%#sdebt_cap'3] (0: UInt128.t)) ] s2
    | s2 = {[@expl:division by zero] [%#sdebt_cap'3] not _16} s3
    | s3 = UInt128.div [%#sdebt_cap'3] {numerator} {[%#sdebt_cap'2] (1000000000: UInt128.t)}
        (fun (_x: UInt128.t) -> [ &_14 <- _x ] s4)
    | s4 = min_u128 [%#sdebt_cap'5] {_14} {[%#sdebt_cap'4] (18446744073709551615: UInt128.t)}
        (fun (_x: UInt128.t) -> [ &_13 <- _x ] s5)
    | s5 = [ &_ret <- UInt64.of_int (UInt128.t'int _13) ] s6
    | s6 = return {_ret} ] ]
  [ & _ret: UInt64.t = Any.any_l ()
  | & wait_nanos: UInt128.t = wait_nanos
  | & rate: UInt64.t = rate
  | & numerator: UInt128.t = Any.any_l ()
  | & _8: t_Option_u128 = Any.any_l ()
  | & _10: UInt128.t = Any.any_l ()
  | & _13: UInt128.t = Any.any_l ()
  | & _14: UInt128.t = Any.any_l ()
  | & _16: bool = Any.any_l () ])
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:quota_debt_cap ensures] [%#sdebt_cap'6] UInt64.t'int result
    = MinMax.min (ComputerDivision.div (UInt128.t'int wait_nanos
    * UInt64.t'int rate) 1000000000) (UInt64.t'int const_MAX'0)}
    (! return {result}) ]
