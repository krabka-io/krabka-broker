  | & _17: UInt64.t = Any.any_l ()
  | & _20: UInt64.t = Any.any_l ()
  | & _22: UInt64.t = Any.any_l ()
  | & _24: UInt64.t = Any.any_l ()
  | & _25: bool = Any.any_l () ])
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:quota_whole_request ensures] ([@stop_split] [@expl:quota_whole_request ensures #0] [%#srequest'4] UInt64.t'int result
        <= UInt64.t'int total
