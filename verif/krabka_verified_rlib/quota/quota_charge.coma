    /\ ([@stop_split] [@expl:quota_charge ensures #1] [%#squota'5] UInt64.t'int result.f1'6
      = capped (UInt64.t'int debt) (UInt64.t'int requested
      - (capped (UInt64.t'int available) 0 (UInt64.t'int burst) - UInt64.t'int result.f0'6)) (UInt64.t'int debt_cap))
