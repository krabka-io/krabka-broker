    | s8 = saturating_add [%#squota'2] {debt} {_35} (fun (_x: UInt64.t) -> [ &_33 <- _x ] s9)
    | s9 = min_u64 [%#squota'3] {_33} {debt_cap} (fun (_x: UInt64.t) -> [ &new_debt <- _x ] s10)
    | s10 = [ &_ret <- { f0'6 = new_available.f0'4; f1'6 = new_debt } ] s11
    | s11 = return {_ret} ] ]
  [ & _ret: tup2_u64_u64 = Any.any_l ()
  | & available: UInt64.t = available
  | & debt: UInt64.t = debt
  | & requested: UInt64.t = requested
  | & burst: UInt64.t = burst
  | & debt_cap: UInt64.t = debt_cap
  | & grant: t_GrantedTokens = Any.any_l ()
  | & new_available: t_NewAvailable = Any.any_l ()
  | & _24: tup2_GrantedTokens_NewAvailable = Any.any_l ()
  | & _25: t_AvailableTokens = Any.any_l ()
  | & _27: t_RefillTokens = Any.any_l ()
  | & _28: t_BurstCapacity = Any.any_l ()
  | & _30: t_RequestedTokens = Any.any_l ()
  | & new_debt: UInt64.t = Any.any_l ()
  | & _33: UInt64.t = Any.any_l ()
  | & _35: UInt64.t = Any.any_l () ])
  [ return (result: tup2_u64_u64) ->
  {[@stop_split] [@expl:quota_charge ensures] ([@stop_split] [@expl:quota_charge ensures #0] [%#squota'4] UInt64.t'int result.f0'6
      = (if UInt64.t'int requested <= capped (UInt64.t'int available) 0 (UInt64.t'int burst) then
        capped (UInt64.t'int available) 0 (UInt64.t'int burst) - UInt64.t'int requested
