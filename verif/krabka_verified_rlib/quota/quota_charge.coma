let quota_charge [#"/workspace/crates/verified/src/quota.rs" 49 0 55 15] (available: UInt64.t)
  (debt: UInt64.t) (requested: UInt64.t) (burst: UInt64.t) (debt_cap: UInt64.t) (return (x: tup2_u64_u64)) = (! bb0
