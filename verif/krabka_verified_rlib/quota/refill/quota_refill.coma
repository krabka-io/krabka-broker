let from_u128 (small: UInt64.t) (return (x: UInt128.t)) = any
  [ return (result: UInt128.t) -> {[@stop_split] [@expl:from ensures] [%#sconvert] result
    = UInt128.of_int (UInt64.t'int small)}
    (! return {result}) ]

function deep_model_u128 [@inline:trivial] (self: UInt128.t) : int = [%#snum] UInt128.t'int self

meta "rewrite_def" function deep_model_u128

let min_u128 (self_: UInt128.t) (o: UInt128.t) (return (x: UInt128.t)) = any
  [ return (result: UInt128.t) ->
  {[@stop_split] [@expl:min_u128 ensures] ([@stop_split] [@expl:min ensures #0] [%#scmp] deep_model_u128 result
      <= deep_model_u128 self_)
    /\ ([@stop_split] [@expl:min ensures #1] [%#scmp'0] deep_model_u128 result <= deep_model_u128 o)
    /\ ([@stop_split] [@expl:min ensures #2] [%#scmp'1] result = self_ \/ result = o)
    /\ ([@stop_split] [@expl:min ensures #3] [%#scmp'2] deep_model_u128 self_ < deep_model_u128 o -> result = self_)
    /\ ([@stop_split] [@expl:min ensures #4] [%#scmp'3] deep_model_u128 o <= deep_model_u128 self_ -> result = o)}
    (! return {result}) ]

type tup2_u64_u64 = { f0: UInt64.t; f1: UInt64.t }

function capped [#"/workspace/crates/verified/src/throttle.rs" 78 0 78 61] (available: int) (refill: int) (burst: int) : int
 = [%#sthrottle] if available + refill <= burst then available + refill else burst

let quota_credit (available: UInt64.t) (debt: UInt64.t) (credit: UInt64.t) (burst: UInt64.t)
  (return (x: tup2_u64_u64)) = any
  [ return (result: tup2_u64_u64) ->
  {[@stop_split] [@expl:quota_credit ensures] ([@stop_split] [@expl:quota_credit ensures #0] [%#squota] UInt64.t'int result.f0
      <= UInt64.t'int burst)
    /\ ([@stop_split] [@expl:quota_credit ensures #1] [%#squota'0] UInt64.t'int result.f1
      = UInt64.t'int debt
      - (if UInt64.t'int debt <= UInt64.t'int credit then UInt64.t'int debt else UInt64.t'int credit))
    /\ ([@stop_split] [@expl:quota_credit ensures #2] [%#squota'1] UInt64.t'int result.f0
      = capped (UInt64.t'int available) (UInt64.t'int credit
      - (if UInt64.t'int debt <= UInt64.t'int credit then
        UInt64.t'int debt
      else
        UInt64.t'int credit
      )) (UInt64.t'int burst))
    /\ ([@stop_split] [@expl:quota_credit ensures #3] [%#squota'2] UInt64.t'int available = 0 \/ UInt64.t'int debt = 0
    -> UInt64.t'int result.f0 = 0 \/ UInt64.t'int result.f1 = 0)}
    (! return {result}) ]

