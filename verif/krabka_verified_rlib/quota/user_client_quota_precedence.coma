(* #"/workspace/crates/verified/src/quota.rs" 174 0 174 93 *)

let%span squota = "/workspace/crates/verified/src/quota.rs" 172 10 172 38
let%span squota'0 = "/workspace/crates/verified/src/quota.rs" 150 8 152 91
let%span squota'1 = "/workspace/crates/verified/src/quota.rs" 119 8 137 9
let%span squota'2 = "/workspace/crates/verified/src/quota.rs" 98 8 108 9

use creusot.prelude.Any
use int.Int

type t_QuotaCandidatePresence = Absent | Present

type t_UserClientQuotaFacts = {
  user_client: t_QuotaCandidatePresence;
  user_default_client: t_QuotaCandidatePresence;
  user: t_QuotaCandidatePresence;
  default_user_client: t_QuotaCandidatePresence;
  default_user_default_client: t_QuotaCandidatePresence;
  default_user: t_QuotaCandidatePresence;
  client: t_QuotaCandidatePresence;
  default_client: t_QuotaCandidatePresence }

type t_UserClientQuotaPrecedence =
  | UserClient
  | UserDefaultClient
  | User
  | DefaultUserClient
  | DefaultUserDefaultClient
  | DefaultUser
  | Client
  | DefaultClient
  | None

predicate is_present [#"/workspace/crates/verified/src/quota.rs" 117 0 117 92] (facts: t_UserClientQuotaFacts) (candidate: t_UserClientQuotaPrecedence) =
  [%#squota'1] match candidate with
    | UserClient -> facts.user_client = Present
    | UserDefaultClient -> facts.user_default_client = Present
    | User -> facts.user = Present
    | DefaultUserClient -> facts.default_user_client = Present
    | DefaultUserDefaultClient -> facts.default_user_default_client = Present
    | DefaultUser -> facts.default_user = Present
    | Client -> facts.client = Present
    | DefaultClient -> facts.default_client = Present
    | None -> false
    end

function kafka_rank [#"/workspace/crates/verified/src/quota.rs" 96 0 96 62] (candidate: t_UserClientQuotaPrecedence) : int
 = [%#squota'2] match candidate with
    | UserClient -> 0
    | UserDefaultClient -> 1
    | User -> 2
    | DefaultUserClient -> 3
    | DefaultUserDefaultClient -> 4
    | DefaultUser -> 5
    | Client -> 6
    | DefaultClient -> 7
    | None -> 8
    end

predicate first_present [#"/workspace/crates/verified/src/quota.rs" 148 0 148 95] (facts: t_UserClientQuotaFacts) (candidate: t_UserClientQuotaPrecedence) =
  [%#squota'0] (is_present facts candidate \/ candidate = None)
  /\ (forall earlier: t_UserClientQuotaPrecedence. kafka_rank earlier < kafka_rank candidate
    -> not is_present facts earlier)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let user_client_quota_precedence [#"/workspace/crates/verified/src/quota.rs" 174 0 174 93]
  (facts: t_UserClientQuotaFacts) (return (x: t_UserClientQuotaPrecedence)) = (! bb0
  [ bb0 = any [ br0 -> {facts.user_client = Absent} (! bb1) | br1 -> {facts.user_client = Present} (! bb3) ]
  | bb1 = s0 [ s0 = [ &_4 <- false ] s1 | s1 = bb4 ]
  | bb3 = s0 [ s0 = [ &_4 <- true ] s1 | s1 = bb4 ]
  | bb4 = any [ br0 -> {_4 = false} (! bb6) | br1 -> {_4} (! bb5) ]
  | bb5 = s0 [ s0 = [ &_ret <- UserClient ] s1 | s1 = return {_ret} ]
  | bb6 = any
    [ br0 -> {facts.user_default_client = Absent} (! bb7) | br1 -> {facts.user_default_client = Present} (! bb9) ]
  | bb7 = s0 [ s0 = [ &_6 <- false ] s1 | s1 = bb10 ]
  | bb9 = s0 [ s0 = [ &_6 <- true ] s1 | s1 = bb10 ]
  | bb10 = any [ br0 -> {_6 = false} (! bb12) | br1 -> {_6} (! bb11) ]
  | bb11 = s0 [ s0 = [ &_ret <- UserDefaultClient ] s1 | s1 = return {_ret} ]
  | bb12 = any [ br0 -> {facts.user = Absent} (! bb13) | br1 -> {facts.user = Present} (! bb15) ]
  | bb13 = s0 [ s0 = [ &_8 <- false ] s1 | s1 = bb16 ]
  | bb15 = s0 [ s0 = [ &_8 <- true ] s1 | s1 = bb16 ]
  | bb16 = any [ br0 -> {_8 = false} (! bb18) | br1 -> {_8} (! bb17) ]
  | bb17 = s0 [ s0 = [ &_ret <- User ] s1 | s1 = return {_ret} ]
  | bb18 = any
    [ br0 -> {facts.default_user_client = Absent} (! bb19) | br1 -> {facts.default_user_client = Present} (! bb21) ]
  | bb19 = s0 [ s0 = [ &_10 <- false ] s1 | s1 = bb22 ]
  | bb21 = s0 [ s0 = [ &_10 <- true ] s1 | s1 = bb22 ]
  | bb22 = any [ br0 -> {_10 = false} (! bb24) | br1 -> {_10} (! bb23) ]
  | bb23 = s0 [ s0 = [ &_ret <- DefaultUserClient ] s1 | s1 = return {_ret} ]
  | bb24 = any
    [ br0 -> {facts.default_user_default_client = Absent} (! bb25)
    | br1 -> {facts.default_user_default_client = Present} (! bb27) ]
  | bb25 = s0 [ s0 = [ &_12 <- false ] s1 | s1 = bb28 ]
  | bb27 = s0 [ s0 = [ &_12 <- true ] s1 | s1 = bb28 ]
  | bb28 = any [ br0 -> {_12 = false} (! bb30) | br1 -> {_12} (! bb29) ]
  | bb29 = s0 [ s0 = [ &_ret <- DefaultUserDefaultClient ] s1 | s1 = return {_ret} ]
  | bb30 = any [ br0 -> {facts.default_user = Absent} (! bb31) | br1 -> {facts.default_user = Present} (! bb33) ]
  | bb31 = s0 [ s0 = [ &_14 <- false ] s1 | s1 = bb34 ]
  | bb33 = s0 [ s0 = [ &_14 <- true ] s1 | s1 = bb34 ]
  | bb34 = any [ br0 -> {_14 = false} (! bb36) | br1 -> {_14} (! bb35) ]
  | bb35 = s0 [ s0 = [ &_ret <- DefaultUser ] s1 | s1 = return {_ret} ]
  | bb36 = any [ br0 -> {facts.client = Absent} (! bb37) | br1 -> {facts.client = Present} (! bb39) ]
  | bb37 = s0 [ s0 = [ &_16 <- false ] s1 | s1 = bb40 ]
  | bb39 = s0 [ s0 = [ &_16 <- true ] s1 | s1 = bb40 ]
  | bb40 = any [ br0 -> {_16 = false} (! bb42) | br1 -> {_16} (! bb41) ]
  | bb41 = s0 [ s0 = [ &_ret <- Client ] s1 | s1 = return {_ret} ]
  | bb42 = any [ br0 -> {facts.default_client = Absent} (! bb43) | br1 -> {facts.default_client = Present} (! bb45) ]
  | bb43 = s0 [ s0 = [ &_18 <- false ] s1 | s1 = bb46 ]
  | bb45 = s0 [ s0 = [ &_18 <- true ] s1 | s1 = bb46 ]
  | bb46 = any [ br0 -> {_18 = false} (! bb48) | br1 -> {_18} (! bb47) ]
  | bb47 = s0 [ s0 = [ &_ret <- DefaultClient ] s1 | s1 = return {_ret} ]
  | bb48 = s0 [ s0 = [ &_ret <- None ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_UserClientQuotaPrecedence = Any.any_l ()
  | & facts: t_UserClientQuotaFacts = facts
  | & _4: bool = Any.any_l ()
  | & _6: bool = Any.any_l ()
  | & _8: bool = Any.any_l ()
  | & _10: bool = Any.any_l ()
  | & _12: bool = Any.any_l ()
  | & _14: bool = Any.any_l ()
  | & _16: bool = Any.any_l ()
  | & _18: bool = Any.any_l () ])
  [ return (result: t_UserClientQuotaPrecedence) ->
  {[@stop_split] [@expl:user_client_quota_precedence ensures] [%#squota] first_present facts result}
    (! return {result}) ]
