predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

let len_i64 (self_: Slice64.slice Int64.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sslice] Seq.length (Slice64.view self_)
    = UInt64.t'int result}
    (! return {result}) ]

predicate is_segment_base [#"/workspace/crates/verified/src/producer_snapshot.rs" 52 0 52 60] (bases: Seq.seq Int64.t) (offset: int) =
  [%#sproducer_snapshot'29] exists j: int. 0 <= j /\ j < Seq.length bases /\ Int64.to_int (Seq.get bases j) = offset

predicate kafka_stray_removed [#"/workspace/crates/verified/src/producer_snapshot.rs" 68 0 68 84] (snapshots: Seq.seq Int64.t) (index: int) (bases: Seq.seq Int64.t) =
  [%#sproducer_snapshot'28] not is_segment_base bases (Int64.to_int (Seq.get snapshots index))
  /\ not ((forall j: int. 0 <= j /\ j < Seq.length snapshots
      -> Int64.to_int (Seq.get snapshots j) <= Int64.to_int (Seq.get snapshots index))
  /\ (forall j: int. 0 <= j /\ j < Seq.length bases
    -> Int64.to_int (Seq.get bases j) < Int64.to_int (Seq.get snapshots index)))

