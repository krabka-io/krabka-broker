(* #"/workspace/crates/verified/src/authz/acl_decision.rs" 132 0 132 51 *)

let%span sacl_decision = "/workspace/crates/verified/src/authz/acl_decision.rs" 122 10 130 1

use creusot.prelude.Any

type t_AclDefault = Deny | Allow

type t_AclFacts = { super_user: bool; saw_allow: bool; saw_deny: bool; default_decision: t_AclDefault }

type t_AclDecision = AllowSuperuser | AllowAcl | AllowNoAcl | DenyExplicit | DenyDefault

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let acl_decision [#"/workspace/crates/verified/src/authz/acl_decision.rs" 132 0 132 51]
  (facts: t_AclFacts) (return (x: t_AclDecision)) = (! bb0
  [ bb0 = any [ br0 -> {facts.super_user = false} (! bb2) | br1 -> {facts.super_user} (! bb1) ]
  | bb1 = s0 [ s0 = [ &_ret <- AllowSuperuser ] s1 | s1 = return {_ret} ]
  | bb2 = any [ br0 -> {facts.saw_deny = false} (! bb4) | br1 -> {facts.saw_deny} (! bb3) ]
  | bb3 = s0 [ s0 = [ &_ret <- DenyExplicit ] s1 | s1 = return {_ret} ]
  | bb4 = any [ br0 -> {facts.saw_allow = false} (! bb6) | br1 -> {facts.saw_allow} (! bb5) ]
  | bb5 = s0 [ s0 = [ &_ret <- AllowAcl ] s1 | s1 = return {_ret} ]
  | bb6 = any [ br0 -> {facts.default_decision = Deny} (! bb9) | br1 -> {facts.default_decision = Allow} (! bb10) ]
  | bb10 = s0 [ s0 = [ &_ret <- AllowNoAcl ] s1 | s1 = return {_ret} ]
  | bb9 = s0 [ s0 = [ &_ret <- DenyDefault ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_AclDecision = Any.any_l () | & facts: t_AclFacts = facts ])
  [ return (result: t_AclDecision) -> {[@stop_split] [@expl:acl_decision ensures] [%#sacl_decision] match result with
      | AllowSuperuser -> facts.super_user
      | DenyExplicit -> not facts.super_user /\ facts.saw_deny
      | AllowAcl -> not facts.super_user /\ not facts.saw_deny /\ facts.saw_allow
      | AllowNoAcl -> not facts.super_user
      /\ not facts.saw_deny /\ not facts.saw_allow /\ facts.default_decision = Allow
      | DenyDefault -> not facts.super_user
      /\ not facts.saw_deny /\ not facts.saw_allow /\ facts.default_decision = Deny
      end}
    (! return {result}) ]
