  [ bb0 = any [ br0 -> {wildcard = false} (! bb2) | br1 -> {wildcard} (! bb1) ]
  | bb1 = s0 [ s0 = [ &_ret <- [%#sauthz] true ] s1 | s1 = return {_ret} ]
  | bb2 = s0 [ s0 = [ &_ret <- exact ] s1 | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l () | & wildcard: bool = wildcard | & exact: bool = exact ])
  [ return (result: bool) -> {[@stop_split] [@expl:acl_identity_match ensures] [%#sauthz'0] result
    = (wildcard \/ exact)}
    (! return {result}) ]
