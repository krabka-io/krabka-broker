  (pattern: t_AclPatternKind) (exact: bool) (wildcard: bool) (prefix: bool) (return (x: bool)) = (! bb0
  [ bb0 = any [ br0 -> {same_type = false} (! bb2) | br1 -> {same_type} (! bb1) ]
  | bb1 = any [ br0 -> {pattern = Literal} (! bb6) | br1 -> {pattern = Prefixed} (! bb5) ]
  | bb5 = s0 [ s0 = [ &_ret <- prefix ] s1 | s1 = return {_ret} ]
  | bb6 = any [ br0 -> {exact = false} (! bb8) | br1 -> {exact} (! bb7) ]
