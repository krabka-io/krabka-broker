  | bb2 = s0 [ s0 = [ &_ret <- [%#sauthz'0] false ] s1 | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l ()
  | & same_type: bool = same_type
  | & pattern: t_AclPatternKind = pattern
  | & exact: bool = exact
  | & wildcard: bool = wildcard
  | & prefix: bool = prefix ])
