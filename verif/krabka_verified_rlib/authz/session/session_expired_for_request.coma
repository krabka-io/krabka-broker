(* #"/workspace/crates/verified/src/authz/session.rs" 57 0 57 93 *)

let%span ssession = "/workspace/crates/verified/src/authz/session.rs" 59 15 59 20
let%span ssession'0 = "/workspace/crates/verified/src/authz/session.rs" 63 16 63 21
let%span ssession'1 = "/workspace/crates/verified/src/authz/session.rs" 52 10 55 2

use creusot.int.Int16
use creusot.int.Int64
use creusot.prelude.Any
use int.Int

type t_Option_i64 = None | Some Int64.t

let elim_Some (_x: t_Option_i64) (return (f0: Int64.t)) = any
  [ _k (f0: Int64.t) -> {Some f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
      | _ -> false
      end}
    any) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let session_expired_for_request [#"/workspace/crates/verified/src/authz/session.rs" 57 0 57 93]
  (expiry_ms: t_Option_i64) (api_key: Int16.t) (now_ms: Int64.t) (return (x: bool)) = (! bb0
  [ bb0 = any
    [ br0 -> {api_key = (17: Int16.t)} (! bb3)
    | br1 -> {api_key = (36: Int16.t)} (! bb3)
    | default -> -{api_key <> (17: Int16.t) /\ api_key <> (36: Int16.t)}- (! bb1) ]
  | bb1 = s0 [ s0 = [ &_9 <- false ] s1 | s1 = bb4 ]
  | bb3 = s0 [ s0 = [ &_9 <- true ] s1 | s1 = bb4 ]
  | bb4 = any [ br0 -> {_9 = false} (! bb6) | br1 -> {_9} (! bb5) ]
  | bb5 = s0 [ s0 = [ &_ret <- [%#ssession] false ] s1 | s1 = return {_ret} ]
  | bb6 = any [ br0 -> {expiry_ms = None} (! bb9) | br1 (x0: Int64.t) -> {expiry_ms = Some x0} (! bb10) ]
  | bb10 = s0
    [ s0 = elim_Some {expiry_ms} (fun (r0: Int64.t) -> [ &at' <- r0 ] s1)
    | s1 = [ &_ret <- Int64.le at' now_ms ] s2
    | s2 = return {_ret} ]
  | bb9 = s0 [ s0 = [ &_ret <- [%#ssession'0] false ] s1 | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l ()
  | & expiry_ms: t_Option_i64 = expiry_ms
  | & api_key: Int16.t = api_key
  | & now_ms: Int64.t = now_ms
  | & _9: bool = Any.any_l ()
  | & at': Int64.t = Any.any_l () ])
  [ return (result: bool) -> {[@stop_split] [@expl:session_expired_for_request ensures] [%#ssession'1] result
    = (Int16.to_int api_key <> 17
    /\ Int16.to_int api_key <> 36
    /\ match expiry_ms with
      | None -> false
      | Some at' -> Int64.to_int at' <= Int64.to_int now_ms
      end)}
    (! return {result}) ]
