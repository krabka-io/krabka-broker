use creusot.int.Int64
use creusot.prelude.Any
use int.Int

type t_Option_i64 = None | Some Int64.t

type tup2_Option_i64_Option_i64 = { f0: t_Option_i64; f1: t_Option_i64 }

let elim_Some (_x: t_Option_i64) (return (f0'0: Int64.t)) = any
  [ _k (f0'0: Int64.t) -> {Some f0'0 = _x} (! return {f0'0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
      | _ -> false
      end}
    any) ]

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

constant const_MIN: Int64.t = (-9223372036854775808: Int64.t)

constant const_MAX: Int64.t = (9223372036854775807: Int64.t)

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

let saturating_sub (self_: Int64.t) (rhs: Int64.t) (return (x: Int64.t)) = any
  [ return (result: Int64.t) ->
  {[@stop_split] [@expl:saturating_sub ensures] ([@stop_split] [@expl:saturating_sub ensures #0] [%#snum] ge_log_Int (Int64.to_int self_
          - Int64.to_int rhs) (Int64.to_int const_MIN)
        /\ Int64.to_int self_ - Int64.to_int rhs <= Int64.to_int const_MAX
      -> Int64.to_int result = Int64.to_int self_ - Int64.to_int rhs)
    /\ ([@stop_split] [@expl:saturating_sub ensures #1] [%#snum'0] Int64.to_int self_ - Int64.to_int rhs
        < Int64.to_int const_MIN -> Int64.to_int result = Int64.to_int const_MIN)
    /\ ([@stop_split] [@expl:saturating_sub ensures #2] [%#snum'1] gt_log_Int (Int64.to_int self_
      - Int64.to_int rhs) (Int64.to_int const_MAX) -> Int64.to_int result = Int64.to_int const_MAX)}
    (! return {result}) ]

constant const_MIN_REAUTH_INTERVAL_MS: Int64.t = [%#ssession'4] (1000: Int64.t)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let reauthentication_begins [#"/workspace/crates/verified/src/authz/session.rs" 63 0 67 9] (expiry_ms: t_Option_i64)
  (now_ms: Int64.t) (last_start_ms: t_Option_i64) (return (x: bool)) = (! bb0
  [ bb0 = s0
    [ s0 = [ &_8 <- { f0 = expiry_ms; f1 = last_start_ms } ] s1
    | s1 = any [ br0 -> {_8.f0 = None} (! bb7) | br1 (x0: Int64.t) -> {_8.f0 = Some x0} (! bb3) ] ]
  | bb3 = any [ br0 -> {_8.f1 = None} (! bb6) | br1 (x0: Int64.t) -> {_8.f1 = Some x0} (! bb5) ]
  | bb5 = s0
    [ s0 = elim_Some {_8.f1} (fun (r0: Int64.t) -> [ &last <- r0 ] s1)
    | s1 = saturating_sub [%#ssession] {now_ms} {last} (fun (_x: Int64.t) -> [ &_14 <- _x ] s2)
    | s2 = [ &_ret <- Int64.ge _14 ([%#ssession'0] const_MIN_REAUTH_INTERVAL_MS) ] s3
    | s3 = return {_ret} ]
  | bb6 = s0 [ s0 = [ &_ret <- [%#ssession'1] true ] s1 | s1 = return {_ret} ]
  | bb7 = s0 [ s0 = [ &_ret <- [%#ssession'2] false ] s1 | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l ()
  | & expiry_ms: t_Option_i64 = expiry_ms
  | & now_ms: Int64.t = now_ms
  | & last_start_ms: t_Option_i64 = last_start_ms
  | & _8: tup2_Option_i64_Option_i64 = Any.any_l ()
  | & last: Int64.t = Any.any_l ()
  | & _14: Int64.t = Any.any_l () ])
  [ return (result: bool) -> {[@stop_split] [@expl:reauthentication_begins ensures] [%#ssession'3] result
    = (expiry_ms <> None
    /\ match last_start_ms with
      | None -> true
      | Some last -> ge_log_Int (Int64.to_int now_ms - Int64.to_int last) 1000
      end)}
    (! return {result}) ]
