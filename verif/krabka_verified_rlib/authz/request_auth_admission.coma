(* #"/workspace/crates/verified/src/authz.rs" 187 0 187 76 *)

let%span sauthz = "/workspace/crates/verified/src/authz.rs" 189 43 189 47
let%span sauthz'0 = "/workspace/crates/verified/src/authz.rs" 190 36 190 41
let%span sauthz'1 = "/workspace/crates/verified/src/authz.rs" 191 51 191 53
let%span sauthz'2 = "/workspace/crates/verified/src/authz.rs" 180 10 180 61
let%span sauthz'3 = "/workspace/crates/verified/src/authz.rs" 181 10 181 55
let%span sauthz'4 = "/workspace/crates/verified/src/authz.rs" 182 10 183 30
let%span sauthz'5 = "/workspace/crates/verified/src/authz.rs" 184 10 185 48

use creusot.int.Int16
use creusot.prelude.Any

type t_RequestAuthState = PreHandshake | Exchanging | Failed | Authenticated

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let request_auth_admission [#"/workspace/crates/verified/src/authz.rs" 187 0 187 76] (state: t_RequestAuthState)
  (api_key: Int16.t) (return (x: bool)) = (! bb0
  [ bb0 = any
    [ br0 -> {state = PreHandshake} (! bb5)
    | br1 -> {state = Exchanging} (! bb6)
    | br2 -> {state = Failed} (! bb7)
    | br3 -> {state = Authenticated} (! bb8) ]
  | bb8 = s0 [ s0 = [ &_ret <- [%#sauthz] true ] s1 | s1 = return {_ret} ]
  | bb7 = s0 [ s0 = [ &_ret <- [%#sauthz'0] false ] s1 | s1 = return {_ret} ]
  | bb6 = s0 [ s0 = [ &_ret <- api_key = ([%#sauthz'1] (36: Int16.t)) ] s1 | s1 = return {_ret} ]
  | bb5 = any
    [ br0 -> {api_key = (17: Int16.t)} (! bb11)
    | br1 -> {api_key = (18: Int16.t)} (! bb11)
    | default -> -{api_key <> (17: Int16.t) /\ api_key <> (18: Int16.t)}- (! bb9) ]
  | bb9 = s0 [ s0 = [ &_ret <- false ] s1 | s1 = return {_ret} ]
  | bb11 = s0 [ s0 = [ &_ret <- true ] s1 | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l () | & state: t_RequestAuthState = state | & api_key: Int16.t = api_key ])
  [ return (result: bool) ->
  {[@stop_split] [@expl:request_auth_admission ensures] ([@stop_split] [@expl:request_auth_admission ensures #0] [%#sauthz'2] state
        = Authenticated -> result)
    /\ ([@stop_split] [@expl:request_auth_admission ensures #1] [%#sauthz'3] state = Failed -> not result)
    /\ ([@stop_split] [@expl:request_auth_admission ensures #2] [%#sauthz'4] state = Exchanging
      -> result = (Int16.to_int api_key = 36))
    /\ ([@stop_split] [@expl:request_auth_admission ensures #3] [%#sauthz'5] state = PreHandshake
    -> result = (Int16.to_int api_key = 17 \/ Int16.to_int api_key = 18))}
    (! return {result}) ]
