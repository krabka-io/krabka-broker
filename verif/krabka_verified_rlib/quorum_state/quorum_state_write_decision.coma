(* #"/workspace/crates/verified/src/quorum_state.rs" 57 0 65 29 *)

let%span squorum_state = "/workspace/crates/verified/src/quorum_state.rs" 66 23 66 24
let%span squorum_state'0 = "/workspace/crates/verified/src/quorum_state.rs" 67 26 67 39
let%span squorum_state'1 = "/workspace/crates/verified/src/quorum_state.rs" 68 38 68 51
let%span squorum_state'2 = "/workspace/crates/verified/src/quorum_state.rs" 69 35 69 48
let%span squorum_state'3 = "/workspace/crates/verified/src/quorum_state.rs" 70 29 70 30
let%span squorum_state'4 = "/workspace/crates/verified/src/quorum_state.rs" 47 10 55 1
let%span squorum_state'5 = "/workspace/crates/verified/src/quorum_state.rs" 36 8 40 57

use creusot.int.UInt16
use creusot.int.UInt32
use creusot.int.UInt64
use creusot.prelude.Any
use creusot.int.Int32
use int.Int

type t_QuorumStateWriteDecision = Reject | Accept

constant const_MAX: Int32.t = (2147483647: Int32.t)

predicate fits_signed_json [#"/workspace/crates/verified/src/quorum_state.rs" 26 0 34 9] (kraft_version: UInt16.t) (leader_epoch: UInt32.t) (has_leader: bool) (leader_id: UInt64.t) (has_vote: bool) (voted_id: UInt64.t) (all_voter_ids_fit: bool) =
  [%#squorum_state'5] UInt16.t'int kraft_version <= 1
  /\ UInt32.t'int leader_epoch <= Int32.to_int const_MAX
  /\ (not has_leader \/ UInt64.t'int leader_id <= Int32.to_int const_MAX)
  /\ (not has_vote \/ UInt64.t'int voted_id <= Int32.to_int const_MAX)
  /\ (UInt16.t'int kraft_version = 1 \/ all_voter_ids_fit)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let quorum_state_write_decision [#"/workspace/crates/verified/src/quorum_state.rs" 57 0 65 29] (kraft_version: UInt16.t)
  (leader_epoch: UInt32.t) (has_leader: bool) (leader_id: UInt64.t) (has_vote: bool) (voted_id: UInt64.t)
  (all_voter_ids_fit: bool) (return (x: t_QuorumStateWriteDecision)) = (! bb0
  [ bb0 = s0
    [ s0 = [ &_16 <- UInt16.gt kraft_version ([%#squorum_state] (1: UInt16.t)) ] s1
    | s1 = any [ br0 -> {_16 = false} (! bb2) | br1 -> {_16} (! bb14) ] ]
  | bb2 = s0
    [ s0 = [ &_18 <- UInt32.gt leader_epoch ([%#squorum_state'0] (2147483647: UInt32.t)) ] s1
    | s1 = any [ br0 -> {_18 = false} (! bb4) | br1 -> {_18} (! bb14) ] ]
  | bb4 = any [ br0 -> {has_leader = false} (! bb8) | br1 -> {has_leader} (! bb5) ]
  | bb5 = s0
    [ s0 = [ &_21 <- UInt64.gt leader_id ([%#squorum_state'1] (2147483647: UInt64.t)) ] s1
    | s1 = any [ br0 -> {_21 = false} (! bb8) | br1 -> {_21} (! bb14) ] ]
  | bb8 = any [ br0 -> {has_vote = false} (! bb12) | br1 -> {has_vote} (! bb9) ]
  | bb9 = s0
    [ s0 = [ &_24 <- UInt64.gt voted_id ([%#squorum_state'2] (2147483647: UInt64.t)) ] s1
    | s1 = any [ br0 -> {_24 = false} (! bb12) | br1 -> {_24} (! bb14) ] ]
  | bb12 = s0
    [ s0 = [ &_26 <- kraft_version = ([%#squorum_state'3] (0: UInt16.t)) ] s1
    | s1 = any [ br0 -> {_26 = false} (! bb16) | br1 -> {_26} (! bb13) ] ]
  | bb13 = any [ br0 -> {all_voter_ids_fit = false} (! bb14) | br1 -> {all_voter_ids_fit} (! bb16) ]
  | bb14 = s0 [ s0 = [ &_ret <- Reject ] s1 | s1 = return {_ret} ]
  | bb16 = s0 [ s0 = [ &_ret <- Accept ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_QuorumStateWriteDecision = Any.any_l ()
  | & kraft_version: UInt16.t = kraft_version
  | & leader_epoch: UInt32.t = leader_epoch
  | & has_leader: bool = has_leader
  | & leader_id: UInt64.t = leader_id
  | & has_vote: bool = has_vote
  | & voted_id: UInt64.t = voted_id
  | & all_voter_ids_fit: bool = all_voter_ids_fit
  | & _16: bool = Any.any_l ()
  | & _18: bool = Any.any_l ()
  | & _21: bool = Any.any_l ()
  | & _24: bool = Any.any_l ()
  | & _26: bool = Any.any_l () ])
  [ return (result: t_QuorumStateWriteDecision) ->
  {[@stop_split] [@expl:quorum_state_write_decision ensures] [%#squorum_state'4] (result = Accept)
    = fits_signed_json kraft_version leader_epoch has_leader leader_id has_vote voted_id all_voter_ids_fit}
    (! return {result}) ]
