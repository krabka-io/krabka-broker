use creusot.int.UInt64
use creusot.int.UInt32
use creusot.prelude.Any

type t_Option_u64 = None | Some UInt64.t

type t_FetchFence = {
  discovering: bool;
  role_leader: t_Option_u64;
  current_leader: t_Option_u64;
  current_epoch: UInt32.t }

let is_none_u64 (self_: t_Option_u64) (return (x: bool)) = any
  [ return (result: bool) -> {[@stop_split] [@expl:is_none ensures] [%#soption] result = (self_ = None)}
    (! return {result}) ]

type t_FetchResponseFacts = { from: UInt64.t; leader: t_Option_u64; epoch: UInt32.t; error_none: bool }

let is_some_u64 (self_: t_Option_u64) (return (x: bool)) = any
  [ return (result: bool) -> {[@stop_split] [@expl:is_some ensures] [%#soption'0] result = (self_ <> None)}
    (! return {result}) ]

type t_FetchResponseMutation = Reject | Discover | Snapshot | Truncate | Append | HighWatermark

type t_Option_Int = None'0 | Some'0 int

function deep_model_u64 [@inline:trivial] (self: UInt64.t) : int = [%#snum] UInt64.t'int self

meta "rewrite_def" function deep_model_u64

function deep_model_Option_u64 [@inline:trivial] (self: t_Option_u64) : t_Option_Int = [%#soption'1] match self with
    | Some t -> Some'0 (deep_model_u64 t)
    | None -> None'0
    end

meta "rewrite_def" function deep_model_Option_u64

function deep_model_ref_Option_u64 [@inline:trivial] (self: t_Option_u64) : t_Option_Int =
  [%#smodel] deep_model_Option_u64 self

meta "rewrite_def" function deep_model_ref_Option_u64

let ne_Option_u64 (self_: t_Option_u64) (rhs: t_Option_u64) (return (x: bool)) = any
  [ return (result: bool) -> {[@stop_split] [@expl:ne ensures] [%#scmp] result
    = (deep_model_ref_Option_u64 self_ <> deep_model_ref_Option_u64 rhs)}
    (! return {result}) ]

type t_FetchContent = { has_snapshot: bool; has_divergence: bool; has_records: bool }

predicate discovery_applies [#"/workspace/crates/verified/src/raft.rs" 91 0 91 81] (fence: t_FetchFence) (response: t_FetchResponseFacts) =
  [%#sraft'11] fence.discovering
  /\ fence.role_leader = None
  /\ fence.current_leader = None /\ response.epoch = fence.current_epoch /\ response.leader <> None

predicate leader_fence_holds [#"/workspace/crates/verified/src/raft.rs" 72 0 72 82] (fence: t_FetchFence) (response: t_FetchResponseFacts) =
  [%#sraft'12] fence.role_leader = Some (response.from)
  /\ fence.current_leader = Some (response.from)
  /\ response.leader = Some (response.from) /\ response.epoch = fence.current_epoch /\ response.error_none

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

