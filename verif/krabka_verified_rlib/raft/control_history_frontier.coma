let len_i64 (self_: Slice64.slice Int64.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sslice] Seq.length (Slice64.view self_)
    = UInt64.t'int result}
    (! return {result}) ]

predicate gt_log_usize [@inline:trivial] (self: UInt64.t) (other: UInt64.t) = [%#sord] UInt64.lt other self

meta "rewrite_def" predicate gt_log_usize

predicate well_founded_relation_usize [@inline:trivial] (self: UInt64.t) (other: UInt64.t) =
  [%#swell_founded] gt_log_usize self other

meta "rewrite_def" predicate well_founded_relation_usize

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

