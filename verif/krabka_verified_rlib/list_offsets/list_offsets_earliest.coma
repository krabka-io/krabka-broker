  [ bb0 = s0
    [ s0 = [ &_9 <- Int64.lt facts.local ([%#slist_offsets] (0: Int64.t)) ] s1
    | s1 = any [ br0 -> {_9 = false} (! bb2) | br1 -> {_9} (! bb9) ] ]
  | bb2 = any [ br0 -> {facts.has_remote = false} (! bb6) | br1 -> {facts.has_remote} (! bb3) ]
  | bb3 = s0
    [ s0 = [ &_12 <- Int64.lt facts.remote ([%#slist_offsets'0] (0: Int64.t)) ] s1
