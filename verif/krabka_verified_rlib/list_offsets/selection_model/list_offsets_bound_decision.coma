  | bb14 = s0 [ s0 = [ &_ret <- RejectMalformed ] s1 | s1 = return {_ret} ]
  | bb18 = s0
    [ s0 = [ &_25 <- facts.replica_id <> ([%#sselection_model'6] (-1: Int32.t)) ] s1
    | s1 = any [ br0 -> {_25 = false} (! bb20) | br1 -> {_25} (! bb19) ] ]
  | bb19 = s0 [ s0 = [ &offset <- facts.log_end ] s1 | s1 = bb27 ]
  | bb20 = s0
    [ s0 = [ &_27 <- facts.isolation_level = ([%#sselection_model'7] (1: Int8.t)) ] s1
    | s1 = any [ br0 -> {_27 = false} (! bb22) | br1 -> {_27} (! bb21) ] ]
  | bb21 = s0
    [ s0 = [ &_29 <- Int64.lt facts.last_stable facts.high_watermark ] s1
    | s1 = any [ br0 -> {_29 = false} (! bb24) | br1 -> {_29} (! bb23) ] ]
  | bb23 = s0 [ s0 = [ &offset <- facts.last_stable ] s1 | s1 = bb27 ]
  | bb24 = s0 [ s0 = [ &offset <- facts.high_watermark ] s1 | s1 = bb27 ]
  | bb22 = s0 [ s0 = [ &offset <- facts.high_watermark ] s1 | s1 = bb27 ]
  | bb27 = s0 [ s0 = [ &_ret <- Bound offset ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_ListOffsetsBoundDecision = Any.any_l ()
  | & facts: t_ListOffsetsBoundFacts = facts
  | & _9: bool = Any.any_l ()
  | & _11: bool = Any.any_l ()
  | & _13: bool = Any.any_l ()
  | & _15: bool = Any.any_l ()
  | & _17: bool = Any.any_l ()
  | & _19: bool = Any.any_l ()
  | & _21: bool = Any.any_l ()
  | & offset: Int64.t = Any.any_l ()
  | & _25: bool = Any.any_l ()
  | & _27: bool = Any.any_l ()
  | & _29: bool = Any.any_l () ])
  [ return (result: t_ListOffsetsBoundDecision) ->
  {[@stop_split] [@expl:list_offsets_bound_decision ensures] [%#sselection_model'8] match result with
      | RejectMalformed -> Int32.to_int facts.replica_id <> - 1 /\ Int64.to_int facts.log_end < 0
      \/ Int32.to_int facts.replica_id = - 1 /\ Int64.to_int facts.high_watermark < 0
      \/ Int32.to_int facts.replica_id = - 1
      /\ Int8.to_int facts.isolation_level = 1 /\ Int64.to_int facts.last_stable < 0
