  | bb10 = s0
    [ s0 = [ &_17 <- facts.replica_id = ([%#sselection_model'3] (-1: Int32.t)) ] s1
    | s1 = any [ br0 -> {_17 = false} (! bb18) | br1 -> {_17} (! bb11) ] ]
  | bb11 = s0
    [ s0 = [ &_19 <- facts.isolation_level = ([%#sselection_model'4] (1: Int8.t)) ] s1
    | s1 = any [ br0 -> {_19 = false} (! bb18) | br1 -> {_19} (! bb12) ] ]
  | bb12 = s0
