type t_ListOffsetsBoundDecision = RejectMalformed | Bound Int64.t

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let list_offsets_bound_decision [#"/workspace/crates/verified/src/list_offsets/selection_model.rs" 86 0 86 98]
  (facts: t_ListOffsetsBoundFacts) (return (x: t_ListOffsetsBoundDecision)) = (! bb0
  [ bb0 = s0
    [ s0 = [ &_9 <- facts.replica_id <> ([%#sselection_model] (-1: Int32.t)) ] s1
    | s1 = any [ br0 -> {_9 = false} (! bb5) | br1 -> {_9} (! bb1) ] ]
  | bb1 = s0
    [ s0 = [ &_11 <- Int64.lt facts.log_end ([%#sselection_model'0] (0: Int64.t)) ] s1
