  | bb20 = s0 [ s0 = [ &offset <- facts.last_fetchable ] s1 | s1 = bb23 ]
  | bb22 = s0 [ s0 = [ &offset <- facts.candidate_offset ] s1 | s1 = bb23 ]
  | bb23 = s0
    [ s0 = [ &_30 <- mode = ([%#slist_offsets'7] (2: Int32.t)) ] s1
    | s1 = any [ br0 -> {_30 = false} (! bb28) | br1 -> {_30} (! bb24) ] ]
  | bb24 = s0
    [ s0 = [ &_32 <- Int64.ge offset facts.last_fetchable ] s1
    | s1 = any [ br0 -> {_32 = false} (! bb28) | br1 -> {_32} (! bb25) ] ]
  | bb25 = s0 [ s0 = [ &_ret <- Unknown ] s1 | s1 = return {_ret} ]
  | bb28 = s0
    [ s0 = [ &_ret <- Resolved offset (facts.candidate_timestamp) (facts.candidate_epoch) ] s1 | s1 = return {_ret} ]
  | bb7 = s0 [ s0 = [ &_ret <- RejectMalformed ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_ListOffsetsSelectionDecision = Any.any_l ()
  | & facts: t_ListOffsetsSelectionFacts = facts
  | & mode: Int32.t = Any.any_l ()
  | & _12: bool = Any.any_l ()
  | & _14: bool = Any.any_l ()
  | & _16: bool = Any.any_l ()
  | & _20: bool = Any.any_l ()
  | & offset: Int64.t = Any.any_l ()
  | & _24: bool = Any.any_l ()
  | & _26: bool = Any.any_l ()
  | & _30: bool = Any.any_l ()
  | & _32: bool = Any.any_l () ])
  [ return (result: t_ListOffsetsSelectionDecision) ->
  {[@stop_split] [@expl:list_offsets_selection_decision ensures] [%#slist_offsets'8] match result with
      | RejectMalformed -> facts.kind = Unsupported
      \/ Int64.to_int facts.candidate_offset < - 1
      \/ Int32.to_int facts.candidate_epoch < - 1 \/ Int64.to_int facts.last_fetchable < 0
      | Unknown -> facts.kind <> Unsupported
      /\ ge_log_Int (Int64.to_int facts.candidate_offset) (- 1)
      /\ ge_log_Int (Int32.to_int facts.candidate_epoch) (- 1)
      /\ ge_log_Int (Int64.to_int facts.last_fetchable) 0
