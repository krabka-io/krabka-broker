let%span slist_offsets'2 = "/workspace/crates/verified/src/list_offsets.rs" 294 32 294 34
let%span slist_offsets'3 = "/workspace/crates/verified/src/list_offsets.rs" 294 62 294 64
let%span slist_offsets'4 = "/workspace/crates/verified/src/list_offsets.rs" 294 91 294 92
let%span slist_offsets'5 = "/workspace/crates/verified/src/list_offsets.rs" 297 33 297 35
