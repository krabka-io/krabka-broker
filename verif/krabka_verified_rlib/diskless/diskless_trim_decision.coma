    | s1 = min_i64 [%#sdiskless'7] {frontier} {_41} (fun (_x: Int64.t) -> [ &target'0 <- _x ] s2)
    | s2 = [ &_44 <- Int64.le target'0 current_start ] s3
    | s3 = any [ br0 -> {_44 = false} (! bb13) | br1 -> {_44} (! bb12) ] ]
  | bb12 = s0
    [ s0 = [ &_ret <- { should_trim = ([%#sdiskless'8] false); target = current_start } ] s1 | s1 = return {_ret} ]
  | bb13 = s0
    [ s0 = [ &_ret <- { should_trim = ([%#sdiskless'9] true); target = target'0 } ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_DisklessTrimDecision = Any.any_l ()
  | & frontier: Int64.t = frontier
  | & high_watermark: Int64.t = high_watermark
  | & safety_lag: Int64.t = safety_lag
  | & current_start: Int64.t = current_start
  | & _23: bool = Any.any_l ()
  | & _25: bool = Any.any_l ()
  | & _27: bool = Any.any_l ()
  | & safety_lag'0: Int64.t = Any.any_l ()
  | & _34: bool = Any.any_l ()
  | & target'0: Int64.t = Any.any_l ()
  | & _41: Int64.t = Any.any_l ()
  | & _44: bool = Any.any_l () ])
  [ return (result: t_DisklessTrimDecision) ->
  {[@stop_split] [@expl:diskless_trim_decision ensures] ([@stop_split] [@expl:diskless_trim_decision ensures #0] [%#sdiskless'10] result.should_trim
      = (ge_log_Int (Int64.to_int frontier) 0
      /\ ge_log_Int (Int64.to_int high_watermark) 0
      /\ ge_log_Int (Int64.to_int current_start) 0
      /\ effective_trim_lag safety_lag <= Int64.to_int high_watermark
