meta "rewrite_def" function deep_model_ref_Option_i32

let ne_Option_i32 (self: t_Option_i32) (other: t_Option_i32) (return (x: bool)) = any
  [ return (result: bool) -> {[@stop_split] [@expl:ne ensures] [%#scmp] result
