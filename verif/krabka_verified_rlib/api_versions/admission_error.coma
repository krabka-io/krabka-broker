type t_Option_Int = None'0 | Some'0 int

function deep_model_i32 [@inline:trivial] (self: Int32.t) : int = [%#snum] Int32.to_int self

meta "rewrite_def" function deep_model_i32

function deep_model_Option_i32 [@inline:trivial] (self: t_Option_i32) : t_Option_Int = [%#soption] match self with
