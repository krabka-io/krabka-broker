(* <consensus::RecoveryCandidate as std::clone::Clone> *)

use creusot.int.Int32
use creusot.int.Int64
use creusot.int.UInt64
use creusot.prelude.Any

type t_RecoveryCandidate = { last_epoch: Int32.t; log_end_offset: Int64.t; broker_id: UInt64.t }

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let clone_RecoveryCandidate [#"/workspace/crates/verified/src/consensus.rs" 171 27 171 32] (self: t_RecoveryCandidate)
  (return (x: t_RecoveryCandidate)) = (! bb0
  [ bb0 = s0 [ s0 = [ &_ret <- self ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_RecoveryCandidate = Any.any_l () | & self: t_RecoveryCandidate = self ])
  [ return (result: t_RecoveryCandidate) -> (! return {result}) ]
