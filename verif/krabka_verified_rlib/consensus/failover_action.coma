(* #"/workspace/crates/verified/src/consensus.rs" 141 0 141 62 *)

let%span sconsensus = "/workspace/crates/verified/src/consensus.rs" 116 10 139 1

use creusot.prelude.Any

type t_LiveIsr = Empty | WitnessesOnly | Electable

type t_FailoverRecovery = None | Balanced | Aggressive

type t_OutOfIsrFacts = { has_electable_elr: bool; recovery: t_FailoverRecovery; unclean_election_available: bool }

type t_FailoverFacts = { leader_dead: bool; isr_shrunk: bool; live_isr: t_LiveIsr; out_of_isr: t_OutOfIsrFacts }

type t_FailoverAction =
  | ElectClean
  | ElectFromElr
  | Recover t_FailoverRecovery
  | ElectUnclean
  | Unavailable
  | ShrinkIsr
  | NoChange

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let failover_action [#"/workspace/crates/verified/src/consensus.rs" 141 0 141 62] (facts: t_FailoverFacts)
  (return (x: t_FailoverAction)) = (! bb0
  [ bb0 = any [ br0 -> {facts.leader_dead = false} (! bb1) | br1 -> {facts.leader_dead} (! bb5) ]
  | bb5 = any
    [ br0 -> {facts.live_isr = Empty} (! bb9)
    | br1 -> {facts.live_isr = WitnessesOnly} (! bb10)
    | br2 -> {facts.live_isr = Electable} (! bb11) ]
  | bb11 = s0 [ s0 = [ &_ret <- ElectClean ] s1 | s1 = return {_ret} ]
  | bb10 = s0 [ s0 = [ &_ret <- Unavailable ] s1 | s1 = return {_ret} ]
  | bb9 = s0
    [ s0 = [ &out_of_isr'0 <- facts.out_of_isr ] s1
    | s1 = any
      [ br0 -> {out_of_isr'0.has_electable_elr = false} (! bb13) | br1 -> {out_of_isr'0.has_electable_elr} (! bb12) ] ]
  | bb12 = s0 [ s0 = [ &_ret <- ElectFromElr ] s1 | s1 = return {_ret} ]
  | bb13 = any
    [ br0 -> {out_of_isr'0.recovery = None} (! bb18)
    | br1 -> {out_of_isr'0.recovery = Balanced} (! bb19)
    | br2 -> {out_of_isr'0.recovery = Aggressive} (! bb19) ]
  | bb19 = s0 [ s0 = [ &_ret <- Recover (out_of_isr'0.recovery) ] s1 | s1 = return {_ret} ]
  | bb18 = any
    [ br0 -> {out_of_isr'0.unclean_election_available = false} (! bb16)
    | br1 -> {out_of_isr'0.unclean_election_available} (! bb20) ]
  | bb20 = s0 [ s0 = [ &_ret <- ElectUnclean ] s1 | s1 = return {_ret} ]
  | bb16 = s0 [ s0 = [ &_ret <- Unavailable ] s1 | s1 = return {_ret} ]
  | bb1 = any [ br0 -> {facts.isr_shrunk = false} (! bb3) | br1 -> {facts.isr_shrunk} (! bb2) ]
  | bb2 = s0 [ s0 = [ &_ret <- ShrinkIsr ] s1 | s1 = return {_ret} ]
  | bb3 = s0 [ s0 = [ &_ret <- NoChange ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_FailoverAction = Any.any_l ()
  | & facts: t_FailoverFacts = facts
  | & out_of_isr'0: t_OutOfIsrFacts = Any.any_l () ])
  [ return (result: t_FailoverAction) -> {[@stop_split] [@expl:failover_action ensures] [%#sconsensus] match result with
      | ElectClean -> facts.leader_dead /\ facts.live_isr = Electable
      | ElectFromElr -> facts.leader_dead /\ facts.live_isr = Empty /\ facts.out_of_isr.has_electable_elr
      | Recover selected -> facts.leader_dead
      /\ facts.live_isr = Empty
      /\ not facts.out_of_isr.has_electable_elr
      /\ facts.out_of_isr.recovery <> None /\ selected = facts.out_of_isr.recovery
      | ElectUnclean -> facts.leader_dead
      /\ facts.live_isr = Empty
      /\ not facts.out_of_isr.has_electable_elr
      /\ facts.out_of_isr.recovery = None /\ facts.out_of_isr.unclean_election_available
      | Unavailable -> facts.leader_dead
      /\ (facts.live_isr = WitnessesOnly
      \/ facts.live_isr = Empty
      /\ not facts.out_of_isr.has_electable_elr
      /\ facts.out_of_isr.recovery = None /\ not facts.out_of_isr.unclean_election_available)
      | ShrinkIsr -> not facts.leader_dead /\ facts.isr_shrunk
      | NoChange -> not facts.leader_dead /\ not facts.isr_shrunk
      end}
    (! return {result}) ]
