use creusot.int.Int64
use creusot.prelude.Any
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let handoff_high_watermark [#"/home/user/krabka-broker/crates/verified/src/consensus.rs" 323 0 323 82]
  (previous_hw: Int64.t) (quorum_frontier: Int64.t) (return (x: Int64.t)) = (! bb0
  [ bb0 = s0
    [ s0 = [ &_10 <- Int64.ge previous_hw quorum_frontier ] s1
    | s1 = any [ br0 -> {_10 = false} (! bb2) | br1 -> {_10} (! bb1) ] ]
  | bb1 = s0 [ s0 = [ &_ret <- previous_hw ] s1 | s1 = return {_ret} ]
  | bb2 = s0 [ s0 = [ &_ret <- quorum_frontier ] s1 | s1 = return {_ret} ] ]
  [ & _ret: Int64.t = Any.any_l ()
  | & previous_hw: Int64.t = previous_hw
  | & quorum_frontier: Int64.t = quorum_frontier
  | & _10: bool = Any.any_l () ])
  [ return (result: Int64.t) ->
  {[@stop_split] [@expl:handoff_high_watermark ensures] ([@stop_split] [@expl:handoff_high_watermark ensures #0] [%#sconsensus] ge_log_Int (Int64.to_int result) (Int64.to_int previous_hw))
    /\ ([@stop_split] [@expl:handoff_high_watermark ensures #1] [%#sconsensus'0] ge_log_Int (Int64.to_int result) (Int64.to_int quorum_frontier))
    /\ ([@stop_split] [@expl:handoff_high_watermark ensures #2] [%#sconsensus'1] Int64.to_int result
      = Int64.to_int previous_hw
    \/ Int64.to_int result = Int64.to_int quorum_frontier)}
    (! return {result}) ]
