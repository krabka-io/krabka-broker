use creusot.int.Int64
use seq.Seq
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

function hwm_member_at [#"/workspace/crates/verified/src/consensus.rs" 269 0 269 62] (log_end: int) (s: Seq.seq Int64.t) (k: int) : int
 = [%#sconsensus'12] if k = 0 then log_end else Int64.to_int (Seq.get s (k - 1))

function count_ge_prefix [#"/workspace/crates/verified/src/consensus.rs" 280 0 280 97] (log_end: int) (s: Seq.seq Int64.t) (v: int) (limit: int) (leader_counts: bool) : int

axiom count_ge_prefix_def:
  forall log_end: int, s: Seq.seq Int64.t, v: int, limit: int, leader_counts: bool [count_ge_prefix log_end s v limit leader_counts]. count_ge_prefix log_end s v limit leader_counts
    = ([%#sconsensus'11] if limit <= 0 then
      0
    else
      count_ge_prefix log_end s v (limit - 1) leader_counts
      + (if (leader_counts \/ gt_log_Int limit 1) /\ ge_log_Int (hwm_member_at log_end s (limit - 1)) v then 1 else 0)
    )

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

function lemma_count_ge_prefix_monotone [#"/workspace/crates/verified/src/consensus.rs" 310 0 317 1] (log_end: int) (s: Seq.seq Int64.t) (low: int) (high: int) (limit: int) (leader_counts: bool) : ()

axiom lemma_count_ge_prefix_monotone_def:
  forall log_end: int, s: Seq.seq Int64.t, low: int, high: int, limit: int, leader_counts: bool [lemma_count_ge_prefix_monotone log_end s low high limit leader_counts]. ([%#sconsensus'5] 0
        <= limit
      /\ limit <= Seq.length s + 1)
    -> ([%#sconsensus'6] low <= high)
    -> lemma_count_ge_prefix_monotone log_end s low high limit leader_counts
    = ([%#sconsensus'14] if gt_log_Int limit 0 then
      let _ = lemma_count_ge_prefix_monotone log_end s low high (limit - 1) leader_counts in ()
    else
      ()
    )

axiom lemma_count_ge_prefix_monotone_spec:
  forall log_end: int, s: Seq.seq Int64.t, low: int, high: int, limit: int, leader_counts: bool. ([%#sconsensus'5] 0
        <= limit
      /\ limit <= Seq.length s + 1)
    -> ([%#sconsensus'6] low <= high)
    -> ([%#sconsensus'7] ge_log_Int (count_ge_prefix log_end s low limit leader_counts) (count_ge_prefix log_end s high limit leader_counts))

function lemma_count_ge_prefix_nonnegative [#"/workspace/crates/verified/src/consensus.rs" 330 0 336 1] (log_end: int) (s: Seq.seq Int64.t) (v: int) (limit: int) (leader_counts: bool) : ()

axiom lemma_count_ge_prefix_nonnegative_def:
  forall log_end: int, s: Seq.seq Int64.t, v: int, limit: int, leader_counts: bool [lemma_count_ge_prefix_nonnegative log_end s v limit leader_counts]. ([%#sconsensus'8] 0
        <= limit
      /\ limit <= Seq.length s + 1)
    -> lemma_count_ge_prefix_nonnegative log_end s v limit leader_counts
    = ([%#sconsensus'16] if gt_log_Int limit 0 then
      let _ = lemma_count_ge_prefix_nonnegative log_end s v (limit - 1) leader_counts in ()
    else
      ()
    )

axiom lemma_count_ge_prefix_nonnegative_spec:
  forall log_end: int, s: Seq.seq Int64.t, v: int, limit: int, leader_counts: bool. ([%#sconsensus'8] 0 <= limit
      /\ limit <= Seq.length s + 1) -> ([%#sconsensus'9] ge_log_Int (count_ge_prefix log_end s v limit leader_counts) 0)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant log_end : int

constant s : Seq.seq Int64.t

constant v : int

constant limit : int

constant leader_counts : bool

function least_hwm_member_ge_index [#"/workspace/crates/verified/src/consensus.rs" 353 0 359 8] (log_end: int) (s: Seq.seq Int64.t) (v: int) (limit: int) (leader_counts: bool) : int

goal vc_least_hwm_member_ge_index: ([%#sconsensus'0] 0 < limit /\ limit <= Seq.length s + 1)
  -> ([%#sconsensus'1] ge_log_Int (count_ge_prefix log_end s v limit leader_counts) 1)
  -> (if limit <= 1 then
    let result = 0 in [@stop_split] [@expl:least_hwm_member_ge_index ensures] ([@stop_split] [@expl:least_hwm_member_ge_index ensures #0] [%#sconsensus'2] 0
        <= result
      /\ result < limit)
    /\ ([@stop_split] [@expl:least_hwm_member_ge_index ensures #1] [%#sconsensus'3] ge_log_Int (hwm_member_at log_end s result) v)
    /\ ([@stop_split] [@expl:least_hwm_member_ge_index ensures #2] [%#sconsensus'4] ge_log_Int (count_ge_prefix log_end s (hwm_member_at log_end s result) limit leader_counts) (count_ge_prefix log_end s v limit leader_counts))
  else
    let last_index = limit
    - 1 in let last_member = hwm_member_at log_end s last_index in let previous_count = count_ge_prefix log_end s v last_index leader_counts in if ge_log_Int last_member v then
      if ge_log_Int previous_count 1 then
        (([@stop_split] [@expl:least_hwm_member_ge_index requires] ([@stop_split] [@expl:least_hwm_member_ge_index requires #0] [%#sconsensus'0] 0
                < last_index
              /\ last_index <= Seq.length s + 1)
            /\ ([@stop_split] [@expl:least_hwm_member_ge_index requires #1] [%#sconsensus'1] ge_log_Int (count_ge_prefix log_end s v last_index leader_counts) 1))
          /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sconsensus] limit) ([%#sconsensus] last_index)))
        /\ (([@stop_split] [@expl:least_hwm_member_ge_index ensures] ([@stop_split] [@expl:least_hwm_member_ge_index ensures #0] [%#sconsensus'2] 0
              <= least_hwm_member_ge_index log_end s v last_index leader_counts
            /\ least_hwm_member_ge_index log_end s v last_index leader_counts < last_index)
          /\ ([@stop_split] [@expl:least_hwm_member_ge_index ensures #1] [%#sconsensus'3] ge_log_Int (hwm_member_at log_end s (least_hwm_member_ge_index log_end s v last_index leader_counts)) v)
          /\ ([@stop_split] [@expl:least_hwm_member_ge_index ensures #2] [%#sconsensus'4] ge_log_Int (count_ge_prefix log_end s (hwm_member_at log_end s (least_hwm_member_ge_index log_end s v last_index leader_counts)) last_index leader_counts) (count_ge_prefix log_end s v last_index leader_counts)))
        -> (let previous_index = least_hwm_member_ge_index log_end s v last_index leader_counts in let previous_member = hwm_member_at log_end s previous_index in if last_member
        <= previous_member then
          ([@stop_split] [@expl:lemma_count_ge_prefix_monotone requires] ([@stop_split] [@expl:lemma_count_ge_prefix_monotone requires #0] [%#sconsensus'5] 0
                <= last_index
              /\ last_index <= Seq.length s + 1)
            /\ ([@stop_split] [@expl:lemma_count_ge_prefix_monotone requires #1] [%#sconsensus'6] last_member
            <= previous_member))
          /\ (([@stop_split] [@expl:lemma_count_ge_prefix_monotone ensures] [%#sconsensus'7] ge_log_Int (count_ge_prefix log_end s last_member last_index leader_counts) (count_ge_prefix log_end s previous_member last_index leader_counts))
          -> (let _ = lemma_count_ge_prefix_monotone log_end s last_member previous_member last_index leader_counts in let result = last_index in [@stop_split] [@expl:least_hwm_member_ge_index ensures] ([@stop_split] [@expl:least_hwm_member_ge_index ensures #0] [%#sconsensus'2] 0
              <= result
            /\ result < limit)
          /\ ([@stop_split] [@expl:least_hwm_member_ge_index ensures #1] [%#sconsensus'3] ge_log_Int (hwm_member_at log_end s result) v)
          /\ ([@stop_split] [@expl:least_hwm_member_ge_index ensures #2] [%#sconsensus'4] ge_log_Int (count_ge_prefix log_end s (hwm_member_at log_end s result) limit leader_counts) (count_ge_prefix log_end s v limit leader_counts))))
        else
          let result = previous_index in [@stop_split] [@expl:least_hwm_member_ge_index ensures] ([@stop_split] [@expl:least_hwm_member_ge_index ensures #0] [%#sconsensus'2] 0
              <= result
            /\ result < limit)
          /\ ([@stop_split] [@expl:least_hwm_member_ge_index ensures #1] [%#sconsensus'3] ge_log_Int (hwm_member_at log_end s result) v)
          /\ ([@stop_split] [@expl:least_hwm_member_ge_index ensures #2] [%#sconsensus'4] ge_log_Int (count_ge_prefix log_end s (hwm_member_at log_end s result) limit leader_counts) (count_ge_prefix log_end s v limit leader_counts))
        ))
      else
        ([@stop_split] [@expl:lemma_count_ge_prefix_nonnegative requires] [%#sconsensus'8] 0 <= last_index
          /\ last_index <= Seq.length s + 1)
        /\ (([@stop_split] [@expl:lemma_count_ge_prefix_nonnegative ensures] [%#sconsensus'9] ge_log_Int (count_ge_prefix log_end s v last_index leader_counts) 0)
        -> (let _ = lemma_count_ge_prefix_nonnegative log_end s v last_index leader_counts in ([@stop_split] [@expl:lemma_count_ge_prefix_nonnegative requires] [%#sconsensus'8] 0
            <= last_index
          /\ last_index <= Seq.length s + 1)
        /\ (([@stop_split] [@expl:lemma_count_ge_prefix_nonnegative ensures] [%#sconsensus'9] ge_log_Int (count_ge_prefix log_end s last_member last_index leader_counts) 0)
        -> (let _ = lemma_count_ge_prefix_nonnegative log_end s last_member last_index leader_counts in let result = last_index in [@stop_split] [@expl:least_hwm_member_ge_index ensures] ([@stop_split] [@expl:least_hwm_member_ge_index ensures #0] [%#sconsensus'2] 0
            <= result
          /\ result < limit)
        /\ ([@stop_split] [@expl:least_hwm_member_ge_index ensures #1] [%#sconsensus'3] ge_log_Int (hwm_member_at log_end s result) v)
        /\ ([@stop_split] [@expl:least_hwm_member_ge_index ensures #2] [%#sconsensus'4] ge_log_Int (count_ge_prefix log_end s (hwm_member_at log_end s result) limit leader_counts) (count_ge_prefix log_end s v limit leader_counts))))))
    
    else
      (([@stop_split] [@expl:least_hwm_member_ge_index requires] ([@stop_split] [@expl:least_hwm_member_ge_index requires #0] [%#sconsensus'0] 0
              < last_index
            /\ last_index <= Seq.length s + 1)
          /\ ([@stop_split] [@expl:least_hwm_member_ge_index requires #1] [%#sconsensus'1] ge_log_Int (count_ge_prefix log_end s v last_index leader_counts) 1))
        /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sconsensus] limit) ([%#sconsensus] last_index)))
      /\ (([@stop_split] [@expl:least_hwm_member_ge_index ensures] ([@stop_split] [@expl:least_hwm_member_ge_index ensures #0] [%#sconsensus'2] 0
            <= least_hwm_member_ge_index log_end s v last_index leader_counts
          /\ least_hwm_member_ge_index log_end s v last_index leader_counts < last_index)
        /\ ([@stop_split] [@expl:least_hwm_member_ge_index ensures #1] [%#sconsensus'3] ge_log_Int (hwm_member_at log_end s (least_hwm_member_ge_index log_end s v last_index leader_counts)) v)
        /\ ([@stop_split] [@expl:least_hwm_member_ge_index ensures #2] [%#sconsensus'4] ge_log_Int (count_ge_prefix log_end s (hwm_member_at log_end s (least_hwm_member_ge_index log_end s v last_index leader_counts)) last_index leader_counts) (count_ge_prefix log_end s v last_index leader_counts)))
      -> (let result = least_hwm_member_ge_index log_end s v last_index leader_counts in [@stop_split] [@expl:least_hwm_member_ge_index ensures] ([@stop_split] [@expl:least_hwm_member_ge_index ensures #0] [%#sconsensus'2] 0
          <= result
        /\ result < limit)
      /\ ([@stop_split] [@expl:least_hwm_member_ge_index ensures #1] [%#sconsensus'3] ge_log_Int (hwm_member_at log_end s result) v)
      /\ ([@stop_split] [@expl:least_hwm_member_ge_index ensures #2] [%#sconsensus'4] ge_log_Int (count_ge_prefix log_end s (hwm_member_at log_end s result) limit leader_counts) (count_ge_prefix log_end s v limit leader_counts))))
  
  )
