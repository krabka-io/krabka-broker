use creusot.int.Int64
use seq.Seq
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

function hwm_member_at [#"/home/matt/.codex/worktrees/6279/krabka-broker/crates/verified/src/consensus.rs" 13 0 13 62] (log_end: int) (s: Seq.seq Int64.t) (k: int) : int
 = [%#sconsensus'4] if k = 0 then log_end else Int64.to_int (Seq.get s (k - 1))

function count_ge_prefix [#"/home/matt/.codex/worktrees/6279/krabka-broker/crates/verified/src/consensus.rs" 22 0 22 97] (log_end: int) (s: Seq.seq Int64.t) (v: int) (limit: int) (leader_counts: bool) : int

axiom count_ge_prefix_def:
  forall log_end: int, s: Seq.seq Int64.t, v: int, limit: int, leader_counts: bool [count_ge_prefix log_end s v limit leader_counts]. count_ge_prefix log_end s v limit leader_counts
    = ([%#sconsensus'3] if limit <= 0 then
      0
    else
      count_ge_prefix log_end s v (limit - 1) leader_counts
      + (if (leader_counts \/ gt_log_Int limit 1) /\ ge_log_Int (hwm_member_at log_end s (limit - 1)) v then 1 else 0)
    )

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant log_end : int

constant s : Seq.seq Int64.t

constant v : int

constant limit : int

constant leader_counts : bool

function lemma_count_ge_prefix_nonnegative [#"/home/matt/.codex/worktrees/6279/krabka-broker/crates/verified/src/consensus.rs" 66 0 72 1] (log_end: int) (s: Seq.seq Int64.t) (v: int) (limit: int) (leader_counts: bool) : ()

goal vc_lemma_count_ge_prefix_nonnegative: ([%#sconsensus'0] 0 <= limit /\ limit <= Seq.length s + 1)
  -> (if gt_log_Int limit 0 then
    (([@stop_split] [@expl:lemma_count_ge_prefix_nonnegative requires] [%#sconsensus'0] 0 <= limit - 1
        /\ limit - 1 <= Seq.length s + 1)
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sconsensus] limit) ([%#sconsensus] limit - 1)))
    /\ (([@stop_split] [@expl:lemma_count_ge_prefix_nonnegative ensures] [%#sconsensus'1] ge_log_Int (count_ge_prefix log_end s v (limit
      - 1) leader_counts) 0)
    -> (let _ = lemma_count_ge_prefix_nonnegative log_end s v (limit
    - 1) leader_counts in [@stop_split] [@expl:lemma_count_ge_prefix_nonnegative ensures] [%#sconsensus'1] ge_log_Int (count_ge_prefix log_end s v limit leader_counts) 0))
  else
    [@stop_split] [@expl:lemma_count_ge_prefix_nonnegative ensures] [%#sconsensus'1] ge_log_Int (count_ge_prefix log_end s v limit leader_counts) 0
  )
