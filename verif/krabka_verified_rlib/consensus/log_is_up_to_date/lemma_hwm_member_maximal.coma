use creusot.int.Int64
use creusot.slice.Slice64
use creusot.int.UInt64
use seq.Seq
use creusot.prelude.Any
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

function hwm_member_at [#"/workspace/crates/verified/src/consensus/failover.rs" 173 0 173 62] (log_end: int) (s: Seq.seq Int64.t) (k: int) : int
 = [%#sfailover'1] if k = 0 then log_end else Int64.to_int (Seq.get s (k - 1))

function count_ge_prefix [#"/workspace/crates/verified/src/consensus/failover.rs" 182 0 182 97] (log_end: int) (s: Seq.seq Int64.t) (v: int) (limit: int) (leader_counts: bool) : int

axiom count_ge_prefix_def:
  forall log_end: int, s: Seq.seq Int64.t, v: int, limit: int, leader_counts: bool [count_ge_prefix log_end s v limit leader_counts]. count_ge_prefix log_end s v limit leader_counts
    = ([%#sfailover'3] if limit <= 0 then
      0
    else
      count_ge_prefix log_end s v (limit - 1) leader_counts
      + (if (leader_counts \/ gt_log_Int limit 1) /\ ge_log_Int (hwm_member_at log_end s (limit - 1)) v then 1 else 0)
    )

function count_ge [#"/workspace/crates/verified/src/consensus/failover.rs" 197 0 197 78] (log_end: int) (s: Seq.seq Int64.t) (v: int) (leader_counts: bool) : int

axiom count_ge_def:
  forall log_end: int, s: Seq.seq Int64.t, v: int, leader_counts: bool [count_ge log_end s v leader_counts]. count_ge log_end s v leader_counts
    = ([%#sfailover'0] count_ge_prefix log_end s v (Seq.length s + 1) leader_counts)

predicate hwm_member_witness [#"/workspace/crates/verified/src/consensus/log_is_up_to_date.rs" 192 0 199 9] (end': int) (offsets: Seq.seq Int64.t) (index: int) (value: int) (majority: int) (leader_counts: bool) =
  [%#slog_is_up_to_date'5] 0 <= index
  /\ index < Seq.length offsets + 1
  /\ ge_log_Int (hwm_member_at end' offsets index) value
  /\ ge_log_Int (count_ge end' offsets (hwm_member_at end' offsets index) leader_counts) majority

let lemma_hwm_threshold_has_member (log_end: Int64.t) (s: Slice64.slice Int64.t) (majority: UInt64.t)
  (leader_counts: bool) (return (x: ())) =
{[@stop_split] [@expl:lemma_hwm_threshold_has_member requires] [%#slog_is_up_to_date'3] 1 <= UInt64.t'int majority
  /\ UInt64.t'int majority <= Seq.length (Slice64.view s) + 1}
  any
  [ return (result: ()) ->
  {[@stop_split] [@expl:lemma_hwm_threshold_has_member ensures] [%#slog_is_up_to_date'4] forall v: int. ge_log_Int (count_ge (Int64.to_int log_end) (Slice64.view s) v leader_counts) (UInt64.t'int majority)
      -> (exists k: int. hwm_member_witness (Int64.to_int log_end) (Slice64.view s) k v (UInt64.t'int majority) leader_counts)}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let lemma_hwm_member_maximal [#"/workspace/crates/verified/src/consensus/log_is_up_to_date.rs" 141 0 147 1]
  (log_end: Int64.t) (s: Slice64.slice Int64.t) (majority: UInt64.t) (best: Int64.t) (leader_counts: bool)
  (return (x: ())) =
{[@stop_split] [@expl:lemma_hwm_member_maximal requires] ([@stop_split] [@expl:lemma_hwm_member_maximal requires #0] [%#slog_is_up_to_date'0] 1
      <= UInt64.t'int majority
    /\ UInt64.t'int majority <= Seq.length (Slice64.view s) + 1)
  /\ ([@stop_split] [@expl:lemma_hwm_member_maximal requires #1] [%#slog_is_up_to_date'1] forall k: int. 0 <= k
      /\ k < Seq.length (Slice64.view s) + 1
      /\ ge_log_Int (count_ge (Int64.to_int log_end) (Slice64.view s) (hwm_member_at (Int64.to_int log_end) (Slice64.view s) k) leader_counts) (UInt64.t'int majority)
    -> hwm_member_at (Int64.to_int log_end) (Slice64.view s) k <= Int64.to_int best)}
  (! bb0
  [ bb0 = s0
    [ s0 = lemma_hwm_threshold_has_member [%#slog_is_up_to_date] {log_end} {s} {majority} {leader_counts}
        (fun (_x: ()) -> [ &_21 <- _x ] s1)
    | s1 = return {_ret} ] ]
  [ & _ret: () = Any.any_l ()
  | & log_end: Int64.t = log_end
  | & s: Slice64.slice Int64.t = s
  | & majority: UInt64.t = majority
  | & leader_counts: bool = leader_counts
  | & _21: () = Any.any_l () ])
  [ return (result: ()) ->
  {[@stop_split] [@expl:lemma_hwm_member_maximal ensures] [%#slog_is_up_to_date'2] forall v: int. ge_log_Int (count_ge (Int64.to_int log_end) (Slice64.view s) v leader_counts) (UInt64.t'int majority)
      -> v <= Int64.to_int best}
    (! return {result}) ]
