let%span sfailover'1 = "/workspace/crates/verified/src/consensus/failover.rs" 177 8 177 48

use creusot.int.Int64
use seq.Seq
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

function hwm_member_at [#"/workspace/crates/verified/src/consensus/failover.rs" 175 0 175 62] (log_end: int) (s: Seq.seq Int64.t) (k: int) : int
 = [%#sfailover'1] if k = 0 then log_end else Int64.to_int (Seq.get s (k - 1))

function count_ge_prefix [#"/workspace/crates/verified/src/consensus/failover.rs" 186 0 186 97] (log_end: int) (s: Seq.seq Int64.t) (v: int) (limit: int) (leader_counts: bool) : int

axiom count_ge_prefix_def:
  forall log_end: int, s: Seq.seq Int64.t, v: int, limit: int, leader_counts: bool [count_ge_prefix log_end s v limit leader_counts]. count_ge_prefix log_end s v limit leader_counts
    = ([%#sfailover'0] if limit <= 0 then
      0
    else
      count_ge_prefix log_end s v (limit - 1) leader_counts
      + (if (leader_counts \/ gt_log_Int limit 1) /\ ge_log_Int (hwm_member_at log_end s (limit - 1)) v then 1 else 0)
    )

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant log_end : int

constant s : Seq.seq Int64.t

constant low : int

constant high : int

constant limit : int

constant leader_counts : bool

function lemma_count_ge_prefix_monotone [#"/workspace/crates/verified/src/consensus/log_is_up_to_date.rs" 14 0 21 1] (log_end: int) (s: Seq.seq Int64.t) (low: int) (high: int) (limit: int) (leader_counts: bool) : ()

goal vc_lemma_count_ge_prefix_monotone: ([%#slog_is_up_to_date'0] 0 <= limit /\ limit <= Seq.length s + 1)
  -> ([%#slog_is_up_to_date'1] low <= high)
  -> (if gt_log_Int limit 0 then
    (([@stop_split] [@expl:lemma_count_ge_prefix_monotone requires] ([@stop_split] [@expl:lemma_count_ge_prefix_monotone requires #0] [%#slog_is_up_to_date'0] 0
            <= limit - 1
          /\ limit - 1 <= Seq.length s + 1)
        /\ ([@stop_split] [@expl:lemma_count_ge_prefix_monotone requires #1] [%#slog_is_up_to_date'1] low <= high))
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#slog_is_up_to_date] limit) ([%#slog_is_up_to_date] limit
      - 1)))
    /\ (([@stop_split] [@expl:lemma_count_ge_prefix_monotone ensures] [%#slog_is_up_to_date'2] ge_log_Int (count_ge_prefix log_end s low (limit
      - 1) leader_counts) (count_ge_prefix log_end s high (limit - 1) leader_counts))
    -> (let _ = lemma_count_ge_prefix_monotone log_end s low high (limit
    - 1) leader_counts in [@stop_split] [@expl:lemma_count_ge_prefix_monotone ensures] [%#slog_is_up_to_date'2] ge_log_Int (count_ge_prefix log_end s low limit leader_counts) (count_ge_prefix log_end s high limit leader_counts)))
  else
    [@stop_split] [@expl:lemma_count_ge_prefix_monotone ensures] [%#slog_is_up_to_date'2] ge_log_Int (count_ge_prefix log_end s low limit leader_counts) (count_ge_prefix log_end s high limit leader_counts)
  )
