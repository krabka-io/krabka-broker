use creusot.int.Int64
use seq.Seq
use creusot.slice.Slice64
use creusot.int.UInt64
use creusot.prelude.Any
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

function hwm_member_at [#"/workspace/crates/verified/src/consensus/failover.rs" 176 0 176 62] (log_end: int) (s: Seq.seq Int64.t) (k: int) : int
 = [%#sfailover'1] if k = 0 then log_end else Int64.to_int (Seq.get s (k - 1))

function count_ge_prefix [#"/workspace/crates/verified/src/consensus/failover.rs" 187 0 187 97] (log_end: int) (s: Seq.seq Int64.t) (v: int) (limit: int) (leader_counts: bool) : int

axiom count_ge_prefix_def:
  forall log_end: int, s: Seq.seq Int64.t, v: int, limit: int, leader_counts: bool [count_ge_prefix log_end s v limit leader_counts]. count_ge_prefix log_end s v limit leader_counts
    = ([%#sfailover'3] if limit <= 0 then
      0
    else
      count_ge_prefix log_end s v (limit - 1) leader_counts
      + (if (leader_counts \/ gt_log_Int limit 1) /\ ge_log_Int (hwm_member_at log_end s (limit - 1)) v then 1 else 0)
    )

function count_ge [#"/workspace/crates/verified/src/consensus/failover.rs" 204 0 204 78] (log_end: int) (s: Seq.seq Int64.t) (v: int) (leader_counts: bool) : int

axiom count_ge_def:
  forall log_end: int, s: Seq.seq Int64.t, v: int, leader_counts: bool [count_ge log_end s v leader_counts]. count_ge log_end s v leader_counts
    = ([%#sfailover'0] count_ge_prefix log_end s v (Seq.length s + 1) leader_counts)

function lemma_count_ge_prefix_monotone [#"/workspace/crates/verified/src/consensus/log_is_up_to_date.rs" 15 0 22 1] (log_end: int) (s: Seq.seq Int64.t) (low: int) (high: int) (limit: int) (leader_counts: bool) : ()

axiom lemma_count_ge_prefix_monotone_def:
  forall log_end: int, s: Seq.seq Int64.t, low: int, high: int, limit: int, leader_counts: bool [lemma_count_ge_prefix_monotone log_end s low high limit leader_counts]. ([%#slog_is_up_to_date'10] 0
        <= limit
      /\ limit <= Seq.length s + 1)
    -> ([%#slog_is_up_to_date'11] low <= high)
    -> lemma_count_ge_prefix_monotone log_end s low high limit leader_counts
    = ([%#slog_is_up_to_date'13] if gt_log_Int limit 0 then
      let _ = lemma_count_ge_prefix_monotone log_end s low high (limit - 1) leader_counts in ()
    else
      ()
    )

axiom lemma_count_ge_prefix_monotone_spec:
  forall log_end: int, s: Seq.seq Int64.t, low: int, high: int, limit: int, leader_counts: bool. ([%#slog_is_up_to_date'10] 0
        <= limit
      /\ limit <= Seq.length s + 1)
    -> ([%#slog_is_up_to_date'11] low <= high)
    -> ([%#slog_is_up_to_date'12] ge_log_Int (count_ge_prefix log_end s low limit leader_counts) (count_ge_prefix log_end s high limit leader_counts))

function lemma_count_ge_prefix_nonnegative [#"/workspace/crates/verified/src/consensus/log_is_up_to_date.rs" 35 0 41 1] (log_end: int) (s: Seq.seq Int64.t) (v: int) (limit: int) (leader_counts: bool) : ()

axiom lemma_count_ge_prefix_nonnegative_def:
  forall log_end: int, s: Seq.seq Int64.t, v: int, limit: int, leader_counts: bool [lemma_count_ge_prefix_nonnegative log_end s v limit leader_counts]. ([%#slog_is_up_to_date'15] 0
        <= limit
      /\ limit <= Seq.length s + 1)
    -> lemma_count_ge_prefix_nonnegative log_end s v limit leader_counts
    = ([%#slog_is_up_to_date'17] if gt_log_Int limit 0 then
      let _ = lemma_count_ge_prefix_nonnegative log_end s v (limit - 1) leader_counts in ()
    else
      ()
    )

axiom lemma_count_ge_prefix_nonnegative_spec:
  forall log_end: int, s: Seq.seq Int64.t, v: int, limit: int, leader_counts: bool. ([%#slog_is_up_to_date'15] 0
        <= limit
      /\ limit <= Seq.length s + 1)
    -> ([%#slog_is_up_to_date'16] ge_log_Int (count_ge_prefix log_end s v limit leader_counts) 0)

function least_hwm_member_ge_index [#"/workspace/crates/verified/src/consensus/log_is_up_to_date.rs" 58 0 64 8] (log_end: int) (s: Seq.seq Int64.t) (v: int) (limit: int) (leader_counts: bool) : int

axiom least_hwm_member_ge_index_def:
  forall log_end: int, s: Seq.seq Int64.t, v: int, limit: int, leader_counts: bool [least_hwm_member_ge_index log_end s v limit leader_counts]. ([%#slog_is_up_to_date'3] 0
        < limit
      /\ limit <= Seq.length s + 1)
    -> ([%#slog_is_up_to_date'4] ge_log_Int (count_ge_prefix log_end s v limit leader_counts) 1)
    -> least_hwm_member_ge_index log_end s v limit leader_counts
    = ([%#slog_is_up_to_date'8] if limit <= 1 then
      0
    else
      let last_index = limit
      - 1 in let last_member = hwm_member_at log_end s last_index in let previous_count = count_ge_prefix log_end s v last_index leader_counts in if ge_log_Int last_member v then
        if ge_log_Int previous_count 1 then
          let previous_index = least_hwm_member_ge_index log_end s v last_index leader_counts in let previous_member = hwm_member_at log_end s previous_index in if last_member
          <= previous_member then
            let _ = lemma_count_ge_prefix_monotone log_end s last_member previous_member last_index leader_counts in last_index
          else
            previous_index

        else
          let _ = lemma_count_ge_prefix_nonnegative log_end s v last_index leader_counts in let _ = lemma_count_ge_prefix_nonnegative log_end s last_member last_index leader_counts in last_index

      else
        least_hwm_member_ge_index log_end s v last_index leader_counts

    )

axiom least_hwm_member_ge_index_spec:
  forall log_end: int, s: Seq.seq Int64.t, v: int, limit: int, leader_counts: bool [least_hwm_member_ge_index log_end s v limit leader_counts]. ([%#slog_is_up_to_date'3] 0
        < limit
      /\ limit <= Seq.length s + 1)
    -> ([%#slog_is_up_to_date'4] ge_log_Int (count_ge_prefix log_end s v limit leader_counts) 1)
    -> ([%#slog_is_up_to_date'5] 0 <= least_hwm_member_ge_index log_end s v limit leader_counts
    /\ least_hwm_member_ge_index log_end s v limit leader_counts < limit)

axiom least_hwm_member_ge_index_spec'0:
  forall log_end: int, s: Seq.seq Int64.t, v: int, limit: int, leader_counts: bool [least_hwm_member_ge_index log_end s v limit leader_counts]. ([%#slog_is_up_to_date'3] 0
        < limit
      /\ limit <= Seq.length s + 1)
    -> ([%#slog_is_up_to_date'4] ge_log_Int (count_ge_prefix log_end s v limit leader_counts) 1)
    -> ([%#slog_is_up_to_date'6] ge_log_Int (hwm_member_at log_end s (least_hwm_member_ge_index log_end s v limit leader_counts)) v)

axiom least_hwm_member_ge_index_spec'1:
  forall log_end: int, s: Seq.seq Int64.t, v: int, limit: int, leader_counts: bool [least_hwm_member_ge_index log_end s v limit leader_counts]. ([%#slog_is_up_to_date'3] 0
        < limit
      /\ limit <= Seq.length s + 1)
    -> ([%#slog_is_up_to_date'4] ge_log_Int (count_ge_prefix log_end s v limit leader_counts) 1)
    -> ([%#slog_is_up_to_date'7] ge_log_Int (count_ge_prefix log_end s (hwm_member_at log_end s (least_hwm_member_ge_index log_end s v limit leader_counts)) limit leader_counts) (count_ge_prefix log_end s v limit leader_counts))

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let lemma_hwm_threshold_has_member [#"/workspace/crates/verified/src/consensus/log_is_up_to_date.rs" 124 0 129 1]
  (log_end: Int64.t) (s: Slice64.slice Int64.t) (majority: UInt64.t) (leader_counts: bool) (return (x: ())) =
{[@stop_split] [@expl:lemma_hwm_threshold_has_member requires] [%#slog_is_up_to_date'0] 1 <= UInt64.t'int majority
  /\ UInt64.t'int majority <= Seq.length (Slice64.view s) + 1}
  (! bb0
  [ bb0 = s0
    [ s0 =
      {[@expl:assertion] [%#slog_is_up_to_date] forall v: int. ge_log_Int (count_ge (Int64.to_int log_end) (Slice64.view s) v leader_counts) (UInt64.t'int majority)
        -> (exists k: int. k
            = least_hwm_member_ge_index (Int64.to_int log_end) (Slice64.view s) v (Seq.length (Slice64.view s)
            + 1) leader_counts
          /\ 0 <= k
          /\ k < Seq.length (Slice64.view s) + 1
          /\ ge_log_Int (hwm_member_at (Int64.to_int log_end) (Slice64.view s) k) v
          /\ ge_log_Int (count_ge (Int64.to_int log_end) (Slice64.view s) (hwm_member_at (Int64.to_int log_end) (Slice64.view s) k) leader_counts) (UInt64.t'int majority))}
      s1
    | s1 = return {_ret} ] ]
  [ & _ret: () = Any.any_l ()
  | & log_end: Int64.t = log_end
  | & s: Slice64.slice Int64.t = s
  | & majority: UInt64.t = majority
  | & leader_counts: bool = leader_counts ])
  [ return (result: ()) ->
  {[@stop_split] [@expl:lemma_hwm_threshold_has_member ensures] [%#slog_is_up_to_date'1] forall v: int. ge_log_Int (count_ge (Int64.to_int log_end) (Slice64.view s) v leader_counts) (UInt64.t'int majority)
      -> (exists k: int. 0 <= k
        /\ k < Seq.length (Slice64.view s) + 1
        /\ ge_log_Int (hwm_member_at (Int64.to_int log_end) (Slice64.view s) k) v
        /\ ge_log_Int (count_ge (Int64.to_int log_end) (Slice64.view s) (hwm_member_at (Int64.to_int log_end) (Slice64.view s) k) leader_counts) (UInt64.t'int majority))}
    (! return {result}) ]
