let%span sord = "/root/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/creusot-std-0.13.0/src/logic/ord.rs" 34 8 34 21
let%span sord'0 = "/root/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/creusot-std-0.13.0/src/logic/ord.rs" 22 8 22 20
let%span swell_founded = "/root/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/creusot-std-0.13.0/src/logic/well_founded.rs" 43 8 43 33
let%span sfailover = "/workspace/crates/verified/src/consensus/failover.rs" 181 10 181 15
let%span sfailover'0 = "/workspace/crates/verified/src/consensus/failover.rs" 184 8 190 9
let%span sfailover'1 = "/workspace/crates/verified/src/consensus/failover.rs" 175 8 175 48
let%span slog_is_up_to_date = "/workspace/crates/verified/src/consensus/log_is_up_to_date.rs" 34 10 34 15
let%span slog_is_up_to_date'0 = "/workspace/crates/verified/src/consensus/log_is_up_to_date.rs" 32 11 32 45
let%span slog_is_up_to_date'1 = "/workspace/crates/verified/src/consensus/log_is_up_to_date.rs" 33 10 33 67

use creusot.int.Int64
use seq.Seq
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

function hwm_member_at [#"/workspace/crates/verified/src/consensus/failover.rs" 173 0 173 62] (log_end: int) (s: Seq.seq Int64.t) (k: int) : int
 = [%#sfailover'1] if k = 0 then log_end else Int64.to_int (Seq.get s (k - 1))

function count_ge_prefix [#"/workspace/crates/verified/src/consensus/failover.rs" 182 0 182 97] (log_end: int) (s: Seq.seq Int64.t) (v: int) (limit: int) (leader_counts: bool) : int

axiom count_ge_prefix_def:
  forall log_end: int, s: Seq.seq Int64.t, v: int, limit: int, leader_counts: bool [count_ge_prefix log_end s v limit leader_counts]. count_ge_prefix log_end s v limit leader_counts
    = ([%#sfailover'0] if limit <= 0 then
      0
    else
      count_ge_prefix log_end s v (limit - 1) leader_counts
      + (if (leader_counts \/ gt_log_Int limit 1) /\ ge_log_Int (hwm_member_at log_end s (limit - 1)) v then 1 else 0)
    )

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant log_end : int

constant s : Seq.seq Int64.t

constant v : int

constant limit : int

constant leader_counts : bool

function lemma_count_ge_prefix_nonnegative [#"/workspace/crates/verified/src/consensus/log_is_up_to_date.rs" 35 0 41 1] (log_end: int) (s: Seq.seq Int64.t) (v: int) (limit: int) (leader_counts: bool) : ()

goal vc_lemma_count_ge_prefix_nonnegative: ([%#slog_is_up_to_date'0] 0 <= limit /\ limit <= Seq.length s + 1)
  -> (if gt_log_Int limit 0 then
    (([@stop_split] [@expl:lemma_count_ge_prefix_nonnegative requires] [%#slog_is_up_to_date'0] 0 <= limit - 1
        /\ limit - 1 <= Seq.length s + 1)
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#slog_is_up_to_date] limit) ([%#slog_is_up_to_date] limit
      - 1)))
    /\ (([@stop_split] [@expl:lemma_count_ge_prefix_nonnegative ensures] [%#slog_is_up_to_date'1] ge_log_Int (count_ge_prefix log_end s v (limit
      - 1) leader_counts) 0)
    -> (let _ = lemma_count_ge_prefix_nonnegative log_end s v (limit
    - 1) leader_counts in [@stop_split] [@expl:lemma_count_ge_prefix_nonnegative ensures] [%#slog_is_up_to_date'1] ge_log_Int (count_ge_prefix log_end s v limit leader_counts) 0))
  else
    [@stop_split] [@expl:lemma_count_ge_prefix_nonnegative ensures] [%#slog_is_up_to_date'1] ge_log_Int (count_ge_prefix log_end s v limit leader_counts) 0
  )
