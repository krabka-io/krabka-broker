type t_RecoveryCandidate = { last_epoch: Int32.t; log_end_offset: Int64.t; broker_id: UInt64.t }

let len_RecoveryCandidate (self_: Slice64.slice t_RecoveryCandidate) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sslice] Seq.length (Slice64.view self_)
    = UInt64.t'int result}
    (! return {result}) ]

type t_Option_usize = None | Some UInt64.t

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

predicate ranks_ge [#"/workspace/crates/verified/src/consensus.rs" 213 0 213 67] (a: t_RecoveryCandidate) (b: t_RecoveryCandidate) =
  [%#sconsensus'12] gt_log_Int (Int32.to_int a.last_epoch) (Int32.to_int b.last_epoch)
  \/ Int32.to_int a.last_epoch = Int32.to_int b.last_epoch
  /\ (gt_log_Int (Int64.to_int a.log_end_offset) (Int64.to_int b.log_end_offset)
  \/ Int64.to_int a.log_end_offset = Int64.to_int b.log_end_offset
  /\ UInt64.t'int a.broker_id <= UInt64.t'int b.broker_id)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

