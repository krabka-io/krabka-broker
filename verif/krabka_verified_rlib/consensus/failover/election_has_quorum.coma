(* #"/workspace/crates/verified/src/consensus/failover.rs" 15 0 15 83 *)

let%span sord = "/cargo-home/registry/src/index.crates.io-1949cf8c6b5b557f/creusot-std-0.13.0/src/logic/ord.rs" 34 8 34 21
let%span sfailover = "/workspace/crates/verified/src/consensus/failover.rs" 16 22 16 48
let%span sfailover'0 = "/workspace/crates/verified/src/consensus/failover.rs" 13 10 13 61
let%span sfailover'1 = "/workspace/crates/verified/src/consensus/failover.rs" 6 10 6 41

use creusot.int.UInt64
use int.ComputerDivision
use creusot.prelude.Any
use int.Int

let majority_size (voter_count: UInt64.t) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:majority_size ensures] [%#sfailover'1] UInt64.t'int result
    = ComputerDivision.div (UInt64.t'int voter_count) 2 + 1}
    (! return {result}) ]

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let election_has_quorum [#"/workspace/crates/verified/src/consensus/failover.rs" 15 0 15 83] (voter_count: UInt64.t)
  (current_grants: UInt64.t) (return (x: bool)) = (! bb0
  [ bb0 = s0
    [ s0 = majority_size [%#sfailover] {voter_count} (fun (_x: UInt64.t) -> [ &_7 <- _x ] s1)
    | s1 = [ &_ret <- UInt64.ge current_grants _7 ] s2
    | s2 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l ()
  | & voter_count: UInt64.t = voter_count
  | & current_grants: UInt64.t = current_grants
  | & _7: UInt64.t = Any.any_l () ])
  [ return (result: bool) -> {[@stop_split] [@expl:election_has_quorum ensures] [%#sfailover'0] result
    = ge_log_Int (UInt64.t'int current_grants) (ComputerDivision.div (UInt64.t'int voter_count) 2 + 1)}
    (! return {result}) ]
