  | & _33: UInt64.t = Any.any_l ()
  | & _34: bool = Any.any_l ()
  | & current': t_RecoveryCandidate = Any.any_l ()
  | & _36: UInt64.t = Any.any_l ()
  | & _37: UInt64.t = Any.any_l ()
  | & _38: bool = Any.any_l ()
  | & _40: bool = Any.any_l ()
  | & _43: bool = Any.any_l ()
  | & _46: bool = Any.any_l ()
  | & _49: bool = Any.any_l ()
  | & _52: bool = Any.any_l ()
  | & _55: bool = Any.any_l ()
  | & variant_old_bb4: int = Any.any_l () ])
  [ return (result: t_Option_usize) ->
  {[@stop_split] [@expl:select_best_recovery_replica ensures] [%#sfailover'11] match result with
      | None -> Seq.length (Slice64.view candidates) = 0
      | Some best -> UInt64.t'int best < Seq.length (Slice64.view candidates)
