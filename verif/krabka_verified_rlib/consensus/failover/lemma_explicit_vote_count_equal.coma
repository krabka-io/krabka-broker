(* #"/workspace/crates/verified/src/consensus/failover.rs" 218 0 224 1 *)

let%span sord = "/cargo-home/registry/src/index.crates.io-1949cf8c6b5b557f/creusot-std-0.13.0/src/logic/ord.rs" 34 8 34 21
let%span sord'0 = "/cargo-home/registry/src/index.crates.io-1949cf8c6b5b557f/creusot-std-0.13.0/src/logic/ord.rs" 22 8 22 20
let%span swell_founded = "/cargo-home/registry/src/index.crates.io-1949cf8c6b5b557f/creusot-std-0.13.0/src/logic/well_founded.rs" 43 8 43 33
let%span sfailover = "/workspace/crates/verified/src/consensus/failover.rs" 217 10 217 15
let%span sfailover'0 = "/workspace/crates/verified/src/consensus/failover.rs" 212 11 212 76
let%span sfailover'1 = "/workspace/crates/verified/src/consensus/failover.rs" 213 11 214 59
let%span sfailover'2 = "/workspace/crates/verified/src/consensus/failover.rs" 215 10 216 63
let%span sfailover'3 = "/workspace/crates/verified/src/consensus/failover.rs" 186 10 186 15
let%span sfailover'4 = "/workspace/crates/verified/src/consensus/failover.rs" 189 8 195 9
let%span sfailover'5 = "/workspace/crates/verified/src/consensus/failover.rs" 178 8 178 48

use creusot.int.Int64
use seq.Seq
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

function hwm_member_at [#"/workspace/crates/verified/src/consensus/failover.rs" 176 0 176 62] (log_end: int) (s: Seq.seq Int64.t) (k: int) : int
 = [%#sfailover'5] if k = 0 then log_end else Int64.to_int (Seq.get s (k - 1))

function count_ge_prefix [#"/workspace/crates/verified/src/consensus/failover.rs" 187 0 187 97] (log_end: int) (s: Seq.seq Int64.t) (v: int) (limit: int) (leader_counts: bool) : int

axiom count_ge_prefix_def:
  forall log_end: int, s: Seq.seq Int64.t, v: int, limit: int, leader_counts: bool [count_ge_prefix log_end s v limit leader_counts]. count_ge_prefix log_end s v limit leader_counts
    = ([%#sfailover'4] if limit <= 0 then
      0
    else
      count_ge_prefix log_end s v (limit - 1) leader_counts
      + (if (leader_counts \/ gt_log_Int limit 1) /\ ge_log_Int (hwm_member_at log_end s (limit - 1)) v then 1 else 0)
    )

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant log_end : int

constant left : Seq.seq Int64.t

constant right : Seq.seq Int64.t

constant threshold : int

constant limit : int

function lemma_explicit_vote_count_equal [#"/workspace/crates/verified/src/consensus/failover.rs" 218 0 224 1] (log_end: int) (left: Seq.seq Int64.t) (right: Seq.seq Int64.t) (threshold: int) (limit: int) : ()

goal vc_lemma_explicit_vote_count_equal: ([%#sfailover'0] 0 <= limit
    /\ limit <= Seq.length left + 1 /\ limit <= Seq.length right + 1)
  -> ([%#sfailover'1] forall i: int. 0 <= i /\ i < limit - 1
      -> ge_log_Int (Int64.to_int (Seq.get left i)) threshold = ge_log_Int (Int64.to_int (Seq.get right i)) threshold)
  -> (if gt_log_Int limit 0 then
    (([@stop_split] [@expl:lemma_explicit_vote_count_equal requires] ([@stop_split] [@expl:lemma_explicit_vote_count_equal requires #0] [%#sfailover'0] 0
            <= limit - 1
          /\ limit - 1 <= Seq.length left + 1 /\ limit - 1 <= Seq.length right + 1)
        /\ ([@stop_split] [@expl:lemma_explicit_vote_count_equal requires #1] [%#sfailover'1] forall i: int. 0 <= i
            /\ i < limit - 1 - 1
          -> ge_log_Int (Int64.to_int (Seq.get left i)) threshold
          = ge_log_Int (Int64.to_int (Seq.get right i)) threshold))
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#sfailover] limit) ([%#sfailover] limit - 1)))
    /\ (([@stop_split] [@expl:lemma_explicit_vote_count_equal ensures] [%#sfailover'2] count_ge_prefix log_end left threshold (limit
        - 1) false
      = count_ge_prefix log_end right threshold (limit - 1) false)
    -> (let _ = lemma_explicit_vote_count_equal log_end left right threshold (limit
    - 1) in [@stop_split] [@expl:lemma_explicit_vote_count_equal ensures] [%#sfailover'2] count_ge_prefix log_end left threshold limit false
    = count_ge_prefix log_end right threshold limit false))
  else
    [@stop_split] [@expl:lemma_explicit_vote_count_equal ensures] [%#sfailover'2] count_ge_prefix log_end left threshold limit false
    = count_ge_prefix log_end right threshold limit false
  )
