use creusot.int.Int64
use creusot.slice.Slice64
use creusot.int.UInt64
use seq.Seq
use creusot.prelude.Any
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

function hwm_member_at [#"/home/user/krabka-broker/crates/verified/src/consensus.rs" 13 0 13 62] (log_end: int) (s: Seq.seq Int64.t) (k: int) : int
 = [%#sconsensus'7] if k = 0 then log_end else Int64.to_int (Seq.get s (k - 1))

function count_ge_prefix [#"/home/user/krabka-broker/crates/verified/src/consensus.rs" 22 0 22 76] (log_end: int) (s: Seq.seq Int64.t) (v: int) (limit: int) : int

axiom count_ge_prefix_def:
  forall log_end: int, s: Seq.seq Int64.t, v: int, limit: int [count_ge_prefix log_end s v limit]. count_ge_prefix log_end s v limit
    = ([%#sconsensus'9] if limit <= 0 then
      0
    else
      count_ge_prefix log_end s v (limit - 1) + (if ge_log_Int (hwm_member_at log_end s (limit - 1)) v then 1 else 0)
    )

function count_ge [#"/home/user/krabka-broker/crates/verified/src/consensus.rs" 36 0 36 57] (log_end: int) (s: Seq.seq Int64.t) (v: int) : int

axiom count_ge_def: forall log_end: int, s: Seq.seq Int64.t, v: int [count_ge log_end s v]. count_ge log_end s v
    = ([%#sconsensus'6] count_ge_prefix log_end s v (Seq.length s + 1))

let lemma_hwm_threshold_has_member (log_end: Int64.t) (s: Slice64.slice Int64.t) (majority: UInt64.t) (return (x: ())) =
{[@stop_split] [@expl:lemma_hwm_threshold_has_member requires] [%#sconsensus'3] 1 <= UInt64.t'int majority
  /\ UInt64.t'int majority <= Seq.length (Slice64.view s) + 1}
  any
  [ return (result: ()) ->
  {[@stop_split] [@expl:lemma_hwm_threshold_has_member ensures] [%#sconsensus'4] forall v: int. ge_log_Int (count_ge (Int64.to_int log_end) (Slice64.view s) v) (UInt64.t'int majority)
      -> (exists k: int. 0 <= k
        /\ k < Seq.length (Slice64.view s) + 1
        /\ ge_log_Int (hwm_member_at (Int64.to_int log_end) (Slice64.view s) k) v
        /\ ge_log_Int (count_ge (Int64.to_int log_end) (Slice64.view s) (hwm_member_at (Int64.to_int log_end) (Slice64.view s) k)) (UInt64.t'int majority))}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let lemma_hwm_member_maximal [#"/home/user/krabka-broker/crates/verified/src/consensus.rs" 176 0 176 84]
  (log_end: Int64.t) (s: Slice64.slice Int64.t) (majority: UInt64.t) (best: Int64.t) (return (x: ())) =
{[@stop_split] [@expl:lemma_hwm_member_maximal requires] ([@stop_split] [@expl:lemma_hwm_member_maximal requires #0] [%#sconsensus'0] 1
      <= UInt64.t'int majority
    /\ UInt64.t'int majority <= Seq.length (Slice64.view s) + 1)
  /\ ([@stop_split] [@expl:lemma_hwm_member_maximal requires #1] [%#sconsensus'1] forall k: int. 0 <= k
      /\ k < Seq.length (Slice64.view s) + 1
      /\ ge_log_Int (count_ge (Int64.to_int log_end) (Slice64.view s) (hwm_member_at (Int64.to_int log_end) (Slice64.view s) k)) (UInt64.t'int majority)
    -> hwm_member_at (Int64.to_int log_end) (Slice64.view s) k <= Int64.to_int best)}
  (! bb0
  [ bb0 = s0
    [ s0 = lemma_hwm_threshold_has_member [%#sconsensus] {log_end} {s} {majority} (fun (_x: ()) -> [ &_18 <- _x ] s1)
    | s1 = return {_ret} ] ]
  [ & _ret: () = Any.any_l ()
  | & log_end: Int64.t = log_end
  | & s: Slice64.slice Int64.t = s
  | & majority: UInt64.t = majority
  | & _18: () = Any.any_l () ])
  [ return (result: ()) ->
  {[@stop_split] [@expl:lemma_hwm_member_maximal ensures] [%#sconsensus'2] forall v: int. ge_log_Int (count_ge (Int64.to_int log_end) (Slice64.view s) v) (UInt64.t'int majority)
      -> v <= Int64.to_int best}
    (! return {result}) ]
