(* #"/workspace/crates/verified/src/consensus.rs" 440 0 446 1 *)

let%span sord = "/root/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/creusot-std-0.13.0/src/logic/ord.rs" 34 8 34 21
let%span sord'0 = "/root/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/creusot-std-0.13.0/src/logic/ord.rs" 22 8 22 20
let%span sconsensus = "/workspace/crates/verified/src/consensus.rs" 447 4 447 71
let%span sconsensus'0 = "/workspace/crates/verified/src/consensus.rs" 435 11 435 54
let%span sconsensus'1 = "/workspace/crates/verified/src/consensus.rs" 436 11 438 47
let%span sconsensus'2 = "/workspace/crates/verified/src/consensus.rs" 439 10 439 93
let%span sconsensus'3 = "/workspace/crates/verified/src/consensus.rs" 414 11 414 54
