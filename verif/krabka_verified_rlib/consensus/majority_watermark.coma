use creusot.int.Int64
use creusot.slice.Slice64
use creusot.int.UInt64
use seq.Seq
use creusot.prelude.Any
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

function hwm_member_at [#"/workspace/crates/verified/src/consensus.rs" 269 0 269 62] (log_end: int) (s: Seq.seq Int64.t) (k: int) : int
 = [%#sconsensus'20] if k = 0 then log_end else Int64.to_int (Seq.get s (k - 1))

function count_ge_prefix [#"/workspace/crates/verified/src/consensus.rs" 280 0 280 97] (log_end: int) (s: Seq.seq Int64.t) (v: int) (limit: int) (leader_counts: bool) : int

axiom count_ge_prefix_def:
  forall log_end: int, s: Seq.seq Int64.t, v: int, limit: int, leader_counts: bool [count_ge_prefix log_end s v limit leader_counts]. count_ge_prefix log_end s v limit leader_counts
    = ([%#sconsensus'19] if limit <= 0 then
      0
    else
      count_ge_prefix log_end s v (limit - 1) leader_counts
      + (if (leader_counts \/ gt_log_Int limit 1) /\ ge_log_Int (hwm_member_at log_end s (limit - 1)) v then 1 else 0)
    )

function count_ge [#"/workspace/crates/verified/src/consensus.rs" 297 0 297 78] (log_end: int) (s: Seq.seq Int64.t) (v: int) (leader_counts: bool) : int

axiom count_ge_def:
  forall log_end: int, s: Seq.seq Int64.t, v: int, leader_counts: bool [count_ge log_end s v leader_counts]. count_ge log_end s v leader_counts
    = ([%#sconsensus'17] count_ge_prefix log_end s v (Seq.length s + 1) leader_counts)

let recompute_high_watermark (log_end: Int64.t) (follower_offsets: Slice64.slice Int64.t) (majority: UInt64.t)
  (epoch_start_offset: Int64.t) (current_hwm: Int64.t) (leader_counts: bool) (return (x: Int64.t)) =
{[@stop_split] [@expl:recompute_high_watermark requires] ([@stop_split] [@expl:recompute_high_watermark requires #0] [%#sconsensus'8] 1
      <= UInt64.t'int majority
    /\ UInt64.t'int majority <= Seq.length (Slice64.view follower_offsets) + 1)
  /\ ([@stop_split] [@expl:recompute_high_watermark requires #1] [%#sconsensus'9] leader_counts
    \/ UInt64.t'int majority <= Seq.length (Slice64.view follower_offsets))
  /\ ([@stop_split] [@expl:recompute_high_watermark requires #2] [%#sconsensus'10] Int64.to_int current_hwm
    <= Int64.to_int log_end)
  /\ ([@stop_split] [@expl:recompute_high_watermark requires #3] [%#sconsensus'11] forall k: int. 0 <= k
      /\ k < Seq.length (Slice64.view follower_offsets)
    -> Int64.to_int (Seq.get (Slice64.view follower_offsets) k) <= Int64.to_int log_end)}
  any
  [ return (result: Int64.t) ->
  {[@stop_split] [@expl:recompute_high_watermark ensures] ([@stop_split] [@expl:recompute_high_watermark ensures #0] [%#sconsensus'12] ge_log_Int (Int64.to_int result) (Int64.to_int current_hwm))
    /\ ([@stop_split] [@expl:recompute_high_watermark ensures #1] [%#sconsensus'13] Int64.to_int result
      <= Int64.to_int log_end)
    /\ ([@stop_split] [@expl:recompute_high_watermark ensures #2] [%#sconsensus'14] forall v: int. gt_log_Int v (Int64.to_int epoch_start_offset)
          /\ ge_log_Int (count_ge (Int64.to_int log_end) (Slice64.view follower_offsets) v leader_counts) (UInt64.t'int majority)
        -> v <= Int64.to_int result)
    /\ ([@stop_split] [@expl:recompute_high_watermark ensures #3] [%#sconsensus'15] gt_log_Int (Int64.to_int result) (Int64.to_int current_hwm)
    -> gt_log_Int (Int64.to_int result) (Int64.to_int epoch_start_offset)
    /\ ge_log_Int (count_ge (Int64.to_int log_end) (Slice64.view follower_offsets) (Int64.to_int result) leader_counts) (UInt64.t'int majority))}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let majority_watermark [#"/workspace/crates/verified/src/consensus.rs" 623 0 628 8] (log_end: Int64.t)
  (follower_offsets: Slice64.slice Int64.t) (majority: UInt64.t) (current': Int64.t) (return (x: Int64.t)) =
{[@stop_split] [@expl:majority_watermark requires] ([@stop_split] [@expl:majority_watermark requires #0] [%#sconsensus'1] 1
      <= UInt64.t'int majority
    /\ UInt64.t'int majority <= Seq.length (Slice64.view follower_offsets) + 1)
  /\ ([@stop_split] [@expl:majority_watermark requires #1] [%#sconsensus'2] Int64.to_int current'
    <= Int64.to_int log_end)
  /\ ([@stop_split] [@expl:majority_watermark requires #2] [%#sconsensus'3] forall k: int. 0 <= k
      /\ k < Seq.length (Slice64.view follower_offsets)
    -> Int64.to_int (Seq.get (Slice64.view follower_offsets) k) <= Int64.to_int log_end)}
  (! bb0
  [ bb0 = s0
    [ s0 = recompute_high_watermark [%#sconsensus'0] {log_end} {follower_offsets} {majority} {current'} {current'}
        {[%#sconsensus] true} (fun (_x: Int64.t) -> [ &_ret <- _x ] s1)
    | s1 = return {_ret} ] ]
  [ & _ret: Int64.t = Any.any_l ()
  | & log_end: Int64.t = log_end
  | & follower_offsets: Slice64.slice Int64.t = follower_offsets
  | & majority: UInt64.t = majority
  | & current': Int64.t = current' ])
  [ return (result: Int64.t) ->
  {[@stop_split] [@expl:majority_watermark ensures] ([@stop_split] [@expl:majority_watermark ensures #0] [%#sconsensus'4] ge_log_Int (Int64.to_int result) (Int64.to_int current'))
    /\ ([@stop_split] [@expl:majority_watermark ensures #1] [%#sconsensus'5] Int64.to_int result
      <= Int64.to_int log_end)
    /\ ([@stop_split] [@expl:majority_watermark ensures #2] [%#sconsensus'6] forall v: int. ge_log_Int (count_ge (Int64.to_int log_end) (Slice64.view follower_offsets) v true) (UInt64.t'int majority)
        -> v <= Int64.to_int result)
    /\ ([@stop_split] [@expl:majority_watermark ensures #3] [%#sconsensus'7] gt_log_Int (Int64.to_int result) (Int64.to_int current')
    -> ge_log_Int (count_ge (Int64.to_int log_end) (Slice64.view follower_offsets) (Int64.to_int result) true) (UInt64.t'int majority))}
    (! return {result}) ]
