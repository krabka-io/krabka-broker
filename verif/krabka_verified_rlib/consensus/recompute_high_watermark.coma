  /\ ([@stop_split] [@expl:lemma_hwm_member_maximal requires #1] [%#sconsensus'28] forall k: int. 0 <= k
      /\ k < Seq.length (Slice64.view s) + 1
      /\ ge_log_Int (count_ge (Int64.to_int log_end) (Slice64.view s) (hwm_member_at (Int64.to_int log_end) (Slice64.view s) k) leader_counts) (UInt64.t'int majority)
    -> hwm_member_at (Int64.to_int log_end) (Slice64.view s) k <= Int64.to_int best)}
  any
  [ return (result: ()) ->
  {[@stop_split] [@expl:lemma_hwm_member_maximal ensures] [%#sconsensus'29] forall v: int. ge_log_Int (count_ge (Int64.to_int log_end) (Slice64.view s) v leader_counts) (UInt64.t'int majority)
