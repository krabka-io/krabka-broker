  | & _52: UInt64.t = Any.any_l ()
  | & _53: bool = Any.any_l ()
  | & _55: bool = Any.any_l ()
  | & _58: bool = Any.any_l ()
  | & variant_old_bb9: int = Any.any_l () ])
  [ return (result: bool) -> {[@stop_split] [@expl:candidate_has_majority ensures] [%#sconsensus'14] result
    = ge_log_Int (count_ge (Int64.to_int log_end) (Slice64.view follower_offsets) (Int64.to_int cand) leader_counts) (UInt64.t'int majority)}
