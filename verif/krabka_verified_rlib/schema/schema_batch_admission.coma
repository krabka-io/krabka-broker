(* #"/workspace/crates/verified/src/schema.rs" 118 0 122 25 *)

let%span sschema = "/workspace/crates/verified/src/schema.rs" 115 10 116 48

use creusot.prelude.Any
use creusot.int.UInt64

type t_SchemaBatchAdmission = Admit | Reject

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let schema_batch_admission [#"/workspace/crates/verified/src/schema.rs" 118 0 122 25] (walk_complete: bool)
  (applicable: UInt64.t) (admitted: UInt64.t) (return (x: t_SchemaBatchAdmission)) = (! bb0
  [ bb0 = any [ br0 -> {walk_complete = false} (! bb4) | br1 -> {walk_complete} (! bb1) ]
  | bb1 = s0
    [ s0 = [ &_9 <- applicable = admitted ] s1 | s1 = any [ br0 -> {_9 = false} (! bb4) | br1 -> {_9} (! bb2) ] ]
  | bb2 = s0 [ s0 = [ &_ret <- Admit ] s1 | s1 = return {_ret} ]
  | bb4 = s0 [ s0 = [ &_ret <- Reject ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_SchemaBatchAdmission = Any.any_l ()
  | & walk_complete: bool = walk_complete
  | & applicable: UInt64.t = applicable
  | & admitted: UInt64.t = admitted
  | & _9: bool = Any.any_l () ])
  [ return (result: t_SchemaBatchAdmission) -> {[@stop_split] [@expl:schema_batch_admission ensures] [%#sschema] (result
      = Admit)
    = (walk_complete /\ applicable = admitted)}
    (! return {result}) ]
