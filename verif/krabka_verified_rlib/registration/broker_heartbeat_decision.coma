let%span sord = "/root/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/creusot-std-0.13.0/src/logic/ord.rs" 34 8 34 21
let%span sregistration = "/workspace/crates/verified/src/registration.rs" 31 10 39 1

use creusot.int.Int64
use creusot.prelude.Any
use int.Int

type t_Option_i64 = None | Some Int64.t

let elim_Some (_x: t_Option_i64) (return (f0: Int64.t)) = any
  [ _k (f0: Int64.t) -> {Some f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
      | _ -> false
      end}
    any) ]

type t_BrokerHeartbeatDecision = Missing | Stale | Current bool

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let broker_heartbeat_decision [#"/workspace/crates/verified/src/registration.rs" 41 0 45 28]
  (registered_epoch: t_Option_i64) (request_epoch: Int64.t) (metadata_offset: Int64.t)
  (return (x: t_BrokerHeartbeatDecision)) = (! bb0
  [ bb0 = any [ br0 -> {registered_epoch = None} (! bb6) | br1 (x0: Int64.t) -> {registered_epoch = Some x0} (! bb5) ]
  | bb5 = s0
    [ s0 = elim_Some {registered_epoch} (fun (r0: Int64.t) -> [ &epoch'0 <- r0 ] s1)
    | s1 = [ &_12 <- request_epoch <> epoch'0 ] s2
    | s2 = any [ br0 -> {_12 = false} (! bb4) | br1 -> {_12} (! bb7) ] ]
  | bb7 = s0
    [ s0 = elim_Some {registered_epoch} (fun (r0: Int64.t) -> [ &epoch <- r0 ] s1)
    | s1 = [ &_ret <- Stale ] s2
    | s2 = return {_ret} ]
  | bb4 = s0
    [ s0 = elim_Some {registered_epoch} (fun (r0: Int64.t) -> [ &epoch'1 <- r0 ] s1)
    | s1 = [ &_16 <- Int64.ge metadata_offset epoch'1 ] s2
    | s2 = [ &_ret <- Current _16 ] s3
    | s3 = return {_ret} ]
  | bb6 = s0 [ s0 = [ &_ret <- Missing ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_BrokerHeartbeatDecision = Any.any_l ()
  | & registered_epoch: t_Option_i64 = registered_epoch
  | & request_epoch: Int64.t = request_epoch
  | & metadata_offset: Int64.t = metadata_offset
  | & epoch: Int64.t = Any.any_l ()
  | & epoch'0: Int64.t = Any.any_l ()
  | & _12: bool = Any.any_l ()
  | & epoch'1: Int64.t = Any.any_l ()
  | & _16: bool = Any.any_l () ])
  [ return (result: t_BrokerHeartbeatDecision) ->
  {[@stop_split] [@expl:broker_heartbeat_decision ensures] [%#sregistration] match result with
      | Missing -> registered_epoch = None
      | Stale -> exists epoch: Int64.t. registered_epoch = Some epoch /\ request_epoch <> epoch
      | Current caught_up -> exists epoch: Int64.t. registered_epoch = Some epoch
        /\ request_epoch = epoch /\ caught_up = ge_log_Int (Int64.to_int metadata_offset) (Int64.to_int epoch)
      end}
    (! return {result}) ]
