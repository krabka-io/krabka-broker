  (want_shut_down: bool) (return (x: t_BrokerHeartbeatDecision)) = (! bb0
  [ bb0 = any [ br0 -> {registered_epoch = None} (! bb6) | br1 (x0: Int64.t) -> {registered_epoch = Some x0} (! bb5) ]
  | bb5 = s0
    [ s0 = elim_Some {registered_epoch} (fun (r0: Int64.t) -> [ &epoch'0 <- r0 ] s1)
    | s1 = [ &_26 <- request_epoch <> epoch'0 ] s2
    | s2 = any [ br0 -> {_26 = false} (! bb4) | br1 -> {_26} (! bb7) ] ]
  | bb7 = s0
