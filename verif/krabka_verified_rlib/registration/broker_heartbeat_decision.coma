use creusot.int.Int64
use creusot.prelude.Any

type t_Option_i64 = None | Some Int64.t

let elim_Some (_x: t_Option_i64) (return (f0: Int64.t)) = any
  [ _k (f0: Int64.t) -> {Some f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
      | _ -> false
      end}
    any) ]

type t_BrokerHeartbeatDecision = {
  registered: bool;
  epoch_matches: bool;
  caught_up: bool;
  fenced: bool;
  should_shut_down: bool }

predicate ge_log_i64 [@inline:trivial] (self: Int64.t) (other: Int64.t) = [%#sord] Int64.le other self

meta "rewrite_def" predicate ge_log_i64

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let broker_heartbeat_decision [#"/proof-work-234/crates/verified/src/registration.rs" 113 0 119 28]
