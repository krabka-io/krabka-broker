                        caught_up = ([%#sregistration'1] false);
                        fenced = ([%#sregistration'2] false);
                        should_shut_down = ([%#sregistration'3] false) } ] s2
    | s2 = return {_ret} ]
  | bb4 = s0
    [ s0 = elim_Some {registered_epoch} (fun (r0: Int64.t) -> [ &epoch'1 <- r0 ] s1)
    | s1 = [ &caught_up'0 <- Int64.ge metadata_offset epoch'1 ] s2
    | s2 = any [ br0 -> {want_fence = false} (! bb10) | br1 -> {want_fence} (! bb9) ] ]
  | bb9 = s0 [ s0 = [ &_34 <- [%#sregistration'4] true ] s1 | s1 = bb11 ]
  | bb10 = s0 [ s0 = [ &_34 <- not caught_up'0 ] s1 | s1 = bb11 ]
  | bb11 = s0
    [ s0 = [ &_ret <- { registered = ([%#sregistration'5] true);
                        epoch_matches = ([%#sregistration'6] true);
                        caught_up = caught_up'0;
                        fenced = _34;
                        should_shut_down = want_shut_down } ] s1
    | s1 = return {_ret} ]
  | bb6 = s0
    [ s0 = [ &_ret <- { registered = ([%#sregistration'7] false);
                        epoch_matches = ([%#sregistration'8] false);
                        caught_up = ([%#sregistration'9] false);
                        fenced = ([%#sregistration'10] false);
                        should_shut_down = ([%#sregistration'11] false) } ] s1
    | s1 = return {_ret} ] ]
  [ & _ret: t_BrokerHeartbeatDecision = Any.any_l ()
  | & registered_epoch: t_Option_i64 = registered_epoch
  | & request_epoch: Int64.t = request_epoch
  | & metadata_offset: Int64.t = metadata_offset
  | & want_fence: bool = want_fence
  | & want_shut_down: bool = want_shut_down
  | & epoch: Int64.t = Any.any_l ()
  | & epoch'0: Int64.t = Any.any_l ()
  | & _26: bool = Any.any_l ()
  | & epoch'1: Int64.t = Any.any_l ()
  | & caught_up'0: bool = Any.any_l ()
  | & _34: bool = Any.any_l () ])
  [ return (result: t_BrokerHeartbeatDecision) ->
  {[@stop_split] [@expl:broker_heartbeat_decision ensures] ([@stop_split] [@expl:broker_heartbeat_decision ensures #0] [%#sregistration'12] result.registered
