    /\ ([@stop_split] [@expl:broker_heartbeat_decision ensures #1] [%#sregistration'13] result.epoch_matches
      = (exists epoch: Int64.t. registered_epoch = Some epoch /\ request_epoch = epoch))
    /\ ([@stop_split] [@expl:broker_heartbeat_decision ensures #2] [%#sregistration'14] result.caught_up
      = (exists epoch: Int64.t. registered_epoch = Some epoch
