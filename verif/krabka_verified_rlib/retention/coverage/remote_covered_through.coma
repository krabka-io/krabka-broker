        /\ Int64.to_int self_ + Int64.to_int rhs <= Int64.to_int const_MAX
      -> Int64.to_int result = Int64.to_int self_ + Int64.to_int rhs)
    /\ ([@stop_split] [@expl:saturating_add ensures #1] [%#snum'0] Int64.to_int self_ + Int64.to_int rhs
        < Int64.to_int const_MIN -> Int64.to_int result = Int64.to_int const_MIN)
    /\ ([@stop_split] [@expl:saturating_add ensures #2] [%#snum'1] gt_log_Int (Int64.to_int self_
      + Int64.to_int rhs) (Int64.to_int const_MAX) -> Int64.to_int result = Int64.to_int const_MAX)}
    (! return {result}) ]

