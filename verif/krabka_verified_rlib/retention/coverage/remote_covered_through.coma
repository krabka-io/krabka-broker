constant const_MAX: Int64.t = (9223372036854775807: Int64.t)

let saturating_add (self_: Int64.t) (rhs: Int64.t) (return (x: Int64.t)) = any
  [ return (result: Int64.t) ->
  {[@stop_split] [@expl:saturating_add ensures] ([@stop_split] [@expl:saturating_add ensures #0] [%#snum] ge_log_Int (Int64.to_int self_
