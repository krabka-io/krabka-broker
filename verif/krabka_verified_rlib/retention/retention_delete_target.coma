    | s2 = any [ br0 -> {_8 = false} (! bb3) | br1 -> {_8} (! bb5) ] ]
  | bb5 = s0
    [ s0 = elim_Some {last_offset} (fun (r0: Int64.t) -> [ &last <- r0 ] s1)
    | s1 = Int64.add [%#sretention'1] {last} {[%#sretention'0] (1: Int64.t)} (fun (_x: Int64.t) -> [ &_10 <- _x ] s2)
    | s2 = [ &_ret <- Some _10 ] s3
    | s3 = return {_ret} ]
  | bb3 = s0 [ s0 = [ &_ret <- None ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_Option_i64 = Any.any_l ()
  | & last_offset: t_Option_i64 = last_offset
  | & last: Int64.t = Any.any_l ()
  | & last'0: Int64.t = Any.any_l ()
  | & _8: bool = Any.any_l ()
  | & _10: Int64.t = Any.any_l () ])
  [ return (result: t_Option_i64) ->
  {[@stop_split] [@expl:retention_delete_target ensures] [%#sretention'2] match { f0 = last_offset; f1 = result } with
      | {f0 = None; f1 = result'0} -> result'0 = None
      | {f0 = Some last; f1 = None} -> Int64.to_int last = Int64.to_int const_MAX
      | {f0 = Some last; f1 = Some target} -> Int64.to_int last < Int64.to_int const_MAX
