        local_retention_model segments limit (i + 1) (debt - UInt64.t'int (Seq.get segments i).size) true
      else
        if (Seq.get segments i).expired then local_retention_model segments limit (i + 1) debt false else i

    )

function local_retention_limit [#"/workspace/crates/verified/src/retention/remote_retention_model.rs" 33 0 33 73] (segments: Seq.seq t_LocalRetentionSegment) : int
 = [%#sremote_retention_model'32] if gt_log_Int (Seq.length segments) 0
  /\ UInt64.t'int (Seq.get segments (Seq.length segments - 1)).size = 0 then
    Seq.length segments - 1
  else
    Seq.length segments


function local_prefix_bytes [#"/workspace/crates/verified/src/retention/local_bytes.rs" 8 0 8 82] (segments: Seq.seq t_LocalRetentionSegment) (count: int) : int

