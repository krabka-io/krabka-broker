axiom local_retention_model_def:
  forall segments: Seq.seq t_LocalRetentionSegment, limit: int, i: int, debt: int, sizing: bool [local_retention_model segments limit i debt sizing]. local_retention_model segments limit i debt sizing
    = ([%#sretention'21] if ge_log_Int i limit
    \/ ge_log_Int i (Seq.length segments) \/ (Seq.get segments i).blocked then
      i
    else
      if sizing /\ UInt64.t'int (Seq.get segments i).size <= debt then
        local_retention_model segments limit (i + 1) (debt - UInt64.t'int (Seq.get segments i).size) true
      else
        if (Seq.get segments i).expired then local_retention_model segments limit (i + 1) debt false else i
    
    )

function local_retention_limit [#"/workspace/crates/verified/src/retention.rs" 74 0 74 73] (segments: Seq.seq t_LocalRetentionSegment) : int
 = [%#sretention'22] if gt_log_Int (Seq.length segments) 0
  /\ UInt64.t'int (Seq.get segments (Seq.length segments - 1)).size = 0 then
    Seq.length segments - 1
  else
    Seq.length segments


