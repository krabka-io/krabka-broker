use creusot.int.Int64
use creusot.prelude.Any
use int.Int

type t_TokenExpireDecision = Expired | Delete | Update Int64.t

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

constant const_MAX: Int64.t = (9223372036854775807: Int64.t)

function deadline_model [#"/workspace/crates/verified/src/delegation_token.rs" 297 0 297 55] (now_ms: Int64.t) (duration_ms: int) : int
 = [%#sdelegation_token'8] if gt_log_Int (Int64.to_int now_ms + duration_ms) (Int64.to_int const_MAX) then
    Int64.to_int const_MAX
  else
    Int64.to_int now_ms + duration_ms


let token_deadline (now_ms: Int64.t) (duration_ms: Int64.t) (return (x: Int64.t)) =
{[@stop_split] [@expl:token_deadline requires] [%#sdelegation_token'5] ge_log_Int (Int64.to_int duration_ms) 0}
  any
  [ return (result: Int64.t) ->
  {[@stop_split] [@expl:token_deadline ensures] [%#sdelegation_token'6] Int64.to_int result
    = deadline_model now_ms (Int64.to_int duration_ms)}
    (! return {result}) ]

function deep_model_i64 [@inline:trivial] (self: Int64.t) : int = [%#snum] Int64.to_int self

meta "rewrite_def" function deep_model_i64

let min_i64 (self_: Int64.t) (o: Int64.t) (return (x: Int64.t)) = any
  [ return (result: Int64.t) ->
  {[@stop_split] [@expl:min_i64 ensures] ([@stop_split] [@expl:min ensures #0] [%#scmp] deep_model_i64 result
      <= deep_model_i64 self_)
    /\ ([@stop_split] [@expl:min ensures #1] [%#scmp'0] deep_model_i64 result <= deep_model_i64 o)
    /\ ([@stop_split] [@expl:min ensures #2] [%#scmp'1] result = self_ \/ result = o)
    /\ ([@stop_split] [@expl:min ensures #3] [%#scmp'2] deep_model_i64 self_ < deep_model_i64 o -> result = self_)
    /\ ([@stop_split] [@expl:min ensures #4] [%#scmp'3] deep_model_i64 o <= deep_model_i64 self_ -> result = o)}
    (! return {result}) ]

function min_model [#"/workspace/crates/verified/src/delegation_token.rs" 317 0 317 42] (left: int) (right: int) : int =
  [%#sdelegation_token'7] if left < right then left else right

