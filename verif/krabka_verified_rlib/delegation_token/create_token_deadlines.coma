predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

constant const_MAX: Int64.t = (9223372036854775807: Int64.t)

function kafka_sum [#"/workspace/crates/verified/src/delegation_token.rs" 248 0 248 48] (now: int) (duration: int) : int
 = [%#sdelegation_token'11] if gt_log_Int now (Int64.to_int const_MAX - duration) then
    Int64.to_int const_MAX
  else
    now + duration


let saturating_sum (now_ms: Int64.t) (duration_ms: Int64.t) (return (x: Int64.t)) =
{[@stop_split] [@expl:saturating_sum requires] [%#sdelegation_token'9] ge_log_Int (Int64.to_int duration_ms) 0}
  any
