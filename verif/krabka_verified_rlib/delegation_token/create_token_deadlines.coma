  | bb11 = s0 [ s0 = [ &_ret <- Invalid ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_TokenCreateDecision = Any.any_l ()
  | & now_ms: Int64.t = now_ms
  | & requested_ms: Int64.t = requested_ms
  | & ceiling_ms: Int64.t = ceiling_ms
  | & default_renew_period_ms: Int64.t = default_renew_period_ms
  | & _16: bool = Any.any_l ()
  | & _18: bool = Any.any_l ()
  | & _20: bool = Any.any_l ()
  | & chosen_lifetime: Int64.t = Any.any_l ()
