  | bb6 = s0 [ s0 = [ &_ret <- Invalid ] s1 | s1 = return {_ret} ]
  | bb7 = s0
    [ s0 = [ &_24 <- requested_ms = ([%#sdelegation_token'2] (-1: Int64.t)) ] s1
