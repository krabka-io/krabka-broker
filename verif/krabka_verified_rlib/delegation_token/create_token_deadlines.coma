    | s1 = Int64.add [%#sdelegation_token'8] {now_ms} {chosen_lifetime} (fun (_x: Int64.t) -> [ &_41 <- _x ] s2)
    | s2 = Int64.add [%#sdelegation_token'9] {now_ms} {initial_period} (fun (_x: Int64.t) -> [ &_44 <- _x ] s3)
    | s3 = [ &_40 <- { max_timestamp_ms = _41; initial_expiry_ms = _44 } ] s4
