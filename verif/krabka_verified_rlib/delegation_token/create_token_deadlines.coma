  | & _41: Int64.t = Any.any_l ()
  | & _44: Int64.t = Any.any_l () ])
  [ return (result: t_TokenCreateDecision) ->
  {[@stop_split] [@expl:create_token_deadlines ensures] ([@stop_split] [@expl:create_token_deadlines ensures #0] [%#sdelegation_token'10] (result
        = Invalid)
      = (Int64.to_int now_ms < 0
      \/ Int64.to_int ceiling_ms <= 0
      \/ Int64.to_int default_renew_period_ms <= 0
      \/ Int64.to_int requested_ms <> - 1 /\ Int64.to_int requested_ms <= 0
      \/ gt_log_Int (chosen_lifetime_model requested_ms ceiling_ms) (Int64.to_int const_MAX - Int64.to_int now_ms)))
    /\ ([@stop_split] [@expl:create_token_deadlines ensures #1] [%#sdelegation_token'11] match result with
      | Invalid -> true
      | Create deadlines -> ge_log_Int (Int64.to_int now_ms) 0
      /\ Int64.to_int deadlines.max_timestamp_ms = Int64.to_int now_ms + chosen_lifetime_model requested_ms ceiling_ms
      /\ Int64.to_int deadlines.initial_expiry_ms
