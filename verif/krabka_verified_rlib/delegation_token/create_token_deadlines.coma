      /\ gt_log_Int (Int64.to_int deadlines.initial_expiry_ms) (Int64.to_int now_ms)
      /\ Int64.to_int deadlines.initial_expiry_ms <= Int64.to_int deadlines.max_timestamp_ms
      /\ Int64.to_int deadlines.max_timestamp_ms <= Int64.to_int const_MAX
      /\ gt_log_Int (Int64.to_int deadlines.max_timestamp_ms) (Int64.to_int now_ms)
