  | bb8 = s0 [ s0 = [ &chosen_lifetime <- ceiling_ms ] s1 | s1 = bb13 ]
  | bb9 = s0
    [ s0 = [ &_26 <- Int64.gt requested_ms ([%#sdelegation_token'3] (0: Int64.t)) ] s1
    | s1 = any [ br0 -> {_26 = false} (! bb11) | br1 -> {_26} (! bb10) ] ]
  | bb10 = s0
    [ s0 = min_i64 [%#sdelegation_token'4] {requested_ms} {ceiling_ms}
        (fun (_x: Int64.t) -> [ &chosen_lifetime <- _x ] s1)
    | s1 = bb13 ]
  | bb13 = s0
    [ s0 = Int64.sub [%#sdelegation_token'6] {[%#sdelegation_token'5] const_MAX} {now_ms}
        (fun (_x: Int64.t) -> [ &_34 <- _x ] s1)
    | s1 = [ &_32 <- Int64.gt chosen_lifetime _34 ] s2
    | s2 = any [ br0 -> {_32 = false} (! bb15) | br1 -> {_32} (! bb14) ] ]
  | bb14 = s0 [ s0 = [ &_ret <- Invalid ] s1 | s1 = return {_ret} ]
  | bb15 = s0
    [ s0 = min_i64 [%#sdelegation_token'7] {default_renew_period_ms} {chosen_lifetime}
