(* #"/workspace/crates/verified/src/delegation_token.rs" 119 0 123 22 *)

let%span sdelegation_token = "/workspace/crates/verified/src/delegation_token.rs" 112 10 114 1
let%span sdelegation_token'0 = "/workspace/crates/verified/src/delegation_token.rs" 115 10 117 1

use creusot.prelude.Any

type t_TokenApiAdmission = Reject | Allow

type t_TokenApi = Create | Renew | Expire | Describe

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let token_api_admission [#"/workspace/crates/verified/src/delegation_token.rs" 119 0 123 22]
  (has_authenticated_identity: bool) (authenticated_via_token: bool) (_api: t_TokenApi)
  (return (x: t_TokenApiAdmission)) = (! bb0
  [ bb0 = any [ br0 -> {has_authenticated_identity = false} (! bb3) | br1 -> {has_authenticated_identity} (! bb1) ]
  | bb1 = any [ br0 -> {authenticated_via_token = false} (! bb2) | br1 -> {authenticated_via_token} (! bb3) ]
  | bb2 = s0 [ s0 = [ &_ret <- Allow ] s1 | s1 = return {_ret} ]
  | bb3 = s0 [ s0 = [ &_ret <- Reject ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_TokenApiAdmission = Any.any_l ()
  | & has_authenticated_identity: bool = has_authenticated_identity
  | & authenticated_via_token: bool = authenticated_via_token ])
  [ return (result: t_TokenApiAdmission) ->
  {[@stop_split] [@expl:token_api_admission ensures] ([@stop_split] [@expl:token_api_admission ensures #0] [%#sdelegation_token] (result
        = Allow)
      = (has_authenticated_identity /\ not authenticated_via_token))
    /\ ([@stop_split] [@expl:token_api_admission ensures #1] [%#sdelegation_token'0] (result = Reject)
    = (not has_authenticated_identity \/ authenticated_via_token))}
    (! return {result}) ]
