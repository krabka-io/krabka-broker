(* #"/workspace/crates/verified/src/delegation_token.rs" 136 0 136 64 *)

let%span sdelegation_token = "/workspace/crates/verified/src/delegation_token.rs" 138 11 138 74
let%span sdelegation_token'0 = "/workspace/crates/verified/src/delegation_token.rs" 137 4 138 74
let%span sdelegation_token'1 = "/workspace/crates/verified/src/delegation_token.rs" 133 10 134 71

use creusot.prelude.Any

type t_TokenDescribeFacts = {
  selected_by_owner_filter: bool;
  caller_is_owner_or_renewer: bool;
  describe_authorized: bool }

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let token_describe_visible [#"/workspace/crates/verified/src/delegation_token.rs" 136 0 136 64]
  (facts: t_TokenDescribeFacts) (return (x: bool)) = (! bb0
  [ bb0 = any
    [ br0 -> {facts.selected_by_owner_filter = false} (! bb2) | br1 -> {facts.selected_by_owner_filter} (! bb1) ]
  | bb1 = any
    [ br0 -> {facts.caller_is_owner_or_renewer = false} (! bb4) | br1 -> {facts.caller_is_owner_or_renewer} (! bb3) ]
  | bb3 = s0 [ s0 = [ &_ret <- [%#sdelegation_token] true ] s1 | s1 = return {_ret} ]
  | bb4 = s0 [ s0 = [ &_ret <- facts.describe_authorized ] s1 | s1 = return {_ret} ]
  | bb2 = s0 [ s0 = [ &_ret <- [%#sdelegation_token'0] false ] s1 | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l () | & facts: t_TokenDescribeFacts = facts ])
  [ return (result: bool) -> {[@stop_split] [@expl:token_describe_visible ensures] [%#sdelegation_token'1] result
    = (facts.selected_by_owner_filter /\ (facts.caller_is_owner_or_renewer \/ facts.describe_authorized))}
    (! return {result}) ]
