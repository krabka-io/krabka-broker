(* #"/workspace/crates/verified/src/delegation_token.rs" 88 0 93 9 *)

let%span sdelegation_token = "/workspace/crates/verified/src/delegation_token.rs" 94 28 94 80
let%span sdelegation_token'0 = "/workspace/crates/verified/src/delegation_token.rs" 94 4 94 80
let%span sdelegation_token'1 = "/workspace/crates/verified/src/delegation_token.rs" 82 10 82 98

use creusot.prelude.Any

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let token_describe_visible [#"/workspace/crates/verified/src/delegation_token.rs" 88 0 93 9]
  (owner_filter_matches: bool) (caller_is_owner: bool) (caller_is_renewer: bool) (acl_allows: bool) (return (x: bool)) =
(! bb0
  [ bb0 = any [ br0 -> {owner_filter_matches = false} (! bb2) | br1 -> {owner_filter_matches} (! bb1) ]
  | bb1 = any [ br0 -> {caller_is_owner = false} (! bb3) | br1 -> {caller_is_owner} (! bb4) ]
  | bb3 = any [ br0 -> {caller_is_renewer = false} (! bb5) | br1 -> {caller_is_renewer} (! bb4) ]
  | bb4 = s0 [ s0 = [ &_ret <- [%#sdelegation_token] true ] s1 | s1 = return {_ret} ]
  | bb5 = s0 [ s0 = [ &_ret <- acl_allows ] s1 | s1 = return {_ret} ]
  | bb2 = s0 [ s0 = [ &_ret <- [%#sdelegation_token'0] false ] s1 | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l ()
  | & owner_filter_matches: bool = owner_filter_matches
  | & caller_is_owner: bool = caller_is_owner
  | & caller_is_renewer: bool = caller_is_renewer
  | & acl_allows: bool = acl_allows ])
  [ return (result: bool) -> {[@stop_split] [@expl:token_describe_visible ensures] [%#sdelegation_token'1] result
    = (owner_filter_matches /\ (caller_is_owner \/ caller_is_renewer \/ acl_allows))}
    (! return {result}) ]
