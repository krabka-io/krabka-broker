(* #"/workspace/crates/verified/src/delegation_token.rs" 96 0 96 84 *)

let%span sdelegation_token = "/workspace/crates/verified/src/delegation_token.rs" 83 10 84 65
let%span sdelegation_token'0 = "/workspace/crates/verified/src/delegation_token.rs" 85 10 86 68
let%span sdelegation_token'1 = "/workspace/crates/verified/src/delegation_token.rs" 87 10 88 71
let%span sdelegation_token'2 = "/workspace/crates/verified/src/delegation_token.rs" 89 10 94 6

use creusot.prelude.Any

type t_TokenLookup = Missing | Expired | Live

type t_ScramCredentialFacts = { token_auth_requested: bool; has_regular_credential: bool; token: t_TokenLookup }

type t_ScramCredentialSource = Regular | DelegationToken | ExpiredDelegationToken | Unknown

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let scram_credential_source [#"/workspace/crates/verified/src/delegation_token.rs" 96 0 96 84]
  (facts: t_ScramCredentialFacts) (return (x: t_ScramCredentialSource)) = (! bb0
  [ bb0 = any [ br0 -> {facts.token_auth_requested = false} (! bb1) | br1 -> {facts.token_auth_requested} (! bb5) ]
  | bb5 = any
    [ br0 -> {facts.token = Missing} (! bb11)
    | br1 -> {facts.token = Expired} (! bb10)
    | br2 -> {facts.token = Live} (! bb9) ]
  | bb9 = s0 [ s0 = [ &_ret <- DelegationToken ] s1 | s1 = return {_ret} ]
  | bb10 = s0 [ s0 = [ &_ret <- ExpiredDelegationToken ] s1 | s1 = return {_ret} ]
  | bb11 = s0 [ s0 = [ &_ret <- Unknown ] s1 | s1 = return {_ret} ]
  | bb1 = any [ br0 -> {facts.has_regular_credential = false} (! bb3) | br1 -> {facts.has_regular_credential} (! bb2) ]
  | bb2 = s0 [ s0 = [ &_ret <- Regular ] s1 | s1 = return {_ret} ]
  | bb3 = s0 [ s0 = [ &_ret <- Unknown ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_ScramCredentialSource = Any.any_l () | & facts: t_ScramCredentialFacts = facts ])
  [ return (result: t_ScramCredentialSource) ->
  {[@stop_split] [@expl:scram_credential_source ensures] ([@stop_split] [@expl:scram_credential_source ensures #0] [%#sdelegation_token] (result
        = Regular)
      = (not facts.token_auth_requested /\ facts.has_regular_credential))
    /\ ([@stop_split] [@expl:scram_credential_source ensures #1] [%#sdelegation_token'0] (result = DelegationToken)
      = (facts.token_auth_requested /\ facts.token = Live))
    /\ ([@stop_split] [@expl:scram_credential_source ensures #2] [%#sdelegation_token'1] (result
        = ExpiredDelegationToken)
      = (facts.token_auth_requested /\ facts.token = Expired))
    /\ ([@stop_split] [@expl:scram_credential_source ensures #3] [%#sdelegation_token'2] (result = Unknown)
    = (if facts.token_auth_requested then facts.token = Missing else not facts.has_regular_credential))}
    (! return {result}) ]
