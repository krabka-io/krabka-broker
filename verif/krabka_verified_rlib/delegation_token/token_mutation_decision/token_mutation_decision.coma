type t_TokenMutationDecision = Append | Retry | Reject

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate token_generation_live [#"/workspace/crates/verified/src/delegation_token/token_mutation_decision.rs" 104 0 104 59] (facts: t_TokenMutationFacts) =
