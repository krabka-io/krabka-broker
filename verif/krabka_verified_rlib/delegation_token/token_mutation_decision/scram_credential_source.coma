(* #"/workspace/crates/verified/src/delegation_token/token_mutation_decision.rs" 26 0 31 26 *)

let%span stoken_mutation_decision = "/workspace/crates/verified/src/delegation_token/token_mutation_decision.rs" 14 10 14 78
let%span stoken_mutation_decision'0 = "/workspace/crates/verified/src/delegation_token/token_mutation_decision.rs" 15 10 16 77
let%span stoken_mutation_decision'1 = "/workspace/crates/verified/src/delegation_token/token_mutation_decision.rs" 17 10 18 78
let%span stoken_mutation_decision'2 = "/workspace/crates/verified/src/delegation_token/token_mutation_decision.rs" 19 10 20 65

use creusot.prelude.Any

type t_ScramCredentialSource = Regular | DelegationToken | ExpiredDelegationToken | Unknown

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let scram_credential_source [#"/workspace/crates/verified/src/delegation_token/token_mutation_decision.rs" 26 0 31 26]
  (has_regular_credential: bool) (token_mechanism: bool) (has_token: bool) (token_active: bool)
  (return (x: t_ScramCredentialSource)) = (! bb0
  [ bb0 = any [ br0 -> {has_regular_credential = false} (! bb2) | br1 -> {has_regular_credential} (! bb1) ]
  | bb1 = s0 [ s0 = [ &_ret <- Regular ] s1 | s1 = return {_ret} ]
  | bb2 = any [ br0 -> {token_mechanism = false} (! bb4) | br1 -> {token_mechanism} (! bb3) ]
  | bb3 = any [ br0 -> {has_token = false} (! bb4) | br1 -> {has_token} (! bb5) ]
  | bb5 = any [ br0 -> {token_active = false} (! bb7) | br1 -> {token_active} (! bb6) ]
  | bb6 = s0 [ s0 = [ &_ret <- DelegationToken ] s1 | s1 = return {_ret} ]
  | bb7 = s0 [ s0 = [ &_ret <- ExpiredDelegationToken ] s1 | s1 = return {_ret} ]
  | bb4 = s0 [ s0 = [ &_ret <- Unknown ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_ScramCredentialSource = Any.any_l ()
  | & has_regular_credential: bool = has_regular_credential
  | & token_mechanism: bool = token_mechanism
  | & has_token: bool = has_token
  | & token_active: bool = token_active ])
  [ return (result: t_ScramCredentialSource) ->
  {[@stop_split] [@expl:scram_credential_source ensures] ([@stop_split] [@expl:scram_credential_source ensures #0] [%#stoken_mutation_decision] (result
        = Regular)
      = has_regular_credential)
    /\ ([@stop_split] [@expl:scram_credential_source ensures #1] [%#stoken_mutation_decision'0] (result
        = DelegationToken)
      = (not has_regular_credential /\ token_mechanism /\ has_token /\ token_active))
    /\ ([@stop_split] [@expl:scram_credential_source ensures #2] [%#stoken_mutation_decision'1] (result
        = ExpiredDelegationToken)
      = (not has_regular_credential /\ token_mechanism /\ has_token /\ not token_active))
    /\ ([@stop_split] [@expl:scram_credential_source ensures #3] [%#stoken_mutation_decision'2] (result = Unknown)
    = (not has_regular_credential /\ (not token_mechanism \/ not has_token)))}
    (! return {result}) ]
