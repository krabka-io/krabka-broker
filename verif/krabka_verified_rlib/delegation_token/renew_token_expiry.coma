use creusot.int.Int64
use creusot.prelude.Any
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate live [#"/workspace/crates/verified/src/delegation_token.rs" 258 0 258 62] (now: int) (expiry: int) (max_timestamp: int) =
  [%#sdelegation_token'11] ge_log_Int expiry now /\ ge_log_Int max_timestamp now

let token_is_active (now_ms: Int64.t) (expiry_timestamp_ms: Int64.t) (max_timestamp_ms: Int64.t) (return (x: bool)) =
any
  [ return (result: bool) -> {[@stop_split] [@expl:token_is_active ensures] [%#sdelegation_token'5] result
    = live (Int64.to_int now_ms) (Int64.to_int expiry_timestamp_ms) (Int64.to_int max_timestamp_ms)}
    (! return {result}) ]

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

function min_i [#"/workspace/crates/verified/src/delegation_token.rs" 238 0 238 35] (a: int) (b: int) : int =
  [%#sdelegation_token'12] if a <= b then a else b

function requested_period [#"/workspace/crates/verified/src/delegation_token.rs" 269 0 269 63] (requested: int) (configured: int) : int
 = [%#sdelegation_token'14] if gt_log_Int requested 0 then min_i configured requested else configured

let effective_period (requested_ms: Int64.t) (configured_ms: Int64.t) (return (x: Int64.t)) =
{[@stop_split] [@expl:effective_period requires] [%#sdelegation_token'6] gt_log_Int (Int64.to_int configured_ms) 0}
  any
  [ return (result: Int64.t) ->
  {[@stop_split] [@expl:effective_period ensures] ([@stop_split] [@expl:effective_period ensures #0] [%#sdelegation_token'7] Int64.to_int result
      = requested_period (Int64.to_int requested_ms) (Int64.to_int configured_ms))
    /\ ([@stop_split] [@expl:effective_period ensures #1] [%#sdelegation_token'8] gt_log_Int (Int64.to_int result) 0)}
    (! return {result}) ]

constant const_MAX: Int64.t = (9223372036854775807: Int64.t)

function kafka_sum [#"/workspace/crates/verified/src/delegation_token.rs" 248 0 248 48] (now: int) (duration: int) : int
 = [%#sdelegation_token'13] if gt_log_Int now (Int64.to_int const_MAX - duration) then
    Int64.to_int const_MAX
  else
    now + duration


let saturating_sum (now_ms: Int64.t) (duration_ms: Int64.t) (return (x: Int64.t)) =
{[@stop_split] [@expl:saturating_sum requires] [%#sdelegation_token'9] ge_log_Int (Int64.to_int duration_ms) 0}
  any
  [ return (result: Int64.t) ->
  {[@stop_split] [@expl:saturating_sum ensures] [%#sdelegation_token'10] Int64.to_int result
    = kafka_sum (Int64.to_int now_ms) (Int64.to_int duration_ms)}
    (! return {result}) ]

function deep_model_i64 [@inline:trivial] (self: Int64.t) : int = [%#snum] Int64.to_int self

meta "rewrite_def" function deep_model_i64

let min_i64 (self_: Int64.t) (o: Int64.t) (return (x: Int64.t)) = any
  [ return (result: Int64.t) ->
  {[@stop_split] [@expl:min_i64 ensures] ([@stop_split] [@expl:min ensures #0] [%#scmp] deep_model_i64 result
      <= deep_model_i64 self_)
    /\ ([@stop_split] [@expl:min ensures #1] [%#scmp'0] deep_model_i64 result <= deep_model_i64 o)
    /\ ([@stop_split] [@expl:min ensures #2] [%#scmp'1] result = self_ \/ result = o)
    /\ ([@stop_split] [@expl:min ensures #3] [%#scmp'2] deep_model_i64 self_ < deep_model_i64 o -> result = self_)
    /\ ([@stop_split] [@expl:min ensures #4] [%#scmp'3] deep_model_i64 o <= deep_model_i64 self_ -> result = o)}
    (! return {result}) ]

type t_TokenRenewDecision = Expired | Renew Int64.t

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let renew_token_expiry [#"/workspace/crates/verified/src/delegation_token.rs" 454 0 460 23] (now_ms: Int64.t)
  (requested_ms: Int64.t) (default_renew_period_ms: Int64.t) (current_expiry_ms: Int64.t) (max_timestamp_ms: Int64.t)
  (return (x: t_TokenRenewDecision)) =
{[@stop_split] [@expl:renew_token_expiry requires] [%#sdelegation_token'3] gt_log_Int (Int64.to_int default_renew_period_ms) 0}
  (! bb0
  [ bb0 = s0
    [ s0 = token_is_active [%#sdelegation_token] {now_ms} {current_expiry_ms} {max_timestamp_ms}
        (fun (_x: bool) -> [ &_15 <- _x ] s1)
    | s1 = any [ br0 -> {_15 = false} (! bb3) | br1 -> {_15} (! bb2) ] ]
  | bb2 = s0
    [ s0 = effective_period [%#sdelegation_token'0] {requested_ms} {default_renew_period_ms}
        (fun (_x: Int64.t) -> [ &period <- _x ] s1)
    | s1 = saturating_sum [%#sdelegation_token'1] {now_ms} {period} (fun (_x: Int64.t) -> [ &_25 <- _x ] s2)
    | s2 = min_i64 [%#sdelegation_token'2] {max_timestamp_ms} {_25} (fun (_x: Int64.t) -> [ &_23 <- _x ] s3)
    | s3 = [ &_ret <- Renew _23 ] s4
    | s4 = return {_ret} ]
  | bb3 = s0 [ s0 = [ &_ret <- Expired ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_TokenRenewDecision = Any.any_l ()
  | & now_ms: Int64.t = now_ms
  | & requested_ms: Int64.t = requested_ms
  | & default_renew_period_ms: Int64.t = default_renew_period_ms
  | & current_expiry_ms: Int64.t = current_expiry_ms
  | & max_timestamp_ms: Int64.t = max_timestamp_ms
  | & _15: bool = Any.any_l ()
  | & period: Int64.t = Any.any_l ()
  | & _23: Int64.t = Any.any_l ()
  | & _25: Int64.t = Any.any_l () ])
  [ return (result: t_TokenRenewDecision) ->
  {[@stop_split] [@expl:renew_token_expiry ensures] [%#sdelegation_token'4] match result with
      | Expired -> not live (Int64.to_int now_ms) (Int64.to_int current_expiry_ms) (Int64.to_int max_timestamp_ms)
      | Renew expiry -> live (Int64.to_int now_ms) (Int64.to_int current_expiry_ms) (Int64.to_int max_timestamp_ms)
      /\ Int64.to_int expiry
      = min_i (Int64.to_int max_timestamp_ms) (kafka_sum (Int64.to_int now_ms) (requested_period (Int64.to_int requested_ms) (Int64.to_int default_renew_period_ms)))
      end}
    (! return {result}) ]
