function bounded_period_model [#"/workspace/crates/verified/src/delegation_token.rs" 307 0 307 66] (requested_ms: Int64.t) (default_ms: Int64.t) : int
 = [%#sdelegation_token'13] if gt_log_Int (Int64.to_int requested_ms) 0
  /\ Int64.to_int requested_ms < Int64.to_int default_ms then
    Int64.to_int requested_ms
  else
