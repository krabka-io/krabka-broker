predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

constant const_MAX: Int64.t = (9223372036854775807: Int64.t)

function deadline_model [#"/workspace/crates/verified/src/delegation_token.rs" 297 0 297 55] (now_ms: Int64.t) (duration_ms: int) : int
 = [%#sdelegation_token'12] if gt_log_Int (Int64.to_int now_ms + duration_ms) (Int64.to_int const_MAX) then
    Int64.to_int const_MAX
  else
