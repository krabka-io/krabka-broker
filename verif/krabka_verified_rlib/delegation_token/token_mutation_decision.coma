use creusot.int.Int64
use creusot.prelude.Any
use int.Int

type t_TokenMutationKind = Renew | Expire | Delete

type t_TokenMutationState = Missing | Expected | Applied | Stale

type t_TokenMutationFacts = {
  kind: t_TokenMutationKind;
  state: t_TokenMutationState;
  now_ms: Int64.t;
  expected_expiry_ms: Int64.t;
  incoming_expiry_ms: Int64.t;
  max_timestamp_ms: Int64.t;
  uncommitted_tail: bool }

type t_TokenMutationDecision = Append | Retry | Reject

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate live [#"/workspace/crates/verified/src/delegation_token.rs" 258 0 258 62] (now: int) (expiry: int) (max_timestamp: int) =
  [%#sdelegation_token'9] ge_log_Int expiry now /\ ge_log_Int max_timestamp now

let token_is_active (now_ms'0: Int64.t) (expiry_timestamp_ms: Int64.t) (max_timestamp_ms'0: Int64.t)
  (return (x: bool)) = any
  [ return (result: bool) -> {[@stop_split] [@expl:token_is_active ensures] [%#sdelegation_token'6] result
    = live (Int64.to_int now_ms'0) (Int64.to_int expiry_timestamp_ms) (Int64.to_int max_timestamp_ms'0)}
    (! return {result}) ]

predicate update_admissible [#"/workspace/crates/verified/src/delegation_token.rs" 280 0 280 59] (facts: t_TokenMutationFacts) =
  [%#sdelegation_token'7] live (Int64.to_int facts.now_ms) (Int64.to_int facts.expected_expiry_ms) (Int64.to_int facts.max_timestamp_ms)
  /\ Int64.to_int facts.incoming_expiry_ms <= Int64.to_int facts.max_timestamp_ms

predicate renew_is_noop [#"/workspace/crates/verified/src/delegation_token.rs" 292 0 292 55] (facts: t_TokenMutationFacts) =
  [%#sdelegation_token'8] facts.kind = Renew
  /\ Int64.to_int facts.incoming_expiry_ms = Int64.to_int facts.expected_expiry_ms

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let token_mutation_decision [#"/workspace/crates/verified/src/delegation_token.rs" 337 0 337 82]
  (facts: t_TokenMutationFacts) (return (x: t_TokenMutationDecision)) = (! bb0
  [ bb0 = any [ br0 -> {facts.uncommitted_tail = false} (! bb2) | br1 -> {facts.uncommitted_tail} (! bb1) ]
  | bb1 = s0 [ s0 = [ &_ret <- Reject ] s1 | s1 = return {_ret} ]
  | bb2 = any
    [ br0 -> {facts.state = Missing} (! bb9)
    | br1 -> {facts.state = Expected} (! bb7)
    | br2 -> {facts.state = Applied} (! bb10)
    | br3 -> {facts.state = Stale} (! bb8) ]
  | bb8 = s0 [ s0 = [ &_ret <- Reject ] s1 | s1 = return {_ret} ]
  | bb10 = s0 [ s0 = [ &_ret <- Retry ] s1 | s1 = return {_ret} ]
  | bb7 = any
    [ br0 -> {facts.kind = Renew} (! bb19)
    | br1 -> {facts.kind = Expire} (! bb18)
    | br2 -> {facts.kind = Delete} (! bb20) ]
  | bb20 = s0 [ s0 = [ &_ret <- Append ] s1 | s1 = return {_ret} ]
  | bb18 = s0 [ s0 = [ &is_renew <- [%#sdelegation_token] false ] s1 | s1 = bb21 ]
  | bb19 = s0 [ s0 = [ &is_renew <- [%#sdelegation_token'0] true ] s1 | s1 = bb21 ]
  | bb21 = s0
    [ s0 = token_is_active [%#sdelegation_token'1] {facts.now_ms} {facts.expected_expiry_ms} {facts.max_timestamp_ms}
        (fun (_x: bool) -> [ &_21 <- _x ] s1)
    | s1 = any [ br0 -> {_21 = false} (! bb24) | br1 -> {_21} (! bb23) ] ]
  | bb23 = s0 [ s0 = [ &admissible <- Int64.le facts.incoming_expiry_ms facts.max_timestamp_ms ] s1 | s1 = bb25 ]
  | bb24 = s0 [ s0 = [ &admissible <- [%#sdelegation_token'2] false ] s1 | s1 = bb25 ]
  | bb25 = any [ br0 -> {admissible = false} (! bb26) | br1 -> {admissible} (! bb27) ]
  | bb27 = any [ br0 -> {is_renew = false} (! bb31) | br1 -> {is_renew} (! bb28) ]
  | bb28 = s0
    [ s0 = [ &_29 <- facts.incoming_expiry_ms = facts.expected_expiry_ms ] s1
    | s1 = any [ br0 -> {_29 = false} (! bb31) | br1 -> {_29} (! bb29) ] ]
  | bb29 = s0 [ s0 = [ &_ret <- Retry ] s1 | s1 = return {_ret} ]
  | bb31 = s0 [ s0 = [ &_ret <- Append ] s1 | s1 = return {_ret} ]
  | bb26 = s0 [ s0 = [ &_ret <- Reject ] s1 | s1 = return {_ret} ]
  | bb9 = any
    [ br0 -> {facts.kind = Renew} (! bb13)
    | br1 -> {facts.kind = Expire} (! bb13)
    | br2 -> {facts.kind = Delete} (! bb14) ]
  | bb14 = s0 [ s0 = [ &_ret <- Retry ] s1 | s1 = return {_ret} ]
  | bb13 = s0 [ s0 = [ &_ret <- Reject ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_TokenMutationDecision = Any.any_l ()
  | & facts: t_TokenMutationFacts = facts
  | & is_renew: bool = Any.any_l ()
  | & admissible: bool = Any.any_l ()
  | & _21: bool = Any.any_l ()
  | & _29: bool = Any.any_l () ])
  [ return (result: t_TokenMutationDecision) ->
  {[@stop_split] [@expl:token_mutation_decision ensures] ([@stop_split] [@expl:token_mutation_decision ensures #0] [%#sdelegation_token'3] (result
        = Reject)
      = (facts.uncommitted_tail
      \/ facts.state = Stale
      \/ facts.state = Missing /\ facts.kind <> Delete
      \/ facts.state = Expected /\ facts.kind <> Delete /\ not update_admissible facts))
    /\ ([@stop_split] [@expl:token_mutation_decision ensures #1] [%#sdelegation_token'4] (result = Retry)
      = (not facts.uncommitted_tail
