use creusot.int.Int64
use creusot.prelude.Any
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate live [#"/workspace/crates/verified/src/delegation_token.rs" 258 0 258 62] (now: int) (expiry: int) (max_timestamp: int) =
  [%#sdelegation_token'1] ge_log_Int expiry now /\ ge_log_Int max_timestamp now

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let token_is_active [#"/workspace/crates/verified/src/delegation_token.rs" 473 0 473 92] (now_ms: Int64.t)
  (expiry_timestamp_ms: Int64.t) (max_timestamp_ms: Int64.t) (return (x: bool)) = (! bb0
  [ bb0 = s0
    [ s0 = [ &_8 <- Int64.ge expiry_timestamp_ms now_ms ] s1
    | s1 = any [ br0 -> {_8 = false} (! bb2) | br1 -> {_8} (! bb1) ] ]
  | bb1 = s0 [ s0 = [ &_ret <- Int64.ge max_timestamp_ms now_ms ] s1 | s1 = return {_ret} ]
  | bb2 = s0 [ s0 = [ &_ret <- [%#sdelegation_token] false ] s1 | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l ()
  | & now_ms: Int64.t = now_ms
  | & expiry_timestamp_ms: Int64.t = expiry_timestamp_ms
  | & max_timestamp_ms: Int64.t = max_timestamp_ms
  | & _8: bool = Any.any_l () ])
  [ return (result: bool) -> {[@stop_split] [@expl:token_is_active ensures] [%#sdelegation_token'0] result
    = live (Int64.to_int now_ms) (Int64.to_int expiry_timestamp_ms) (Int64.to_int max_timestamp_ms)}
    (! return {result}) ]
