  | bb10 = any [ br0 -> {acl_allowed = false} (! bb9) | br1 -> {acl_allowed} (! bb25) ]
  | bb25 = s0 [ s0 = [ &_ret <- AllowShare ] s1 | s1 = return {_ret} ]
  | bb9 = s0 [ s0 = [ &_ret <- DenyCluster ] s1 | s1 = return {_ret} ]
  | bb24 = s0 [ s0 = [ &_ret <- InvalidRequest ] s1 | s1 = return {_ret} ]
  | bb13 = any [ br0 -> {acl_allowed = false} (! bb12) | br1 -> {acl_allowed} (! bb18) ]
  | bb18 = s0 [ s0 = [ &_ret <- AllowTransaction ] s1 | s1 = return {_ret} ]
  | bb12 = s0 [ s0 = [ &_ret <- DenyTransaction ] s1 | s1 = return {_ret} ]
  | bb15 = any [ br0 -> {acl_allowed = false} (! bb14) | br1 -> {acl_allowed} (! bb16) ]
  | bb16 = s0 [ s0 = [ &_ret <- AllowGroup ] s1 | s1 = return {_ret} ]
  | bb14 = s0 [ s0 = [ &_ret <- DenyGroup ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_FindCoordinatorAdmission = Any.any_l ()
  | & api_version: Int16.t = api_version
  | & key_type: Int8.t = key_type
  | & acl_allowed: bool = acl_allowed
  | & share_key_valid: bool = share_key_valid
  | & _21: bool = Any.any_l () ])
  [ return (result: t_FindCoordinatorAdmission) ->
  {[@stop_split] [@expl:find_coordinator_admission ensures] ([@stop_split] [@expl:find_coordinator_admission ensures #0] [%#sbroker'0] Int8.to_int key_type
