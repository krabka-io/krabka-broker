    /\ Seq.length (Slice64.view changes) <= UInt64.t'int max_changes
    /\ (forall i: int. 0 <= i /\ i < Seq.length (Slice64.view changes)
      -> preferred_change_eligible (Seq.get (Slice64.view changes) i)))}
    (! return {result}) ]
