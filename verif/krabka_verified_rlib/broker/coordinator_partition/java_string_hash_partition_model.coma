use creusot.int.UInt16
use seq.Seq
use creusot.int.Int32
use int.ComputerDivision
use int.Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

function java_string_hash_prefix_model [#"/workspace/crates/verified/src/broker/coordinator_partition.rs" 100 0 100 72] (units: Seq.seq UInt16.t) (limit: int) : Int32.t

axiom java_string_hash_prefix_model_def:
  forall units: Seq.seq UInt16.t, limit: int [java_string_hash_prefix_model units limit]. ([%#scoordinator_partition'0] 0
        <= limit
      /\ limit <= Seq.length units)
    -> java_string_hash_prefix_model units limit
    = ([%#scoordinator_partition'2] if limit <= 0 then
      (0: Int32.t)
    else
      Int32.add (Int32.mul (java_string_hash_prefix_model units (limit
      - 1)) (31: Int32.t)) (Int32.of_int (UInt16.t'int (Seq.get units (limit - 1))))
    )

constant const_MIN: Int32.t = (-2147483648: Int32.t)

function java_string_abs_model [#"/workspace/crates/verified/src/broker/coordinator_partition.rs" 115 0 115 42] (hash: Int32.t) : Int32.t
 = [%#scoordinator_partition'3] if hash = const_MIN then
    (0: Int32.t)
  else
    if Int32.lt hash (0: Int32.t) then Int32.neg hash else hash


