meta "rewrite_def" function deep_model_ref_Option_u64

let ne_Option_u64 (self_: t_Option_u64) (rhs: t_Option_u64) (return (x: bool)) = any
  [ return (result: bool) -> {[@stop_split] [@expl:ne ensures] [%#scmp] result
    = (deep_model_ref_Option_u64 self_ <> deep_model_ref_Option_u64 rhs)}
    (! return {result}) ]

type t_DirectoryResponseDecision = ControllerError | StaleController | Accept

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let directory_response_decision [#"/proof-work-232/crates/verified/src/directory.rs" 53 0 57 30] (response_ok: bool)
  (sent_controller: UInt64.t) (current_controller: t_Option_u64) (return (x: t_DirectoryResponseDecision)) = (! bb0
  [ bb0 = any [ br0 -> {response_ok = false} (! bb1) | br1 -> {response_ok} (! bb2) ]
  | bb2 = s0
    [ s0 = [ &_18 <- Some sent_controller ] s1
    | s1 = ne_Option_u64 [%#sdirectory] {current_controller} {_18} (fun (_x: bool) -> [ &_15 <- _x ] s2)
    | s2 = any [ br0 -> {_15 = false} (! bb5) | br1 -> {_15} (! bb4) ] ]
  | bb4 = s0 [ s0 = [ &_ret <- StaleController ] s1 | s1 = return {_ret} ]
  | bb5 = s0 [ s0 = [ &_ret <- Accept ] s1 | s1 = return {_ret} ]
  | bb1 = s0 [ s0 = [ &_ret <- ControllerError ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_DirectoryResponseDecision = Any.any_l ()
  | & response_ok: bool = response_ok
  | & sent_controller: UInt64.t = sent_controller
  | & current_controller: t_Option_u64 = current_controller
  | & _15: bool = Any.any_l ()
  | & _18: t_Option_u64 = Any.any_l () ])
  [ return (result: t_DirectoryResponseDecision) ->
  {[@stop_split] [@expl:directory_response_decision ensures] ([@stop_split] [@expl:directory_response_decision ensures #0] [%#sdirectory'0] (result
        = ControllerError)
      = (not response_ok))
    /\ ([@stop_split] [@expl:directory_response_decision ensures #1] [%#sdirectory'1] (result = StaleController)
      = (response_ok /\ current_controller <> Some sent_controller))
    /\ ([@stop_split] [@expl:directory_response_decision ensures #2] [%#sdirectory'2] (result = Accept)
    = (response_ok /\ current_controller = Some sent_controller))}
    (! return {result}) ]
