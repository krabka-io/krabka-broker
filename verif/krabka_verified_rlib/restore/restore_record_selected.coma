(* #"/proof-work-244/crates/verified/src/restore.rs" 39 0 50 9 *)

let%span srestore = "/proof-work-244/crates/verified/src/restore.rs" 51 4 56 27
let%span srestore'0 = "/proof-work-244/crates/verified/src/restore.rs" 25 10 32 1

use creusot.int.Int64
use creusot.prelude.Any
use int.Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let restore_record_selected [#"/proof-work-244/crates/verified/src/restore.rs" 39 0 50 9] (offset: Int64.t)
  (offset_bound_applies: bool) (offset_bound: Int64.t) (timestamp: Int64.t) (timestamp_bound_applies: bool)
  (timestamp_bound: Int64.t) (producer_excluded: bool) (offset_excluded: bool) (key_excluded: bool)
  (header_excluded: bool) (return (x: bool)) = (! bb0
  [ bb0 = any [ br0 -> {offset_bound_applies = false} (! bb3) | br1 -> {offset_bound_applies} (! bb1) ]
  | bb1 = s0
    [ s0 = [ &_23 <- Int64.le offset offset_bound ] s1
    | s1 = any [ br0 -> {_23 = false} (! bb12) | br1 -> {_23} (! bb3) ] ]
  | bb3 = any [ br0 -> {timestamp_bound_applies = false} (! bb6) | br1 -> {timestamp_bound_applies} (! bb4) ]
  | bb4 = s0
    [ s0 = [ &_27 <- Int64.lt timestamp timestamp_bound ] s1
    | s1 = any [ br0 -> {_27 = false} (! bb12) | br1 -> {_27} (! bb6) ] ]
  | bb6 = any [ br0 -> {producer_excluded = false} (! bb7) | br1 -> {producer_excluded} (! bb12) ]
  | bb7 = any [ br0 -> {offset_excluded = false} (! bb8) | br1 -> {offset_excluded} (! bb12) ]
  | bb8 = any [ br0 -> {key_excluded = false} (! bb9) | br1 -> {key_excluded} (! bb12) ]
  | bb12 = s0 [ s0 = [ &_ret <- [%#srestore] false ] s1 | s1 = return {_ret} ]
  | bb9 = s0 [ s0 = [ &_ret <- not header_excluded ] s1 | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l ()
  | & offset: Int64.t = offset
  | & offset_bound_applies: bool = offset_bound_applies
  | & offset_bound: Int64.t = offset_bound
  | & timestamp: Int64.t = timestamp
  | & timestamp_bound_applies: bool = timestamp_bound_applies
  | & timestamp_bound: Int64.t = timestamp_bound
  | & producer_excluded: bool = producer_excluded
  | & offset_excluded: bool = offset_excluded
  | & key_excluded: bool = key_excluded
  | & header_excluded: bool = header_excluded
  | & _23: bool = Any.any_l ()
  | & _27: bool = Any.any_l () ])
  [ return (result: bool) -> {[@stop_split] [@expl:restore_record_selected ensures] [%#srestore'0] result
    = ((not offset_bound_applies \/ Int64.to_int offset <= Int64.to_int offset_bound)
    /\ (not timestamp_bound_applies \/ Int64.to_int timestamp < Int64.to_int timestamp_bound)
    /\ not producer_excluded /\ not offset_excluded /\ not key_excluded /\ not header_excluded)}
    (! return {result}) ]
