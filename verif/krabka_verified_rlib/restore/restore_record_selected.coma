(* #"/workspace/crates/verified/src/restore.rs" 66 0 72 9 *)

let%span srestore = "/workspace/crates/verified/src/restore.rs" 75 16 75 20
let%span srestore'0 = "/workspace/crates/verified/src/restore.rs" 78 16 78 20
let%span srestore'1 = "/workspace/crates/verified/src/restore.rs" 79 11 82 37
let%span srestore'2 = "/workspace/crates/verified/src/restore.rs" 73 4 82 37
let%span srestore'3 = "/workspace/crates/verified/src/restore.rs" 60 10 64 1
let%span srestore'4 = "/workspace/crates/verified/src/restore.rs" 50 8 53 40

use creusot.int.Int64
use creusot.prelude.Any
use int.Int

type t_Option_i64 = None | Some Int64.t

let elim_Some (_x: t_Option_i64) (return (f0: Int64.t)) = any
  [ _k (f0: Int64.t) -> {Some f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
      | _ -> false
      end}
    any) ]

type t_RestoreContentExclusions = { key: bool; header: bool }

type t_RestoreExclusions = { producer: bool; offset: bool; content: t_RestoreContentExclusions }

predicate restore_excluded [#"/workspace/crates/verified/src/restore.rs" 48 0 48 62] (exclusions: t_RestoreExclusions) =
  [%#srestore'4] exclusions.producer \/ exclusions.offset \/ exclusions.content.key \/ exclusions.content.header

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let restore_record_selected [#"/workspace/crates/verified/src/restore.rs" 66 0 72 9] (offset'0: Int64.t)
  (offset_bound: t_Option_i64) (timestamp: Int64.t) (timestamp_bound: t_Option_i64) (exclusions: t_RestoreExclusions)
  (return (x: bool)) = (! bb0
  [ bb0 = any [ br0 -> {offset_bound = None} (! bb3) | br1 (x0: Int64.t) -> {offset_bound = Some x0} (! bb4) ]
  | bb4 = s0
    [ s0 = elim_Some {offset_bound} (fun (r0: Int64.t) -> [ &bound <- r0 ] s1)
    | s1 = [ &_12 <- Int64.le offset'0 bound ] s2
    | s2 = bb5 ]
  | bb3 = s0 [ s0 = [ &_12 <- [%#srestore] true ] s1 | s1 = bb5 ]
  | bb5 = any [ br0 -> {_12 = false} (! bb13) | br1 -> {_12} (! bb6) ]
  | bb6 = any [ br0 -> {timestamp_bound = None} (! bb9) | br1 (x0: Int64.t) -> {timestamp_bound = Some x0} (! bb10) ]
  | bb10 = s0
    [ s0 = elim_Some {timestamp_bound} (fun (r0: Int64.t) -> [ &bound'0 <- r0 ] s1)
    | s1 = [ &_17 <- Int64.lt timestamp bound'0 ] s2
    | s2 = bb11 ]
  | bb9 = s0 [ s0 = [ &_17 <- [%#srestore'0] true ] s1 | s1 = bb11 ]
  | bb11 = any [ br0 -> {_17 = false} (! bb13) | br1 -> {_17} (! bb12) ]
  | bb12 = any [ br0 -> {exclusions.producer = false} (! bb14) | br1 -> {exclusions.producer} (! bb16) ]
  | bb14 = any [ br0 -> {exclusions.offset = false} (! bb15) | br1 -> {exclusions.offset} (! bb16) ]
  | bb15 = any [ br0 -> {exclusions.content.key = false} (! bb17) | br1 -> {exclusions.content.key} (! bb16) ]
  | bb16 = s0 [ s0 = [ &_22 <- [%#srestore'1] true ] s1 | s1 = bb18 ]
  | bb17 = s0 [ s0 = [ &_22 <- exclusions.content.header ] s1 | s1 = bb18 ]
  | bb18 = s0 [ s0 = [ &_ret <- not _22 ] s1 | s1 = return {_ret} ]
  | bb13 = s0 [ s0 = [ &_ret <- [%#srestore'2] false ] s1 | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l ()
  | & offset'0: Int64.t = offset'0
  | & offset_bound: t_Option_i64 = offset_bound
  | & timestamp: Int64.t = timestamp
  | & timestamp_bound: t_Option_i64 = timestamp_bound
  | & exclusions: t_RestoreExclusions = exclusions
  | & _12: bool = Any.any_l ()
  | & bound: Int64.t = Any.any_l ()
  | & _17: bool = Any.any_l ()
  | & bound'0: Int64.t = Any.any_l ()
  | & _22: bool = Any.any_l () ])
  [ return (result: bool) -> {[@stop_split] [@expl:restore_record_selected ensures] [%#srestore'3] result
    = (match offset_bound with
        | Some bound -> Int64.to_int offset'0 <= Int64.to_int bound
        | None -> true
        end
    /\ match timestamp_bound with
        | Some bound -> Int64.to_int timestamp < Int64.to_int bound
        | None -> true
        end
    /\ not restore_excluded exclusions)}
    (! return {result}) ]
