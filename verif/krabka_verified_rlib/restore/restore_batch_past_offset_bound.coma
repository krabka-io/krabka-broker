let restore_batch_past_offset_bound [#"/proof-work-244/crates/verified/src/restore.rs" 80 0 84 9] (batch_base: Int64.t)
  (offset_bound_applies: bool) (offset_bound: Int64.t) (return (x: bool)) = (! bb0
  [ bb0 = any [ br0 -> {offset_bound_applies = false} (! bb2) | br1 -> {offset_bound_applies} (! bb1) ]
  | bb1 = s0 [ s0 = [ &_ret <- Int64.gt batch_base offset_bound ] s1 | s1 = return {_ret} ]
  | bb2 = s0 [ s0 = [ &_ret <- [%#srestore] false ] s1 | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l ()
  | & batch_base: Int64.t = batch_base
  | & offset_bound_applies: bool = offset_bound_applies
  | & offset_bound: Int64.t = offset_bound ])
  [ return (result: bool) -> {[@stop_split] [@expl:restore_batch_past_offset_bound ensures] [%#srestore'0] result
    = (offset_bound_applies /\ gt_log_Int (Int64.to_int batch_base) (Int64.to_int offset_bound))}
    (! return {result}) ]
