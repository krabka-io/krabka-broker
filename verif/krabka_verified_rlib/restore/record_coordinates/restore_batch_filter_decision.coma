(* #"/workspace/crates/verified/src/restore/record_coordinates.rs" 57 0 57 93 *)

let%span srecord_coordinates = "/workspace/crates/verified/src/restore/record_coordinates.rs" 51 10 55 1

use creusot.prelude.Any

type t_RestoreFilterDecision = Keep | Empty | Filter

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let restore_batch_filter_decision [#"/workspace/crates/verified/src/restore/record_coordinates.rs" 57 0 57 93]
  (saw_keep: bool) (saw_drop: bool) (return (x: t_RestoreFilterDecision)) = (! bb0
  [ bb0 = any [ br0 -> {saw_keep = false} (! bb3) | br1 -> {saw_keep} (! bb1) ]
  | bb1 = any [ br0 -> {saw_drop = false} (! bb3) | br1 -> {saw_drop} (! bb2) ]
  | bb2 = s0 [ s0 = [ &_ret <- Filter ] s1 | s1 = return {_ret} ]
  | bb3 = any [ br0 -> {saw_drop = false} (! bb5) | br1 -> {saw_drop} (! bb4) ]
  | bb4 = s0 [ s0 = [ &_ret <- Empty ] s1 | s1 = return {_ret} ]
  | bb5 = s0 [ s0 = [ &_ret <- Keep ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_RestoreFilterDecision = Any.any_l () | & saw_keep: bool = saw_keep | & saw_drop: bool = saw_drop ])
  [ return (result: t_RestoreFilterDecision) ->
  {[@stop_split] [@expl:restore_batch_filter_decision ensures] [%#srecord_coordinates] match result with
      | Keep -> not saw_drop
      | Empty -> saw_drop /\ not saw_keep
      | Filter -> saw_keep /\ saw_drop
      end}
    (! return {result}) ]
