  | bb9 = s0 [ s0 = [ &_ret <- FencedLeaderEpoch'0 ] s1 | s1 = return {_ret} ]
  | bb10 = any [ br0 -> {exact_retry = false} (! bb12) | br1 -> {exact_retry} (! bb11) ]
  | bb11 = s0 [ s0 = [ &_ret <- ExactRetry'0 ] s1 | s1 = return {_ret} ]
  | bb12 = s0
    [ s0 = checked_add [%#sshare'0] {state_epoch} {[%#sshare] (1: Int32.t)}
        (fun (_x: t_Option_i32) -> [ &_24 <- _x ] s1)
    | s1 = any [ br0 -> {_24 = None} (! bb16) | br1 (x0: Int32.t) -> {_24 = Some x0} (! bb17) ] ]
  | bb17 = s0
    [ s0 = elim_Some {_24} (fun (r0: Int32.t) -> [ &next_state_epoch <- r0 ] s1)
    | s1 = [ &_ret <- Apply'0 next_state_epoch ] s2
    | s2 = return {_ret} ]
  | bb16 = s0 [ s0 = [ &_ret <- StateEpochOverflow'0 ] s1 | s1 = return {_ret} ]
  | bb6 = s0 [ s0 = [ &_ret <- Unrequested'0 ] s1 | s1 = return {_ret} ]
  | bb7 = s0 [ s0 = [ &_ret <- NonEmptyGroup'0 ] s1 | s1 = return {_ret} ]
  | bb8 = s0 [ s0 = [ &_ret <- NotCoordinator'0 ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_ShareOffsetMutationDecision = Any.any_l ()
  | & gate: t_ShareOffsetMutationGate = gate
  | & observed_leader_epoch: Int32.t = observed_leader_epoch
  | & current_leader_epoch: Int32.t = current_leader_epoch
  | & state_epoch: Int32.t = state_epoch
  | & exact_retry: bool = Any.any_l ()
  | & exact_retry'0: bool = Any.any_l ()
  | & _17: bool = Any.any_l ()
  | & _24: t_Option_i32 = Any.any_l ()
  | & next_state_epoch: Int32.t = Any.any_l () ])
  [ return (result: t_ShareOffsetMutationDecision) ->
  {[@stop_split] [@expl:share_offset_mutation_decision ensures] [%#sshare'1] match result with
      | Apply'0 next_state_epoch -> gate = Admissible false
      /\ Int32.to_int observed_leader_epoch = Int32.to_int current_leader_epoch
      /\ Int32.to_int state_epoch < Int32.to_int const_MAX
      /\ Int32.to_int next_state_epoch = Int32.to_int state_epoch + 1
      | NotCoordinator'0 -> gate = NotCoordinator
      | NonEmptyGroup'0 -> gate = NonEmptyGroup
      | Unrequested'0 -> gate = Unrequested
      | FencedLeaderEpoch'0 -> (exists retry: bool. gate = Admissible retry)
      /\ Int32.to_int observed_leader_epoch <> Int32.to_int current_leader_epoch
      | StateEpochOverflow'0 -> gate = Admissible false
      /\ Int32.to_int observed_leader_epoch = Int32.to_int current_leader_epoch
      /\ Int32.to_int state_epoch = Int32.to_int const_MAX
      | ExactRetry'0 -> gate = Admissible true /\ Int32.to_int observed_leader_epoch = Int32.to_int current_leader_epoch
