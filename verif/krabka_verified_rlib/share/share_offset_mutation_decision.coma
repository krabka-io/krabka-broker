use creusot.int.Int32
use creusot.prelude.Any
use int.Int

type t_ShareOffsetMutationGate = NotCoordinator | NonEmptyGroup | Unrequested | Admissible bool

let elim_Admissible (_x: t_ShareOffsetMutationGate) (return (exact_retry: bool)) = any
  [ _k (exact_retry: bool) -> {Admissible exact_retry = _x} (! return {exact_retry})
  | _chk -> (! {[@expl:elim Admissible] match _x with
      | Admissible _ -> true
      | _ -> false
      end}
    any) ]

type t_ShareOffsetMutationDecision =
  | NotCoordinator'0
  | NonEmptyGroup'0
  | Unrequested'0
  | FencedLeaderEpoch'0
  | StateEpochOverflow'0
  | ExactRetry'0
  | Apply'0 Int32.t

type t_Option_i32 = None | Some Int32.t

constant const_MIN: Int32.t = (-2147483648: Int32.t)

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

constant const_MAX: Int32.t = (2147483647: Int32.t)

let checked_add (self_: Int32.t) (rhs: Int32.t) (return (x: t_Option_i32)) = any
  [ return (result: t_Option_i32) ->
  {[@stop_split] [@expl:checked_add ensures] ([@stop_split] [@expl:checked_add ensures #0] [%#snum] (result = None)
      = (Int32.to_int self_ + Int32.to_int rhs < Int32.to_int const_MIN
      \/ gt_log_Int (Int32.to_int self_ + Int32.to_int rhs) (Int32.to_int const_MAX)))
    /\ ([@stop_split] [@expl:checked_add ensures #1] [%#snum'0] forall r: Int32.t. result = Some r
      -> Int32.to_int r = Int32.to_int self_ + Int32.to_int rhs)}
    (! return {result}) ]

let elim_Some (_x: t_Option_i32) (return (f0: Int32.t)) = any
  [ _k (f0: Int32.t) -> {Some f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
      | _ -> false
      end}
    any) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let share_offset_mutation_decision [#"/workspace/crates/verified/src/share.rs" 67 0 72 32]
  (gate: t_ShareOffsetMutationGate) (observed_leader_epoch: Int32.t) (current_leader_epoch: Int32.t)
