type tup2_i64_i32 = { f0: Int64.t; f1: Int32.t }

let len_tup2_i64_i32 (self_: Slice64.slice tup2_i64_i32) (return (x: UInt64.t)) = any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] [%#sslice] Seq.length (Slice64.view self_)
    = UInt64.t'int result}
    (! return {result}) ]

type t_Option_usize = None | Some UInt64.t

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other <= self

meta "rewrite_def" predicate ge_log_Int

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

let checkpoint_id_newer (candidate_end: Int64.t) (candidate_epoch: Int32.t) (current_end: Int64.t)
  (current_epoch: Int32.t) (return (x: bool)) = any
  [ return (result: bool) -> {[@stop_split] [@expl:checkpoint_id_newer ensures] [%#scheckpoint'19] result
    = (gt_log_Int (Int64.to_int candidate_end) (Int64.to_int current_end)
    \/ Int64.to_int candidate_end = Int64.to_int current_end
    /\ gt_log_Int (Int32.to_int candidate_epoch) (Int32.to_int current_epoch))}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

