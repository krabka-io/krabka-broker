(* #"/workspace/crates/verified/src/stretch.rs" 56 0 56 53 *)

let%span sstretch = "/workspace/crates/verified/src/stretch.rs" 54 11 54 41
let%span sstretch'0 = "/workspace/crates/verified/src/stretch.rs" 55 10 55 74
let%span sstretch'1 = "/workspace/crates/verified/src/stretch.rs" 29 10 29 15
let%span sstretch'2 = "/workspace/crates/verified/src/stretch.rs" 32 8 36 9

use creusot.int.Int64
use seq.Seq
use int.Int

function sum_prefix [#"/workspace/crates/verified/src/stretch.rs" 30 0 30 49] (s: Seq.seq Int64.t) (limit: int) : int

axiom sum_prefix_def: forall s: Seq.seq Int64.t, limit: int [sum_prefix s limit]. sum_prefix s limit
    = ([%#sstretch'2] if limit <= 0 then 0 else sum_prefix s (limit - 1) + Int64.to_int (Seq.get s (limit - 1)))

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant s : Seq.seq Int64.t

constant limit : int

function lemma_sum_prefix_step [#"/workspace/crates/verified/src/stretch.rs" 56 0 56 53] (s: Seq.seq Int64.t) (limit: int) : ()

goal vc_lemma_sum_prefix_step: ([%#sstretch] 1 <= limit /\ limit <= Seq.length s)
  -> ([@stop_split] [@expl:lemma_sum_prefix_step ensures] [%#sstretch'0] sum_prefix s limit
  = sum_prefix s (limit - 1) + Int64.to_int (Seq.get s (limit - 1)))
