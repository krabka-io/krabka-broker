use int.Int

function sum_prefix [#"/workspace/crates/verified/src/stretch.rs" 30 0 30 49] (s: Seq.seq Int64.t) (limit: int) : int

axiom sum_prefix_def: forall s: Seq.seq Int64.t, limit: int [sum_prefix s limit]. sum_prefix s limit
    = ([%#sstretch'7] if limit <= 0 then 0 else sum_prefix s (limit - 1) + Int64.to_int (Seq.get s (limit - 1)))

function sum_all [#"/workspace/crates/verified/src/stretch.rs" 45 0 45 34] (s: Seq.seq Int64.t) : int =
  [%#sstretch'8] sum_prefix s (Seq.length s)

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let lemma_two_sites_never_survive [#"/workspace/crates/verified/src/stretch.rs" 89 0 89 61]
  (voters_per_site: Slice64.slice Int64.t) (return (x: ())) =
{[@stop_split] [@expl:lemma_two_sites_never_survive requires] ([@stop_split] [@expl:lemma_two_sites_never_survive requires #0] [%#sstretch'3] Seq.length (Slice64.view voters_per_site)
    = 2)
  /\ ([@stop_split] [@expl:lemma_two_sites_never_survive requires #1] [%#sstretch'4] forall k: int. 0 <= k /\ k < 2
    -> ge_log_Int (Int64.to_int (Seq.get (Slice64.view voters_per_site) k)) 0)}
  (! bb0
  [ bb0 = s0
    [ s0 = {[@expl:assertion] [%#sstretch] sum_prefix (Slice64.view voters_per_site) 1
      = Int64.to_int (Seq.get (Slice64.view voters_per_site) 0)}
      s1
    | s1 = {[@expl:assertion] [%#sstretch'0] sum_all (Slice64.view voters_per_site)
      = Int64.to_int (Seq.get (Slice64.view voters_per_site) 0)
      + Int64.to_int (Seq.get (Slice64.view voters_per_site) 1)}
      s2
    | s2 =
      {[@expl:assertion] [%#sstretch'1] ge_log_Int (Int64.to_int (Seq.get (Slice64.view voters_per_site) 0)) (Int64.to_int (Seq.get (Slice64.view voters_per_site) 1))
      -> 2 * (sum_all (Slice64.view voters_per_site) - Int64.to_int (Seq.get (Slice64.view voters_per_site) 0))
      <= sum_all (Slice64.view voters_per_site)}
      s3
    | s3 =
      {[@expl:assertion] [%#sstretch'2] ge_log_Int (Int64.to_int (Seq.get (Slice64.view voters_per_site) 1)) (Int64.to_int (Seq.get (Slice64.view voters_per_site) 0))
      -> 2 * (sum_all (Slice64.view voters_per_site) - Int64.to_int (Seq.get (Slice64.view voters_per_site) 1))
      <= sum_all (Slice64.view voters_per_site)}
      s4
    | s4 = return {_ret} ] ] [ & _ret: () = Any.any_l () | & voters_per_site: Slice64.slice Int64.t = voters_per_site ])
  [ return (result: ()) -> {[@stop_split] [@expl:lemma_two_sites_never_survive ensures] [%#sstretch'5] exists k: int. 0
        <= k
      /\ k < Seq.length (Slice64.view voters_per_site)
      /\ 2 * (sum_all (Slice64.view voters_per_site) - Int64.to_int (Seq.get (Slice64.view voters_per_site) k))
      <= sum_all (Slice64.view voters_per_site)}
    (! return {result}) ]
