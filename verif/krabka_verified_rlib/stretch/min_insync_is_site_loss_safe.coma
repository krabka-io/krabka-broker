use creusot.int.Int64
use int.ComputerDivision
use creusot.prelude.Any
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

let site_loss_survivors (rf: Int64.t) (sites: Int64.t) (return (x: Int64.t)) =
{[@stop_split] [@expl:site_loss_survivors requires] ([@stop_split] [@expl:site_loss_survivors requires #0] [%#sstretch'5] ge_log_Int (Int64.to_int rf) 1
    /\ Int64.to_int rf <= 1024)
  /\ ([@stop_split] [@expl:site_loss_survivors requires #1] [%#sstretch'6] ge_log_Int (Int64.to_int sites) 1
  /\ Int64.to_int sites <= 1024)}
  any
  [ return (result: Int64.t) ->
  {[@stop_split] [@expl:site_loss_survivors ensures] ([@stop_split] [@expl:site_loss_survivors ensures #0] [%#sstretch'7] Int64.to_int result
      = Int64.to_int rf - ComputerDivision.div (Int64.to_int rf + Int64.to_int sites - 1) (Int64.to_int sites))
    /\ ([@stop_split] [@expl:site_loss_survivors ensures #1] [%#sstretch'8] ge_log_Int (Int64.to_int result) 0)
    /\ ([@stop_split] [@expl:site_loss_survivors ensures #2] [%#sstretch'9] Int64.to_int result < Int64.to_int rf)
    /\ ([@stop_split] [@expl:site_loss_survivors ensures #3] [%#sstretch'10] Int64.to_int sites = 1
    -> Int64.to_int result = 0)}
    (! return {result}) ]

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let min_insync_is_site_loss_safe [#"/home/user/krabka-broker/crates/verified/src/stretch.rs" 141 0 141 81] (rf: Int64.t)
  (sites: Int64.t) (min_insync: Int64.t) (return (x: bool)) =
{[@stop_split] [@expl:min_insync_is_site_loss_safe requires] ([@stop_split] [@expl:min_insync_is_site_loss_safe requires #0] [%#sstretch'2] ge_log_Int (Int64.to_int rf) 1
    /\ Int64.to_int rf <= 1024)
  /\ ([@stop_split] [@expl:min_insync_is_site_loss_safe requires #1] [%#sstretch'3] ge_log_Int (Int64.to_int sites) 1
  /\ Int64.to_int sites <= 1024)}
  (! bb0
  [ bb0 = s0
    [ s0 = site_loss_survivors [%#sstretch] {rf} {sites} (fun (_x: Int64.t) -> [ &survivors <- _x ] s1)
    | s1 = Int64.sub [%#sstretch'0] {rf} {survivors} (fun (_x: Int64.t) -> [ &largest_site <- _x ] s2)
    | s2 = [ &_18 <- Int64.gt min_insync largest_site ] s3
    | s3 = any [ br0 -> {_18 = false} (! bb3) | br1 -> {_18} (! bb2) ] ]
  | bb2 = s0 [ s0 = [ &_ret <- Int64.le min_insync survivors ] s1 | s1 = return {_ret} ]
  | bb3 = s0 [ s0 = [ &_ret <- [%#sstretch'1] false ] s1 | s1 = return {_ret} ] ]
  [ & _ret: bool = Any.any_l ()
  | & rf: Int64.t = rf
  | & sites: Int64.t = sites
  | & min_insync: Int64.t = min_insync
  | & survivors: Int64.t = Any.any_l ()
  | & largest_site: Int64.t = Any.any_l ()
  | & _18: bool = Any.any_l () ])
  [ return (result: bool) -> {[@stop_split] [@expl:min_insync_is_site_loss_safe ensures] [%#sstretch'4] result
    = (gt_log_Int (Int64.to_int min_insync) (ComputerDivision.div (Int64.to_int rf + Int64.to_int sites
      - 1) (Int64.to_int sites))
    /\ Int64.to_int min_insync
    <= Int64.to_int rf - ComputerDivision.div (Int64.to_int rf + Int64.to_int sites - 1) (Int64.to_int sites))}
    (! return {result}) ]
