use int.ComputerDivision
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

function lemma_div_exact [#"/workspace/crates/verified/src/stretch.rs" 143 0 143 67] (divisor: int) (quotient: int) (remainder: int) : ()
 = [%#sstretch'3] ()

axiom lemma_div_exact_spec: forall divisor: int, quotient: int, remainder: int. ([%#sstretch'1] ge_log_Int divisor 1
      /\ ge_log_Int quotient 0 /\ 0 <= remainder /\ remainder < divisor)
    -> ([%#sstretch'2] ComputerDivision.div (divisor * quotient + remainder) divisor = quotient)

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant rf : int

constant sites : int

constant site : int

function lemma_round_robin_step [#"/workspace/crates/verified/src/stretch.rs" 159 0 159 61] (rf: int) (sites: int) (site: int) : ()

goal vc_lemma_round_robin_step: ([%#sstretch] ge_log_Int rf 1 /\ ge_log_Int sites 1 /\ 0 <= site /\ site < sites)
  -> (let q = ComputerDivision.div (rf - 1) sites in let r = ComputerDivision.mod (rf - 1) sites in if rf - 1
  = sites * q + r then
    if 0 <= r then
      if r < sites then
        ge_log_Int q 0
        && (if r = site then
          rf - site + sites - 1 = sites * (q + 1) + 0
          && rf - 1 - site + sites - 1 = sites * q + (sites - 1)
          && ([@stop_split] [@expl:lemma_div_exact requires] [%#sstretch'1] ge_log_Int sites 1
            /\ ge_log_Int (q + 1) 0 /\ 0 <= 0 /\ 0 < sites)
          /\ (([@stop_split] [@expl:lemma_div_exact ensures] [%#sstretch'2] ComputerDivision.div (sites * (q + 1)
              + 0) sites
            = q + 1)
          -> (let _ = lemma_div_exact sites (q
          + 1) 0 in ([@stop_split] [@expl:lemma_div_exact requires] [%#sstretch'1] ge_log_Int sites 1
            /\ ge_log_Int q 0 /\ 0 <= sites - 1 /\ sites - 1 < sites)
          /\ (([@stop_split] [@expl:lemma_div_exact ensures] [%#sstretch'2] ComputerDivision.div (sites * q
              + (sites - 1)) sites
            = q)
          -> (let _ = lemma_div_exact sites q (sites
          - 1) in [@stop_split] [@expl:lemma_round_robin_step ensures] [%#sstretch'0] ComputerDivision.div (rf - site
              + sites
            - 1) sites
          = ComputerDivision.div (rf - 1 - site + sites - 1) sites
          + (if ComputerDivision.mod (rf - 1) sites = site then 1 else 0)))))
