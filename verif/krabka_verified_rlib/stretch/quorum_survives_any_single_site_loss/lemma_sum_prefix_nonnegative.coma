use creusot.int.Int64
use seq.Seq
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

function sum_prefix [#"/workspace/crates/verified/src/stretch/quorum_survives_any_single_site_loss.rs" 9 0 9 49] (s: Seq.seq Int64.t) (limit: int) : int

axiom sum_prefix_def: forall s: Seq.seq Int64.t, limit: int [sum_prefix s limit]. sum_prefix s limit
    = ([%#squorum_survives_any_single_site_loss'6] if limit <= 0 then
      0
    else
      sum_prefix s (limit - 1) + Int64.to_int (Seq.get s (limit - 1))
    )

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  [%#swell_founded] ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

function lemma_sum_prefix_step [#"/workspace/crates/verified/src/stretch/quorum_survives_any_single_site_loss.rs" 35 0 35 53] (s: Seq.seq Int64.t) (limit: int) : ()
 = [%#squorum_survives_any_single_site_loss'7] ()

axiom lemma_sum_prefix_step_spec: forall s: Seq.seq Int64.t, limit: int. ([%#squorum_survives_any_single_site_loss'3] 1
        <= limit
      /\ limit <= Seq.length s)
    -> ([%#squorum_survives_any_single_site_loss'4] sum_prefix s limit
    = sum_prefix s (limit - 1) + Int64.to_int (Seq.get s (limit - 1)))

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant s : Seq.seq Int64.t

constant limit : int

function lemma_sum_prefix_nonnegative [#"/workspace/crates/verified/src/stretch/quorum_survives_any_single_site_loss.rs" 46 0 46 60] (s: Seq.seq Int64.t) (limit: int) : ()

goal vc_lemma_sum_prefix_nonnegative: ([%#squorum_survives_any_single_site_loss'0] 0 <= limit /\ limit <= Seq.length s)
  -> ([%#squorum_survives_any_single_site_loss'1] forall k: int. 0 <= k /\ k < limit
      -> ge_log_Int (Int64.to_int (Seq.get s k)) 0)
  -> (if gt_log_Int limit 0 then
    (([@stop_split] [@expl:lemma_sum_prefix_nonnegative requires] ([@stop_split] [@expl:lemma_sum_prefix_nonnegative requires #0] [%#squorum_survives_any_single_site_loss'0] 0
            <= limit - 1
          /\ limit - 1 <= Seq.length s)
        /\ ([@stop_split] [@expl:lemma_sum_prefix_nonnegative requires #1] [%#squorum_survives_any_single_site_loss'1] forall k: int. 0
              <= k
            /\ k < limit - 1 -> ge_log_Int (Int64.to_int (Seq.get s k)) 0))
      /\ ([@expl:variant decreases] well_founded_relation_Int ([%#squorum_survives_any_single_site_loss] limit) ([%#squorum_survives_any_single_site_loss] limit
      - 1)))
    /\ (([@stop_split] [@expl:lemma_sum_prefix_nonnegative ensures] [%#squorum_survives_any_single_site_loss'2] ge_log_Int (sum_prefix s (limit
      - 1)) 0)
    -> (let _ = lemma_sum_prefix_nonnegative s (limit
    - 1) in ([@stop_split] [@expl:lemma_sum_prefix_step requires] [%#squorum_survives_any_single_site_loss'3] 1 <= limit
      /\ limit <= Seq.length s)
    /\ (([@stop_split] [@expl:lemma_sum_prefix_step ensures] [%#squorum_survives_any_single_site_loss'4] sum_prefix s limit
      = sum_prefix s (limit - 1) + Int64.to_int (Seq.get s (limit - 1)))
    -> (let _ = lemma_sum_prefix_step s limit in [@stop_split] [@expl:lemma_sum_prefix_nonnegative ensures] [%#squorum_survives_any_single_site_loss'2] ge_log_Int (sum_prefix s limit) 0))))
  else
    [@stop_split] [@expl:lemma_sum_prefix_nonnegative ensures] [%#squorum_survives_any_single_site_loss'2] ge_log_Int (sum_prefix s limit) 0
