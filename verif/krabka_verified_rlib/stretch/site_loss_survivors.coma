predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

function lemma_div_monotone [#"/workspace/crates/verified/src/stretch.rs" 126 0 126 60] (low: int) (high: int) (divisor: int) : ()
 = [%#sstretch'18] ()

axiom lemma_div_monotone_spec: forall low: int, high: int, divisor: int. ([%#sstretch'16] 0 <= low
      /\ low <= high /\ ge_log_Int divisor 1)
    -> ([%#sstretch'17] ComputerDivision.div low divisor <= ComputerDivision.div high divisor)

function lemma_div_exact [#"/workspace/crates/verified/src/stretch.rs" 143 0 143 67] (divisor: int) (quotient: int) (remainder: int) : ()
 = [%#sstretch'21] ()

axiom lemma_div_exact_spec: forall divisor: int, quotient: int, remainder: int. ([%#sstretch'19] ge_log_Int divisor 1
      /\ ge_log_Int quotient 0 /\ 0 <= remainder /\ remainder < divisor)
    -> ([%#sstretch'20] ComputerDivision.div (divisor * quotient + remainder) divisor = quotient)

function round_robin_load [#"/workspace/crates/verified/src/stretch.rs" 107 0 107 62] (rf: int) (sites: int) (site: int) : int

axiom round_robin_load_def:
  forall rf: int, sites: int, site: int [round_robin_load rf sites site]. round_robin_load rf sites site
    = ([%#sstretch'27] if rf <= 0 then
      0
    else
      round_robin_load (rf - 1) sites site + (if ComputerDivision.mod (rf - 1) sites = site then 1 else 0)
    )

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

function lemma_round_robin_step [#"/workspace/crates/verified/src/stretch.rs" 159 0 159 61] (rf: int) (sites: int) (site: int) : ()
 = [%#sstretch'33] let q = ComputerDivision.div (rf - 1) sites in let r = ComputerDivision.mod (rf - 1) sites in if r
  = site then
    let _ = lemma_div_exact sites (q + 1) 0 in let _ = lemma_div_exact sites q (sites - 1) in ()
  else
    if gt_log_Int r site then
      let _ = lemma_div_exact sites (q + 1) (r - site) in let _ = lemma_div_exact sites (q + 1) (r - site - 1) in ()
    else
      let _ = lemma_div_exact sites q (sites + r - site) in let _ = lemma_div_exact sites q (sites + r - site - 1) in ()
  


axiom lemma_round_robin_step_spec: forall rf: int, sites: int, site: int. ([%#sstretch'31] ge_log_Int rf 1
      /\ ge_log_Int sites 1 /\ 0 <= site /\ site < sites)
    -> ([%#sstretch'32] ComputerDivision.div (rf - site + sites - 1) sites
    = ComputerDivision.div (rf - 1 - site + sites - 1) sites
    + (if ComputerDivision.mod (rf - 1) sites = site then 1 else 0))

function lemma_round_robin_load [#"/workspace/crates/verified/src/stretch.rs" 193 0 193 61] (rf: int) (sites: int) (site: int) : ()

axiom lemma_round_robin_load_def:
  forall rf: int, sites: int, site: int [lemma_round_robin_load rf sites site]. ([%#sstretch'23] ge_log_Int rf 0
      /\ ge_log_Int sites 1 /\ 0 <= site /\ site < sites)
    -> lemma_round_robin_load rf sites site
    = ([%#sstretch'25] if gt_log_Int rf 0 then
      let _ = lemma_round_robin_load (rf - 1) sites site in let _ = lemma_round_robin_step rf sites site in ()
    else
      ()
    )

axiom lemma_round_robin_load_spec: forall rf: int, sites: int, site: int. ([%#sstretch'23] ge_log_Int rf 0
      /\ ge_log_Int sites 1 /\ 0 <= site /\ site < sites)
    -> ([%#sstretch'24] round_robin_load rf sites site = ComputerDivision.div (rf - site + sites - 1) sites)

function lemma_site_load_at_most_first [#"/workspace/crates/verified/src/stretch.rs" 208 0 208 68] (rf: int) (sites: int) (site: int) : ()
 =
  [%#sstretch'30] let _ = lemma_round_robin_load rf sites site in let _ = lemma_round_robin_load rf sites 0 in let _ = lemma_div_monotone (rf
      - site
    + sites
  - 1) (rf + sites - 1) sites in ()

axiom lemma_site_load_at_most_first_spec: forall rf: int, sites: int, site: int. ([%#sstretch'28] ge_log_Int rf 0
      /\ ge_log_Int sites 1 /\ 0 <= site /\ site < sites)
    -> ([%#sstretch'29] round_robin_load rf sites site <= round_robin_load rf sites 0)

