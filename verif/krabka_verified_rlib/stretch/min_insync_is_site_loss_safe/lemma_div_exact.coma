function lemma_div_exact [#"/workspace/crates/verified/src/stretch/min_insync_is_site_loss_safe.rs" 64 0 64 67] (divisor: int) (quotient: int) (remainder: int) : ()

goal vc_lemma_div_exact: ([%#smin_insync_is_site_loss_safe] ge_log_Int divisor 1
    /\ ge_log_Int quotient 0 /\ 0 <= remainder /\ remainder < divisor)
  -> ComputerDivision.div (divisor * quotient + remainder) divisor = quotient + ComputerDivision.div remainder divisor
