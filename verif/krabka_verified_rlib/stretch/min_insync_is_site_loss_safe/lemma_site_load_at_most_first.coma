use int.ComputerDivision
use int.Int

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord] other <= self

meta "rewrite_def" predicate ge_log_Int

function round_robin_load [#"/workspace/crates/verified/src/stretch/min_insync_is_site_loss_safe.rs" 28 0 28 62] (rf: int) (sites: int) (site: int) : int

axiom round_robin_load_def:
  forall rf: int, sites: int, site: int [round_robin_load rf sites site]. round_robin_load rf sites site
    = ([%#smin_insync_is_site_loss_safe'6] if rf <= 0 then
      0
    else
      round_robin_load (rf - 1) sites site + (if ComputerDivision.mod (rf - 1) sites = site then 1 else 0)
    )

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = [%#sord'0] other < self

meta "rewrite_def" predicate gt_log_Int

function lemma_div_exact [#"/workspace/crates/verified/src/stretch/min_insync_is_site_loss_safe.rs" 64 0 64 67] (divisor: int) (quotient: int) (remainder: int) : ()
 = [%#smin_insync_is_site_loss_safe'15] ()

axiom lemma_div_exact_spec:
  forall divisor: int, quotient: int, remainder: int. ([%#smin_insync_is_site_loss_safe'13] ge_log_Int divisor 1
      /\ ge_log_Int quotient 0 /\ 0 <= remainder /\ remainder < divisor)
    -> ([%#smin_insync_is_site_loss_safe'14] ComputerDivision.div (divisor * quotient + remainder) divisor = quotient)

function lemma_round_robin_step [#"/workspace/crates/verified/src/stretch/min_insync_is_site_loss_safe.rs" 15 8 15 55] (rf: int) (sites: int) (site: int) : ()
 = [%#smin_insync_is_site_loss_safe'12] let q = ComputerDivision.div (rf - 1) sites in let r = ComputerDivision.mod (rf
  - 1) sites in if r = site then
    let _ = lemma_div_exact sites (q + 1) 0 in let _ = lemma_div_exact sites q (sites - 1) in ()
  else
    if gt_log_Int r site then
      let _ = lemma_div_exact sites (q + 1) (r - site) in let _ = lemma_div_exact sites (q + 1) (r - site - 1) in ()
    else
      let _ = lemma_div_exact sites q (sites + r - site) in let _ = lemma_div_exact sites q (sites + r - site - 1) in ()



axiom lemma_round_robin_step_spec:
  forall rf: int, sites: int, site: int. ([%#smin_insync_is_site_loss_safe'10] ge_log_Int rf 1
      /\ ge_log_Int sites 1 /\ 0 <= site /\ site < sites)
    -> ([%#smin_insync_is_site_loss_safe'11] ComputerDivision.div (rf - site + sites - 1) sites
    = ComputerDivision.div (rf - 1 - site + sites - 1) sites
    + (if ComputerDivision.mod (rf - 1) sites = site then 1 else 0))

function lemma_round_robin_load [#"/workspace/crates/verified/src/stretch/min_insync_is_site_loss_safe.rs" 15 8 15 55] (rf: int) (sites: int) (site: int) : ()

axiom lemma_round_robin_load_def:
  forall rf: int, sites: int, site: int [lemma_round_robin_load rf sites site]. ([%#smin_insync_is_site_loss_safe'1] ge_log_Int rf 0
      /\ ge_log_Int sites 1 /\ 0 <= site /\ site < sites)
    -> lemma_round_robin_load rf sites site
    = ([%#smin_insync_is_site_loss_safe'8] if gt_log_Int rf 0 then
      let _ = lemma_round_robin_load (rf - 1) sites site in let _ = lemma_round_robin_step rf sites site in ()
    else
      ()
    )

axiom lemma_round_robin_load_spec:
  forall rf: int, sites: int, site: int. ([%#smin_insync_is_site_loss_safe'1] ge_log_Int rf 0
      /\ ge_log_Int sites 1 /\ 0 <= site /\ site < sites)
    -> ([%#smin_insync_is_site_loss_safe'2] round_robin_load rf sites site
    = ComputerDivision.div (rf - site + sites - 1) sites)

function lemma_div_monotone [#"/workspace/crates/verified/src/stretch/min_insync_is_site_loss_safe.rs" 47 0 47 60] (low: int) (high: int) (divisor: int) : ()
 = [%#smin_insync_is_site_loss_safe'9] ()

axiom lemma_div_monotone_spec: forall low: int, high: int, divisor: int. ([%#smin_insync_is_site_loss_safe'3] 0 <= low
      /\ low <= high /\ ge_log_Int divisor 1)
    -> ([%#smin_insync_is_site_loss_safe'4] ComputerDivision.div low divisor <= ComputerDivision.div high divisor)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant rf : int

constant sites : int

constant site : int

function lemma_site_load_at_most_first [#"/workspace/crates/verified/src/stretch/min_insync_is_site_loss_safe.rs" 15 8 15 55] (rf: int) (sites: int) (site: int) : ()

goal vc_lemma_site_load_at_most_first: ([%#smin_insync_is_site_loss_safe] ge_log_Int rf 0
    /\ ge_log_Int sites 1 /\ 0 <= site /\ site < sites)
  -> ([@stop_split] [@expl:lemma_round_robin_load requires] [%#smin_insync_is_site_loss_safe'1] ge_log_Int rf 0
    /\ ge_log_Int sites 1 /\ 0 <= site /\ site < sites)
  /\ (([@stop_split] [@expl:lemma_round_robin_load ensures] [%#smin_insync_is_site_loss_safe'2] round_robin_load rf sites site
    = ComputerDivision.div (rf - site + sites - 1) sites)
  -> (let _ = lemma_round_robin_load rf sites site in ([@stop_split] [@expl:lemma_round_robin_load requires] [%#smin_insync_is_site_loss_safe'1] ge_log_Int rf 0
    /\ ge_log_Int sites 1 /\ 0 <= 0 /\ 0 < sites)
  /\ (([@stop_split] [@expl:lemma_round_robin_load ensures] [%#smin_insync_is_site_loss_safe'2] round_robin_load rf sites 0
    = ComputerDivision.div (rf - 0 + sites - 1) sites)
  -> (let _ = lemma_round_robin_load rf sites 0 in ([@stop_split] [@expl:lemma_div_monotone requires] [%#smin_insync_is_site_loss_safe'3] 0
      <= rf - site + sites - 1
    /\ rf - site + sites - 1 <= rf + sites - 1 /\ ge_log_Int sites 1)
  /\ (([@stop_split] [@expl:lemma_div_monotone ensures] [%#smin_insync_is_site_loss_safe'4] ComputerDivision.div (rf
          - site
        + sites
      - 1) sites
    <= ComputerDivision.div (rf + sites - 1) sites)
  -> (let _ = lemma_div_monotone (rf - site + sites - 1) (rf + sites
  - 1) sites in [@stop_split] [@expl:lemma_site_load_at_most_first ensures] [%#smin_insync_is_site_loss_safe'0] round_robin_load rf sites site
  <= round_robin_load rf sites 0))))))
