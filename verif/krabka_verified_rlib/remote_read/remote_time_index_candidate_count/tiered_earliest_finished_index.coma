let%span sremote_time_index_candidate_count = "/workspace/crates/verified/src/remote_read/remote_time_index_candidate_count.rs" 75 50 75 55
let%span sremote_time_index_candidate_count'0 = "/workspace/crates/verified/src/remote_read/remote_time_index_candidate_count.rs" 75 4 75 56
let%span sremote_time_index_candidate_count'1 = "/workspace/crates/verified/src/remote_read/remote_time_index_candidate_count.rs" 67 11 67 75
let%span sremote_time_index_candidate_count'2 = "/workspace/crates/verified/src/remote_read/remote_time_index_candidate_count.rs" 68 10 68 85
let%span sremote_time_index_candidate_count'3 = "/workspace/crates/verified/src/remote_read/remote_time_index_candidate_count.rs" 28 11 28 75
let%span sremote_time_index_candidate_count'4 = "/workspace/crates/verified/src/remote_read/remote_time_index_candidate_count.rs" 29 10 29 86
let%span sremote_time_index_candidate_count'5 = "/workspace/crates/verified/src/remote_read/remote_time_index_candidate_count.rs" 16 8 24 9

use creusot.slice.Slice64
use creusot.int.Int64
use creusot.int.UInt64
use seq.Seq
use creusot.prelude.Any
use int.Int

type t_Option_usize = None | Some UInt64.t

predicate finished_selection [#"/workspace/crates/verified/src/remote_read/remote_time_index_candidate_count.rs" 7 0 14 9] (starts: Seq.seq Int64.t) (ends: Seq.seq Int64.t) (finished: Seq.seq bool) (best: t_Option_usize) (count: int) (latest: bool) =
  [%#sremote_time_index_candidate_count'5] match best with
    | Some best'0 -> UInt64.t'int best'0 < count
    /\ Seq.get finished (UInt64.t'int best'0)
    /\ 0 <= Int64.to_int (Seq.get starts (UInt64.t'int best'0))
    /\ Int64.to_int (Seq.get starts (UInt64.t'int best'0)) <= Int64.to_int (Seq.get ends (UInt64.t'int best'0))
    /\ (forall i: int. 0 <= i
        /\ i < count
        /\ Seq.get finished i
        /\ 0 <= Int64.to_int (Seq.get starts i) /\ Int64.to_int (Seq.get starts i) <= Int64.to_int (Seq.get ends i)
      -> (if latest then
        Int64.to_int (Seq.get ends i) <= Int64.to_int (Seq.get ends (UInt64.t'int best'0))
      else
        Int64.to_int (Seq.get starts (UInt64.t'int best'0)) <= Int64.to_int (Seq.get starts i)
      ))
    | None -> forall i: int. 0 <= i /\ i < count
      -> not Seq.get finished i
      \/ Int64.to_int (Seq.get starts i) < 0 \/ Int64.to_int (Seq.get ends i) < Int64.to_int (Seq.get starts i)
    end

let select_finished_index (starts: Slice64.slice Int64.t) (ends: Slice64.slice Int64.t) (finished: Slice64.slice bool)
  (latest: bool) (return (x: t_Option_usize)) =
{[@stop_split] [@expl:select_finished_index requires] [%#sremote_time_index_candidate_count'3] Seq.length (Slice64.view starts)
    = Seq.length (Slice64.view ends)
  /\ Seq.length (Slice64.view starts) = Seq.length (Slice64.view finished)}
  any
  [ return (result: t_Option_usize) ->
  {[@stop_split] [@expl:select_finished_index ensures] [%#sremote_time_index_candidate_count'4] finished_selection (Slice64.view starts) (Slice64.view ends) (Slice64.view finished) result (Seq.length (Slice64.view starts)) latest}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let tiered_earliest_finished_index [#"/workspace/crates/verified/src/remote_read/remote_time_index_candidate_count.rs" 70 0 74 18]
  (starts: Slice64.slice Int64.t) (ends: Slice64.slice Int64.t) (finished: Slice64.slice bool)
  (return (x: t_Option_usize)) =
{[@stop_split] [@expl:tiered_earliest_finished_index requires] [%#sremote_time_index_candidate_count'1] Seq.length (Slice64.view starts)
    = Seq.length (Slice64.view ends)
  /\ Seq.length (Slice64.view starts) = Seq.length (Slice64.view finished)}
  (! bb0
  [ bb0 = s0
    [ s0 = select_finished_index [%#sremote_time_index_candidate_count'0] {starts} {ends} {finished}
        {[%#sremote_time_index_candidate_count] false} (fun (_x: t_Option_usize) -> [ &_ret <- _x ] s1)
    | s1 = return {_ret} ] ]
  [ & _ret: t_Option_usize = Any.any_l ()
  | & starts: Slice64.slice Int64.t = starts
  | & ends: Slice64.slice Int64.t = ends
  | & finished: Slice64.slice bool = finished ])
  [ return (result: t_Option_usize) ->
  {[@stop_split] [@expl:tiered_earliest_finished_index ensures] [%#sremote_time_index_candidate_count'2] finished_selection (Slice64.view starts) (Slice64.view ends) (Slice64.view finished) result (Seq.length (Slice64.view starts)) false}
    (! return {result}) ]
