"""Installed-artifact adapters for historical and candidate ecosystem gates.

The shell runs inside the Aspect task: it is not another repository script.
Each adapter uses an isolated directory and emits names only after behavioral
checks pass. Source checkouts and downloaded artifacts come from the manifest.
"""

_COMMON = r"""
set -euo pipefail
manifest=$1
evidence=$2
work=$3
scope=qualification-$(basename "$work" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9')
mkdir -p "$evidence" "$work/sources" "$work/artifacts"
: > "$evidence/checks.txt"
check() {
  local name=$1
  shift
  "$@"
  printf '%s\n' "$name" >> "$evidence/checks.txt"
}
junit_passed() {
  local count
  count=$(xmllint --xpath "count(/testsuite/testcase[@classname='$1' and @name='$2'][not(skipped) and not(failure) and not(error)])" "$3")
  test "$count" = 1
}
revision() { jq -er --arg repo "krabka-io/$1" '.components[] | select(.repository == $repo) | .revision' "$manifest"; }
source_repo() {
  local repo=$1 destination="$work/sources/$1" rev
  rev=$(revision "$repo")
  if [ ! -d "$destination/.git" ]; then
    git init -q "$destination"
    git -C "$destination" remote add origin "https://github.com/krabka-io/$repo.git"
    git -C "$destination" fetch -q --depth 1 origin "$rev"
    git -C "$destination" checkout -q --detach FETCH_HEAD
  fi
  test "$(git -C "$destination" rev-parse HEAD)" = "$rev"
  printf '%s\n' "$destination"
}
artifact_fields() {
  jq -er --arg repo "krabka-io/$1" --arg kind "$2" '.components[] | select(.repository == $repo) | .artifacts[] | select(.kind == $kind) | [.reference,.digest] | @tsv' "$manifest"
}
download() {
  local repo=$1 kind=$2 reference digest destination="$work/artifacts/$1-$2"
  read -r reference digest < <(artifact_fields "$repo" "$kind")
  curl --fail --location --silent --show-error "$reference" --output "$destination"
  echo "${digest#sha256:}  $destination" | sha256sum --check --status
  printf '%s\n' "$destination"
}
image_ref() {
  local reference digest
  read -r reference digest < <(artifact_fields "$1" image)
  docker pull "$reference@$digest" >&2
  docker image inspect "$reference@$digest" > "$evidence/$1-image.json"
  printf '%s@%s\n' "$reference" "$digest"
}
broker_image=$(image_ref krabka-broker)
tools_image=mirror.gcr.io/apache/kafka:4.0.0@sha256:01b9a4030e54c6068e66eb3ba4cb82c0d89238629ef1c30d79b86036bf89b1b7
"""

_INSTALLATION = r"""
site=$(source_repo krabka-io.github.io)
operator_image=$(image_ref krabka-operator)
rebalancer_image=$(image_ref krabka-rebalancer)
operator_chart=$(download krabka-operator chart)
rebalancer_chart=$(download krabka-rebalancer chart)
project=$scope-installation
cluster=$scope-installation
cleanup() {
  docker compose -p "$project" -f "$work/compose.json" down -v > /dev/null 2>&1 || true
  kind delete cluster --name "$cluster" > /dev/null 2>&1 || true
}
trap cleanup EXIT
# Resolve the published recipe at its recorded Git revision, then substitute
# only the candidate broker image. Docker's parser handles YAML and aliases.
recipe="$site/public/quickstart/docker-compose.yml"
test -f "$recipe"
docker compose -f "$recipe" config --format json > "$work/recipe.json"
# The pinned Java suite intentionally selects KIP-1071. Enable that optional
# broker surface and finalize its feature in this isolated candidate volume.
jq --arg image "$broker_image" '
  .services |= with_entries(if (.value.image // "" | contains("krabka-broker")) then .value.image=$image else . end) |
  .services["broker-format"].command += ["--feature=streams.version=1"] |
  .services.broker.environment.KRABKA_STREAMS_GROUP_ENABLE="true" |
  .services.broker.environment.KRABKA_STREAMS_GROUP_NUM_STANDBY_REPLICAS="1"
' "$work/recipe.json" > "$work/compose.json"
jq -e --arg image "$broker_image" 'any(.services[]; .image == $image)' "$work/compose.json" > /dev/null
docker compose -p "$project" -f "$work/compose.json" up -d --wait --wait-timeout 180
for attempt in $(seq 1 60); do
  if docker run --rm --network host "$tools_image" /opt/kafka/bin/kafka-topics.sh --bootstrap-server localhost:9092 --list; then break; fi
  test "$attempt" -lt 60
  sleep 2
done
docker run --rm --network host "$tools_image" /opt/kafka/bin/kafka-topics.sh --bootstrap-server localhost:9092 --create --topic qualification --partitions 1 --replication-factor 1
printf 'candidate-installation\n' | docker run --rm -i --network host "$tools_image" /opt/kafka/bin/kafka-console-producer.sh --bootstrap-server localhost:9092 --topic qualification
docker run --rm --network host "$tools_image" /opt/kafka/bin/kafka-console-consumer.sh --bootstrap-server localhost:9092 --topic qualification --from-beginning --max-messages 1 --timeout-ms 60000 > "$evidence/compose-record.txt"
check compose-record grep -Fx candidate-installation "$evidence/compose-record.txt"
docker compose -p "$project" -f "$work/compose.json" ps --format json > "$evidence/compose-containers.json"
# Re-run the existing M19 supporting suites while the installed candidate is
# available. Explicit assertions on named live tests reject skipped suites.
go_source=$(source_repo krabka-streams-go)
(cd "$go_source" && bazel test //coordination:coordination_test --test_env=KRABKA_INTEGRATION_BOOTSTRAP=localhost:9092 --test_arg=-test.v --test_output=all --nocache_test_results) 2>&1 | tee "$evidence/m19-go.log"
check m19-go grep -F -- '--- PASS: TestKafkaTransportFencesAStaleLeaderAndKeepsSuccessionOrder' "$evidence/m19-go.log"
java_source=$(source_repo krabka-streams-java)
(cd "$java_source" && bazel test //krabka-streams-test-utils:integration_tests --strategy=TestRunner=local --test_arg="--reports-dir=$evidence/java-junit" --test_env=KRABKA_INTEGRATION_BOOTSTRAP=localhost:9092 --test_output=all --nocache_test_results) 2>&1 | tee "$evidence/m19-java.log"
# JUnit's XML names the individual method and records disabled/aborted tests
# as skipped. Bazel's wrapper XML only describes the suite process.
check m19-java-coordination junit_passed io.krabka.streams.test.CoordinationCompatibilityIT 'fencesTheOldLeaderAndAppendsARecoveredMemberToTheTail()' "$evidence/java-junit/TEST-junit-jupiter.xml"
check m19-java-streams junit_passed io.krabka.streams.test.BrokerCompatibilityIT 'runsStreamsProtocolEosStandbyIqv2AndRestore()' "$evidence/java-junit/TEST-junit-jupiter.xml"
broker_source=$(source_repo krabka-broker)
(cd "$broker_source" && bazel test //crates/broker:schema_validation_test --test_output=all --nocache_test_results) 2>&1 | tee "$evidence/m19-schema.log"
check m19-schema grep -F 'test live_registry::rf_three_validation_survives_registry_and_broker_failover ... ok' "$evidence/m19-schema.log"
# Match the historical negative-pin probe: unsupported protocol records must
# produce a compiler diagnostic, not an apparent successful compatibility run.
protocol_revision=$(revision krabka-protocol)
bad_revision=d252ed24df9eeeb092b9a7989da8667b3229e559
test "$protocol_revision" != "$bad_revision"
grep -F "$protocol_revision" "$broker_source/Cargo.toml"
sed -i "s/$protocol_revision/$bad_revision/g" "$broker_source/Cargo.toml"
(cd "$broker_source" && cargo generate-lockfile) > "$evidence/negative-lock.log" 2>&1
if (cd "$broker_source" && cargo check --locked -p krabka-broker) > "$evidence/negative-compat.log" 2>&1; then
  echo 'unsupported protocol revision unexpectedly compiled' >&2
  exit 1
fi
check negative-compat grep -E 'V1PartitionElr|V1PartitionRecovery' "$evidence/negative-compat.log"
git -C "$broker_source" diff -- Cargo.toml Cargo.lock > "$evidence/negative-compat.patch"
docker compose -p "$project" -f "$work/compose.json" down -v

kind create cluster --name "$cluster" --wait 120s
export KUBECONFIG="$work/kubeconfig"
kind get kubeconfig --name "$cluster" > "$KUBECONFIG"
mkdir -p "$work/crds"
chmod 0777 "$work/crds"
docker run --rm --user 0:0 -v "$work/crds:/crds" "$operator_image" gen-crds /crds
kubectl apply -f "$work/crds"
helm install operator "$operator_chart" --namespace krabka-system --create-namespace --wait --timeout 5m --set image.repository="${operator_image%@*}" --set image.digest="${operator_image#*@}"
test -f "$site/public/quickstart/krabka-cluster.yaml"
kubectl apply --dry-run=client -f "$site/public/quickstart/krabka-cluster.yaml" -o json | jq --arg image "$broker_image" 'if .kind == "List" then .items |= map(if .kind == "KafkaNodePool" then .spec.image=$image else . end) elif .kind == "KafkaNodePool" then .spec.image=$image else . end' > "$work/cluster.json"
kubectl apply -f "$work/cluster.json"
kubectl wait --for=condition=Ready kafka/m20-quickstart --timeout=10m
kubectl wait --for=condition=Ready kafkatopic/quickstart --timeout=5m
helm install rebalancer "$rebalancer_chart" --wait --timeout 5m --set bootstrapServers=m20-quickstart-broker-headless.default.svc.cluster.local:9092 --set image.repository="${rebalancer_image%@*}" --set image.digest="${rebalancer_image#*@}"
kubectl run kafka-tools --image="$tools_image" --restart=Never --rm -i --pod-running-timeout=5m --command -- /bin/bash -lc 'printf "candidate-installation\n" | /opt/kafka/bin/kafka-console-producer.sh --bootstrap-server m20-quickstart-broker-headless.default.svc.cluster.local:9092 --topic quickstart && /opt/kafka/bin/kafka-console-consumer.sh --bootstrap-server m20-quickstart-broker-headless.default.svc.cluster.local:9092 --topic quickstart --from-beginning --max-messages 1 --timeout-ms 60000' > "$evidence/helm-record.txt"
check helm-record grep -Fx candidate-installation "$evidence/helm-record.txt"
kubectl get pods -A -o json > "$evidence/helm-pods.json"
for image in "$broker_image" "$operator_image" "$rebalancer_image"; do
  check "installed-$image" jq -e --arg image "$image" 'any(.items[].spec.containers[]; .image == $image)' "$evidence/helm-pods.json"
done
# Let topic finalizers reach the broker before removing their cluster.
kubectl delete kafkatopic --all --timeout=5m
kubectl delete -f "$work/cluster.json" --ignore-not-found --timeout=5m
helm uninstall rebalancer
helm uninstall operator -n krabka-system
helm list -A -o json > "$evidence/helm-after-uninstall.json"
check helm-uninstall jq -e 'length == 0' "$evidence/helm-after-uninstall.json"
"""

_LIFECYCLE = r"""
operator=$(source_repo krabka-operator)
operator_image=$(image_ref krabka-operator)
rebalancer_image=$(image_ref krabka-rebalancer)
operator_chart=$(download krabka-operator chart)
rebalancer_chart=$(download krabka-rebalancer chart)
mkdir -p "$work/operator-chart" "$work/rebalancer-chart"
tar -xzf "$operator_chart" -C "$work/operator-chart"
tar -xzf "$rebalancer_chart" -C "$work/rebalancer-chart"
# Use the published chart bytes. The existing script's source-chart location
# is a mount point in this isolated copy, never a mutation of a user's tree.
mv "$operator/charts/krabka-operator" "$work/unexercised-source-chart"
cp -a "$work/operator-chart/krabka-operator" "$operator/charts/krabka-operator"
# The pinned harness supports digest broker/rebalancer refs, but the operator
# uses Never plus tag parsing. A private local alias names the pulled digest;
# record and compare the actual image IDs before running it.
alias=$scope-operator:verified
docker tag "$operator_image" "$alias"
check operator-alias test "$(docker image inspect "$alias" --format '{{.Id}}')" = "$(docker image inspect "$operator_image" --format '{{.Id}}')"
export BROKER_IMAGE="$broker_image" OPERATOR_IMAGE="$alias" REBALANCER_IMAGE="$rebalancer_image"
export REBALANCER_CHART="$work/rebalancer-chart/crabka-rebalancer"
export OPERATOR_REVISION="$(revision krabka-operator)" BROKER_REVISION="$(revision krabka-broker)" REBALANCER_REVISION="$(revision krabka-rebalancer)"
export EVIDENCE_DIR="$evidence/lifecycle" KIND_CLUSTER="$scope-lifecycle"
bash "$operator/packaging/kind-lifecycle.sh" 2>&1 | tee "$evidence/lifecycle.log"
check lifecycle-complete grep -F 'PASS: RF=3/minISR=2 survived upgrade, disruption, broker evacuation and leaf rotation;' "$evidence/lifecycle.log"
check lifecycle-ledger test -s "$EVIDENCE_DIR/acknowledged-offsets.tsv"
check lifecycle-no-missing-records test ! -s "$EVIDENCE_DIR/missing-acknowledged-records.txt"
check lifecycle-exit jq -e '.exit_code == 0' "$EVIDENCE_DIR/revisions.json"
"""

_OBSERVABILITY = r"""
demo=$(source_repo krabka-o11y-demo)
compose=$(download krabka-o11y-demo compose)
test "$(sha256sum "$demo/demo/observability/docker-compose.yml" | cut -d' ' -f1)" = "$(sha256sum "$compose" | cut -d' ' -f1)"
export KRABKA_BROKER_IMAGE="$broker_image"
export KRABKA_O11Y_IMAGE="$(image_ref krabka-o11y)"
export KRABKA_QUALIFICATION_ARTIFACT_DIR="$evidence/recovery"
export KRABKA_SMOKE_TARGETS='metrics logs traces cross-signal profiles demo-produce demo-stream demo-consume'
export COMPOSE_PROJECT_NAME=$scope-recovery
mkdir -p "$KRABKA_QUALIFICATION_ARTIFACT_DIR"
cd "$demo/demo/observability"
cleanup() { docker compose logs --no-color > "$evidence/compose.log" 2>&1; docker compose down -v; }
trap cleanup EXIT
docker compose config --format json > "$evidence/compose.json"
check candidate-broker jq -e --arg image "$KRABKA_BROKER_IMAGE" '.services.broker.image == $image' "$evidence/compose.json"
check candidate-o11y jq -e --arg image "$KRABKA_O11Y_IMAGE" '.services["metrics-distributor"].image == $image' "$evidence/compose.json"
docker compose up -d --wait --wait-timeout 600 grafana cadvisor demo-produce demo-stream demo-consume metrics-distributor metrics-compactor metrics-querier traces-distributor traces-block-builder traces-metrics-generator traces-querier logs-distributor logs-compactor logs-querier profiles-distributor profiles-block-builder profiles-querier
check observability-recovery bash -o pipefail ./qualify-failover.sh
for file in reconciliation.txt alerts-firing.json alerts-resolved.json seed-log-before.json seed-log-after.json seed-trace-before.pb seed-trace-after.pb profiles-before.json profiles-after.json; do
  check "retained-$file" test -s "$KRABKA_QUALIFICATION_ARTIFACT_DIR/$file"
done
"""

_CLI = r"""
cli=$(source_repo krabka-cli)
cli_binary=$(download krabka-cli binary)
chmod +x "$cli_binary"
network=$scope-cli
cleanup() {
  for n in 1 2 3; do docker logs "$network-$n" > "$evidence/broker-$n.log" 2>&1 || true; docker rm -f "$network-$n" > /dev/null 2>&1 || true; done
  docker network rm "$network" > /dev/null 2>&1 || true
}
trap cleanup EXIT
docker network create "$network"
cluster_id=3d70a78c-bb3a-4af5-a767-51e31f403c62
for n in 1 2 3; do
  mkdir -p "$work/node$n/data"
  chmod 0777 "$work/node$n/data"
  client_port=$((19093+n))
  cat > "$work/node$n/broker.toml" <<EOF
broker_id = $n
log_dir = "/var/lib/krabka"
controller_quorum_voters = ["1@$network-1:9093", "2@$network-2:9093", "3@$network-3:9093"]
bootstrap_servers = ["$network-1:9093", "$network-2:9093", "$network-3:9093"]
inter_broker_listener_name = "INTERNAL"
controller_listener_protocol = "Plaintext"
[[listeners]]
name = "INTERNAL"
bind_addr = "0.0.0.0:9092"
advertised = "$network-$n:9092"
protocol = "Plaintext"
[[listeners]]
name = "CLIENT"
bind_addr = "0.0.0.0:9094"
advertised = "127.0.0.1:$client_port"
protocol = "SaslPlaintext"
sasl_config = { enabled_mechanisms = ["PLAIN"] }
[sasl_plain]
credentials_path = "/etc/krabka/users"
[authorization]
type = "simple"
super_users = ["admin"]
[process]
roles = ["controller", "broker"]
EOF
  printf 'admin=qualification-admin\ndenied=qualification-denied\n' > "$work/node$n/users"
  docker run --rm --network "$network" -v "$work/node$n/data:/var/lib/krabka" --entrypoint /usr/bin/krabka-format "$broker_image" --cluster-id "$cluster_id" --node-id "$n" --log-dir /var/lib/krabka --release-version 3.9 --feature kraft.version=0 \
    --add-acl 'principal=User:ANONYMOUS,host=*,operation=ClusterAction,permission=Allow,resource=Cluster:kafka-cluster' \
    --add-acl 'principal=User:ANONYMOUS,host=*,operation=Read,permission=Allow,resource=Topic:*'
  docker run -d --name "$network-$n" --network "$network" --log-opt max-size=10m --log-opt max-file=2 -p "127.0.0.1:$client_port:9094" -v "$work/node$n/data:/var/lib/krabka" -v "$work/node$n:/etc/krabka:ro" "$broker_image" --broker-id "$n" --config-file /etc/krabka/broker.toml
done
for user in admin denied; do
  cat > "$work/$user.properties" <<EOF
security.protocol=SASL_PLAINTEXT
sasl.mechanism=PLAIN
sasl.jaas.config=org.apache.kafka.common.security.plain.PlainLoginModule required username="$user" password="qualification-$user";
EOF
done
export KRABKA_CANDIDATE_BOOTSTRAP=127.0.0.1:19094 KRABKA_CANDIDATE_IMAGE="$broker_image" KRABKA_CANDIDATE_REVISION="$(revision krabka-broker)" KRABKA_CLI_REVISION="$(revision krabka-cli)"
export KRABKA_COMMAND_CONFIG="$work/admin.properties" KRABKA_DENIED_COMMAND_CONFIG="$work/denied.properties" KRABKA_DENIED_PRINCIPAL=User:denied
for attempt in $(seq 1 90); do
  if "$cli_binary" topics --list --bootstrap-server "$KRABKA_CANDIDATE_BOOTSTRAP" --command-config "$KRABKA_COMMAND_CONFIG" --timeout 2s; then break; fi
  test "$attempt" -lt 90
  sleep 2
done
# Give the denial principal its documented initially-authorized precondition.
"$cli_binary" acls --add --topic '*' --allow-principal User:denied --operation all --bootstrap-server "$KRABKA_CANDIDATE_BOOTSTRAP" --command-config "$KRABKA_COMMAND_CONFIG"
# The existing suite otherwise executes Cargo's freshly built binary. Override
# that single invocation in the isolated harness; retain the patch as evidence.
test_file="$cli/crates/krabka-cli/tests/candidate_broker.rs"
test "$(grep -Fc 'env!("CARGO_BIN_EXE_krabka")' "$test_file")" = 1
sed -i 's/env!("CARGO_BIN_EXE_krabka")/std::env::var("KRABKA_QUALIFICATION_CLI_BINARY").expect("qualified binary")/' "$test_file"
git -C "$cli" diff -- crates/krabka-cli/tests/candidate_broker.rs > "$evidence/harness.patch"
export KRABKA_QUALIFICATION_CLI_BINARY="$cli_binary"
cd "$cli"
cargo test --locked -p krabka-cli --test candidate_broker authenticated_admin_matrix_matches_real_broker_state -- --ignored --exact --nocapture 2>&1 | tee "$evidence/cli.log"
check authenticated-admin-matrix grep -F 'test result: ok. 1 passed; 0 failed;' "$evidence/cli.log"
check acl-denial-observed grep -F '"name":"acl-denied-request"' "$evidence/cli.log"
check reassignment-completed grep -F '"name":"reassignment-complete-state"' "$evidence/cli.log"
"""

_DISASTER_RECOVERY = r"""
broker_source=$(source_repo krabka-broker)
(cd "$broker_source" && bazel test //crates/restore:dr_roundtrip_test --test_output=all --nocache_test_results) \
  2>&1 | tee "$evidence/hermetic-dr.log"
check hermetic-dr grep -F 'test a_captured_cluster_restores_with_its_configuration_and_its_group_positions ... ok' "$evidence/hermetic-dr.log"
minio_image=mirror.gcr.io/minio/minio@sha256:a1a8bd4ac40ad7881a245bab97323e18f971e4d4cba2c2007ec1bedd21cbaba2
mc_image=mirror.gcr.io/minio/mc@sha256:eb4ea9884b77704230e2423e9004d2fa738dc272876b9cc41a297d29443b8780
network=$scope-dr
bucket=dr-archive
data_prefix=candidate/data
capture_prefix=candidate/capture
access=minioadmin
secret=minioadmin
source_started_ms=$(date +%s%3N)

cleanup() {
  for cluster in source restored; do
    for n in 1 2 3; do
      docker logs "$scope-$cluster-$n" > "$evidence/$cluster-broker-$n.log" 2>&1 || true
      docker rm -f "$scope-$cluster-$n" > /dev/null 2>&1 || true
    done
  done
  docker logs "$scope-minio" > "$evidence/minio.log" 2>&1 || true
  docker rm -f "$scope-minio" > /dev/null 2>&1 || true
  docker network rm "$network" > /dev/null 2>&1 || true
}
trap cleanup EXIT
docker network create "$network"
mkdir -p "$work/tls" "$work/worm" "$work/capture" "$work/restored-node1"
chmod 0777 "$work" "$work/capture" "$work/restored-node1"

# One throwaway CA and one certificate naming every endpoint keep the drill's
# TLS trust boundary explicit without introducing an external PKI dependency.
openssl req -x509 -newkey rsa:2048 -nodes -days 1 -subj '/CN=qualification-ca' \
  -keyout "$work/tls/ca.key" -out "$work/tls/ca.pem" >/dev/null 2>&1
cat > "$work/tls/server.ext" <<EOF
subjectAltName=DNS:$scope-source-1,DNS:$scope-source-2,DNS:$scope-source-3,DNS:$scope-restored-1
extendedKeyUsage=serverAuth
EOF
openssl req -newkey rsa:2048 -nodes -subj '/CN=qualification-broker' \
  -keyout "$work/tls/server.key" -out "$work/tls/server.csr" >/dev/null 2>&1
openssl x509 -req -days 1 -in "$work/tls/server.csr" -CA "$work/tls/ca.pem" \
  -CAkey "$work/tls/ca.key" -CAcreateserial -extfile "$work/tls/server.ext" \
  -out "$work/tls/server.pem" >/dev/null 2>&1
openssl req -x509 -newkey rsa:2048 -nodes -days 1 -subj '/CN=wrong-ca' \
  -keyout "$work/tls/wrong-ca.key" -out "$work/tls/wrong-ca.pem" >/dev/null 2>&1
openssl genpkey -algorithm ED25519 -outform DER -out "$work/worm/signing.pk8"
openssl pkey -inform DER -in "$work/worm/signing.pk8" -pubout -outform DER | tail -c 32 > "$work/worm/signing.pub"
openssl genpkey -algorithm ED25519 -outform DER -out "$work/worm/untrusted.pk8"
openssl pkey -inform DER -in "$work/worm/untrusted.pk8" -pubout -outform DER | tail -c 32 > "$work/worm/untrusted.pub"
chmod -R a+rX "$work/tls" "$work/worm"

cat > "$work/admin.properties" <<EOF
security.protocol=SASL_SSL
ssl.truststore.type=PEM
ssl.truststore.location=/work/tls/ca.pem
sasl.mechanism=SCRAM-SHA-512
sasl.jaas.config=org.apache.kafka.common.security.scram.ScramLoginModule required username="admin" password="qualification-admin";
EOF
cat > "$work/backup.properties" <<EOF
security.protocol=SASL_SSL
ssl.truststore.type=PEM
ssl.truststore.location=/work/tls/ca.pem
sasl.mechanism=SCRAM-SHA-512
sasl.jaas.config=org.apache.kafka.common.security.scram.ScramLoginModule required username="backup" password="qualification-backup";
EOF
cat > "$work/bad.properties" <<EOF
security.protocol=SASL_SSL
ssl.truststore.type=PEM
ssl.truststore.location=/work/tls/ca.pem
sasl.mechanism=SCRAM-SHA-512
sasl.jaas.config=org.apache.kafka.common.security.scram.ScramLoginModule required username="backup" password="qualification-wrong";
EOF
cat > "$work/denied.properties" <<EOF
security.protocol=SASL_SSL
ssl.truststore.type=PEM
ssl.truststore.location=/work/tls/ca.pem
sasl.mechanism=SCRAM-SHA-512
sasl.jaas.config=org.apache.kafka.common.security.scram.ScramLoginModule required username="denied" password="qualification-denied";
EOF
sed 's#tls/ca.pem#tls/wrong-ca.pem#' "$work/backup.properties" > "$work/wrong-ca.properties"
chmod a+r "$work"/*.properties

docker run -d --name "$scope-minio" --network "$network" \
  -e MINIO_ROOT_USER="$access" -e MINIO_ROOT_PASSWORD="$secret" \
  "$minio_image" server /data
docker run --rm --network "$network" --entrypoint /bin/sh "$mc_image" -c \
  "until mc alias set local http://$scope-minio:9000 $access $secret >/dev/null 2>&1; do sleep 1; done; mc mb --with-lock local/$bucket; mc retention set --default COMPLIANCE 1d local/$bucket"

cluster_id=3d70a78c-bb3a-4af5-a767-51e31f403c62
for n in 1 2 3; do
  mkdir -p "$work/source-node$n"
  chmod 0777 "$work/source-node$n"
  cat > "$work/source-node$n/broker.toml" <<EOF
broker_id = $n
log_dir = "/var/lib/krabka"
controller_quorum_voters = ["1@$scope-source-1:9093", "2@$scope-source-2:9093", "3@$scope-source-3:9093"]
bootstrap_servers = ["$scope-source-1:9092", "$scope-source-2:9092", "$scope-source-3:9092"]
inter_broker_listener_name = "INTERNAL"
controller_listener_protocol = "Plaintext"
metadata_snapshot_interval_records = 1
metadata_max_snapshot_interval = "1s"
log_segment_bytes = "1KiB"
log_retention_check_interval = "1s"
remote_log_manager_interval = "1s"
diskless_wal_flush_interval = "50ms"
diskless_wal_flush_max_size = "1KiB"
diskless_wal_local_replica_count = 3
diskless_wal_trim_safety_lag = 0
[[listeners]]
name = "INTERNAL"
bind_addr = "0.0.0.0:9092"
advertised = "$scope-source-$n:9092"
protocol = "Plaintext"
[[listeners]]
name = "CLIENT"
bind_addr = "0.0.0.0:9094"
advertised = "$scope-source-$n:9094"
protocol = "SaslSsl"
[listeners.tls_config]
cert_path = "/etc/krabka/tls/server.pem"
key_path = "/etc/krabka/tls/server.key"
[listeners.sasl_config]
enabled_mechanisms = ["SCRAM-SHA-512"]
[authorization]
type = "simple"
super_users = ["admin"]
[process]
roles = ["controller", "broker"]
[remote_storage.s3]
bucket = "$bucket"
region = "us-east-1"
prefix = "$data_prefix"
endpoint = "http://$scope-minio:9000"
access_key_id = "$access"
secret_access_key = "$secret"
allow_http = true
[remote_storage.kafka_metadata]
bootstrap = "$scope-source-1:9092"
num_partitions = 1
replication = 3
snapshot_interval = "1s"
[remote_storage.worm]
signing_key_path = "/etc/krabka/worm/signing.pk8"
signing_key_id = "qualification-worm"
EOF
  chmod -R a+rX "$work/source-node$n"
  docker run --rm --network "$network" -v "$work/source-node$n:/var/lib/krabka" \
    --entrypoint /usr/bin/krabka-format "$broker_image" --cluster-id "$cluster_id" --node-id "$n" \
    --log-dir /var/lib/krabka --release-version 3.9 --feature kraft.version=0 \
    --add-scram 'SCRAM-SHA-512=[name=admin,password=qualification-admin]' \
    --add-scram 'SCRAM-SHA-512=[name=backup,password=qualification-backup]' \
    --add-scram 'SCRAM-SHA-512=[name=denied,password=qualification-denied]' \
    --add-acl 'principal=User:ANONYMOUS,host=*,operation=ClusterAction,permission=Allow,resource=Cluster:kafka-cluster' \
    --add-acl 'principal=User:ANONYMOUS,host=*,operation=Read,permission=Allow,resource=Topic:*'
  docker run -d --name "$scope-source-$n" --network "$network" \
    -v "$work/source-node$n:/var/lib/krabka" -v "$work/tls:/etc/krabka/tls:ro" \
    -v "$work/worm:/etc/krabka/worm:ro" \
    "$broker_image" --broker-id "$n" --config-file /var/lib/krabka/broker.toml
done

kafka() {
  local cluster=$1 tool=$2
  shift 2
  docker run --rm --network "$network" -v "$work:/work:ro" "$tools_image" \
    "/opt/kafka/bin/kafka-$tool.sh" --bootstrap-server "$scope-$cluster-1:9094" \
    --command-config /work/admin.properties "$@"
}
for attempt in $(seq 1 90); do
  if kafka source topics --list; then break; fi
  test "$attempt" -lt 90
  sleep 2
done

# Least privilege for the account whose secured coordinator path is captured.
kafka source acls --add --allow-principal User:backup --operation DESCRIBE --cluster
for topic in classic diskless; do
  kafka source acls --add --allow-principal User:backup --operation READ --operation DESCRIBE --operation DESCRIBE_CONFIGS --topic "$topic"
done
kafka source acls --add --allow-principal User:backup --operation READ --operation DESCRIBE --group dr-group
kafka source acls --add --allow-principal User:backup --operation READ --operation WRITE --operation DESCRIBE --topic __diskless_wal_index
kafka source topics --create --topic classic --partitions 1 --replication-factor 3 \
  --config remote.storage.enable=true --config local.retention.bytes=1 \
  --config retention.bytes=-1 --config retention.ms=604800000 --config segment.ms=1000
kafka source topics --create --topic diskless --partitions 1 --replication-factor 3 \
  --config krabka.diskless=true --config retention.ms=604800000

for topic in classic diskless; do
  seq 0 199 | awk -v topic="$topic" '{printf "%s-%04d-%01024d\n", topic, $1, $1}' | \
    docker run --rm -i --network "$network" -v "$work:/work:ro" "$tools_image" \
      /opt/kafka/bin/kafka-console-producer.sh --bootstrap-server "$scope-source-1:9094" \
      --producer.config /work/admin.properties --topic "$topic" \
      --producer-property acks=all
done
sleep 2
printf 'classic-roll-sentinel\n' | docker run --rm -i --network "$network" -v "$work:/work:ro" "$tools_image" \
  /opt/kafka/bin/kafka-console-producer.sh --bootstrap-server "$scope-source-1:9094" \
  --producer.config /work/admin.properties --topic classic --producer-property acks=all
sleep 2
printf 'classic-boundary-trigger\n' | docker run --rm -i --network "$network" -v "$work:/work:ro" "$tools_image" \
  /opt/kafka/bin/kafka-console-producer.sh --bootstrap-server "$scope-source-1:9094" \
  --producer.config /work/admin.properties --topic classic --producer-property acks=all
docker run --rm --network "$network" -v "$work:/work:ro" "$tools_image" \
  /opt/kafka/bin/kafka-console-consumer.sh --bootstrap-server "$scope-source-1:9094" \
  --consumer.config /work/admin.properties --topic classic --group dr-group \
  --from-beginning --max-messages 75 --timeout-ms 60000 > "$evidence/source-group-read.txt"

negative_capture() {
  local name=$1 config=$2 negative_prefix="candidate/negative/$1"
  if docker run --rm --network "$network" -v "$work:/work:ro" \
    --entrypoint /usr/bin/krabka-backup "$broker_image" capture \
    --bootstrap-server "$scope-source-1:9094" --command-config "/work/$config" \
    --archive-s3-bucket "$bucket" --archive-s3-region us-east-1 \
    --archive-s3-endpoint "http://$scope-minio:9000" --archive-s3-access-key-id "$access" \
    --archive-s3-secret-access-key "$secret" --archive-s3-allow-http \
    --archive-prefix "$negative_prefix" > "$evidence/$name.log" 2>&1; then
    echo "$name unexpectedly completed a capture" >&2
    exit 1
  fi
  negative_listing=$(docker run --rm --network "$network" --entrypoint /bin/sh "$mc_image" -c \
    "mc alias set local http://$scope-minio:9000 $access $secret >/dev/null; mc find local/$bucket/$negative_prefix --name manifest.json 2>/dev/null || true")
  check "$name-no-manifest" test -z "$negative_listing"
  check "$name-no-secret" bash -c '! grep -F -e qualification-admin -e qualification-backup -e qualification-denied -e qualification-wrong "$1"' qualification "$evidence/$name.log"
}
negative_capture invalid-credentials bad.properties
negative_capture invalid-certificate wrong-ca.properties
negative_capture denied-acl denied.properties

# Wait for both classic segment manifests and diskless WAL objects to settle.
for attempt in $(seq 1 120); do
  listing=$(docker run --rm --network "$network" --entrypoint /bin/sh "$mc_image" -c \
    "mc alias set local http://$scope-minio:9000 $access $secret >/dev/null; mc find local/$bucket")
  classic_manifests=$(grep 'classic-0-' <<<"$listing" | grep -c '\.manifest$' || true)
  if [ "$classic_manifests" -ge 201 ] && grep -q 'diskless' <<<"$listing"; then break; fi
  test "$attempt" -lt 120
  sleep 2
done
printf '%s\n' "$listing" > "$evidence/archive-before.txt"
for attempt in $(seq 1 60); do
  if test -s "$work/source-node1/remote-log-metadata/snapshot" && \
    find "$work/source-node1/__cluster_metadata" -name '*.checkpoint' -type f | grep -q .; then
    break
  fi
  test "$attempt" -lt 60
  sleep 1
done
check capture-source-files test -s "$work/source-node1/remote-log-metadata/snapshot"

# The image's tool captures snapshots, group positions, and the committed WAL
# projection over the real SASL/TLS coordinator paths.
docker run --rm --network "$network" -v "$work:/work:ro" -v "$work/source-node1:/var/lib/krabka:ro" \
  --entrypoint /usr/bin/krabka-backup "$broker_image" capture \
  --log-dir /var/lib/krabka --bootstrap-server "$scope-source-1:9094" \
  --command-config /work/backup.properties \
  --archive-s3-bucket "$bucket" --archive-s3-region us-east-1 \
  --archive-s3-endpoint "http://$scope-minio:9000" --archive-s3-access-key-id "$access" \
  --archive-s3-secret-access-key "$secret" --archive-s3-allow-http --archive-prefix "$capture_prefix" \
  --worm-signing-key-id qualification-worm --worm-signing-key /work/worm/signing.pk8 \
  2>&1 | tee "$evidence/capture.log"
docker run --rm --network "$network" --entrypoint /usr/bin/krabka-backup "$broker_image" verify \
  --archive-s3-bucket "$bucket" --archive-s3-region us-east-1 \
  --archive-s3-endpoint "http://$scope-minio:9000" --archive-s3-access-key-id "$access" \
  --archive-s3-secret-access-key "$secret" --archive-s3-allow-http --archive-prefix "$capture_prefix" \
  > "$evidence/capture-verify.txt"
capture_id=$(docker run --rm --network "$network" --entrypoint /usr/bin/krabka-backup "$broker_image" list \
  --archive-s3-bucket "$bucket" --archive-s3-region us-east-1 \
  --archive-s3-endpoint "http://$scope-minio:9000" --archive-s3-access-key-id "$access" \
  --archive-s3-secret-access-key "$secret" --archive-s3-allow-http --archive-prefix "$capture_prefix" | tail -1 | awk '{print $1}')
test -n "$capture_id"
docker run --rm --network "$network" -v "$work/capture:/capture" --entrypoint /bin/sh "$mc_image" -c \
  "mc alias set local http://$scope-minio:9000 $access $secret >/dev/null; mc cp --recursive local/$bucket/$capture_prefix/restore-inputs/$capture_id/ /capture/"
check captured-inputs jq -e '
  ([.artifacts[].name] | sort) == ["cluster-metadata.checkpoint","diskless-wal-index.json","group-offsets.json","rlmm-snapshot"]
' "$work/capture/manifest.json"
capture_ms=$(jq -er .captured_at_ms "$work/capture/manifest.json")
kafka source get-offsets --topic classic > "$evidence/source-classic-offsets.txt"
kafka source get-offsets --topic diskless > "$evidence/source-diskless-offsets.txt"
kafka source configs --describe --topic classic > "$evidence/source-classic-config.txt"
kafka source configs --describe --topic diskless > "$evidence/source-diskless-config.txt"
kafka source consumer-groups --describe --group dr-group > "$evidence/source-group-offsets.txt"
awk 'NR > 1 {print $1, $2, $3, $4}' "$evidence/source-group-offsets.txt" > "$evidence/source-group-positions.txt"
for topic in classic diskless; do
  messages=200
  if [ "$topic" = classic ]; then messages=201; fi
  docker run --rm --network "$network" -v "$work:/work:ro" "$tools_image" \
    /opt/kafka/bin/kafka-console-consumer.sh --bootstrap-server "$scope-source-1:9094" \
    --consumer.config /work/admin.properties --topic "$topic" --from-beginning \
    --max-messages "$messages" --timeout-ms 60000 --property print.offset=true > "$evidence/source-$topic-ledger.txt"
done

AWS_ACCESS_KEY_ID=$access AWS_SECRET_ACCESS_KEY=$secret AWS_REGION=us-east-1 \
docker run --rm --network "$network" -e AWS_ACCESS_KEY_ID -e AWS_SECRET_ACCESS_KEY -e AWS_REGION \
  -v "$work/worm:/worm:ro" --entrypoint /usr/bin/krabka-worm-verify "$broker_image" verify \
  --bucket "$bucket" --region us-east-1 --endpoint "http://$scope-minio:9000" --allow-http \
  --prefix "$data_prefix" --key-id qualification-worm --public-key /worm/signing.pub --deep \
  > "$evidence/worm-verified.txt"
check worm-authenticated grep -F 'OK:' "$evidence/worm-verified.txt"
awk '/: tip / && $3 != "none," {sub(/:$/, "", $1); sub(/,$/, "", $3); print $1, $3}' "$evidence/worm-verified.txt" > "$evidence/worm-heads.txt"
awk '/diskless-capture WORM head / {print $1, $4}' "$evidence/capture.log" >> "$evidence/worm-heads.txt"
check worm-heads test -s "$evidence/worm-heads.txt"
check diskless-worm-head grep -Eq '^diskless-capture [0-9a-f]{64}$' "$evidence/worm-heads.txt"
jq -n --argjson captured_at_ms "$capture_ms" \
  --rawfile classic "$evidence/source-classic-offsets.txt" \
  --rawfile diskless "$evidence/source-diskless-offsets.txt" \
  --rawfile heads "$evidence/worm-heads.txt" \
  '{captured_at_ms:$captured_at_ms,classic_offsets:$classic,diskless_offsets:$diskless,worm_heads:$heads}' \
  > "$evidence/capture-boundary.json"
check capture-boundary jq -e '.captured_at_ms > 0 and (.classic_offsets|length)>0 and (.diskless_offsets|length)>0 and (.worm_heads|length)>0' "$evidence/capture-boundary.json"

# Complete loss means no source log directory survives into materialization.
for n in 1 2 3; do docker rm -f "$scope-source-$n" >/dev/null; done
rm -rf "$work/source-node1" "$work/source-node2" "$work/source-node3"
check source-volumes-destroyed test ! -e "$work/source-node1"
disaster_ms=$(date +%s%3N)

# The trusted tips are independently retained above and passed back during
# authenticated restore; the diskless capture names committed cutoffs.
restore_args=(
  --archive-s3-bucket "$bucket" --archive-s3-region us-east-1
  --archive-s3-endpoint "http://$scope-minio:9000" --archive-s3-access-key-id "$access"
  --archive-s3-secret-access-key "$secret" --archive-s3-allow-http --archive-prefix "$data_prefix"
  --rlmm-snapshot /capture/rlmm-snapshot --metadata-snapshot /capture/cluster-metadata.checkpoint
  --diskless-wal-capture /capture/diskless-wal-index.json
  --worm-key-id qualification-worm --worm-public-key /worm/signing.pub
  --log-dir /restored --node-id 1 --standalone --controller-listener "$scope-restored-1:9093" --report json
)
while read -r partition head; do restore_args+=(--worm-expect-head "$partition=$head"); done < "$evidence/worm-heads.txt"
docker run --rm --network "$network" -v "$work/capture:/capture:ro" -v "$work/worm:/worm:ro" \
  -v "$work/restored-node1:/restored" --entrypoint /usr/bin/krabka-restore "$broker_image" \
  "${restore_args[@]}" > "$evidence/restore-report.json"
check restore-boundary jq -e '
  .authentication.tail_truncation_protected == true and
  (.diskless.partitions | length) > 0 and
  ([.diskless.partitions[] | .recovery_cutoff >= .delete_floor] | all)
' "$evidence/restore-report.json"

# The restored node is fresh and secured; no source directory is mounted.
cat > "$work/restored-node1/broker.toml" <<EOF
broker_id = 1
log_dir = "/var/lib/krabka"
controller_quorum_voters = ["1@$scope-restored-1:9093"]
bootstrap_servers = ["$scope-restored-1:9093"]
inter_broker_listener_name = "INTERNAL"
controller_listener_protocol = "Plaintext"
[[listeners]]
name = "INTERNAL"
bind_addr = "0.0.0.0:9092"
advertised = "$scope-restored-1:9092"
protocol = "Plaintext"
[[listeners]]
name = "CLIENT"
bind_addr = "0.0.0.0:9094"
advertised = "$scope-restored-1:9094"
protocol = "SaslSsl"
[listeners.tls_config]
cert_path = "/etc/krabka/tls/server.pem"
key_path = "/etc/krabka/tls/server.key"
[listeners.sasl_config]
enabled_mechanisms = ["SCRAM-SHA-512"]
[authorization]
type = "simple"
super_users = ["admin"]
[process]
roles = ["controller", "broker"]
EOF
chmod -R a+rX "$work/restored-node1"
docker run -d --name "$scope-restored-1" --network "$network" \
  -v "$work/restored-node1:/var/lib/krabka" -v "$work/tls:/etc/krabka/tls:ro" \
  "$broker_image" --broker-id 1 --config-file /var/lib/krabka/broker.toml
for attempt in $(seq 1 90); do
  if kafka restored topics --list; then break; fi
  test "$attempt" -lt 90
  sleep 2
done
docker run --rm --network "$network" -v "$work:/work:ro" --entrypoint /usr/bin/krabka-backup "$broker_image" restore-offsets \
  --bootstrap-server "$scope-restored-1:9094" --command-config /work/backup.properties \
  --archive-s3-bucket "$bucket" --archive-s3-region us-east-1 \
  --archive-s3-endpoint "http://$scope-minio:9000" --archive-s3-access-key-id "$access" \
  --archive-s3-secret-access-key "$secret" --archive-s3-allow-http --archive-prefix "$capture_prefix"

for topic in classic diskless; do
  messages=200
  if [ "$topic" = classic ]; then messages=201; fi
  kafka restored get-offsets --topic "$topic" > "$evidence/restored-$topic-offsets.txt"
  kafka restored configs --describe --topic "$topic" > "$evidence/restored-$topic-config.txt"
  check "$topic-original-offsets" grep -Eq "^$topic:[[:space:]]*0:[[:space:]]*[1-9][0-9]*$" "$evidence/restored-$topic-offsets.txt"
  check "$topic-settings" cmp "$evidence/source-$topic-config.txt" "$evidence/restored-$topic-config.txt"
  docker run --rm --network "$network" -v "$work:/work:ro" "$tools_image" \
    /opt/kafka/bin/kafka-console-consumer.sh --bootstrap-server "$scope-restored-1:9094" \
    --consumer.config /work/admin.properties --topic "$topic" --from-beginning \
    --max-messages "$messages" --timeout-ms 60000 --property print.offset=true > "$evidence/restored-$topic-ledger.txt"
  check "$topic-ledger" cmp "$evidence/source-$topic-ledger.txt" "$evidence/restored-$topic-ledger.txt"
done
kafka restored consumer-groups --describe --group dr-group > "$evidence/restored-group-offsets.txt"
awk 'NR > 1 {print $1, $2, $3, $4}' "$evidence/restored-group-offsets.txt" > "$evidence/restored-group-positions.txt"
check consumer-positions cmp "$evidence/source-group-positions.txt" "$evidence/restored-group-positions.txt"
restore_ready_ms=$(date +%s%3N)
jq -n --argjson captured_at_ms "$capture_ms" --argjson source_started_ms "$source_started_ms" \
  --argjson disaster_ms "$disaster_ms" --argjson restore_ready_ms "$restore_ready_ms" \
  '{capture_boundary_ms:$captured_at_ms,disaster_ms:$disaster_ms,rpo_ms:($disaster_ms-$captured_at_ms),rto_ms:($restore_ready_ms-$disaster_ms),source_runtime_ms:($captured_at_ms-$source_started_ms)}' \
  > "$evidence/rpo-rto.json"
check measured-rpo-rto jq -e '.rpo_ms >= 0 and .rto_ms > 0' "$evidence/rpo-rto.json"

# Failure copies are mutable by design: they prove the consumers of archive
# evidence reject hostile bytes without weakening the locked source bucket.
for bad in tampered missing; do
  docker run --rm --network "$network" --entrypoint /bin/sh "$mc_image" -c \
    "mc alias set local http://$scope-minio:9000 $access $secret >/dev/null; mc mb local/$bad; mc mirror local/$bucket local/$bad"
done
tamper_object=$(grep '\.log$' "$evidence/archive-before.txt" | head -1 | sed "s#local/$bucket#local/tampered#")
missing_manifest=$(grep '\.manifest$' "$evidence/archive-before.txt" | tail -1 | sed "s#local/$bucket#local/missing#")
test -n "$tamper_object" -a -n "$missing_manifest"
docker run --rm -i --network "$network" --entrypoint /bin/sh "$mc_image" -c \
  "mc alias set local http://$scope-minio:9000 $access $secret >/dev/null; printf hostile | mc pipe '$tamper_object'; mc rm '$missing_manifest'"
for bad in tampered missing; do
  if AWS_ACCESS_KEY_ID=$access AWS_SECRET_ACCESS_KEY=$secret AWS_REGION=us-east-1 \
    docker run --rm --network "$network" -e AWS_ACCESS_KEY_ID -e AWS_SECRET_ACCESS_KEY -e AWS_REGION \
      -v "$work/worm:/worm:ro" --entrypoint /usr/bin/krabka-worm-verify "$broker_image" verify \
      --bucket "$bad" --region us-east-1 --endpoint "http://$scope-minio:9000" --allow-http \
      --prefix "$data_prefix" --key-id qualification-worm --public-key /worm/signing.pub --deep --strict-orphans; then
    echo "$bad archive unexpectedly verified" >&2
    exit 1
  fi
  printf '%s\n' "$bad-rejected" >> "$evidence/checks.txt"
  mkdir -p "$work/$bad-target"
  chmod 0777 "$work/$bad-target"
  bad_restore_args=()
  for arg in "${restore_args[@]}"; do
    if [ "$arg" = "$bucket" ]; then
      bad_restore_args+=("$bad")
    else
      bad_restore_args+=("$arg")
    fi
  done
  if docker run --rm --network "$network" -v "$work/capture:/capture:ro" -v "$work/worm:/worm:ro" \
    -v "$work/$bad-target:/restored" --entrypoint /usr/bin/krabka-restore "$broker_image" \
    "${bad_restore_args[@]}"; then
    echo "$bad archive unexpectedly restored" >&2
    exit 1
  fi
  printf '%s\n' "$bad-restore-rejected" >> "$evidence/checks.txt"
done
if docker run --rm --network "$network" --entrypoint /usr/bin/krabka-backup "$broker_image" list \
  --archive-s3-bucket "$bucket" --archive-s3-region us-east-1 \
  --archive-s3-endpoint "http://$scope-minio:9000" --archive-s3-access-key-id bad \
  --archive-s3-secret-access-key bad --archive-s3-allow-http --archive-prefix "$capture_prefix"; then
  echo 'bad credentials unexpectedly read the archive' >&2
  exit 1
fi
printf 'bad-credentials\n' >> "$evidence/checks.txt"
mkdir -p "$work/untrusted-target"
chmod 0777 "$work/untrusted-target"
if docker run --rm --network "$network" -v "$work/capture:/capture:ro" -v "$work/worm:/worm:ro" \
  -v "$work/untrusted-target:/restored" --entrypoint /usr/bin/krabka-restore "$broker_image" \
  "${restore_args[@]/\/worm\/signing.pub/\/worm\/untrusted.pub}"; then
  echo 'untrusted WORM key unexpectedly restored' >&2
  exit 1
fi
printf 'untrusted-worm-key\n' >> "$evidence/checks.txt"
"""

def gate_script(name):
    """The exact commands retained beside each result and bound to the candidate."""
    return _COMMON + {
        "installation": _INSTALLATION,
        "operator-lifecycle": _LIFECYCLE,
        "cli-admin": _CLI,
        "observability-recovery": _OBSERVABILITY,
        "disaster-recovery": _DISASTER_RECOVERY,
    }[name]

def run_gate(ctx, document, identity, name, digest):
    """Run one isolated gate and retain its receipt only after successful checks."""
    root = ctx.std.env.bazel_root_dir()
    output = root + "/" + ctx.args.output + "/" + name
    created = ctx.std.process.command("mkdir").args(["-p", output]).spawn().wait()
    if created.code != 0:
        return created.code

    # Refuse accidental mixing of reruns. Each GitHub attempt or local retry
    # supplies its own output path; a failed attempt keeps its diagnostic log.
    marker = ctx.std.process.command("test").args(["!", "-e", output + "/commands.txt"]).spawn().wait()
    if marker.code != 0:
        fail("qualification output already exists; select a fresh --output directory")
    scratch = ctx.std.process.command("mktemp").args(["-d"]).stdout("piped").spawn().wait_with_output()
    if scratch.status.code != 0:
        return scratch.status.code
    work = scratch.stdout.strip()
    manifest = json.encode(document) + "\n"
    commands = gate_script(name)
    ctx.std.fs.write(output + "/candidate.json", manifest)
    ctx.std.fs.write(output + "/commands.txt", commands)

    # tee retains stdout and stderr even if the caller cancels the task. The
    # external timeout also bounds hung helper processes outside Actions.
    result = ctx.std.process.command("bash").args([
        "-c",
        "set -o pipefail; timeout 150m bash \"$1\" \"$2\" \"$3\" \"$4\" 2>&1 | tee \"$3/run.log\"",
        "qualification",
        output + "/commands.txt",
        output + "/candidate.json",
        output,
        work,
    ]).spawn().wait()
    if result.code != 0:
        ctx.std.io.stderr.write("qualification failed; retained evidence in " + output + "; scratch " + work + "\n")
        return result.code or 1
    checks = ctx.std.fs.read_to_string(output + "/checks.txt").splitlines()
    if not checks:
        fail("qualification command executed zero checks")
    receipt = {
        "gate": name,
        "candidate_sha256": identity,
        "runner_sha256": document["runner_sha256"],
        "exit_code": 0,
        "tests_passed": len(checks),
        "checks": checks,
        "commands_sha256": digest(commands),
        "log_sha256": digest(ctx.std.fs.read_to_string(output + "/run.log")),
    }
    ctx.std.fs.write(output + "/result.json", json.encode(receipt) + "\n")
    return 0
