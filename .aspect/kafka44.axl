"""Collect immutable released Kafka 4.4 evidence, never a parity pass.

    aspect kafka44 --revision <full-sha> --output <new-directory>
"""

load("./verify_release.axl", "text_sha256")

IMAGE = "apache/kafka:4.4.0@sha256:76af3d0116abbb33b4cd964af410d4921c33d1f663e7a95d5453a9c35a84869b"
BIN = "/opt/kafka/bin/"
PROBES = {
    "api-versions": ["kafka-broker-api-versions.sh"],
    "features": ["kafka-features.sh", "describe"],
    "broker-configs": ["kafka-configs.sh", "--describe", "--entity-type", "brokers", "--entity-default", "--all"],
}
UNEXECUTED = ["authorization", "config validation/errors", "feature-level boundaries", "share DLQ", "delayed tiered uploads", "misrouting", "controller unregistration", "topic-ID transactional commits", "Streams topology APIs", "restart/recovery", "multi-broker"]

def input_problems(revision, inputs):
    problems = []
    if len(revision) != 40 or [c for c in revision.elems() if c not in "0123456789abcdef"]:
        problems.append("revision must be a full lowercase 40-character commit SHA")
    if any(inputs) and not all(inputs):
        problems.append("supply both bootstrap addresses and both configuration inputs, or none")
    return problems

def authorization_input_problems(enabled, protocol, candidate, endpoints):
    problems = []
    if not enabled and any(endpoints):
        problems.append("authorization endpoints require --authorization-scenarios")
    if enabled and not protocol:
        problems.append("authorization scenarios require --protocol-scenarios")
    if enabled and candidate and not all(endpoints):
        problems.append("authorization scenarios require both candidate SASL endpoints")
    return problems

def api_ranges(output):
    """Released JVM tool rows, excluding endpoint identity and usable annotation."""
    rows = {}
    for line in output.splitlines():
        line = line.strip().rstrip(",")
        if "): " in line:
            key, versions = line.split("): ", 1)
            if "(" in key:
                rows[key + ")"] = versions.split(" [usable:", 1)[0]
    return rows

def api_differences(oracle, candidate):
    """Never treat empty or failed parsing as parity."""
    expected = api_ranges(oracle)
    actual = api_ranges(candidate)
    if not expected or not actual:
        return [{"error": "missing parsed API rows"}]
    differences = []
    for key in sorted({k: True for k in list(expected) + list(actual)}):
        if expected.get(key) != actual.get(key):
            differences.append({"api": key, "oracle": expected.get(key), "candidate": actual.get(key)})
    return differences

def _command(ctx, argv, seconds = 90):
    result = (ctx.std.process.command("timeout").args([str(seconds)] + argv)
        .stdout("piped").stderr("piped").spawn().wait_with_output())
    return {
        "command": ["timeout", str(seconds)] + argv,
        "returncode": result.status.code,
        "stdout": result.stdout,
        "stderr": result.stderr,
    }

def _tool(ctx, probe, bootstrap, container = "", seconds = 90):
    argv = ["docker", "exec", container] if container else ["docker", "run", "--rm", "--network", "host", IMAGE]
    return _command(ctx, argv + [BIN + probe[0], "--bootstrap-server", bootstrap] + probe[1:], seconds)

def scenario_results(output):
    """Only compare explicit scenario result rows, not volatile response identities."""
    rows = {}
    for line in output.splitlines():
        parts = line.split("\t")
        if len(parts) == 3 and parts[0] == "SCENARIO":
            rows[parts[1]] = parts[2]
    return rows

def scenario_differences(oracle, candidate, count = 17):
    expected = scenario_results(oracle)
    actual = scenario_results(candidate)
    if len(expected) != count or len(actual) != count:
        return [{"error": "missing protocol scenario rows"}]
    return [
        {"scenario": key, "oracle": expected[key], "candidate": actual.get(key)}
        for key in expected
        if expected[key] != actual.get(key) or "TRANSPORT:" in actual.get(key, "")
    ]

def _protocol_setup(ctx, name, output):
    # javac is local; the only linked client codecs come from the pinned oracle.
    results = [_command(ctx, ["mkdir", output + "/libs", output + "/classes"])]
    results.append(_command(ctx, ["docker", "cp", name + ":/opt/kafka/libs/.", output + "/libs/"]))
    results.append(_command(ctx, ["javac", "--release", "17", "-cp", output + "/libs/*", "-d", output + "/classes", "tools/kafka44/ProtocolScenarios.java", "tools/kafka44/AuthorizationScenarios.java", "tools/kafka44/TransactionScenarios.java", "tools/kafka44/ConfigScenarios.java", "tools/kafka44/ControllerRecovery.java", "tools/kafka44/StreamsPositive.java"]))
    results.append(_command(ctx, ["docker", "cp", output + "/classes", name + ":/opt/kafka/kafka44classes"]))
    return results

def _protocol(ctx, name, bootstrap, controller, classes):
    argv = ["docker", "exec", name] if name else ["docker", "run", "--rm", "--network", "host", "-v", classes + ":/opt/kafka/kafka44classes:ro", "--entrypoint", "java", IMAGE]
    if name:
        argv.append("java")
    return _command(ctx, argv + ["-cp", "/opt/kafka/libs/*:/opt/kafka/kafka44classes", "ProtocolScenarios", bootstrap, controller], 120)

def _config_scenarios(ctx, name, bootstrap, classes):
    argv = ["docker", "exec", name, "java"] if name else ["docker", "run", "--rm", "--network", "host", "-v", classes + ":/opt/kafka/kafka44classes:ro", "--entrypoint", "java", IMAGE]
    return _command(ctx, argv + ["-cp", "/opt/kafka/libs/*:/opt/kafka/kafka44classes", "ConfigScenarios", bootstrap], 180)

def _streams(ctx, name, bootstrap, classes):
    argv = ["docker", "exec", name, "java"] if name else ["docker", "run", "--rm", "--network", "host", "-v", classes + ":/opt/kafka/kafka44classes:ro", "--entrypoint", "java", IMAGE]
    return _command(ctx, argv + ["-cp", "/opt/kafka/libs/*:/opt/kafka/kafka44classes", "StreamsPositive", bootstrap, "fixture"], 180)

def _authorization(ctx, name, bootstrap, classes, admin_bootstrap):
    argv = ["docker", "exec", name, "java"] if name else ["docker", "run", "--rm", "--network", "host", "-v", classes + ":/opt/kafka/kafka44classes:ro", "--entrypoint", "java", IMAGE]
    return _command(ctx, argv + ["-cp", "/opt/kafka/libs/*:/opt/kafka/kafka44classes", "AuthorizationScenarios", bootstrap, admin_bootstrap], 120)

def _controller_recovery(ctx, name, mode):
    return _command(ctx, ["docker", "exec", name, "java", "-cp", "/opt/kafka/libs/*:/opt/kafka/kafka44classes", "ControllerRecovery", "localhost:9093", mode], 90)

def _transactions(ctx, name, bootstrap, classes, legacy = False):
    argv = ["docker", "exec", name, "java"] if name else ["docker", "run", "--rm", "--network", "host", "-v", classes + ":/opt/kafka/kafka44classes:ro", "--entrypoint", "java", IMAGE]
    return _command(ctx, argv + ["-cp", "/opt/kafka/libs/*:/opt/kafka/kafka44classes", "TransactionScenarios", bootstrap] + (["legacy"] if legacy else []), 180)

def transaction_recovery_args(stdout):
    rows = [line.split("\t")[1:] for line in stdout.splitlines() if line.startswith("RECOVERY\t")]
    return rows[0] if len(rows) == 1 and len(rows[0]) == 3 and all(rows[0]) else []

def _transaction_recovery(ctx, name, result):
    values = transaction_recovery_args(result["stdout"])
    if not values:
        return {"returncode": 1, "stdout": "", "stderr": "missing recovery identity"}
    return _command(ctx, ["docker", "exec", name, "java", "-cp", "/opt/kafka/libs/*:/opt/kafka/kafka44classes", "TransactionScenarios", "localhost:9092", "recover"] + values, 120)

def _cleanup(ctx, name, path, evidence):
    evidence["oracle_logs"] = _command(ctx, ["docker", "logs", name])
    evidence["cleanup"] = _command(ctx, ["docker", "rm", "-f", name])
    ctx.std.fs.write(path, json.encode(evidence) + "\n")

def _impl(ctx: TaskContext) -> int:
    a = ctx.args
    problems = input_problems(a.revision, [a.default_bootstrap, a.enabled_bootstrap, a.default_config, a.enabled_config])
    if a.protocol_scenarios and a.default_bootstrap and not (a.default_controller and a.enabled_controller):
        problems.append("protocol scenarios require both candidate controller addresses")
    problems.extend(authorization_input_problems(a.authorization_scenarios, a.protocol_scenarios, a.default_bootstrap, [a.default_auth_bootstrap, a.enabled_auth_bootstrap]))
    if a.streams_scenarios and not a.protocol_scenarios:
        problems.append("streams scenarios require --protocol-scenarios")
    if a.transaction_scenarios and not a.protocol_scenarios:
        problems.append("transaction scenarios require --protocol-scenarios")
    if a.oracle_crash_recovery and not a.transaction_scenarios:
        problems.append("oracle crash recovery requires --transaction-scenarios")
    if not a.output:
        problems.append("output directory is required")
    if problems:
        fail("; ".join(problems))
    revision = _command(ctx, ["git", "cat-file", "-t", a.revision])
    if revision["returncode"] or revision["stdout"].strip() != "commit":
        fail("revision must identify a commit in the local repository")

    # mkdir, not create_dir_all: overwriting old evidence must fail.
    made = _command(ctx, ["mkdir", a.output])
    if made["returncode"]:
        fail(made["stderr"])
    configs = {}
    for side, path in [("default", a.default_config), ("enabled", a.enabled_config)]:
        if path:
            configs[side] = {"sha256": text_sha256(ctx.std.fs.read_to_string(path)).removeprefix("sha256:")}
    name = "krabka-kafka44-" + a.output.replace("/", "-").replace(".", "-")[-40:]
    evidence = {
        "schema_version": 1,
        "status": "incomplete",
        "krabka_revision": a.revision,
        "oracle_image": IMAGE,
        "configs": configs,
        "sides": {},
        "qualification_pass": False,
        "unexecuted": UNEXECUTED,
    }
    env = {
        "KAFKA_NODE_ID": "1",
        "KAFKA_PROCESS_ROLES": "broker,controller",
        "KAFKA_LISTENERS": "PLAINTEXT://:9092,CONTROLLER://:9093",
        "KAFKA_ADVERTISED_LISTENERS": "PLAINTEXT://localhost:9092",
        "KAFKA_CONTROLLER_LISTENER_NAMES": "CONTROLLER",
        "KAFKA_INTER_BROKER_LISTENER_NAME": "PLAINTEXT",
        "KAFKA_LISTENER_SECURITY_PROTOCOL_MAP": "CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT",
        "KAFKA_CONTROLLER_QUORUM_VOTERS": "1@localhost:9093",
        "KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR": "1",
        "KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR": "1",
        "KAFKA_TRANSACTION_STATE_LOG_MIN_ISR": "1",
        "CLUSTER_ID": "MkU3OEVBNTcwNTJENDM2Qk",
    }
    if a.authorization_scenarios:
        env.update({
            "KAFKA_LISTENERS": env["KAFKA_LISTENERS"] + ",AUTH://:9094",
            "KAFKA_ADVERTISED_LISTENERS": env["KAFKA_ADVERTISED_LISTENERS"] + ",AUTH://localhost:9094",
            "KAFKA_LISTENER_SECURITY_PROTOCOL_MAP": env["KAFKA_LISTENER_SECURITY_PROTOCOL_MAP"] + ",AUTH:SASL_PLAINTEXT",
            "KAFKA_SASL_ENABLED_MECHANISMS": "PLAIN",
            "KAFKA_LISTENER_NAME_AUTH_PLAIN_SASL_JAAS_CONFIG": 'org.apache.kafka.common.security.plain.PlainLoginModule required user_denied="qualification-fixture-password" user_operator="qualification-fixture-password" user_writer="qualification-fixture-password" user_reader="qualification-fixture-password";',
            "KAFKA_AUTHORIZER_CLASS_NAME": "org.apache.kafka.metadata.authorizer.StandardAuthorizer",
            "KAFKA_SUPER_USERS": "User:ANONYMOUS",
            "KAFKA_ALLOW_EVERYONE_IF_NO_ACL_FOUND": "false",
        })
    if a.streams_scenarios:
        env["KAFKA_GROUP_STREAMS_TOPOLOGY_DESCRIPTION_PLUGIN_CLASS"] = "org.apache.kafka.server.streams.InMemoryTopologyDescriptionPlugin"
    evidence["oracle_configuration"] = env
    argv = ["docker", "run", "-d", "--name", name]
    for key, value in env.items():
        argv.extend(["-e", key + "=" + value])
    evidence["startup"] = _command(ctx, argv + [IMAGE])
    path = a.output + "/evidence.json"
    ctx.std.fs.write(path, json.encode(evidence) + "\n")
    if evidence["startup"]["returncode"]:
        return 1
    ctx.defer(_cleanup, ctx, name, path, evidence)
    ready = False
    for _ in range(30):
        result = _tool(ctx, ["kafka-topics.sh", "--list"], "localhost:9092", name, 10)
        if result["returncode"] == 0:
            ready = True
            break
    evidence["readiness"] = result
    if not ready:
        return 1
    evidence["client_version"] = _command(ctx, ["docker", "exec", name, BIN + "kafka-topics.sh", "--version"])
    if evidence["client_version"]["returncode"] or not evidence["client_version"]["stdout"].startswith("4.4.0"):
        return 1
    for side, bootstrap, container in [("oracle", "localhost:9092", name), ("default", a.default_bootstrap, ""), ("enabled", a.enabled_bootstrap, "")]:
        if bootstrap:
            evidence["sides"][side] = {key: _tool(ctx, probe, bootstrap, container) for key, probe in PROBES.items()}
    evidence["api_differences"] = {
        side: api_differences(evidence["sides"]["oracle"]["api-versions"]["stdout"], probes["api-versions"]["stdout"])
        for side, probes in evidence["sides"].items()
        if side != "oracle"
    }
    if a.protocol_scenarios:
        evidence["protocol_fixture_sha256"] = text_sha256(ctx.std.fs.read_to_string("tools/kafka44/ProtocolScenarios.java"))
        evidence["protocol_setup"] = _protocol_setup(ctx, name, a.output)
        if any([r["returncode"] for r in evidence["protocol_setup"]]):
            evidence["status"] = "protocol-setup-failure"
            return 1
        absolute = _command(ctx, ["realpath", a.output + "/classes"])["stdout"].strip()
        evidence["protocol_scenarios"] = {"oracle": _protocol(ctx, name, "localhost:9092", "localhost:9093", absolute)}
        for side, bootstrap, controller in [("default", a.default_bootstrap, a.default_controller), ("enabled", a.enabled_bootstrap, a.enabled_controller)]:
            if bootstrap:
                evidence["protocol_scenarios"][side] = _protocol(ctx, "", bootstrap, controller, absolute)
        evidence["protocol_differences"] = {
            side: scenario_differences(evidence["protocol_scenarios"]["oracle"]["stdout"], result["stdout"])
            for side, result in evidence["protocol_scenarios"].items()
            if side != "oracle"
        }
    if a.protocol_scenarios:
        evidence["config_fixture_sha256"] = text_sha256(ctx.std.fs.read_to_string("tools/kafka44/ConfigScenarios.java"))
        evidence["config_scenarios"] = {"oracle": _config_scenarios(ctx, name, "localhost:9092", absolute)}
        for side, bootstrap in [("default", a.default_bootstrap), ("enabled", a.enabled_bootstrap)]:
            if bootstrap:
                evidence["config_scenarios"][side] = _config_scenarios(ctx, "", bootstrap, absolute)
        evidence["config_differences"] = {
            side: scenario_differences(evidence["config_scenarios"]["oracle"]["stdout"], result["stdout"], 13)
            for side, result in evidence["config_scenarios"].items()
            if side != "oracle"
        }
    if a.streams_scenarios:
        evidence["streams_fixture_sha256"] = text_sha256(ctx.std.fs.read_to_string("tools/kafka44/StreamsPositive.java"))
        evidence["streams_scenarios"] = {"oracle": _streams(ctx, name, "localhost:9092", absolute)}
        if a.enabled_bootstrap:
            evidence["streams_scenarios"]["enabled"] = _streams(ctx, "", a.enabled_bootstrap, absolute)
        evidence["streams_differences"] = {
            side: scenario_differences(evidence["streams_scenarios"]["oracle"]["stdout"], result["stdout"], 9)
            for side, result in evidence["streams_scenarios"].items()
            if side != "oracle"
        }
    if a.authorization_scenarios:
        evidence["authorization_fixture_sha256"] = text_sha256(ctx.std.fs.read_to_string("tools/kafka44/AuthorizationScenarios.java"))
        evidence["authorization_scenarios"] = {"oracle": _authorization(ctx, name, "localhost:9094", absolute, "localhost:9092")}
        for side, bootstrap, admin_bootstrap in [("default", a.default_auth_bootstrap, a.default_bootstrap), ("enabled", a.enabled_auth_bootstrap, a.enabled_bootstrap)]:
            if bootstrap:
                evidence["authorization_scenarios"][side] = _authorization(ctx, "", bootstrap, absolute, admin_bootstrap)
        evidence["authorization_differences"] = {
            side: scenario_differences(evidence["authorization_scenarios"]["oracle"]["stdout"], result["stdout"], 10)
            for side, result in evidence["authorization_scenarios"].items()
            if side != "oracle"
        }
    if a.transaction_scenarios:
        evidence["transaction_fixture_sha256"] = text_sha256(ctx.std.fs.read_to_string("tools/kafka44/TransactionScenarios.java"))
        evidence["transaction_scenarios"] = {"oracle": _transactions(ctx, name, "localhost:9092", absolute)}
        for side, bootstrap in [("default", a.default_bootstrap), ("enabled", a.enabled_bootstrap)]:
            if bootstrap:
                evidence["transaction_scenarios"][side] = _transactions(ctx, "", bootstrap, absolute)
        evidence["transaction_differences"] = {
            side: scenario_differences(evidence["transaction_scenarios"]["oracle"]["stdout"], result["stdout"], 16)
            for side, result in evidence["transaction_scenarios"].items()
            if side != "oracle"
        }
    if a.transaction_scenarios:
        evidence["legacy_transaction_scenarios"] = {"oracle": _transactions(ctx, name, "localhost:9092", absolute, True)}
        for side, bootstrap in [("default", a.default_bootstrap), ("enabled", a.enabled_bootstrap)]:
            if bootstrap:
                evidence["legacy_transaction_scenarios"][side] = _transactions(ctx, "", bootstrap, absolute, True)
        evidence["legacy_transaction_differences"] = {
            side: scenario_differences(evidence["legacy_transaction_scenarios"]["oracle"]["stdout"], result["stdout"], 15)
            for side, result in evidence["legacy_transaction_scenarios"].items()
            if side != "oracle"
        }
    if a.transaction_scenarios:
        evidence["controller_recovery_fixture_sha256"] = text_sha256(ctx.std.fs.read_to_string("tools/kafka44/ControllerRecovery.java"))
        evidence["controller_before_restart"] = _controller_recovery(ctx, name, "prepare")

        # Only restart the isolated oracle owned by this invocation. Candidate
        # lifecycle belongs to its caller and is never inferred from endpoints.
        evidence["transaction_oracle_restart_kind"] = "SIGKILL" if a.oracle_crash_recovery else "clean-SIGTERM"
        if a.oracle_crash_recovery:
            evidence["transaction_oracle_stop"] = _command(ctx, ["docker", "kill", "--signal", "KILL", name], 60)
            evidence["transaction_oracle_restart"] = _command(ctx, ["docker", "start", name], 60)
        else:
            evidence["transaction_oracle_restart"] = _command(ctx, ["docker", "restart", "--time", "30", name], 60)
        for _ in range(30):
            result = _tool(ctx, ["kafka-topics.sh", "--list"], "localhost:9092", name, 10)
            if result["returncode"] == 0:
                break
        evidence["transaction_restart_readiness"] = result
        evidence["controller_after_restart"] = _controller_recovery(ctx, name, "recover")
        evidence["transaction_recovery"] = {
            "modern": _transaction_recovery(ctx, name, evidence["transaction_scenarios"]["oracle"]),
            "legacy": _transaction_recovery(ctx, name, evidence["legacy_transaction_scenarios"]["oracle"]),
        }
    failed = evidence.get("transaction_oracle_stop", {}).get("returncode", 0) != 0
    failed = failed or any([r["returncode"] for probes in evidence["sides"].values() for r in probes.values()])
    if a.streams_scenarios:
        failed = failed or any([r["returncode"] or len(scenario_results(r["stdout"])) != 9 for r in evidence["streams_scenarios"].values()]) or any(evidence["streams_differences"].values())
    evidence["status"] = "probe-failure" if failed else "collected-not-qualified"
    if a.protocol_scenarios:
        failed = failed or any([r["returncode"] for r in evidence["protocol_scenarios"].values()]) or any(evidence["protocol_differences"].values()) or len(scenario_results(evidence["protocol_scenarios"]["oracle"]["stdout"])) != 17 or "TRANSPORT:" in evidence["protocol_scenarios"]["oracle"]["stdout"]
    if a.protocol_scenarios:
        failed = failed or any([r["returncode"] for r in evidence["config_scenarios"].values()]) or any(evidence["config_differences"].values()) or len(scenario_results(evidence["config_scenarios"]["oracle"]["stdout"])) != 13
    if a.authorization_scenarios:
        failed = failed or any([r["returncode"] for r in evidence["authorization_scenarios"].values()]) or any(evidence["authorization_differences"].values()) or len(scenario_results(evidence["authorization_scenarios"]["oracle"]["stdout"])) != 10 or "TRANSPORT:" in evidence["authorization_scenarios"]["oracle"]["stdout"]
    if a.transaction_scenarios:
        failed = failed or evidence["controller_before_restart"]["returncode"] or len(scenario_results(evidence["controller_before_restart"]["stdout"])) != 3 or evidence["controller_after_restart"]["returncode"] or len(scenario_results(evidence["controller_after_restart"]["stdout"])) != 1
        failed = failed or evidence["transaction_oracle_restart"]["returncode"] or evidence["transaction_restart_readiness"]["returncode"] or any([r["returncode"] or len(scenario_results(r["stdout"])) != 2 for r in evidence["transaction_recovery"].values()])
        failed = failed or any([r["returncode"] for r in evidence["transaction_scenarios"].values()]) or any(evidence["transaction_differences"].values()) or len(scenario_results(evidence["transaction_scenarios"]["oracle"]["stdout"])) != 16
    if a.transaction_scenarios:
        failed = failed or any([r["returncode"] for r in evidence["legacy_transaction_scenarios"].values()]) or any(evidence["legacy_transaction_differences"].values()) or len(scenario_results(evidence["legacy_transaction_scenarios"]["oracle"]["stdout"])) != 15
    if a.streams_scenarios:
        failed = failed or any([r["returncode"] or len(scenario_results(r["stdout"])) != 9 for r in evidence["streams_scenarios"].values()]) or any(evidence["streams_differences"].values())
    evidence["status"] = "probe-failure" if failed else "collected-not-qualified"
    return 1 if failed else 0

kafka44 = task(
    summary = "Collect released Kafka 4.4 oracle/candidate evidence (not parity)",
    implementation = _impl,
    args = {"oracle_crash_recovery": args.boolean(default = False, description = "SIGKILL only the task-owned isolated oracle before transaction recovery instead of clean restart."), "streams_scenarios": args.boolean(default = False, description = "Execute nine positive reference in-memory Streams lifecycle cases (oracle and enabled candidate only)."), "transaction_scenarios": args.boolean(default = False, description = "Execute explicit v6 commit/abort offset-state scenarios on isolated brokers."), "authorization_scenarios": args.boolean(default = False, description = "Execute synthetic SASL user authorization and preauth routing probes."), "default_auth_bootstrap": args.string(default = "", description = "Isolated default SASL listener with synthetic denied user."), "enabled_auth_bootstrap": args.string(default = "", description = "Isolated enabled SASL listener with synthetic denied user."), "protocol_scenarios": args.boolean(default = False, description = "Execute seventeen released-codec negative protocol scenarios (not qualification)."), "default_controller": args.string(default = "", description = "Isolated default controller address."), "enabled_controller": args.string(default = "", description = "Isolated enabled controller address.")} | {name: args.string(default = "", description = description) for name, description in {
        "revision": "Exact candidate commit SHA.",
        "output": "New evidence directory.",
        "default_bootstrap": "Isolated default candidate address.",
        "enabled_bootstrap": "Isolated enabled candidate address.",
        "default_config": "Private effective default TOML.",
        "enabled_config": "Private effective enabled TOML.",
    }.items()},
)
