"""Decide which of CI's path-scoped jobs a change needs.

It answers three questions, one `GITHUB_OUTPUT` line each:

- `rust`: whether the change reaches the Rust build or its test inputs. CI
  uses it to skip the Cargo and wasm Clippy lanes on documentation-only pull
  requests. The Bazel build, lint and daemon-free tests still run. A KFC,
  style guide, README or workflow change cannot move what those lanes check;
  source, build rules and test fixtures can.
- `kubernetes`: whether the change reaches the kind smoke test's own inputs,
  the image packaging and the cluster manifests. A pull request that only
  changes broker code skips it; the nightly and the release gate run it.
- `proofs`: whether the change reaches what the Creusot proofs read, the
  proved crate, its in-workspace dependency, the proof sessions and the proof
  image. Anything else cannot invalidate a proof.

`container-suites` separately answers which container suites a change needs.
A wrong answer here could omit a useful run, so the rules are deliberately
generous: for `rust`, a file counts if it plausibly reaches a compiler, a
linker, a Bazel rule or a test fixture, and only a `.md` under `crates/` is
carved back out. The scheduled run takes every scope regardless, and a release
requires a green scheduled or dispatched run, so a scope that misses a file
delays the signal to the nightly rather than losing it.

It fails open. An unresolvable `--base` -- an empty one, a shallow clone that
does not reach the merge base, a branch force-pushed out from under the runner
-- means the diff is unknown, and an unknown diff runs every scope. The cost of
being wrong in that direction is one slower pull request; the other direction
can hide a regression until the nightly.

    aspect changed-scope --base origin/main
"""

load("./changes.axl", "run", "valid_base")
load("./repo.axl", "starts_with_any")

# Root files that redefine the build for every crate at once: the workspace
# manifest and its lock, the Bazel module the `@crates` repo is generated from
# and its resolved graph, the flags every `bazel` invocation inherits, the two
# pinned toolchains, the lint and format configuration those toolchains read,
# and the coverage upload's own settings. None of these is a `.rs` file and
# every one of them can change what a Rust job produces or where its result
# goes.
BUILD_FILES = [
    ".bazelrc",
    ".bazelversion",
    "Cargo.lock",
    "Cargo.toml",
    "MODULE.bazel",
    "MODULE.bazel.lock",
    "clippy.toml",
    "codecov.yml",
    "rust-toolchain.toml",
    "rustfmt.toml",
]

# Directories that feed the build without being crates. `bazel/` holds the rule
# definitions every `BUILD.bazel` calls, `packaging/` builds the image the
# container suites load, and `tools/` holds the lint aspects and the toolchains
# the actions run under. `.cargo/` holds the Cargo config, whose per-target
# rustflags (the wasm lane's `tokio_unstable` among them) change what Cargo
# compiles. An edit in any of them changes what a Rust job does without
# touching a `.rs` file.
BUILD_PREFIXES = [".cargo/", "bazel/", "packaging/", "tools/"]

# Generated artifacts and example configs that live under `docs/` but are Rust
# test inputs. `crates/broker/BUILD.bazel` names every one of them in the
# `data` of its test targets, where `config_reference`, `docgen_contract`,
# `example_broker_toml` and `metrics_contract` read them back and compare or
# parse them against what the code produces.
#
# They have to be listed because the `crates/` rule below cannot see them, and
# the `.md` carve-out would drop `config-reference.md` even if it could.
# These inputs can change test behavior and coverage, so they need the same
# scope decision as source changes. The `ci` job's daemon-free tests run their
# Rust contract checks even when coverage is skipped. Regenerating the
# reference *from* the schema alone does not compare it against `FileConfig`.
#
# The two directories are whole prefixes rather than the seven exact files, so
# that a file added to one of those `data` attributes is covered before anyone
# remembers this list exists.
# `bench/scenarios/` is the same kind of input from outside `docs/`:
# `crates/bench-driver/BUILD.bazel` names `//bench:scenarios` in the `data` of
# its test targets, and `scenario_files` loads every one of those YAML files
# through the driver's own `Scenario` type. A scenario edited alone must
# therefore qualify for coverage just as a test-source change does.
DATA_FILES = ["docs/config-reference.md", "docs/config-schema.json"]
DATA_PREFIXES = ["bench/scenarios/", "docs/examples/", "docs/operations/"]

# The kind smoke test's inputs. `packaging/` builds the image it loads and
# holds the manifests and the script it applies; `.github/kind.yaml` shapes
# the cluster. The workflow itself is here so that an edit to the job runs the
# job it edits.
CI_WORKFLOW = ".github/workflows/ci.yml"
KUBERNETES_FILES = [".github/kind.yaml", CI_WORKFLOW]
KUBERNETES_PREFIXES = ["packaging/"]

# What the Creusot proofs read. `crates/verified/` is the one proved package
# (`check-creusot-packages` keeps that list honest) and `crates/macros/` its one
# in-workspace dependency. `verif/` holds the checked-in proof sessions and
# `tools/creusot/` the image they run in, whose Creusot release
# `.creusot-version` pins and whose base `MODULE.bazel` pins. The workspace
# manifest, lock and toolchain decide what `cargo creusot` compiles.
PROOFS_FILES = [
    ".creusot-version",
    "Cargo.lock",
    "Cargo.toml",
    "MODULE.bazel",
    "rust-toolchain.toml",
    CI_WORKFLOW,
]
PROOFS_PREFIXES = ["crates/macros/", "crates/verified/", "tools/creusot/", "verif/"]

# Where the code is. Everything under it counts except documentation: a crate's
# README and changelog are checked by their own tasks, which do not need a
# compiler.
SOURCE_PREFIX = "crates/"
DOC_SUFFIX = ".md"

def touches_rust(paths):
    """Whether any of `paths` can change what the Rust build or its tests do."""
    for raw_path in paths:
        path = raw_path.strip().replace("\\", "/")
        if not path:
            continue
        if path in BUILD_FILES or path in DATA_FILES:
            return True
        if starts_with_any(path, BUILD_PREFIXES) or starts_with_any(path, DATA_PREFIXES):
            return True
        if path.startswith(SOURCE_PREFIX) and not path.endswith(DOC_SUFFIX):
            return True
    return False

def _touches(paths, files, prefixes):
    for raw_path in paths:
        path = raw_path.strip().replace("\\", "/")
        if path and (path in files or starts_with_any(path, prefixes)):
            return True
    return False

def touches_kubernetes(paths):
    """Whether any of `paths` can change what the kind smoke test does."""
    return _touches(paths, KUBERNETES_FILES, KUBERNETES_PREFIXES)

def touches_proofs(paths):
    """Whether any of `paths` can change what the Creusot proofs prove."""
    return _touches(paths, PROOFS_FILES, PROOFS_PREFIXES)

# The scopes, in the order the task prints them.
SCOPES = ["rust", "kubernetes", "proofs"]

def decide(base_resolved, paths):
    """Which scoped jobs should run, given a diff that may not exist.

    Returns a dict from each name in `SCOPES` to whether its jobs run.

    `base_resolved` is whether Git could turn the `--base` this task was handed
    into a commit. When it could not, `paths` says nothing about the change and
    the conservative answer is to run everything: this is the fail-open case,
    and it is a branch of its own rather than an empty list flowing through the
    `touches_*` functions, because an empty diff and an unknown diff are
    opposite answers.
    """
    if not base_resolved:
        return {scope: True for scope in SCOPES}
    return {
        "rust": touches_rust(paths),
        "kubernetes": touches_kubernetes(paths),
        "proofs": touches_proofs(paths),
    }

def _changed(ctx, base):
    """`(base resolved, changed paths)` for the diff against `base`.

    The comparison is `base...HEAD`, the same one `container-suites` uses, so
    the two tasks are never gating on different sets of files: it is the diff
    from the merge base, which is what the pull request actually proposes
    rather than everything that has landed on the target branch since.
    """
    if not valid_base(ctx, base):
        return False, []
    return True, run(ctx, "git", ["diff", "--name-only", base + "...HEAD"])

def _impl(ctx: TaskContext) -> int:
    resolved, paths = _changed(ctx, ctx.args.base)
    lines = output_lines(decide(resolved, paths))

    github_output = ctx.std.env.var("GITHUB_OUTPUT")
    if github_output:
        if not ctx.std.fs.try_append(github_output, "".join([line + "\n" for line in lines])):
            fail("could not append the changed scope to GITHUB_OUTPUT")

    # The reason, not just the verdict: a job that was skipped is invisible in
    # the run summary, so the log of the step that skipped it is the only place
    # anyone can find out why.
    reason = "from the diff against --base"
    if not resolved:
        reason = "no resolvable --base, so the diff is unknown and every scope runs"
    for line in lines:
        ctx.std.io.stdout.write("%s (%s)\n" % (line, reason))
    return 0

def output_lines(scopes):
    """The `name=true|false` lines for `scopes`, in `SCOPES` order."""
    return ["%s=%s" % (scope, "true" if scopes[scope] else "false") for scope in SCOPES]

changed_scope = task(
    summary = "Decide which path-scoped CI jobs a change needs",
    implementation = _impl,
    args = {
        "base": args.string(
            default = "",
            description = "Git commit to compare with HEAD.",
        ),
    },
)
