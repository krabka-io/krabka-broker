    "./generate_kip_matrix.axl",
    "annotation_bodies",
    "api_versions_rows",
    "catalog_outside_annotations",
    "citations",
    "const_str_value",
    "decision_row_problem",
    "declares_fn",
    "defines_fn",
    "digest_for",
    "docker_map",
    "image_for",
    "image_legend",
    "intent_cell",
    "intent_problem",
    "is_word_char",
    "kafka_image_keys",
    "kcat_evidence",
    "kip_mentions",
    "kip_order",
    "kip_order_key",
    "kip_row",
    "librdkafka_clients",
    "link_citations",
    "log_contract_rows",
    "parse_annotations",
    "parse_divergences",
    "render_page",
    "suite_stem",
    "test_cell",
    "throttle_echo_rows",
)
load("./testing.axl", "check", "check_eq", "suite", "suite_task")

def _test_word_characters(_ctx):
    check_eq("underscore is a word character", is_word_char("_"), True)
    check_eq("a digit is", is_word_char("4"), True)
    check_eq("a hyphen is not", is_word_char("-"), False)
    check_eq("a dot is not", is_word_char("."), False)

def _test_const_str_value(_ctx):
    source = "\n".join([
        "use std::fmt;",
        'const KAFKA_IMAGE: &str = "mirror.gcr.io/confluentinc/cp-kafka";',
        'const KAFKA_TAG: &str = "6.1.1";',
        'pub(crate) const ORACLE_IMAGE: &str = "mirror.gcr.io/apache/kafka:4.3.1";',
    ])
    check_eq(
        "the image",
        const_str_value(source, 'const KAFKA_IMAGE: &str = "'),
        "mirror.gcr.io/confluentinc/cp-kafka",
    )
    check_eq("the tag", const_str_value(source, 'const KAFKA_TAG: &str = "'), "6.1.1")
    check_eq(
        "the visibility is part of the declaration",
        const_str_value(source, 'pub(crate) const ORACLE_IMAGE: &str = "'),
        "mirror.gcr.io/apache/kafka:4.3.1",
    )
    check_eq(
        "a missing constant",
        const_str_value(source, 'const MISSING: &str = "'),
        "",
    )

def _test_const_str_value_is_anchored_and_terminated(_ctx):
    # The original anchored at column zero and required the closing `";`, so an
    # indented declaration, an empty value and a value the line does not
    # terminate all read as absent.
    check_eq(
        "an indented declaration",
        const_str_value('    const NAME: &str = "x";', 'const NAME: &str = "'),
        "",
    )
    check_eq("an empty value", const_str_value('const NAME: &str = "";', 'const NAME: &str = "'), "")
    check_eq(
        "an unterminated value",
        const_str_value('const NAME: &str = "x"', 'const NAME: &str = "'),
        "",
    )
    check_eq(
        "a later line still matches",
        const_str_value(
            "\n".join(['    const NAME: &str = "wrong";', 'const NAME: &str = "right";']),
            'const NAME: &str = "',
        ),
        "right",
    )

def _test_defines_fn(_ctx):
    source = "\n".join([
        "#[tokio::test]",
        "async fn read_jvm_produced_log_dir() {",
        "fn helper() {",
        "    fn nested() {",
    ])
    check_eq("an async test", defines_fn(source, "read_jvm_produced_log_dir", prefix = "async fn "), True)
    check_eq("a plain fn", defines_fn(source, "helper"), True)
    check_eq("the prefix matters", defines_fn(source, "read_jvm_produced_log_dir"), False)
    check_eq("an indented fn is not at column zero", defines_fn(source, "nested"), False)
    check_eq("an absent fn", defines_fn(source, "absent"), False)

def _test_declares_fn(_ctx):
    source = "\n".join([
        "    fn round_trip(&self) {",
        "    fn encodes_at<T: Encode>(value: T) {",
        "    fn read_all() {",
        "    let handler = myfn other();",
    ])
    check_eq("a method", declares_fn(source, "round_trip"), True)
    check_eq("a generic function", declares_fn(source, "encodes_at"), True)
    check_eq("a prefix of a longer name is not the name", declares_fn(source, "read"), False)
    check_eq("the whole name is", declares_fn(source, "read_all"), True)
    check_eq("`fn` needs its own word boundary", declares_fn(source, "other"), False)
    check_eq("an absent function", declares_fn(source, "absent"), False)

def _test_image_for(_ctx):
    images = "\n".join([
        "IMAGES = {",
        '    "apache_kafka_4_3_1": "mirror.gcr.io/apache/kafka:4.3.1",',
        '    "kcat_1_7_1": "mirror.gcr.io/edenhill/kcat:1.7.1",',
        "}",
    ])
    check_eq("a Kafka image", image_for(images, "apache_kafka_4_3_1"), "mirror.gcr.io/apache/kafka:4.3.1")
    check_eq("the client image", image_for(images, "kcat_1_7_1"), "mirror.gcr.io/edenhill/kcat:1.7.1")
    check_eq("an unknown key", image_for(images, "cp_kafka_7_5_0"), "")
    check_eq(
        "a key that only prefixes a real one",
        image_for(images, "apache_kafka_4_3"),
        "",
    )

def _test_digest_for_reads_the_last_field(_ctx):
    # The pin is the last quoted field whatever the fields before it are. An
    # earlier pattern counted them and stopped matching when rules_img widened
    # the row from `(name, tag, digest)` to five fields.
    narrow = '        ("cp_kafka_7_5_0", "7.5.0", "sha256:beef"),'
    wide = '        ("cp_kafka_7_5_0", "mirror.gcr.io", "confluentinc/cp-kafka", "7.5.0", "sha256:beef"),'
    check_eq("a three-field row", digest_for(narrow, "cp_kafka_7_5_0"), "sha256:beef")
    check_eq("the same row, widened", digest_for(wide, "cp_kafka_7_5_0"), "sha256:beef")
    check_eq("an unknown key", digest_for(wide, "kcat_1_7_1"), "")

def _test_digest_for_needs_a_trailing_digest(_ctx):
    check_eq(
        "a digest that is not the last field",
        digest_for('("k", "sha256:beef", "7.5.0")', "k"),
        "",
    )
    check_eq(
        "a row with nothing between the key and the digest",
        digest_for('("k", "sha256:beef")', "k"),
        "",
    )
    check_eq(
        "a last field that is not a digest",
        digest_for('("k", "mirror.gcr.io", "7.5.0")', "k"),
        "",
    )

def _test_parse_divergences(_ctx):
    audit = "\n".join([
        "const THROTTLE_ECHO_DIVERGENCES: &[(ApiKeyCode, ApiVersion, ApiVersion, QuotaReach)] = &[",
        "    (0, 1, 13, QuotaReach::SelfAccounted),          // Produce",
        "    (18, 1, 5, QuotaReach::FallbackAccounted),      // ApiVersions",
        "    (47, 0, 0, QuotaReach::UnsupportedVersionOnly), // OffsetDelete",
        "];",
        "",
        "fn unrelated(a: u8) {}",
    ])
    check_eq(
        "one triple per entry, with the range the table shows",
        parse_divergences(audit),
        [
            (0, "1-13", "SelfAccounted"),
            (18, "1-5", "FallbackAccounted"),
            (47, "0", "UnsupportedVersionOnly"),
        ],
    )

def _test_parse_divergences_tolerates_formatting(_ctx):
    audit = "\n".join([
        "const THROTTLE_ECHO_DIVERGENCES: &[(u16, u16, u16, QuotaReach)] = &[",
        "    (",
        "        38,",
        "        1,",
        "        3,",
        "        QuotaReach::UnsupportedVersionOnly,",
        "    ),",
        "];",
    ])
    check_eq(
        "a row the formatter broke across lines, with a trailing comma",
        parse_divergences(audit),
        [(38, "1-3", "UnsupportedVersionOnly")],
    )

_DIVERGENCES = [
    (0, "1-13", "SelfAccounted"),
    (18, "1-5", "FallbackAccounted"),
    (38, "1-3", "UnsupportedVersionOnly"),
    (39, "1-2", "UnsupportedVersionOnly"),
    (40, "1-2", "UnsupportedVersionOnly"),
    (41, "1-3", "UnsupportedVersionOnly"),
    (47, "0", "UnsupportedVersionOnly"),
]

def _test_throttle_echo_rows(_ctx):
    rows = throttle_echo_rows(_DIVERGENCES).splitlines()
    check_eq("one row per divergence", len(rows), len(_DIVERGENCES))
    check_eq(
        "the Produce row",
        rows[0],
        "| Produce | 0 | 1-13 | Sits behind the `Responses` array, at an offset the " +
        "response header does not fix | None. The handler charges its own quota and sets " +
        "`ThrottleTimeMs` on the typed response before encoding, so the client does see the delay |",
    )
    check_eq(
        "the OffsetDelete row, whose range is a single version",
        rows[6],
        "| OffsetDelete | 47 | 0 | Leads with `ErrorCode`; the field is at a fixed offset of 2, " +
        "but the dispatch loop patches leading fields only | The ordinary path is `InlineExempt`, " +
        "so it is never held. Only a request outside the advertised version range is, and that " +
        "reply reports `throttle_time_ms = 0` |",
    )

_ANNOTATIONS = "\n".join([
    "// BEGIN KIP_ANNOTATIONS",
    "pub const KIP_ANNOTATIONS: &[KipAnnotation] = &[",
    "    KipAnnotation {",
    '        key: "KIP-13",',
    '        claim: "Producer and consumer byte-rate quotas",',
    "        status: KipStatus::Implemented,",
    '        module: "crates/broker/src/quota/mod.rs",',
    "        tests: &[",
    '            "crates/broker/tests/client_quotas.rs",',
    '            "crates/broker/tests/client_quotas/throttling.rs",',
    "        ],",
    "        clients: ClientEvidence::NotCovered,",
    '        note: "",',
    "    },",
    "    KipAnnotation {",
    '        key: "mixed-quorum",',
    '        claim: "A controller quorum with both JVM and Krabka voters",',
    "        status: KipStatus::OutOfScope,",
    '        module: "crates/raft/src/lib.rs",',
    "        tests: &[],",
    "        clients: ClientEvidence::Kcat,",
    '        note: "Outside the target: crates/raft/src/lib.rs:52.",',
    "    },",
    "];",
    "// END KIP_ANNOTATIONS",
])

def _test_annotation_bodies(_ctx):
    bodies = annotation_bodies(_ANNOTATIONS)
    check_eq("one body per literal", len(bodies), 2)
    check_eq("the element type is not a literal", bodies[0].find("KIP_ANNOTATIONS"), -1)
    check_eq("the body opens after the brace", bodies[0].splitlines()[0], "")
    check_eq(
        "and stops before the closing line",
        bodies[0].splitlines()[-1],
        '        note: "",',
    )

def _test_parse_annotations(_ctx):
    rows = parse_annotations(_ANNOTATIONS, "catalog.rs")
    check_eq(
        "the first row",
        rows[0],
        struct(
            key = "KIP-13",
            claim = "Producer and consumer byte-rate quotas",
            status = "Implemented",
            module = "crates/broker/src/quota/mod.rs",
            tests = [
                "crates/broker/tests/client_quotas.rs",
                "crates/broker/tests/client_quotas/throttling.rs",
            ],
            clients = "NotCovered",
            note = "",
        ),
    )
    check_eq(
        "the scope row, whose tests are empty and whose note is not",
        rows[1],
        struct(
            key = "mixed-quorum",
            claim = "A controller quorum with both JVM and Krabka voters",
            status = "OutOfScope",
            module = "crates/raft/src/lib.rs",
            tests = [],
            clients = "Kcat",
            note = "Outside the target: crates/raft/src/lib.rs:52.",
        ),
    )

def _test_catalog_outside_annotations(_ctx):
    catalog = "before\n// BEGIN KIP_ANNOTATIONS\nKIP-13\n// END KIP_ANNOTATIONS\nafter"
    check_eq(
        "the block the inventory must not count itself from",
        catalog_outside_annotations(catalog),
        "before\n// END KIP_ANNOTATIONS\nafter",
    )
    check_eq("no markers, no cut", catalog_outside_annotations("plain"), "plain")

def _test_kip_mentions(_ctx):
    check_eq(
        "sorted and deduplicated",
        kip_mentions("KIP-848 and KIP-98, then KIP-848 again"),
        ["KIP-848", "KIP-98"],
    )
    check_eq("a link fragment still counts", kip_mentions("(KIP-500)."), ["KIP-500"])

def _test_kip_mentions_needs_whole_words(_ctx):
    check_eq("a word character in front", kip_mentions("xKIP-13"), [])
    check_eq("a word character behind", kip_mentions("KIP-13a"), [])
    check_eq("no digits at all", kip_mentions("KIP-"), [])
    check_eq("a hyphen behind is a boundary", kip_mentions("KIP-13-rc"), ["KIP-13"])
    check_eq("a non-word character in front is a boundary", kip_mentions("-KIP-13."), ["KIP-13"])

def _test_kip_order(_ctx):
    check_eq(
        "KIPs by number, then the scope rows by name",
        kip_order(["mixed-quorum", "KIP-98", "KIP-13", "KIP-848", "byte-rate"]),
        ["KIP-13", "KIP-98", "KIP-848", "byte-rate", "mixed-quorum"],
    )
    check_eq("a KIP sorts on its number", kip_order_key("KIP-848"), (0, 848, ""))
    check_eq("a scope row sorts on its name", kip_order_key("mixed-quorum"), (1, 0, "mixed-quorum"))

