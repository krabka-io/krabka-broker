])

def _test_docker_map(_ctx):
    check_eq(
        "stem to image keys, with the nested map after it left out",
        docker_map(_BUILD),
        {
            "api_versions_differential": ["apache_kafka_4_3_1"],
            "jvm_acceptance_tiered": ["cp_kafka_6_1_1", "minio"],
            "librdkafka_conformance": ["kcat_1_7_1"],
        },
    )
    check_eq("no docker map", docker_map("crate_tests(name = \"log\")"), {})

def _test_docker_map_ignores_commented_entries(_ctx):
    check_eq(
        "a commented-out key is not a live one",
        "retired_suite" in docker_map(_BUILD),
        False,
    )

def _test_suite_stem(_ctx):
    check_eq(
        "a suite file",
        suite_stem("crates/broker/tests/client_quotas.rs"),
        struct(crate = "broker", stem = "client_quotas"),
    )
    check_eq(
        "a file inside a suite directory",
        suite_stem("crates/broker/tests/client_quotas/throttling.rs"),
        struct(crate = "broker", stem = "client_quotas"),
    )
    check_eq("a unit test runs in process", suite_stem("crates/broker/src/quota/mod.rs"), None)
    check_eq("a crate root", suite_stem("crates/log/lib.rs"), None)

def _test_kafka_image_keys(_ctx):
    check_eq(
        "only the broker images reach the column",
        kafka_image_keys(["cp_kafka_6_1_1", "minio", "kcat_1_7_1", "apache_kafka_4_3_1", "minio_mc"]),
        ["cp_kafka_6_1_1", "apache_kafka_4_3_1"],
    )

def _test_citations(_ctx):
    note = "reads it (crates/broker/src/handlers/init_producer_id.rs:157), so a stale epoch"
    found = citations(note)
    check_eq("one citation", len(found), 1)
    check_eq("the path", found[0].path, "crates/broker/src/handlers/init_producer_id.rs")
    check_eq("the line", found[0].line, 157)
    check_eq("the span ends at the digits", note[found[0].start:found[0].end], "crates/broker/src/handlers/init_producer_id.rs:157")

def _test_citations_needs_a_whole_reference(_ctx):
    check_eq("no line number", citations("see crates/raft/src/lib.rs and stop"), [])
    check_eq("no .rs extension", citations("see crates/raft/src/lib.md:52."), [])
    check_eq("a word character behind the line", citations("see crates/raft/src/lib.rs:52a."), [])
    check_eq("a word character in front", citations("xcrates/raft/src/lib.rs:52."), [])
    check_eq("a path outside crates/", citations("see docs/raft.rs:52."), [])
    check_eq("a bare directory", citations("crates/.rs:1"), [])

def _test_link_citations(_ctx):
    note = "out of scope: crates/raft/src/lib.rs:52. See crates/raft/src/lib.rs:60 too."
    check_eq(
        "both citations become links and the prose survives",
        link_citations(note, {"crates/raft/src/lib.rs": 80}),
        "out of scope: [`crates/raft/src/lib.rs:52`](../crates/raft/src/lib.rs#L52). " +
        "See [`crates/raft/src/lib.rs:60`](../crates/raft/src/lib.rs#L60) too.",
    )
    check_eq("a note with nothing to link", link_citations("plain note", {}), "plain note")

_CITATION = "crates/raft/src/lib.rs:52"
_CITED = "out of scope: crates/raft/src/lib.rs:52."

def _decision(key, status, note):
    """The complaint `decision_row_problem` makes about one row."""
    row = struct(key = key, status = status, note = note)
    return decision_row_problem(row, "mixed-quorum", "KIP-590", _CITATION)

def _test_decision_row_problem(_ctx):
    check_eq(
        "a row the decision does not touch",
        _decision("KIP-500", "Partial", ""),
        "",
    )
    check_eq(
        "the mixed-quorum row citing the decision",
        _decision("mixed-quorum", "OutOfScope", _CITED),
        "",
    )
    check_eq(
        "the served-only forwarding row",
        _decision("KIP-590", "Implemented", _CITED),
        "",
    )

def _test_decision_row_problem_rejects(_ctx):
    check_eq(
        "the mixed-quorum row dropping the citation",
        _decision("mixed-quorum", "OutOfScope", "no citation"),
        "mixed-quorum does not cite %s" % _CITATION,
    )
    check_eq(
        "the forwarding row dropping the citation",
        _decision("KIP-590", "Implemented", "no citation"),
        "KIP-590 does not cite %s" % _CITATION,
    )
    check_eq(
        "the forwarding row back to Partial",
        _decision("KIP-590", "Partial", _CITED),
        "KIP-590 serves Envelope and needs no broker half; it is Partial, not Implemented",
    )

def _test_librdkafka_clients(_ctx):
    suite = "\n".join([
        "const CLIENTS: [ClientCase; 2] = [",
        "    ClientCase {",
        '        image: "mirror.gcr.io/edenhill/kcat:1.7.1",',
        '        program: "kcat",',
        '        library: "librdkafka 1.8.2",',
        '        version_marker: "librdkafka 1.8.2",',
        "    },",
        "    ClientCase {",
        '        image: "mirror.gcr.io/example/rdkafka-example:2",',
        '        program: "rdkafka_example",',
        '        library: "librdkafka 2.x",',
        '        version_marker: "librdkafka 2.",',
        "    },",
        "];",
    ])
    check_eq(
        "one triple per client, in table order",
        librdkafka_clients(suite),
        [
            ("mirror.gcr.io/edenhill/kcat:1.7.1", "kcat", "librdkafka 1.8.2"),
            ("mirror.gcr.io/example/rdkafka-example:2", "rdkafka_example", "librdkafka 2.x"),
        ],
    )

def _test_log_contract_rows(_ctx):
    rows = log_contract_rows("mirror.gcr.io/confluentinc/cp-kafka:6.1.1@sha256:beef").splitlines()
    check_eq("one row per direction", len(rows), 2)
    check_eq(
        "the JVM-first row",
        rows[0],
        "| JVM -> krabka | Implemented | Open and read a JVM-written Kafka log directory | " +
        "[`crates/log`](../crates/log) | " +
        "[`read_jvm_produced_log_dir`](../crates/log/tests/integration.rs) | " +
        "`mirror.gcr.io/confluentinc/cp-kafka:6.1.1@sha256:beef` |",
    )

def _test_api_versions_rows(_ctx):
    report = {"apis": [
        {
            "api_key": 0,
            "name": "Produce",
            "krabka": {"min": 0, "max": 13},
            "kafka": {"min": 0, "max": 13},
            "verdict": "same",
            "intent": None,
        },
        {
            "api_key": 1,
            "name": "Fetch",
            "krabka": {"min": 0, "max": 18},
            "kafka": {"min": 4, "max": 18},
            "verdict": "range_differs",
            "intent": "Intended: krabka still serves the pre-v4 request shapes.",
        },
        {
            "api_key": 72,
            "name": "GetTelemetrySubscriptions",
            "krabka": {"min": 0, "max": 0},
            "kafka": None,
            "verdict": "krabka_only",
            "intent": None,
        },
    ]}
    check_eq(
        "a matching key, a divergence carrying its intent, and a krabka-only key",
        api_versions_rows(report),
        "| Produce | 0 | 0-13 | 0-13 | match | -- |\n" +
        "| Fetch | 1 | 0-18 | 4-18 | range differs | " +
        "Intended: krabka still serves the pre-v4 request shapes. |\n" +
        "| GetTelemetrySubscriptions | 72 | 0-0 | not advertised | krabka only | -- |",
    )

def _test_intent_cell(_ctx):
    check_eq(
        "a range divergence renders its recorded sentence",
        intent_cell({"api_key": 18, "verdict": "range_differs", "intent": "Intended: KIP-1242."}),
        "Intended: KIP-1242.",
    )
    for verdict in ["same", "krabka_only", "kafka_only"]:
        check_eq(
            "a %s row has nothing to explain" % verdict,
            intent_cell({"api_key": 3, "verdict": verdict, "intent": None}),
            "--",
        )

def _test_intent_problem(_ctx):
    check_eq(
        "a range divergence carrying its sentence",
        intent_problem({"api_key": 18, "verdict": "range_differs", "intent": "Intended."}),
        "",
    )
    check_eq(
        "a matching range with nothing recorded",
        intent_problem({"api_key": 3, "verdict": "same", "intent": None}),
        "",
    )

def _test_intent_problem_rejects(_ctx):
    check_eq(
        "a range divergence with no intent",
        intent_problem({"api_key": 1, "verdict": "range_differs", "intent": None}),
        "api key 1 differs in range and records no intent",
    )
    check_eq(
        "a range divergence whose intent is empty",
        intent_problem({"api_key": 1, "verdict": "range_differs", "intent": ""}),
        "api key 1 differs in range and records no intent",
    )
    check_eq(
        "an intent recorded on a matching range",
        intent_problem({"api_key": 3, "verdict": "same", "intent": "why?"}),
        "api key 3 records an intent but its verdict is same",
    )

def _test_kcat_evidence(_ctx):
    check_eq(
        "the client-family cell names the tag, not the whole image",
        kcat_evidence("mirror.gcr.io/edenhill/kcat:1.7.1", "kcat", "librdkafka 1.8.2"),
        "kcat 1.7.1 (librdkafka 1.8.2): " +
        "[`round_trip_group_join_and_api_versions_with_kcat`]" +
        "(../crates/broker/tests/librdkafka_conformance.rs)",
    )

def _row(status = "Implemented", clients = "NotCovered"):
    return struct(
        key = "KIP-13",
        claim = "Producer and consumer byte-rate quotas",
        status = status,
        module = "crates/broker/src/quota/mod.rs",
        tests = [],
        clients = clients,
        note = "",
    )

def _test_kip_row(_ctx):
    check_eq(
        "a row with tests and an image",
        kip_row(
            _row(),
            [test_cell("crates/broker/tests/client_quotas.rs", "crates/broker/tests/client_quotas.rs")],
            ["cp_kafka_6_1_1"],
            "kcat 1.7.1",
            "",
        ),
        "| KIP-13 | Implemented | Producer and consumer byte-rate quotas | " +
        "[`broker/src/quota/mod.rs`](../crates/broker/src/quota/mod.rs) | " +
        "[`broker/tests/client_quotas.rs`](../crates/broker/tests/client_quotas.rs) | " +
        "`cp_kafka_6_1_1` | none |  |",
    )

def _test_kip_row_without_evidence(_ctx):
    check_eq(
        "an out-of-scope row runs in process and lists no test",
        kip_row(_row(status = "OutOfScope", clients = "Kcat"), [], [], "kcat 1.7.1", "a note"),
        "| KIP-13 | Out of scope | Producer and consumer byte-rate quotas | " +
        "[`broker/src/quota/mod.rs`](../crates/broker/src/quota/mod.rs) | " +
        "none | in process | kcat 1.7.1 | a note |",
    )

def _test_test_cell(_ctx):
    check_eq(
        "a function entry is shown whole but links to the file",
        test_cell(
            "crates/log/tests/integration.rs::read_jvm_produced_log_dir",
            "crates/log/tests/integration.rs",
        ),
        "[`log/tests/integration.rs::read_jvm_produced_log_dir`](../crates/log/tests/integration.rs)",
    )

def _test_image_legend(_ctx):
    images = 'IMAGES = {\n    "cp_kafka_6_1_1": "cp-kafka:6.1.1",\n    "apache_kafka_4_3_1": "kafka:4.3.1",\n}'
    module = "\n".join([
        '        ("apache_kafka_4_3_1", "mirror.gcr.io", "apache/kafka", "4.3.1", "sha256:aaa"),',
        '        ("cp_kafka_6_1_1", "mirror.gcr.io", "confluentinc/cp-kafka", "6.1.1", "sha256:bbb"),',
    ])
    check_eq(
        "the legend is sorted by key",
        image_legend({"cp_kafka_6_1_1": True, "apache_kafka_4_3_1": True}, images, module),
        "| `apache_kafka_4_3_1` | `kafka:4.3.1@sha256:aaa` |\n" +
        "| `cp_kafka_6_1_1` | `cp-kafka:6.1.1@sha256:bbb` |",
    )

def _test_render_page(_ctx):
    page = render_page("KIP", "LEGEND", "log-image", "LOG", "api-image", "API", "THROTTLE")
    check_eq("the title", page.splitlines()[0], "# Kafka KIP compatibility matrix")
    check_eq("the page ends with the throttle rows", page.endswith("\nTHROTTLE\n"), True)
    for section in ["KIP", "LEGEND", "LOG", "API"]:
        check(page.find("\n" + section + "\n") >= 0, "the %s section is substituted" % section)
    check(page.find("It ran against\n`log-image`.") >= 0, "the log image is named")
    check(page.find("The oracle is `api-image`.") >= 0, "the oracle is named")

generate_kip_matrix_tests = suite("generate-kip-matrix", [
    _test_word_characters,
    _test_const_str_value,
    _test_const_str_value_is_anchored_and_terminated,
    _test_defines_fn,
    _test_declares_fn,
    _test_image_for,
    _test_digest_for_reads_the_last_field,
    _test_digest_for_needs_a_trailing_digest,
    _test_parse_divergences,
    _test_parse_divergences_tolerates_formatting,
    _test_throttle_echo_rows,
    _test_annotation_bodies,
    _test_parse_annotations,
    _test_catalog_outside_annotations,
    _test_kip_mentions,
    _test_kip_mentions_needs_whole_words,
    _test_kip_order,
    _test_docker_map,
    _test_docker_map_ignores_commented_entries,
    _test_suite_stem,
    _test_kafka_image_keys,
    _test_citations,
    _test_citations_needs_a_whole_reference,
    _test_link_citations,
    _test_decision_row_problem,
    _test_decision_row_problem_rejects,
    _test_librdkafka_clients,
    _test_log_contract_rows,
    _test_api_versions_rows,
    _test_intent_cell,
    _test_intent_problem,
    _test_intent_problem_rejects,
    _test_kcat_evidence,
    _test_kip_row,
    _test_kip_row_without_evidence,
    _test_test_cell,
    _test_image_legend,
    _test_render_page,
])

test_generate_kip_matrix = suite_task(generate_kip_matrix_tests)
