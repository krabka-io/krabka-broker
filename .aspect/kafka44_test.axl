"""Input safety tests for the released Kafka evidence task."""

load("./kafka44.axl", "api_differences", "authorization_input_problems", "input_problems", "scenario_differences", "transaction_recovery_args")
load("./testing.axl", "check_eq", "suite", "suite_task")

def _test_revision(_ctx):
    for value in ["", "a" * 39, "A" * 40, "g" * 40, "a" * 41]:
        check_eq("invalid revision", len(input_problems(value, ["", "", "", ""])), 1)
    check_eq("exact revision", input_problems("a" * 40, ["", "", "", ""]), [])

def _test_candidate_pairs(_ctx):
    for mask in range(1, 15):
        inputs = ["present" if mask // power % 2 else "" for power in [1, 2, 4, 8]]
        check_eq("partial candidate configuration", len(input_problems("a" * 40, inputs)), 1)
    check_eq("paired candidates", input_problems("a" * 40, ["a", "b", "c", "d"]), [])

def _test_api_differences(_ctx):
    check_eq("missing output fails", api_differences("", ""), [{"error": "missing parsed API rows"}])
    reference = "host (id: 1) -> (\n\tApiVersions(18): 0 to 5 [usable: 5],\n)"
    check_eq("endpoint identity ignored", api_differences(reference, reference.replace("host", "elsewhere")), [])
    check_eq("version regression", api_differences(reference, reference.replace("0 to 5", "0 to 4")), [{"api": "ApiVersions(18)", "oracle": "0 to 5", "candidate": "0 to 4"}])

def _test_protocol_differences(_ctx):
    check_eq("empty fixture output fails", scenario_differences("", ""), [{"error": "missing protocol scenario rows"}])
    rows = "\n".join(["SCENARIO\tcase-" + str(i) + "\t{NONE=1}" for i in range(17)])
    check_eq("equal errors", scenario_differences(rows, rows), [])
    changed = rows.replace("case-0\t{NONE=1}", "case-0\t{INVALID_REQUEST=1}")
    check_eq("error mismatch retained", scenario_differences(rows, changed), [{"scenario": "case-0", "oracle": "{NONE=1}", "candidate": "{INVALID_REQUEST=1}"}])
    transport = rows.replace("case-0\t{NONE=1}", "case-0\tTRANSPORT:EOFException")
    check_eq("equal disconnect is not parity", len(scenario_differences(transport, transport)), 1)

def _test_authorization_inputs(_ctx):
    for enabled, protocol, candidate, endpoints, expected in [
        (False, False, False, ["", ""], 0),
        (True, True, False, ["", ""], 0),
        (True, False, False, ["", ""], 1),
        (True, True, True, ["a", ""], 1),
        (True, True, True, ["a", "b"], 0),
        (False, True, False, ["a", ""], 1),
    ]:
        check_eq("authorization input completeness", len(authorization_input_problems(enabled, protocol, candidate, endpoints)), expected)

def _test_authorization_differences(_ctx):
    rows = "\n".join(["SCENARIO\tauth-" + str(i) + "\t{NONE=1}" for i in range(10)])
    check_eq("ten auth cases", scenario_differences(rows, rows, 10), [])
    check_eq("truncated authorization is not parity", scenario_differences(rows, rows.splitlines()[0], 10), [{"error": "missing protocol scenario rows"}])

def _test_config_results(_ctx):
    rows = "\n".join(["SCENARIO\tconfig-" + str(i) + "\tNONE" for i in range(13)])
    check_eq("thirteen config cases", scenario_differences(rows, rows, 13), [])
    check_eq("truncated config output fails", len(scenario_differences(rows, rows.splitlines()[0], 13)), 1)

def _test_transaction_recovery(_ctx):
    check_eq("missing recovery identity fails", transaction_recovery_args(""), [])
    check_eq("malformed recovery identity fails", transaction_recovery_args("RECOVERY\ta\tb"), [])
    check_eq("one exact identity", transaction_recovery_args("noise\nRECOVERY\ttopic\tgroup\tuuid"), ["topic", "group", "uuid"])
    check_eq("ambiguous identities fail", transaction_recovery_args("RECOVERY\ta\tb\tc\nRECOVERY\tx\ty\tz"), [])
    rows = "\n".join(["SCENARIO\ttxn-" + str(i) + "\tPASS" for i in range(16)])
    check_eq("sixteen modern state cases", scenario_differences(rows, rows, 16), [])
    check_eq("truncated commit-abort is not parity", len(scenario_differences(rows, rows.splitlines()[0], 16)), 1)

kafka44_tests = suite("kafka44", [_test_revision, _test_candidate_pairs, _test_api_differences, _test_protocol_differences, _test_authorization_inputs, _test_authorization_differences, _test_transaction_recovery, _test_config_results])
test_kafka44 = suite_task(kafka44_tests)
