"""Strict coordinator-movement scenario validation."""

load("./kafka44_streams_movement.axl", "PREPARE", "RECOVER", "valid_outcomes")
load("./testing.axl", "check_eq", "suite", "suite_task")

def _test_outcomes(_ctx):
    for recover, cases in [(False, PREPARE), (True, RECOVER)]:
        valid = "\n".join(["SCENARIO\t" + case + "\tPASS" for case in cases])
        check_eq("exact cases", valid_outcomes(valid, recover), True)
        for invalid in ["", valid + "\nSCENARIO\textra\tFAIL", valid + "\nSCENARIO\tcoordinator-owner-changed\tPASS", valid.replace("PASS", "FAIL"), valid.replace("\tPASS", "\textra\tPASS")]:
            check_eq("reject incomplete/extra/failed/malformed", valid_outcomes(invalid, recover), False)

kafka44_streams_movement_tests = suite("kafka44-streams-movement", [_test_outcomes])
test_kafka44_streams_movement = suite_task(kafka44_streams_movement_tests)
