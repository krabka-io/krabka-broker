pgo_tests = suite("pgo", [
    _test_a_hung_driver_gets_one_more_session,
    _test_a_run_reports_the_errors_its_driver_recorded,
    _test_a_trial_with_errors_gets_one_more_session_and_never_counts,
    _test_work_dir_defaults_beside_the_root,
    _test_phase_runs_itself_and_every_later_phase,
    _test_phase_list_runs_exactly_its_phases_in_pipeline_order,
    _test_variants_keep_their_order_and_require_baseline,
    _test_v3_needs_every_x86_64_v3_flag,
    _test_shortening_rewrites_only_warmup_and_duration,
    _test_a_missing_key_is_appended,
    _test_compressed_variant_renames_and_sets_the_codec,
    _test_training_set_covers_compression_and_consumers,
    _test_evaluation_keeps_small_and_cuts_large_to_30s,
    _test_scenario_values,
    _test_variant_rustflags,
    _test_builds,
    _test_phase_needs_cover_every_selected_variant,
    _test_a_dry_run_checks_only_what_the_run_does_not_make,
    _test_binaries,
    _test_format_command,
