"""Orchestration tests; CheckCpdTest runs real PMD regression fixtures in the job."""

load("./check_cpd.axl", "checksum_matches", "patch_grammar", "rust_paths", "snapshot_sources")
load("./testing.axl", "check", "check_eq", "suite", "suite_task", "temp_tree")

def _test_inventory_preserves_hidden_and_unusual_paths(_ctx):
    text = "a.rs\x00.hidden/b.rs\x00space name.rs\x00line\nbreak.rs\x00a.rs\x00README.md\x00"
    check_eq("all Rust files", rust_paths(text), [".hidden/b.rs", "a.rs", "line\nbreak.rs", "space name.rs"])

def _test_checksum_rejects_another_artifact(_ctx):
    check(checksum_matches("abc  /path with spaces\n", "abc"), "matching checksum")
    check(not checksum_matches("abc  file\n", "def"), "wrong checksum")
    check(not checksum_matches("", "abc"), "missing checksum")

def _test_only_the_two_string_rules_change(_ctx):
    original = 'STRING: ~["];\nBYTE: ~["];\nOTHER: ~[abc];\n'
    check_eq("escaped strings", patch_grammar(original), 'STRING: ~["\\\\];\nBYTE: ~["\\\\];\nOTHER: ~[abc];\n')

def _git(ctx, root, argv):
    result = ctx.std.process.command("git").args(argv).current_dir(root).stdout("piped").stderr("piped").spawn().wait_with_output()
    check_eq("git " + " ".join(argv) + ": " + result.stderr, result.status.code, 0)
    return result.stdout.strip()

def _test_real_git_snapshots_include_moves_deletions_and_new_files(ctx):
    root = temp_tree(ctx, {
        "old.rs": "fn old() {}\n",
        ".hidden/space name.rs": "fn hidden() {}\n",
        "line\nbreak.rs": "fn newline() {}\n",
    })
    _git(ctx, root, ["init", "--quiet"])
    _git(ctx, root, ["add", "."])
    _git(ctx, root, ["-c", "user.name=CPD Test", "-c", "user.email=cpd@example.invalid", "commit", "--quiet", "-m", "base"])
    revision = _git(ctx, root, ["rev-parse", "HEAD"])
    _git(ctx, root, ["mv", "old.rs", "moved.rs"])
    _git(ctx, root, ["rm", "--quiet", "line\nbreak.rs"])
    ctx.std.fs.write(root + "/.hidden/new.rs", "fn added() {}\n")
    work = temp_tree(ctx, {})
    base, head, selected = snapshot_sources(ctx, work, root, revision)
    check_eq("immutable base", selected, revision)
    check_eq("base bytes", ctx.std.fs.read_to_string(base + "/old.rs"), "fn old() {}\n")
    check_eq("hidden baseline", ctx.std.fs.read_to_string(base + "/.hidden/space name.rs"), "fn hidden() {}\n")
    check(ctx.std.fs.exists(base + "/line\nbreak.rs"), "deleted file remains in baseline")
    check(not ctx.std.fs.exists(head + "/old.rs"), "moved source removed")
    check(not ctx.std.fs.exists(head + "/line\nbreak.rs"), "deleted source removed")
    check_eq("moved bytes", ctx.std.fs.read_to_string(head + "/moved.rs"), "fn old() {}\n")
    check_eq("untracked hidden source", ctx.std.fs.read_to_string(head + "/.hidden/new.rs"), "fn added() {}\n")

check_cpd_tests = suite("check-cpd", [
    _test_inventory_preserves_hidden_and_unusual_paths,
    _test_checksum_rejects_another_artifact,
    _test_only_the_two_string_rules_change,
    _test_real_git_snapshots_include_moves_deletions_and_new_files,
])
check_cpd_test = suite_task(check_cpd_tests)
