"""Render `docs/config-reference.md` from `docs/config-schema.json`.

The schema is the JSON Schema that `krabka-broker --print-config-schema`
prints for `FileConfig`, the `--config-file` document. Every `///` comment on
a config field is the `description` of that field in the schema, so nothing
here reads Rust source: the doc comments are the reference text.

CI renders the page to a temporary file and diffs it against the checked-in
one, so a schema change that is not followed by a regeneration fails the docs
job.

    aspect generate-config-reference
"""

# Both paths are repository-relative; `--schema` and `--output` override them.
DEFAULT_SCHEMA = "docs/config-schema.json"
DEFAULT_OUTPUT = "docs/config-reference.md"

BANNER = (
    "<!-- Generated by `aspect generate-config-reference` from " +
    "docs/config-schema.json; do not edit by hand. -->"
)

HEADER = """# Broker configuration reference

{banner}

`krabka-broker --config-file PATH` reads one TOML document. This page lists
every key that document accepts, with the type, the default, the units, and
the description from the field's doc comment. A key whose default is `broker
default` leaves the broker's built-in value in place when it is absent. The
CLI flag or environment variable for the same setting, when one exists, wins
over the file.

The schema behind this page is [`docs/config-schema.json`](config-schema.json),
which `krabka-broker --print-config-schema` prints. Two annotated examples sit
beside it: [`broker-single-node.toml`](examples/broker-single-node.toml) and
[`broker-three-node-quorum.toml`](examples/broker-three-node-quorum.toml).

A `duration` is a string with a unit suffix, for example `"500ms"`, `"30s"`,
or `"10m"`. A `byte size` is a string with a unit suffix, for example `"1MiB"`
or `"10GB"`. A `ratio` is a string such as `"10%"` or `"0.1"`. A key whose
units column says `milliseconds` or `seconds` is a plain integer in that unit.

""".format(banner = BANNER)

# The `format` a `Time`, `ByteSize`, or `Ratio` field carries in the schema,
# and the word the units column uses for it.
FORMAT_UNITS = {
    "duration": "duration",
    "byte-size": "byte size",
    "ratio": "ratio",
}

# Integer keys name their unit in the key itself, Kafka style. Every pattern
# the Python original matched was anchored at the end of the key, so a suffix
# test is the faithful port of its `re.search`.
KEY_UNITS = [
    (["_ms"], "milliseconds"),
    (["_secs", "_seconds"], "seconds"),
    (["_bytes"], "bytes"),
]

# An integer key without a unit suffix can still say its unit in its doc
# comment. The original matched `\\bword\\b`, so `subseconds` is not `seconds`.
DESCRIPTION_UNITS = [
    "milliseconds",
    "seconds",
    "bytes",
    "entries",
]

TABLE_HEAD = [
    "| Key | Type | Default | Units | Description |",
    "| :--- | :--- | :--- | :--- | :--- |",
]

# What a regular expression writes `\\s`: the ASCII whitespace class, which is
# what collapses to a single space inside a table cell.
_WHITESPACE = [" ", "\t", "\n", "\r", "\x0b", "\x0c"]

_DEFS_PREFIX = "#/$defs/"

def resolve(root, schema):
    """Follow a `$ref` to its `$defs` entry, or return `schema` unchanged."""
    ref = schema.get("$ref")
    if ref == None:
        return schema
    if not ref.startswith(_DEFS_PREFIX):
        fail("unsupported $ref %s" % ref)
    return root["$defs"][ref[len(_DEFS_PREFIX):]]

def effective(root, schema):
    """The non-null branch of an `Option<T>` schema, resolved.

    schemars renders `Option<Struct>` as `anyOf: [{$ref}, {type: null}]` and
    `Option<scalar>` as `type: [scalar, "null"]`. Both collapse to the inner
    schema here so the caller sees one shape. The field's own description and
    default survive the collapse.
    """
    schema = resolve(root, schema)
    branches = schema.get("anyOf")
    if branches != None:
        inner = [branch for branch in branches if branch.get("type") != "null"]
        if len(inner) == 1:
            merged = dict(resolve(root, inner[0]))
            for key in ["description", "default"]:
                if key in schema and key not in merged:
                    merged[key] = schema[key]
            return merged
    return schema

def type_names(schema):
    """The JSON types of `schema`, with `null` removed."""
    kind = schema.get("type", [])
    if type(kind) == "string":
        kind = [kind]
    return [name for name in kind if name != "null"]

def is_nullable(schema):
    """Whether the field may be absent: a `null` type or a `null` branch."""
    kind = schema.get("type", [])
    if type(kind) == "list" and "null" in kind:
        return True
    for branch in schema.get("anyOf", []):
        if branch.get("type") == "null":
            return True
    return False

def enum_values(schema):
    """The allowed strings of a unit enum, whether `enum` or `oneOf` consts."""
    if "enum" in schema:
        return list(schema["enum"])
    consts = [branch.get("const") for branch in schema.get("oneOf", [])]
    if consts and all([type(value) == "string" for value in consts]):
        return consts
    return None

def is_table(root, schema):
    """Whether `schema` is a struct: a TOML `[table]` or `[[array of tables]]`."""
    return "properties" in effective(root, schema)

def is_tagged_union(root, schema):
    """A `oneOf` whose branches are structs with a `type` discriminator."""
    branches = effective(root, schema).get("oneOf")
    if not branches:
        return False
    return all(["properties" in resolve(root, branch) for branch in branches])

def type_label(root, schema):
    """The Type column: what a value of this field looks like in TOML.

    An array or a map names its element type, which the Python original
    reached by recursing. Starlark forbids recursion, and both wrappers only
    ever prepend to the label, so the descent is a loop that accumulates the
    prefix instead.
    """
    prefix = ""
    current = schema
    for _ in range(64):
        resolved = effective(root, current)
        if "const" in resolved:
            return prefix + "constant `%s`" % json.encode(resolved["const"])
        values = enum_values(resolved)
        if values != None:
            return prefix + "one of " + ", ".join(["`%s`" % value for value in values])
        kinds = type_names(resolved)
        if kinds == ["array"]:
            items = resolved.get("items", {})
            if is_table(root, items):
                return prefix + "array of tables"
            prefix += "array of "
            current = items
            continue
        if kinds == ["object"]:
            extra = resolved.get("additionalProperties")
            if type(extra) == "dict":
                prefix += "map of string to "
                current = extra
                continue
            return prefix + "table"
        if kinds == ["integer"]:
            fmt = resolved.get("format")
            if fmt:
                return prefix + "integer (%s)" % fmt
            return prefix + "integer"
        if len(kinds) == 1:
            return prefix + kinds[0]
        if not kinds:
            return prefix + "any"
        return prefix + " or ".join(kinds)
    fail("type_label: %s nests element types deeper than this sweep can reach" % prefix)

def default_label(field, resolved, required):
    """The Default column.

    A field is `required` when its parent's `required` list names it. A
    `default` in the schema is the value serde fills in. A nullable field with
    neither leaves the broker's own default in place.
    """
    if required:
        return "required"
    if "default" in resolved and resolved["default"] != None:
        return "`%s`" % json.encode(resolved["default"])
    if is_nullable(field) or "default" in resolved:
        return "broker default"
    if type_names(resolved) == ["array"]:
        return "`[]`"
    return "broker default"

def contains_word(text, word):
    """Whether `word` occurs in `text` bounded by non-word characters.

    This is `\\bword\\b`: the character on either side of a hit, when there is
    one, must not be one a word can continue with, so `subseconds` does not
    contain the word `seconds`.
    """
    start = 0
    for _ in range(len(text) + 1):
        at = text.find(word, start)
        if at < 0:
            return False
        before = at == 0 or not _is_word_character(text[at - 1])
        end = at + len(word)
        after = end == len(text) or not _is_word_character(text[end])
        if before and after:
            return True
        start = at + 1
    return False

def _is_word_character(character):
    return character.isalnum() or character == "_"

def units_label(key, resolved):
    """The Units column: the format's word, the key's suffix, or the prose."""
    fmt = resolved.get("format")
    if fmt in FORMAT_UNITS:
        return FORMAT_UNITS[fmt]
    for suffixes, unit in KEY_UNITS:
        for suffix in suffixes:
            if key.endswith(suffix):
                return unit
    if type_names(resolved) == ["integer"]:
        description = resolved.get("description", "")
        for unit in DESCRIPTION_UNITS:
            if contains_word(description, unit):
                return unit
    return ""

def cell(text):
    """Flatten a description into one table cell.

    Paragraph breaks and every other run of whitespace become a single space,
    the way the original's two `re.sub` passes left them, and a pipe is
    escaped so it cannot end the cell.
    """
    for character in _WHITESPACE:
        if character != " ":
            text = text.replace(character, " ")
    words = [word for word in text.split(" ") if word]
    return " ".join(words).replace("|", "\\|")

def blurb(schema):
    """A description as the lead of a table cell, or nothing."""
    text = cell(schema.get("description", ""))
    if text:
        return text + " "
    return ""

def _rows(root, resolved, path):
    """One section's table rows and the subsections its keys point at.

    Scalar keys go into the section's table. A key that is itself a struct
    gets a row that points at its own subsection, named by its dotted TOML
    path, so `[remote_storage.s3]` follows `[remote_storage]`.
    """
    required = resolved.get("required", [])
    rows = []
    nested = []
    for key, field in resolved.get("properties", {}).items():
        child = path + "." + key if path else key
        target = effective(root, field)
        default = default_label(field, target, key in required)
        if is_tagged_union(root, field):
            nested.append((child, field, "union"))
            rows.append("| `%s` | table | %s |  | %sSee the `[%s]` sections below. |" % (
                key,
                default,
                blurb(target),
                child,
            ))
            continue
        if is_table(root, field):
            nested.append((child, field, "table"))
            rows.append("| `%s` | table | %s |  | %sSee `[%s]` below. |" % (
                key,
                default,
                blurb(target),
                child,
            ))
            continue
        items = target.get("items")
        if items != None and is_table(root, items):
            nested.append((child, items, "array"))
            rows.append("| `%s` | array of tables | %s |  | %sSee `[[%s]]` below. |" % (
                key,
                default,
                blurb(target),
                child,
            ))
            continue
        rows.append("| `%s` | %s | %s | %s | %s |" % (
            key,
            type_label(root, field),
            default,
            units_label(key, target),
            cell(target.get("description", "")),
        ))
    return rows, nested

def _subsections(root, nested, depth):
    """The work items the subsections of one section become, in page order.

    Each carries the heading and description its parent emitted before
    descending, so a work item is everything that section contributes.
    """
    heading = "#" * min(depth + 1, 6)
    children = []
    for child, field, kind in nested:
        if kind == "union":
            for branch in effective(root, field)["oneOf"]:
                resolved = resolve(root, branch)
                tag = resolved["properties"]["type"]["const"]
                lead = ['%s `[%s]` with `type = "%s"`' % (heading, child, tag), ""]
                if resolved.get("description"):
                    lead.append(cell(resolved["description"]))
                    lead.append("")
                children.append(struct(schema = resolved, path = child, depth = depth + 1, lead = lead))
            continue
        target = effective(root, field)
        if kind == "array":
            lead = ["%s `[[%s]]`" % (heading, child), ""]
        else:
            lead = ["%s `[%s]`" % (heading, child), ""]
        if target.get("description"):
            lead.append(cell(target["description"]))
            lead.append("")
        children.append(struct(schema = target, path = child, depth = depth + 1, lead = lead))
    return children

def render(root_schema):
    """The whole page: the header, then every section depth-first."""
    out = [HEADER.rstrip(), "", "## Top-level keys", ""]

    # The Python walked the schema by recursion, which Starlark forbids. A
    # stack reproduces its order exactly as long as a section's subsections go
    # on in reverse, so the first one comes back off first: this section's
    # table, then each nested section in turn, each followed by its own.
    pending = [struct(schema = root_schema, path = "", depth = 2, lead = [])]
    for _ in range(10000):
        if not pending:
            break
        section = pending.pop()
        out.extend(section.lead)
        resolved = effective(root_schema, section.schema)
        rows, nested = _rows(root_schema, resolved, section.path)
        if rows:
            out.extend(TABLE_HEAD)
            out.extend(rows)
            out.append("")
        for child in reversed(_subsections(root_schema, nested, section.depth)):
            pending.append(child)
    if pending:
        fail("render: the schema nests more sections than this sweep can reach")
    return "\n".join(out).rstrip() + "\n"

def _absolute(root, path):
    """`path` as given when it is absolute, else read against the repo root."""
    if path.startswith("/"):
        return path
    return root + "/" + path

def _impl(ctx: TaskContext) -> int:
    root = ctx.std.env.bazel_root_dir()
    schema_path = _absolute(root, ctx.args.schema or DEFAULT_SCHEMA)
    output_path = _absolute(root, ctx.args.output or DEFAULT_OUTPUT)

    schema = json.decode(ctx.std.fs.read_to_string(schema_path))
    ctx.std.fs.write(output_path, render(schema))
    ctx.std.io.stdout.write("generate-config-reference: wrote %s\n" % output_path)
    return 0

generate_config_reference = task(
    summary = "Render docs/config-reference.md from docs/config-schema.json",
    implementation = _impl,
    args = {
        "output": args.string(
            default = "",
            description = "Where to write the page; empty means docs/config-reference.md.",
        ),
        "schema": args.string(
            default = DEFAULT_SCHEMA,
            description = "The JSON Schema to render.",
        ),
    },
)
