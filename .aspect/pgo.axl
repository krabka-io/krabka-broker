"""Measure what profile-guided optimization does for the broker.

The task builds the broker with the repository's release profile in up to
four variants, and one more time to record a profile. `baseline` is the
plain release build, `pgo` uses the recorded profile, `v3` targets
`x86-64-v3`, and `v3-pgo` does both. It then runs every selected variant
against the same benchmark scenarios and writes the comparison to
`report.md`.

    aspect pgo
    aspect pgo --dry-run
    aspect pgo --phase compare --trials 8
    aspect pgo --phase build,optimize,compare --variants baseline,v3,v3-pgo
    aspect pgo --work-dir /var/tmp/pgo

The phases run in this order: `build`, `train`, `merge`, `optimize`,
`compare`. A single `--phase` names the first phase to run, and every later
phase runs after it, so a run that failed can continue from the phase that
failed. A comma list runs exactly the phases it names, in pipeline order.
`--variants` picks the builds that `build` and `optimize` make and that
`compare` runs, and always includes `baseline`. `--dry-run` prints every
command with its environment, and runs nothing.

1. `build` makes the baseline `krabka-broker`, `krabka-format` and
   `krabka-bench-driver`, a broker built with `-Cprofile-generate`, and the
   `v3` broker.
2. `train` runs the instrumented broker under shortened copies of the
   scenarios in `bench/scenarios/`. Each broker stops on SIGTERM, which makes
   it write its `.profraw` file.
3. `merge` merges the `.profraw` files with `llvm-profdata`.
4. `optimize` builds the `pgo` and `v3-pgo` brokers with `-Cprofile-use`.
5. `compare` runs every selected broker for `--trials` rounds, in an order
   that rotates each round. It records the driver's producer throughput and
   p99 ack latency and the broker's CPU seconds from `/proc/<pid>/stat`.

`docs/operations/pgo.md` explains how to read the report.
"""

load("@std//time.axl", "sleep")

PHASES = ["build", "train", "merge", "optimize", "compare"]

CLIENT_PORT = 19092
CONTROLLER_PORT = 19093
NODE_ID = 1

# The compare phase keeps the broker and the driver off each other's cores.
BROKER_CPUS = "2,3"
DRIVER_CPUS = "0,1"

TRAIN_WARMUP = "2s"
TRAIN_DURATION = "20s"

# The release binaries that every phase uses: the baseline build makes all
# three, and the other builds make the broker only.
BASELINE_PACKAGES = [
    ("krabka-broker", "krabka-broker"),
    ("krabka-format", "krabka-format"),
    ("krabka-bench-driver", "krabka-bench-driver"),
]
BROKER_PACKAGE = [("krabka-broker", "krabka-broker")]

# The training set. Each entry is a shortened copy of a file in
# `bench/scenarios/`; `compression` makes a compressed variant of it.
# Together they cover small records, large records, consumers, a fixed rate,
# `acks=all`, and the lz4 and zstd codecs.
TRAINING = [
    struct(name = "small-msg-saturate", source = "small-msg-saturate", compression = None),
    struct(name = "small-msg-saturate-zstd", source = "small-msg-saturate", compression = "zstd"),
    struct(name = "large-msg", source = "large-msg", compression = None),
    struct(name = "fan-out", source = "fan-out", compression = None),
    struct(name = "fixed-rate-latency", source = "fixed-rate-latency", compression = None),
    struct(name = "mixed-acks", source = "mixed-acks", compression = None),
]

# The evaluation set. `duration` replaces the scenario's own when it is set.
EVALUATION = [
    struct(name = "small-msg-saturate", source = "small-msg-saturate", duration = None, compression = None),
    struct(name = "large-msg", source = "large-msg", duration = "30s", compression = None),
]

# The broker builds that `compare` can run, in the order a round rotates
# through them. `phase` is the phase that builds one, `cpu` its
# `-Ctarget-cpu`, and `profile` whether it uses the merged profile. Each one
# builds into `target-<name>` under the work directory.
VARIANTS = [
    struct(name = "baseline", label = "Baseline", phase = "build", cpu = None, profile = False),
    struct(name = "pgo", label = "PGO", phase = "optimize", cpu = None, profile = True),
    struct(name = "v3", label = "v3", phase = "build", cpu = "x86-64-v3", profile = False),
    struct(name = "v3-pgo", label = "v3-PGO", phase = "optimize", cpu = "x86-64-v3", profile = True),
]
DEFAULT_VARIANTS = ",".join([v.name for v in VARIANTS])

_VARIANT = {v.name: v for v in VARIANTS}

# The `/proc/cpuinfo` flags of every feature that LLVM's `x86-64-v3` level
# assumes: the `x86-64-v2` set, then AVX, AVX2, BMI1, BMI2, F16C, FMA, LZCNT
# (`abm`), MOVBE and XSAVE.
X86_64_V3_FLAGS = [
    "cx16",
    "lahf_lm",
    "popcnt",
    "pni",
    "ssse3",
    "sse4_1",
    "sse4_2",
    "avx",
    "avx2",
    "bmi1",
    "bmi2",
    "f16c",
    "fma",
    "abm",
    "movbe",
    "xsave",
]

# The report's metrics, in the order the report lists them.
METRICS = [
    struct(key = "msgs_per_s", label = "Producer throughput, msgs/s", better = "higher", digits = 0),
    struct(key = "mb_per_s", label = "Producer throughput, MB/s", better = "higher", digits = 2),
    struct(key = "p99_ms", label = "Producer p99 ack latency, ms", better = "lower", digits = 3),
    struct(key = "cpu_s", label = "Broker CPU, s", better = "lower", digits = 2),
]

# A broker gets this long to log that it started, and this long to exit after
# SIGTERM. Both are polls of `_POLL_MS` milliseconds.
_POLL_MS = 250
_START_POLLS = 240
_STOP_POLLS = 480

# The line `krabka-broker` logs once its listeners are open.
STARTED_LINE = "krabka-broker started"

_SHELL_SAFE = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-+=/.,:@%"

# ── Paths ────────────────────────────────────────────────────────────────────

def default_work_dir(root):
    """`pgo-work` beside the repository root."""
    parent = root.rstrip("/").rsplit("/", 1)[0]
    return (parent or "") + "/pgo-work"

def resolve_path(path, cwd):
    """`path` made absolute against `cwd`, without a trailing slash."""
    if not path.startswith("/"):
        path = cwd.rstrip("/") + "/" + path
    return path.rstrip("/") or "/"

def variant_target_dir(work, name):
    """The `CARGO_TARGET_DIR` of variant `name`: `<work>/target-<name>`."""
    return "%s/target-%s" % (work, name)

def binaries(work):
    """Where each build leaves the binaries that the later phases run.

    `brokers` maps every variant's name to its broker. The baseline build
    also makes `format` and `driver`.
    """
    baseline = variant_target_dir(work, "baseline") + "/release/"
    return struct(
        format = baseline + "krabka-format",
        driver = baseline + "krabka-bench-driver",
        instrumented = work + "/target-instrumented/release/krabka-broker",
        brokers = {v.name: variant_target_dir(work, v.name) + "/release/krabka-broker" for v in VARIANTS},
    )

def phases_from(phase):
    """The phases to run for a single `--phase`: that phase and every one after it.

    Returns `None` for a name that is not a phase.
    """
    if phase == "all":
        return list(PHASES)
    if phase not in PHASES:
        return None
    return PHASES[PHASES.index(phase):]

def _comma_list(text):
    return [word.strip() for word in text.split(",")]

def _duplicate(names):
    seen = []
    for name in names:
        if name in seen:
            return name
        seen.append(name)
    return None

def parse_phases(text):
    """The phases `--phase` selects, in pipeline order, and an error.

    A single name keeps its `phases_from` meaning. A comma list such as
    `build,optimize,compare` selects exactly the phases it names. Returns
    `(phases, None)`, or `(None, message)` for a value that selects nothing.
    """
    if "," not in text:
        phases = phases_from(text.strip())
        if phases == None:
            return None, "--phase must be all, one of %s, or a comma list of them, got %r" % (", ".join(PHASES), text)
        return phases, None
    names = _comma_list(text)
    for name in names:
        if name not in PHASES:
            return None, "a --phase list names phases from %s, got %r in %r" % (", ".join(PHASES), name, text)
    repeated = _duplicate(names)
    if repeated != None:
        return None, "--phase names %r twice in %r" % (repeated, text)
    return [phase for phase in PHASES if phase in names], None

def parse_variants(text):
    """The variants `--variants` selects, in `VARIANTS` order, and an error.

    Returns `(names, None)`, or `(None, message)` for an unknown or repeated
    name, or a list without `baseline`, which every report compares against.
    """
    known = [v.name for v in VARIANTS]
    names = _comma_list(text)
    for name in names:
        if name not in known:
            return None, "--variants names variants from %s, got %r in %r" % (", ".join(known), name, text)
    repeated = _duplicate(names)
    if repeated != None:
        return None, "--variants names %r twice in %r" % (repeated, text)
    if "baseline" not in names:
        return None, "--variants must include baseline, which every variant is compared against, got %r" % text
    return [name for name in known if name in names], None

def variant_label(name):
    """The name the report gives variant `name`: `Baseline`, `PGO`, `v3`, `v3-PGO`."""
    return _VARIANT[name].label

def missing_cpu_flags(cpuinfo, wanted):
    """The flags of `wanted` that the first `flags` line of `/proc/cpuinfo` lacks.

    A text with no `flags` line lacks them all.
    """
    for line in cpuinfo.splitlines():
        if line.startswith("flags") and ":" in line:
            have = line.split(":", 1)[1].split()
            return [flag for flag in wanted if flag not in have]
    return list(wanted)

# ── Scenarios ────────────────────────────────────────────────────────────────

def set_scenario_key(text, key, value):
    """`text` with its top-level `key:` line set to `value`.

    Every other line stays as it is. A scenario without the key gets it as
    its last line.
    """
    lines = text.splitlines()
    out = []
    found = False
    for line in lines:
        if line.startswith(key + ":"):
            out.append("%s: %s" % (key, value))
            found = True
        else:
            out.append(line)
    if not found:
        out.append("%s: %s" % (key, value))
    return "\n".join(out) + "\n"

def scenario_value(text, key):
    """The value of the top-level `key:` line, or `None` when there is none."""
    for line in text.splitlines():
        if line.startswith(key + ":"):
            value = line[len(key) + 1:]
            comment = value.find(" #")
            if comment >= 0:
                value = value[:comment]
            return value.strip()
    return None

def shorten_scenario(text):
    """A training copy of a scenario: a 2s warmup and a 20s measured window."""
    return set_scenario_key(set_scenario_key(text, "warmup", TRAIN_WARMUP), "duration", TRAIN_DURATION)

def training_scenario(entry, source):
    """The training copy of `entry`, made from its source scenario's text."""
    text = shorten_scenario(source)
    if entry.compression:
        text = set_scenario_key(text, "name", entry.name)
        text = set_scenario_key(text, "compression", entry.compression)
    return text

def evaluation_scenario(entry, source):
    """The evaluation copy of `entry`: the source, with its duration and codec set."""
    text = source
    if entry.duration:
        text = set_scenario_key(text, "duration", entry.duration)
    if entry.compression:
        text = set_scenario_key(text, "name", entry.name)
        text = set_scenario_key(text, "compression", entry.compression)
    return text

def parse_seconds(value):
    """A scenario extent such as `20s`, `2m` or `500ms`, in seconds."""
    units = [("ms", 0.001), ("s", 1), ("m", 60), ("h", 3600)]
    for suffix, scale in units:
        if value.endswith(suffix):
            number = value[:-len(suffix)]
            if number and number.isdigit():
                return int(number) * scale
    fail("cannot read %r as an extent such as 20s" % value)

def scenario_seconds(text):
    """The measured window of a scenario, in seconds. The driver's default is 60s."""
    value = scenario_value(text, "duration")
    return parse_seconds(value) if value != None else 60

def scenario_partitions(text):
    """The topic's partition count. The driver's topic auto-creates with it."""
    value = scenario_value(text, "partitions")
    if value == None or not value.isdigit():
        fail("the scenario names no partition count")
    return int(value)

# ── Commands ─────────────────────────────────────────────────────────────────

def command(argv, env = {}, cwd = ""):
    """One process to run: its argv, the environment it adds, and its directory."""
    return struct(argv = argv, env = env, cwd = cwd)

def shell_quote(word):
    """`word` as a POSIX shell reads it back, quoted only where it needs it."""
    if word and not [c for c in word.elems() if c not in _SHELL_SAFE]:
        return word
    return "'" + word.replace("'", "'\\''") + "'"

def render_command(cmd):
    """The command as one shell line: directory, environment, then argv."""
    words = ["%s=%s" % (key, shell_quote(value)) for key, value in cmd.env.items()]
    words.extend([shell_quote(word) for word in cmd.argv])
    line = " ".join(words)
    if cmd.cwd:
        line = "cd %s && %s" % (shell_quote(cmd.cwd), line)
    return line

def cargo_build(root, target_dir, packages, rustflags = None):
    """`cargo build --release --locked` of `packages` into `target_dir`."""
    argv = ["cargo", "build", "--release", "--locked"]
    for package, binary in packages:
        argv.extend(["-p", package, "--bin", binary])
    env = {"CARGO_TARGET_DIR": target_dir}
    if rustflags != None:
        env["RUSTFLAGS"] = rustflags
    return command(argv, env = env, cwd = root)

def variant_rustflags(work, name):
    """The `RUSTFLAGS` of variant `name`, or `None` for the plain release build.

    The `-Ctarget-cpu` flag comes before `-Cprofile-use`. LLVM only warns
    when a function's control flow no longer matches the profile, so a
    `v3-pgo` build accepts the profile of the instrumented generic build.
    """
    variant = _VARIANT[name]
    flags = []
    if variant.cpu:
        flags.append("-Ctarget-cpu=" + variant.cpu)
    if variant.profile:
        flags.append("-Cprofile-use=" + work + "/merged.profdata")
    return " ".join(flags) if flags else None

def variant_build(root, work, name):
    """The build of variant `name`. The baseline also builds the format tool and the driver."""
    packages = BASELINE_PACKAGES if name == "baseline" else BROKER_PACKAGE
    return cargo_build(root, variant_target_dir(work, name), packages, variant_rustflags(work, name))

def build_commands(root, work, variants):
    """The builds of the `build` phase.

    The baseline comes first, then the instrumented broker that `train` runs,
    then every other selected variant that this phase builds.
    """
    cmds = [
        variant_build(root, work, "baseline"),
        cargo_build(root, work + "/target-instrumented", BROKER_PACKAGE, "-Cprofile-generate=" + work + "/profraw"),
    ]
    for name in variants:
        if name != "baseline" and _VARIANT[name].phase == "build":
            cmds.append(variant_build(root, work, name))
    return cmds

def optimize_commands(root, work, variants):
    """The `optimize` phase's builds: every selected variant that uses the merged profile."""
    return [variant_build(root, work, name) for name in variants if _VARIANT[name].phase == "optimize"]

def phase_needs(phase, work, variants):
    """The files `phase` reads that an earlier phase makes.

    Returns `(path, phase that makes it)` pairs. `merge` checks its own
    `.profraw` files, so it has none here.
    """
    bin = binaries(work)
    tools = [(bin.format, "build"), (bin.driver, "build")]
    if phase == "train":
        return [(bin.instrumented, "build")] + tools
    if phase == "optimize":
        if optimize_commands("", work, variants):
            return [(work + "/merged.profdata", "merge")]
        return []
    if phase == "compare":
        return [(bin.brokers[name], _VARIANT[name].phase) for name in variants] + tools
    return []

def needs_to_check(needs, phases, dry):
    """The needs to check before a phase runs.

    A real run checks every one. A dry run makes nothing, so it checks only
    the files that no phase of this run makes.
    """
    if not dry:
        return list(needs)
    return [need for need in needs if need[1] not in phases]

def pinned(argv, cpus):
    """`argv` under `taskset -c cpus`, or as it is when `cpus` is empty."""
    return ["taskset", "-c", cpus] + argv if cpus else argv

def format_command(format_binary, log_dir):
    """Format `log_dir` as a standalone node that is its own controller."""
    return command([
        format_binary,
        "--log-dir",
        log_dir,
        "--standalone",
        "--node-id",
        str(NODE_ID),
        "--controller-listener",
        "127.0.0.1:%d" % CONTROLLER_PORT,
    ])

def broker_command(broker_binary, log_dir, partitions, cpus = "", env = {}):
    """Start a single-node broker on `log_dir`.

    One broker holds every replica, so the internal topics take one replica
    and a minimum ISR of one. The driver's topic does not exist beforehand:
    the producer's metadata request creates it with `--num-partitions`.
    The metrics and health endpoints are off, so that no fixed port of theirs
    can collide with another process.
    """
    return command(pinned([
        broker_binary,
        "--log-dir",
        log_dir,
        "--broker-id",
        str(NODE_ID),
        "--listen-addr",
        "127.0.0.1:%d" % CLIENT_PORT,
        "--controller-listen-addr",
        "127.0.0.1:%d" % CONTROLLER_PORT,
        "--metrics-listen-addr",
        "none",
        "--health-listen-addr",
        "none",
        "--offsets-topic-replication-factor",
        "1",
        "--transaction-state-replication-factor",
        "1",
        "--transaction-state-min-isr",
        "1",
        "--num-partitions",
        str(partitions),
        "--default-replication-factor",
        "1",
    ], cpus), env = env)

# How long one driver run may take before `timeout` stops it. The longest
# scenario here is 70 s of load; the rest is start-up and the final drain.
DRIVER_LIMIT_SECONDS = 600

# `timeout` exits 124 when the limit stopped the command, and 137 when it
# needed `--kill-after`'s SIGKILL.
DRIVER_TIMED_OUT = [124, 137]

def driver_command(driver_binary, scenario_path, out, cpus = ""):
    """Run one scenario against the broker and write its `RunOutput` JSON to `out`.

    `timeout` bounds the run, so a driver that hangs costs one retry rather
    than the whole experiment.
    """
    return command(["timeout", "--kill-after=10", str(DRIVER_LIMIT_SECONDS)] + pinned([
        driver_binary,
        "--scenario",
        scenario_path,
        "--bootstrap",
        "127.0.0.1:%d" % CLIENT_PORT,
        "--stack",
        "krabka",
        "--out",
        out,
    ], cpus))

def training_env(work, name):
    """Where an instrumented broker writes its profile, named after the scenario.

    `LLVM_PROFILE_FILE` wins over the directory that `-Cprofile-generate`
    compiled in. `%p` is the process id and `%m` the binary's signature.
    """
    return {"LLVM_PROFILE_FILE": "%s/profraw/%s-%%p-%%m.profraw" % (work, name)}

def host_triple(rustc_version):
    """The `host:` line of `rustc -vV`."""
    for line in rustc_version.splitlines():
        if line.startswith("host:"):
            return line[len("host:"):].strip()
    fail("rustc -vV printed no host line")

def llvm_profdata_path(sysroot, triple):
    """Where `rustup component add llvm-tools` puts `llvm-profdata`."""
    return "%s/lib/rustlib/%s/bin/llvm-profdata" % (sysroot.strip(), triple)

def profraw_files(directory, names):
    """The `.profraw` files among `names`, as sorted paths under `directory`."""
    return [directory + "/" + name for name in sorted(names) if name.endswith(".profraw")]

def merge_command(llvm_profdata, work, profraws):
    """Merge every training profile into `merged.profdata`."""
    return command([llvm_profdata, "merge", "-o", work + "/merged.profdata"] + profraws)

# ── Trials ───────────────────────────────────────────────────────────────────

def round_order(round, variants):
    """The variants in the order round `round` runs them, counted from 1.

    The order rotates: round 1 starts at the first variant, and each round
    starts one variant later than the one before, so round `r` starts at
    variant `(r - 1) mod n`. Over `n` rounds every variant runs once in
    every position, and a drift over the run, such as a warming disk or a
    hotter CPU, falls on every variant alike.
    """
    start = (round - 1) % len(variants)
    return variants[start:] + variants[:start]

def trial_plan(trials, scenarios, variants):
    """Every trial of the compare phase, in the order it runs.

    A round runs each scenario once on each variant, in `round_order`.
    """
    plan = []
    for round in range(1, trials + 1):
        for scenario in scenarios:
            for binary in round_order(round, variants):
                plan.append(struct(round = round, scenario = scenario, binary = binary))
    return plan

def trial_label(trial):
    """The name a trial's files share: `r1-baseline-large-msg`."""
    return "r%d-%s-%s" % (trial.round, trial.binary, trial.scenario)

# ── Measurements ─────────────────────────────────────────────────────────────

def parse_proc_stat(text):
    """`utime` and `stime` of a `/proc/<pid>/stat` line, in clock ticks.

    The second field is the command name in parentheses, and the name can
    hold spaces and parentheses itself. The fields after it start after the
    last `)`. There, field 3 (`state`) is the first word, so `utime` and
    `stime`, fields 14 and 15, are the 12th and 13th.
    """
    close = text.rfind(")")
    if close < 0:
        fail("not a /proc/<pid>/stat line: %r" % text)
    fields = text[close + 1:].split()
    if len(fields) < 13:
        fail("a /proc/<pid>/stat line with %d fields after the command name" % len(fields))
    return struct(utime = int(fields[11]), stime = int(fields[12]))

def cpu_seconds(stat, clock_ticks):
    """User plus system CPU time of a process, in seconds."""
    if clock_ticks <= 0:
        fail("CLK_TCK must be positive, got %d" % clock_ticks)
    return (stat.utime + stat.stime) / clock_ticks

def driver_metrics(run, seconds):
    """The producer's throughput and p99 ack latency from one `RunOutput`.

    `msgs_produced` and `bytes_in` count the measured window only, so the
    rates divide them by the scenario's `duration`. `producer_latency.p99`
    is in whole nanoseconds. A MB is 10^6 bytes.
    """
    throughput = run["throughput"]
    return {
        "msgs_per_s": throughput["msgs_produced"] / seconds,
        "mb_per_s": throughput["bytes_in"] / seconds / 1000000,
        "p99_ms": run["producer_latency"]["p99"] / 1000000,
    }

def median(values):
    """The middle value, or the mean of the two middle values."""
    if not values:
        fail("median of no values")
    ordered = sorted(values)
    middle = len(ordered) // 2
    if len(ordered) % 2 == 1:
        return ordered[middle]
    return (ordered[middle - 1] + ordered[middle]) / 2

def percent_change(baseline, optimized):
    """How far `optimized` is from `baseline`, in percent of `baseline`.

    Returns `None` when the baseline is zero.
    """
    if baseline == 0:
        return None
    return (optimized - baseline) * 100.0 / baseline

def fixed(value, digits):
    """`value` with exactly `digits` decimals, rounded half away from zero.

    AXL's `%` operator has no precision, so `%.2f` is not available.
    """
    scale = 1
    for _ in range(digits):
        scale *= 10
    scaled = int(abs(value) * scale + 0.5)
    text = str(scaled // scale)
    if digits:
        text += "." + ("0" * digits + str(scaled % scale))[-digits:]
    return "-" + text if value < 0 and scaled else text

def signed_percent(change):
    """`+1.25%`, `-0.50%`, or `n/a` for a change with no baseline."""
    if change == None:
        return "n/a"
    text = fixed(change, 2)
    return text + "%" if text.startswith("-") else "+" + text + "%"

# ── Report ───────────────────────────────────────────────────────────────────

def trial_values(results, scenario, binary, key):
    """`key` of every result for `scenario` and `binary`, in round order."""
    picked = [r for r in results if r["scenario"] == scenario and r["binary"] == binary]
    return [r["metrics"][key] for r in sorted(picked, key = lambda r: r["round"])]

def _table_row(cells):
    return "| " + " | ".join(cells) + " |"

def render_report(setup, scenarios, results):
    """The Markdown comparison: one table per scenario, one row per metric.

    `setup` is a struct of `work`, `trials`, `clock_ticks` and `variants`,
    the selected variant names with `baseline` first. A row gives the
    baseline median, then each other variant's median and its change against
    the baseline, then every variant's trial values. A median with no trials
    behind it, and a change without both medians, stay empty. `results`
    holds one dict per trial: `round`, `scenario`, `binary` and `metrics`.
    """
    others = [name for name in setup.variants if name != "baseline"]
    brokers = binaries(setup.work).brokers
    lines = [
        "# PGO comparison",
        "",
        "%d rounds of these brokers:" % setup.trials,
        "",
    ]
    lines.extend(["- %s: `%s`" % (variant_label(name), brokers[name]) for name in setup.variants])
    lines.extend([
        "",
        "Each round runs every broker on a fresh log directory. The order rotates: each round starts one broker later than the round before.",
        "The broker runs on CPUs %s and the driver on CPUs %s." % (BROKER_CPUS, DRIVER_CPUS),
        "Broker CPU is utime plus stime from `/proc/<pid>/stat` before SIGTERM, at %d ticks a second." % setup.clock_ticks,
        "A change is a broker's median against the baseline median.",
    ])
    header = ["Metric", "Better", "Baseline median"]
    for name in others:
        header.extend([variant_label(name) + " median", variant_label(name) + " change"])
    header.extend([variant_label(name) + " trials" for name in setup.variants])
    align = [":---", ":---"] + ["---:"] * (1 + 2 * len(others)) + [":---"] * len(setup.variants)
    for scenario in scenarios:
        lines.extend(["", "## " + scenario, "", _table_row(header), _table_row(align)])
        for metric in METRICS:
            values = {name: trial_values(results, scenario, name, metric.key) for name in setup.variants}
            medians = {name: median(values[name]) if values[name] else None for name in setup.variants}
            base = medians["baseline"]
            cells = [metric.label, metric.better, fixed(base, metric.digits) if base != None else ""]
            for name in others:
                mid = medians[name]
                cells.append(fixed(mid, metric.digits) if mid != None else "")
                cells.append(signed_percent(percent_change(base, mid)) if base != None and mid != None else "")
            for name in setup.variants:
                cells.append(", ".join([fixed(v, metric.digits) for v in values[name]]))
            lines.append(_table_row(cells))
    return "\n".join(lines) + "\n"

# ── IO ───────────────────────────────────────────────────────────────────────

def _say(r, text):
    r.ctx.std.io.stdout.write("# %s\n" % text)

def _spawn(r, cmd, stdout = None, stderr = None):
    process = r.ctx.std.process.command(cmd.argv[0]).args(cmd.argv[1:])
    for key, value in cmd.env.items():
        process = process.env(key, value)
    if cmd.cwd:
        process = process.current_dir(cmd.cwd)
    if stdout:
        process = process.stdout(r.ctx.std.fs.create(stdout))
    if stderr:
        process = process.stderr(r.ctx.std.fs.create(stderr))
    return process.spawn()

def _run(r, cmd):
    """Print `cmd`, then run it to completion and return its exit code. `--dry-run` only prints it."""
    r.ctx.std.io.stdout.write("$ %s\n" % render_command(cmd))
    if r.dry:
        return 0
    return _spawn(r, cmd).wait().code

def _must(r, cmd):
    code = _run(r, cmd)
    if code != 0:
        fail("%s exited with %r" % (render_command(cmd), code))

def _capture(ctx, argv, cwd):
    """The stdout of a read-only query. It runs under `--dry-run` too."""
    result = ctx.std.process.command(argv[0]).args(argv[1:]).current_dir(cwd).stdout("piped").stderr("piped").spawn().wait_with_output()
    if result.status.code != 0:
        fail("%s failed:\n%s" % (" ".join(argv), result.stderr))
    return result.stdout

def _fresh_dir(r, path):
    _say(r, "rm -rf %s && mkdir -p %s" % (path, path))
    if r.dry:
        return
    if r.ctx.std.fs.exists(path):
        r.ctx.std.fs.remove_dir_all(path)
    r.ctx.std.fs.create_dir_all(path)

def _remove_dir(r, path):
    _say(r, "rm -rf " + path)
    if not r.dry and r.ctx.std.fs.exists(path):
        r.ctx.std.fs.remove_dir_all(path)

def _write(r, path, contents):
    _say(r, "write " + path)
    if not r.dry:
        r.ctx.std.fs.create_dir_all(path.rsplit("/", 1)[0])
        r.ctx.std.fs.write(path, contents)

def _require(r, phase):
    """Check that the files `phase` reads exist.

    A real run stops at the first missing one. A dry run only checks the
    files no phase of this run makes, and says which a real run would miss.
    """
    for path, maker in needs_to_check(phase_needs(phase, r.work, r.variants), r.phases, r.dry):
        if r.ctx.std.fs.exists(path):
            continue
        if r.dry:
            _say(r, "missing %s, and no phase of this run makes it: a real run stops here. The `%s` phase makes it." % (path, maker))
        else:
            fail("%s is missing: the `%s` phase makes it" % (path, maker))

def _started(r, logs):
    for path in logs:
        if r.ctx.std.fs.exists(path) and STARTED_LINE in r.ctx.std.fs.read_to_string(path):
            return True
    return False

def _kill_quietly(child):
    if child.try_wait() == None:
        child.kill()
        child.wait()

def _session(r, broker, driver, log_dir, logs):
    """Format `log_dir`, start `broker`, run `driver`, then stop the broker.

    Returns the broker's CPU seconds, read just before the SIGTERM, or 0
    under `--dry-run`.
    """
    _remove_dir(r, log_dir)
    _must(r, format_command(r.bin.format, log_dir))

    r.ctx.std.io.stdout.write("$ %s > %s 2> %s &\n" % (render_command(broker), logs[0], logs[1]))
    _say(r, "wait for %r in the broker's output" % STARTED_LINE)
    child = None
    if not r.dry:
        child = _spawn(r, broker, stdout = logs[0], stderr = logs[1])
        r.ctx.defer(_kill_quietly, child)
        ready = False
        for _ in range(_START_POLLS):
            if child.try_wait() != None:
                fail("the broker exited before it started; see %s and %s" % (logs[0], logs[1]))
            if _started(r, logs):
                ready = True
                break
            sleep(_POLL_MS)
        if not ready:
            fail("the broker did not start in %d ms; see %s" % (_START_POLLS * _POLL_MS, logs[0]))

    code = _run(r, driver)

    _say(r, "read /proc/<broker pid>/stat, then kill -TERM <broker pid> and wait for it to exit")
    seconds = 0
    if not r.dry:
        seconds = cpu_seconds(parse_proc_stat(r.ctx.std.fs.read_to_string("/proc/%d/stat" % child.id)), r.clock_ticks)
        r.ctx.std.process.command("kill").args(["-TERM", str(child.id)]).spawn().wait()
        status = None
        for _ in range(_STOP_POLLS):
            status = child.try_wait()
            if status != None:
                break
            sleep(_POLL_MS)
        if status == None:
            child.kill()
            child.wait()
            fail("the broker did not exit in %d ms after SIGTERM" % (_STOP_POLLS * _POLL_MS))
        if status.code != 0:
            r.ctx.std.io.stderr.write("warning: the broker exited with %r after SIGTERM; see %s\n" % (status.code, logs[1]))

    # A saturating run writes gigabytes, and nothing reads them afterwards.
    _remove_dir(r, log_dir)
    return struct(seconds = seconds, code = code)

def session_verdict(code, attempt, attempts):
    """What to do after a driver run that exited with `code`.

    `"ok"` on success, `"retry"` when `timeout` stopped a hung driver and an
    attempt is left, and `"fail"` otherwise.
    """
    if code == 0:
        return "ok"
    if code in DRIVER_TIMED_OUT and attempt < attempts:
        return "retry"
    return "fail"

# A hung driver gets one more session: a fresh data directory and broker.
_SESSION_ATTEMPTS = 2

def _session_retrying(r, broker, driver, log_dir, logs):
    """[`_session`], run again once when `timeout` stopped a hung driver."""
    for attempt in range(1, _SESSION_ATTEMPTS + 1):
        outcome = _session(r, broker, driver, log_dir, logs)
        verdict = session_verdict(outcome.code, attempt, _SESSION_ATTEMPTS)
        if verdict == "ok":
            return outcome.seconds
        if verdict == "fail":
            fail("%s exited with %r" % (render_command(driver), outcome.code))
        r.ctx.std.io.stderr.write("warning: the driver hung (exit %r); running the session again\n" % outcome.code)
    fail("unreachable")

def _read_scenarios(r, entries):
    sources = {}
    for entry in entries:
        if entry.source not in sources:
            sources[entry.source] = r.ctx.std.fs.read_to_string("%s/bench/scenarios/%s.yaml" % (r.root, entry.source))
    return sources

def _phase_build(r):
    for cmd in build_commands(r.root, r.work, r.variants):
        _must(r, cmd)

def _phase_train(r):
    _require(r, "train")

    # The instrumented build runs instrumented build scripts, and they leave
    # profiles here too. Only the broker's profiles go into the merge.
    _fresh_dir(r, r.work + "/profraw")
    sources = _read_scenarios(r, TRAINING)
    for entry in TRAINING:
        text = training_scenario(entry, sources[entry.source])
        path = "%s/scenarios/train/%s.yaml" % (r.work, entry.name)
        _write(r, path, text)
        label = "train-" + entry.name
        _session_retrying(
            r,
            broker_command(r.bin.instrumented, r.work + "/data/" + label, scenario_partitions(text), env = training_env(r.work, entry.name)),
            driver_command(r.bin.driver, path, "%s/train/%s.json" % (r.work, entry.name)),
            r.work + "/data/" + label,
            [r.work + "/logs/" + label + ".out", r.work + "/logs/" + label + ".err"],
        )

def _phase_merge(r):
    sysroot = _capture(r.ctx, ["rustc", "--print", "sysroot"], r.root)
    triple = host_triple(_capture(r.ctx, ["rustc", "-vV"], r.root))
    tool = llvm_profdata_path(sysroot, triple)
    directory = r.work + "/profraw"
    if r.dry:
        profraws = [directory + "/*.profraw"]
    else:
        if not r.ctx.std.fs.exists(tool):
            fail("%s is missing: run `rustup component add llvm-tools`" % tool)
        names = [entry.path for entry in r.ctx.std.fs.read_dir(directory) if entry.is_file] if r.ctx.std.fs.exists(directory) else []
        profraws = profraw_files(directory, names)
        if not profraws:
            fail("%s holds no .profraw files: run `aspect pgo --phase train`. An instrumented broker writes one only when it exits cleanly." % directory)
    _must(r, merge_command(tool, r.work, profraws))

def _phase_optimize(r):
    _require(r, "optimize")
    cmds = optimize_commands(r.root, r.work, r.variants)
    if not cmds:
        _say(r, "no selected variant uses the profile")
    for cmd in cmds:
        _must(r, cmd)

def _phase_compare(r):
    _require(r, "compare")
    sources = _read_scenarios(r, EVALUATION)
    texts = {}
    for entry in EVALUATION:
        texts[entry.name] = evaluation_scenario(entry, sources[entry.source])
        _write(r, "%s/scenarios/eval/%s.yaml" % (r.work, entry.name), texts[entry.name])

    brokers = r.bin.brokers
    results = []
    results_path = r.work + "/compare/results.json"
    for trial in trial_plan(r.trials, [entry.name for entry in EVALUATION], r.variants):
        label = trial_label(trial)
        text = texts[trial.scenario]
        out = "%s/compare/%s.json" % (r.work, label)
        _say(r, "round %d of %d: %s on %s" % (trial.round, r.trials, trial.scenario, trial.binary))
        seconds = _session_retrying(
            r,
            broker_command(brokers[trial.binary], r.work + "/data/" + label, scenario_partitions(text), cpus = BROKER_CPUS),
            driver_command(r.bin.driver, "%s/scenarios/eval/%s.yaml" % (r.work, trial.scenario), out, cpus = DRIVER_CPUS),
            r.work + "/data/" + label,
            [r.work + "/logs/" + label + ".out", r.work + "/logs/" + label + ".err"],
        )
        if r.dry:
            continue
        run = json.decode(r.ctx.std.fs.read_to_string(out))
        if run.get("errors"):
            r.ctx.std.io.stderr.write("warning: %s reports errors: %s\n" % (out, run["errors"]))
        metrics = driver_metrics(run, scenario_seconds(text))
        metrics["cpu_s"] = seconds
        results.append({"round": trial.round, "scenario": trial.scenario, "binary": trial.binary, "metrics": metrics})

        # Kept after every trial, so a run that stops part way still has its numbers.
        r.ctx.std.fs.write(results_path, json.encode(results))

    report = r.work + "/report.md"
    setup = struct(work = r.work, trials = r.trials, clock_ticks = r.clock_ticks, variants = r.variants)
    _write(r, report, render_report(setup, [entry.name for entry in EVALUATION], results))
    r.ctx.std.io.stdout.write("report: %s\n" % report)

_PHASE_IMPLS = {
    "build": _phase_build,
    "train": _phase_train,
    "merge": _phase_merge,
    "optimize": _phase_optimize,
    "compare": _phase_compare,
}

def _impl(ctx: TaskContext) -> int:
    root = ctx.std.env.bazel_root_dir()
    phases, error = parse_phases(ctx.args.phase)
    if error == None:
        variants, error = parse_variants(ctx.args.variants)
    if error != None:
        ctx.std.io.stderr.write(error + "\n")
        return 2
    if ctx.args.trials < 1:
        ctx.std.io.stderr.write("--trials must be at least 1, got %d\n" % ctx.args.trials)
        return 2
    work = resolve_path(ctx.args.work_dir, ctx.std.env.current_dir()) if ctx.args.work_dir else default_work_dir(root)

    # A `v3` build compiles its build scripts for `x86-64-v3` too, and runs
    # them here, so the build host needs the level as much as the compare host.
    targeted = [n for n in variants if _VARIANT[n].cpu and (_VARIANT[n].phase in phases or "compare" in phases)]
    if targeted:
        missing = missing_cpu_flags(ctx.std.fs.read_to_string("/proc/cpuinfo"), X86_64_V3_FLAGS)
        if missing:
            message = "this CPU lacks %s, which the %s build needs for x86-64-v3; leave it out of --variants" % (" ".join(missing), ", ".join(targeted))
            if not ctx.args.dry_run:
                ctx.std.io.stderr.write(message + "\n")
                return 2
            ctx.std.io.stdout.write("# warning: %s\n" % message)

    clock_ticks = 100
    if "train" in phases or "compare" in phases:
        clock_ticks = int(_capture(ctx, ["getconf", "CLK_TCK"], root).strip())

    r = struct(
        ctx = ctx,
        dry = ctx.args.dry_run,
        root = root,
        work = work,
        bin = binaries(work),
        trials = ctx.args.trials,
        clock_ticks = clock_ticks,
        phases = phases,
        variants = variants,
    )
    _say(r, "work directory %s, phases %s, variants %s%s" % (work, " ".join(phases), " ".join(variants), ", dry run" if r.dry else ""))
    if not r.dry:
        ctx.std.fs.create_dir_all(work + "/logs")
    for phase in phases:
        _say(r, "phase " + phase)
        _PHASE_IMPLS[phase](r)
    return 0

pgo = task(
    summary = "Build profile-guided and x86-64-v3 brokers and compare them with the baseline",
    implementation = _impl,
    args = {
        "work_dir": args.string(default = "", description = "Where builds, profiles and results go. Default: pgo-work beside the repository root."),
        "phase": args.string(default = "all", description = "all, or the first phase to run (build, train, merge, optimize or compare) and every later one after it, or a comma list of phases that runs exactly those, in pipeline order."),
        "variants": args.string(default = DEFAULT_VARIANTS, description = "Comma list of the brokers to build and compare: baseline, pgo, v3, v3-pgo. Must include baseline."),
        "trials": args.int(default = 5, description = "Compare rounds. Each round runs every selected broker on every evaluation scenario."),
        "dry_run": args.boolean(default = False, description = "Print every command with its environment, and run nothing."),
    },
)
