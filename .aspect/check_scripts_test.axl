"""Unit tests for `check_scripts.axl`."""

load("./check_scripts.axl", "ALLOWED", "audit", "is_script", "shebang_interpreter")
load("./testing.axl", "check_eq", "suite", "suite_task")

def _unreadable(path):
    fail("the first line of %s should not have been read" % path)

def _empty(_path):
    return ""

def _line(text):
    return lambda _path: text

def _test_shebang_interpreter(_ctx):
    for line, want in [
        ("#!/bin/bash", "bash"),
        ("#!/usr/bin/env bash", "bash"),
        ("#!/usr/bin/env python3", "python3"),
        ("#!/usr/bin/env -S python3 -u", "python3"),
        ("#! /bin/sh", "sh"),
        ("#!/usr/bin/perl", "perl"),
        ("// not a shebang", ""),
        ("", ""),
        ("#!/usr/bin/env", ""),
    ]:
        check_eq("shebang %r" % line, shebang_interpreter(line), want)

def _test_suffixes_settle_it(_ctx):
    for path in ["tools/x.sh", "a/b/c.py", "x.bash", "x.zsh", "stubs/x.pyi"]:
        check_eq("%s is a script" % path, is_script(path, _unreadable), True)
    for path in ["crates/broker/src/lib.rs", "docs/README.md", "Cargo.toml", "x.python"]:
        check_eq("%s is not a script" % path, is_script(path, _unreadable), False)

def _test_suffixless_files_are_read(_ctx):
    check_eq("shell shebang", is_script("tools/check-thing", _line("#!/bin/sh")), True)
    check_eq("python shebang", is_script("tools/gen", _line("#!/usr/bin/env python3")), True)
    check_eq("no shebang", is_script("LICENSE", _line("The MIT License")), False)
    check_eq("other interpreter", is_script("tools/gen", _line("#!/usr/bin/env ruby")), False)

def _test_a_suffixed_file_is_never_read(_ctx):
    # `_unreadable` fails if called: a suffix decides on its own, so a sweep
    # over a tree of `.rs` sources opens none of them.
    check_eq(
        "a suffix settles it without a read",
        audit(["crates/broker/src/lib.rs", "docs/x.md", "tools/a.sh"], _unreadable).unlisted,
        ["tools/a.sh"],
    )

def _test_unlisted_scripts_are_reported(_ctx):
    result = audit(sorted(ALLOWED) + ["tools/new.sh", "tools/new.py"], _empty)
    check_eq("unlisted", result.unlisted, ["tools/new.py", "tools/new.sh"])
    check_eq("stale", result.stale, [])

def _test_an_allowed_script_passes(_ctx):
    result = audit(sorted(ALLOWED), _empty)
    check_eq("unlisted", result.unlisted, [])
    check_eq("stale", result.stale, [])

def _test_a_deleted_allowed_script_is_reported(_ctx):
    remaining = sorted(ALLOWED)[1:]
    result = audit(remaining, _empty)
    check_eq("stale", result.stale, [sorted(ALLOWED)[0]])
    check_eq("unlisted", result.unlisted, [])

def _test_every_reason_says_where_it_runs(_ctx):
    for path, reason in ALLOWED.items():
        check_eq(
            "%s reason names where it runs" % path,
            reason.find("runs inside") >= 0,
            True,
        )

check_scripts_tests = suite("check-scripts", [
    _test_shebang_interpreter,
    _test_suffixes_settle_it,
    _test_suffixless_files_are_read,
    _test_a_suffixed_file_is_never_read,
    _test_unlisted_scripts_are_reported,
    _test_an_allowed_script_passes,
    _test_a_deleted_allowed_script_is_reported,
    _test_every_reason_says_where_it_runs,
])

test_check_scripts = suite_task(check_scripts_tests)
