"""Validate historical qualification and execute subsequent immutable candidates."""

load("@std//hash.axl", "sha256")
load("./check_qualification_gates.axl", "gate_script", "run_gate")

_HEX = "0123456789abcdef"
_REPOSITORIES = [
    "krabka-io/krabka-broker",
    "krabka-io/krabka-cli",
    "krabka-io/krabka-client-rs",
    "krabka-io/krabka-connect",
    "krabka-io/krabka-io.github.io",
    "krabka-io/krabka-o11y",
    "krabka-io/krabka-o11y-demo",
    "krabka-io/krabka-operator",
    "krabka-io/krabka-protocol",
    "krabka-io/krabka-rebalancer",
    "krabka-io/krabka-schema-registry",
    "krabka-io/krabka-streams-go",
    "krabka-io/krabka-streams-java",
    "krabka-io/krabka-streams-rs",
]
_GATES = {
    "installation": 523,
    "operator-lifecycle": 524,
    "cli-admin": 525,
    "observability-recovery": 526,
}
_ARTIFACT_KINDS = {
    "krabka-io/krabka-broker": ["image"],
    "krabka-io/krabka-cli": ["binary"],
    "krabka-io/krabka-o11y": ["image"],
    "krabka-io/krabka-o11y-demo": ["compose"],
    "krabka-io/krabka-operator": ["chart", "image"],
    "krabka-io/krabka-rebalancer": ["chart", "image"],
}
_EVIDENCE = {
    "installation": ["compose", "helm", "m19", "matrix", "negative-compat"],
    "operator-lifecycle": ["certificate-rotation", "ledger", "scale-down", "upgrade"],
    "cli-admin": ["commands", "state"],
    "observability-recovery": ["alerts", "ledger", "logs", "metrics", "profiles", "traces"],
}

def _hex(value, length):
    if type(value) != "string" or len(value) != length:
        return False
    for index in range(len(value)):
        if value[index] not in _HEX:
            return False
    return True

def _digest(value):
    return type(value) == "string" and value.startswith("sha256:") and _hex(value.removeprefix("sha256:"), 64)

def _digits(value):
    if not value:
        return False
    for index in range(len(value)):
        if value[index] not in "0123456789":
            return False
    return True

def utc_timestamp(value):
    """Whether value is a calendar-valid YYYY-MM-DDTHH:MM:SSZ timestamp."""
    if type(value) != "string" or len(value) != 20:
        return False
    if value[4] != "-" or value[7] != "-" or value[10] != "T" or value[13] != ":" or value[16] != ":" or value[19] != "Z":
        return False
    fields = [value[0:4], value[5:7], value[8:10], value[11:13], value[14:16], value[17:19]]
    if False in [_digits(field) for field in fields]:
        return False
    year, month, day, hour, minute, second = [int(field) for field in fields]
    if year < 1 or month < 1 or month > 12 or hour > 23 or minute > 59 or second > 59:
        return False
    days = [31, 29 if year % 400 == 0 or (year % 4 == 0 and year % 100 != 0) else 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    return day >= 1 and day <= days[month - 1]

def text_digest(value):
    """The SHA-256 identity of retained text, including its final newline."""
    digest = sha256()
    digest.update(value)
    return "sha256:" + digest.hexdigest()

def candidate_identity(document):
    """Canonical input identity, excluding mutable progress and output evidence."""
    components = []
    by_repository = {component["repository"]: component for component in document.get("components", [])}
    for repository in sorted(by_repository.keys()):
        component = by_repository[repository]
        artifacts = sorted([
            [artifact.get("kind", ""), artifact.get("reference", ""), artifact.get("digest", "")]
            for artifact in component.get("artifacts", [])
        ])
        components.append([repository, component.get("revision"), component.get("default_branch"), artifacts])
    return text_digest(json.encode([
        document.get("schema"),
        document.get("captured_at"),
        document.get("architectures"),
        document.get("runner_sha256"),
        components,
    ]))

def runner_digest():
    """Bind candidate results to the reviewed adapters that performed the checks."""
    return text_digest(json.encode([[name, gate_script(name)] for name in sorted(_GATES.keys())]))

def result_problems(document, name, result):
    """Reject reused, incomplete, zero-check or incorrectly bound gate receipts."""
    problems = []
    if type(result) != "dict":
        return ["%s: result must be an object" % name]
    if result.get("gate") != name or result.get("candidate_sha256") != candidate_identity(document):
        problems.append("%s: result does not name this gate and candidate" % name)
    if result.get("runner_sha256") != document.get("runner_sha256"):
        problems.append("%s: result was produced by different qualification adapters" % name)
    checks = result.get("checks", [])
    if type(checks) != "list" or not checks or False in [type(check) == "string" and bool(check) for check in checks]:
        problems.append("%s: result needs named executed checks" % name)
        checks = []
    elif len(checks) != len({check: True for check in checks}):
        problems.append("%s: executed checks must be unique" % name)
    if type(result.get("tests_passed")) != "int" or result.get("tests_passed", 0) <= 0 or result.get("tests_passed") != len(checks):
        problems.append("%s: result must contain a nonzero count of executed checks" % name)
    if type(result.get("exit_code")) != "int" or result.get("exit_code") != 0:
        problems.append("%s: gate command did not succeed" % name)
    for field in ["commands_sha256", "log_sha256"]:
        if not _digest(result.get(field, "")):
            problems.append("%s: result needs %s" % (name, field))
    return problems

def retained_result_problems(document, name, result, commands, log, executed_candidate):
    """Validate downloaded evidence bytes as well as their execution receipt."""
    problems = result_problems(document, name, result)
    if candidate_identity(executed_candidate) != candidate_identity(document):
        problems.append(name + ": retained input belongs to another candidate")
    if result.get("commands_sha256") != text_digest(gate_script(name)):
        problems.append(name + ": commands differ from the candidate's gate adapter")
    for field, content in [("commands_sha256", commands), ("log_sha256", log)]:
        if result.get(field) != text_digest(content):
            problems.append(name + ": retained " + field + " differs from the executed result")
    return problems

def assemble_results(ctx, document):
    """Package verified gate receipts into a final manifest and publishable report."""
    if document.get("schema") != 2:
        fail("assembly requires a schema-2 candidate")
    if document.get("runner_sha256") != runner_digest():
        fail("assembly needs the candidate's qualification adapters")
    if not ctx.args.publish_prefix.startswith("https://github.com/krabka-io/krabka-broker/releases/download/"):
        fail("assembly requires the immutable GitHub release download prefix")
    root = ctx.std.env.bazel_root_dir()
    output = root + "/" + ctx.args.output
    report = ["# Ecosystem qualification", "", "Candidate: `" + candidate_identity(document) + "`", ""]
    for gate in document["gates"]:
        name = gate["name"]
        directory = output + "/" + name
        result = json.decode(ctx.std.fs.read_to_string(directory + "/result.json"))
        executed_candidate = json.decode(ctx.std.fs.read_to_string(directory + "/candidate.json"))
        problems = retained_result_problems(
            document,
            name,
            result,
            ctx.std.fs.read_to_string(directory + "/commands.txt"),
            ctx.std.fs.read_to_string(directory + "/run.log"),
            executed_candidate,
        )
        if problems:
            fail("\n".join(problems))
        archive = output + "/" + name + ".tar.gz"
        status = ctx.std.process.command("tar").args(["-czf", archive, "-C", output, name]).spawn().wait()
        if status.code != 0:
            return status.code
        hashed = ctx.std.process.command("sha256sum").args([archive]).stdout("piped").spawn().wait_with_output()
        if hashed.status.code != 0:
            return hashed.status.code
        digest = "sha256:" + hashed.stdout.split()[0]
        url = ctx.args.publish_prefix.rstrip("/") + "/" + name + ".tar.gz"
        gate["status"] = "passed"
        gate["result"] = result
        gate["evidence"] = [{"name": item, "url": url, "sha256": digest} for item in _EVIDENCE[name]]
        report.append("- [%s](%s): %d executed checks; `%s`." % (name, url, result["tests_passed"], digest))
    report.extend(["", "Each bundle contains the candidate, exact commands, complete log, named executed checks and bound receipt.", ""])
    report_text = "\n".join(report)
    ctx.std.fs.write(output + "/report.md", report_text)
    document["status"] = "qualified"
    document["report"] = {"url": ctx.args.publish_prefix.rstrip("/") + "/report.md", "sha256": text_digest(report_text)}
    problems = manifest_problems(document, final = True)
    if problems:
        fail("\n".join(problems))
    ctx.std.fs.write(output + "/manifest.json", json.encode(document) + "\n")
    return 0

def manifest_problems(document, final = False):
    """Return every contract violation without stopping at the first one."""
    problems = []
    candidate = document.get("schema") == 2
    if document.get("schema") not in [1, 2]:
        problems.append("schema must be 1 (historical) or 2 (candidate)")
    if candidate and not _digest(document.get("runner_sha256", "")):
        problems.append("candidate needs the qualification runner sha256")
    if document.get("status") not in ["draft", "qualified"]:
        problems.append("status must be draft or qualified")
    if not utc_timestamp(document.get("captured_at", "")):
        problems.append("captured_at must be a calendar-valid UTC timestamp")
    if document.get("architectures") != ["linux/amd64"]:
        problems.append("architectures must state the one published platform: linux/amd64")

    repositories = []
    strict = final or document.get("status") == "qualified"
    for component in document.get("components", []):
        repository = component.get("repository", "")
        repositories.append(repository)
        if not _hex(component.get("revision", ""), 40):
            problems.append("%s: revision is not a 40-character commit" % repository)
        if not component.get("default_branch"):
            problems.append("%s: default_branch is empty" % repository)
        artifacts = component.get("artifacts", [])
        if repository in _ARTIFACT_KINDS and sorted([artifact.get("kind", "") for artifact in artifacts]) != _ARTIFACT_KINDS[repository]:
            problems.append("%s: artifacts must preserve the %s slot" % (repository, ", ".join(_ARTIFACT_KINDS[repository])))
        for artifact in artifacts:
            if not artifact.get("kind") or not artifact.get("reference"):
                problems.append("%s: artifact kind and reference are required" % repository)
            if (strict or candidate) and not _digest(artifact.get("digest", "")):
                problems.append("%s: qualified artifact has no sha256 digest" % repository)
            if (strict or candidate) and artifact.get("kind") != "image" and not artifact.get("reference", "").startswith("https://"):
                problems.append("%s: qualified non-image artifact needs an https URL" % repository)
    if sorted(repositories) != _REPOSITORIES:
        problems.append("components must name each canonical repository exactly once")

    gates = []
    for gate in document.get("gates", []):
        name = gate.get("name", "")
        gates.append(name)
        if name not in _GATES or gate.get("issue") != _GATES.get(name):
            problems.append("%s: gate does not name its Milestone 20 issue" % name)
        if gate.get("status") not in ["pending", "passed"]:
            problems.append("%s: status must be pending or passed" % name)
        claimed = strict or gate.get("status") == "passed"
        if strict:
            if gate.get("status") != "passed":
                problems.append("%s: qualification gate has not passed" % name)
        if claimed:
            if candidate:
                problems.extend(result_problems(document, name, gate.get("result", {})))
            if not gate.get("evidence"):
                problems.append("%s: qualification gate has no evidence" % name)
            names = sorted([evidence.get("name", "") for evidence in gate.get("evidence", [])])
            if name in _EVIDENCE and names != _EVIDENCE[name]:
                problems.append("%s: evidence does not cover %s" % (name, ", ".join(_EVIDENCE[name])))
        for evidence in gate.get("evidence", []):
            if not evidence.get("name") or not evidence.get("url", "").startswith("https://") or not _digest(evidence.get("sha256", "")):
                problems.append("%s: evidence needs a name, https URL and sha256 digest" % name)
    if sorted(gates) != sorted(_GATES.keys()):
        problems.append("gates must name each Milestone 20 acceptance gate exactly once")

    if strict:
        if document.get("status") != "qualified":
            problems.append("a final manifest must have status qualified")
        report = document.get("report", {})
        if not report.get("url", "").startswith("https://") or not _digest(report.get("sha256", "")):
            problems.append("a final manifest needs a published report URL and sha256 digest")
    return problems

def _impl(ctx: TaskContext) -> int:
    root = ctx.std.env.bazel_root_dir()
    document = json.decode(ctx.std.fs.read_to_string(root + "/" + ctx.args.manifest))
    if ctx.args.new_candidate:
        if ctx.args.new_candidate == ctx.args.manifest:
            fail("new candidate must not overwrite the input manifest")
        absent = ctx.std.process.command("test").args(["!", "-e", root + "/" + ctx.args.new_candidate]).spawn().wait()
        if absent.code != 0:
            fail("new candidate destination already exists")
        document["schema"] = 2
        document["status"] = "draft"
        document["runner_sha256"] = runner_digest()
        stamp = ctx.std.process.command("date").args(["-u", "+%Y-%m-%dT%H:%M:%SZ"]).stdout("piped").spawn().wait_with_output()
        if stamp.status.code != 0:
            fail("cannot capture candidate timestamp")
        document["captured_at"] = stamp.stdout.strip()
        document["report"] = {"url": "", "sha256": ""}
        for gate in document["gates"]:
            gate["status"] = "pending"
            gate["evidence"] = []
            gate.pop("result", None)
        ctx.std.fs.write(root + "/" + ctx.args.new_candidate, json.encode(document) + "\n")
        return 0
    problems = manifest_problems(document, final = ctx.args.final)
    for problem in problems:
        ctx.std.io.stderr.write(problem + "\n")
    if problems:
        return 1
    if ctx.args.assemble:
        return assemble_results(ctx, document)
    if ctx.args.gate:
        if document.get("schema") != 2 or document.get("runner_sha256") != runner_digest():
            fail("execution needs a schema-2 candidate bound to the current adapters")
        if ctx.args.gate not in _GATES:
            fail("unknown qualification gate: " + ctx.args.gate)
        return run_gate(ctx, document, candidate_identity(document), ctx.args.gate, text_digest)
    ctx.std.io.stdout.write(
        "check-qualification: %d components and %d gates, %s\n" % (
            len(document["components"]),
            len(document["gates"]),
            document["status"],
        ),
    )
    return 0

check_qualification = task(
    summary = "Validate qualification or execute one immutable candidate gate",
    implementation = _impl,
    args = {
        "manifest": args.string(default = "qualification/milestone-20.json"),
        "final": args.boolean(default = False, description = "Require immutable artifacts and passed evidence."),
        "new_candidate": args.string(default = "", description = "Copy the manifest into a fresh draft at this repository-relative path."),
        "gate": args.string(default = "", description = "Execute one candidate gate; each invocation uses an isolated work directory."),
        "output": args.string(default = ".qualification", description = "Repository-relative evidence directory."),
        "assemble": args.boolean(default = False, description = "Assemble and validate the four retained gate receipts."),
        "publish_prefix": args.string(default = "", description = "Immutable release download URL used by assembled evidence."),
    },
)
